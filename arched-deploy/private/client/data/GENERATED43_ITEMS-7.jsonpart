/wiki/Spiral_Jetty","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":313,"canonical_number":null,"revision95":1,"topic74":"Land Art and site","skill74":"context_relation","testedRelation95":"B03:land-art-and-site","practiceRepetitionKeys95":["TOPIC:land-art-and-site"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"e1f1495bebe19bd36d21803d71a3793b5a37174abfa1507489055cacf74314e7","fingerprint":"16ad7f1fc1ac0879f935","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B03-20261007-314","qid":950314,"nodeId":"REVIEW95-ARCHED-B03-20261007-314","relatedNodeIds":["REVIEW95-ARCHED-B03-20261007-314"],"sourceAtlasNodeIds":[],"major":"Art History","group":"Photography and painting medium distinction","stem":"Which pairing identifies two different image-making processes?","choices":["Daguerreotype — early photography; lithography — planographic printing","Daguerreotype — intaglio printing; lithography — relief printing","Daguerreotype — stencil printing; lithography — photographic projection","Daguerreotype — relief printing; lithography — intaglio printing","Daguerreotype — planographic printing; lithography — early photography"],"correctIndex":0,"answer":"Daguerreotype — early photography; lithography — planographic printing","explanation":"A daguerreotype is a photographic image on a prepared metal plate. Lithography prints from a surface whose image and non-image areas differ chemically, not by relief depth.","format":"matching","references":[{"file":"Encyclopaedia reference — Daguerreotype","verificationUrl":"https://en.wikipedia.org/wiki/Daguerreotype","sourceMetadata95":{"id":"B03-S-Daguerreotype","key":"Daguerreotype","title":"Encyclopaedia reference — Daguerreotype","url":"https://en.wikipedia.org/wiki/Daguerreotype","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}},{"file":"Encyclopaedia reference — Lithography","verificationUrl":"https://en.wikipedia.org/wiki/Lithography","sourceMetadata95":{"id":"B03-S-Lithography","key":"Lithography","title":"Encyclopaedia reference — Lithography","url":"https://en.wikipedia.org/wiki/Lithography","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":314,"canonical_number":null,"revision95":1,"topic74":"Photography and painting medium distinction","skill74":"context_relation","testedRelation95":"B03:photography-and-painting-medium-distinction","practiceRepetitionKeys95":["TOPIC:photography-and-painting-medium-distinction"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"b46d5dda72725df9e