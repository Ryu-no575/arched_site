:[{"id":"louvre-museum-paris","name":"Louvre Museum, Paris"}],"url":"https://en.wikipedia.org/wiki/Grande_Odalisque","imageRecordUrl":"https://commons.wikimedia.org/wiki/File:La_grande_odalisque_-_Jean-Auguste_Dominique_Ingres_-_Mus%C3%A9e_du_Louvre_Peintures_RF_1158.jpg","license":"Public domain","credit":"Jean-Auguste-Dominique Ingres","path":"private/media/068f626d0a7e5b82d212b767.webp","width":960,"height":536,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Orientalist subject and deliberately elongated anatomy.","tapestryId93":"t63-f1bd9df37745","imageScope":"Identified work. Sculpture photographs may show later casts or surviving copies.","alphaRefs93":[926],"aliases93":["La Grande Odalisque"]},{"assetId":"ART93-t68-0fc0c72010ea","title":"The Sea of Ice","artist":"Caspar David Friedrich","date":"1823–1824","begin":1823,"end":1824,"museums":[{"id":"hamburger-kunsthalle","name":"Hamburger Kunsthalle"}],"url":"https://en.wikipedia.org/w/index.php?search=The%20Sea%20of%20Ice","imageRecordUrl":"https://commons.wikimedia.org/wiki/File:Caspar_David_Friedrich_-_Das_Eismeer_-_Hamburger_Kunsthalle_-_02.jpg","license":"Public domain","credit":"Caspar David Friedrich","path":"private/media/b50eeedb92d688ea5a5bf21e.webp","width":960,"height":718,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"A shipwreck within fractured ice; often associated with Romantic ideas of the sublime.","tapestryId93":"t68-0fc0c72010ea","imageScope":"Identified work. Sculpture photographs may show later casts or surviving copies.","alphaRefs93":[518],"aliases93":["The Sea of Ice"]},{"assetId":"ART93-t68-b7e0d1b9bcca","title":"The Thinker","artist":"Auguste Rodin","date":"Conceived c. 1880; enlarged model 1902; illustrated cast 1968","begin":1880,"end":1880,"museums":[{"id":"kunsthalle-bielefeld","name":"Kunsthalle Bielefeld"}],"url":"https://kunsthalle-bielefeld.de/en/museum/collection/","imageRecordUrl":"https://commons.wikimedia.org/wiki/File:Le_Penseur_by_Rodin_%28Kunsthalle_Bielefeld%29_2014-04-10.JPG","license":"Public domain","credit":"Kaisching","path":"private/media/31edc6542179030c4e68a6de.webp","width":900,"height":1200,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Conceived for The Gates of Hell; enlarged versions and bronze casts have later dates. The image is the Bielefeld cast, catalogued 1902/1968, not the original small figure.","tapestryId93":"t68-b7e0d1b9bcca","imageScope":"Identified work. Sculpture photographs may show later casts or surviving copies.","alphaRefs93":[945],"aliases93":["The Thinker"]},{"assetId":"ART93-t68-1c449f97fb23","title":"The Scream","artist":"Edvard Munch","date":"1893","begin":1893,"end":1893,"museums":[{"id":"national-museum-oslo","name":"National Museum, Oslo"}],"url":"https://en.wikipedia.org/w/index.php?search=The%20Scream","imageRecordUrl":"https://commons.wikimedia.org/wiki/File:Edvard_Munch%2C_1893%2C_The_Scream%2C_oil%2C_tempera_and_pastel_on_cardboard%2C_91_x_73_cm%2C_National_Gallery_of_Norway.jpg","license":"Public domain","credit":"Edvard Munch","path":"private/media/303bfcb847f3ceb56b920f06.webp","width":960,"height":1191,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Several painted and printed versions exist; 1893 refers to the early painted version.","tapestryId93":"t68-1c449f97fb23","imageScope":"Identified work. Sculpture photographs may show later casts or surviving copies.","alphaRefs93":[191],"aliases93":["The Scream"]},{"assetId":"ART93-t68-c8f1ada187ec","title":"Dynamism of a Dog on a Leash","artist":"Giacomo Balla","date":"1912","begin":1912,"end":1912,"museums":[{"id":"buffalo-akg-art-museum","name":"Buffalo AKG Art Museum"}],"url":"https://en.wikipedia.org/w/index.php?search=Dynamism%20of%20a%20Dog%20on%20a%20Leash","imageRecordUrl":"https://en.wikipedia.org/wiki/File:Giacomo_Balla%2C_1912%2C_Dynamism_of_a_Dog_on_a_Leash%2C_oil_on_canvas%2C_89.8_x_109.8_cm%2C_Albright-Knox_Art_Gallery.jpg","license":"Copyrighted artwork; reproduction from Wikipedia. Commercial-use permission not established.","credit":"Giacomo Balla","path":"private/media/94dbd45784b54737e525963c.webp","width":330,"height":272,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Repeated forms suggest motion and the influence of photographic studies.","tapestryId93":"t68-c8f1ada187ec","imageScope":"Identified work. Sculpture photographs may show later casts or surviving copies.","alphaRefs93":[788],"aliases93":["Dynamism of a Dog on a Leash"]},{"assetId":"ART93-t68-8f7ccc2d89be","title":"Dynamism of a Cyclist","artist":"Umberto Boccioni","date":"1913","begin":1913,"end":1913,"museums":[{"id":"museo-del-novecento-milan","name":"Museo del Novecento, Milan"}],"url":"https://catalogo.beniculturali.it/detail/HistoricOrArtisticProperty/0303275261","imageRecordUrl":"https://commons.wikimedia.org/wiki/File:Umberto_Boccioni%2C_1913%2C_Dynamism_of_a_Cyclist_%28Dinamismo_di_un_ciclista%29%2C_oil_on_canvas%2C_70_x_95_cm%2C_Gianni_Mattioli_Collection%2C_on_long-term_loan_to_the_Peggy_Guggenheim_Collection%2C_Venice.jpg","license":"Public domain","credit":"Umberto Boccioni","path":"private/media/4c063c9346a211f62d2d9438.webp","width":960,"height":696,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Futurist painting explores movement rather than depicting a static anatomical study. Gianni Mattioli Collection, on deposit at Museo del Novecento since 2022. The historic image filename refers to an earlier Venice loan.","tapestryId93":"t68-8f7ccc2d89be","imageScope":"Identified work. Sculpture photographs may show later casts or surviving copies.","alphaRefs93":[294],"aliases93":["Dynamism of a Cyclist"]},{"assetId":"ART94-MET-438817","title":"The Dance Class","artist":"Edgar Degas","date":"1874","begin":1874,"end":1874,"museums":[{"id":"MET","name":"The Metropolitan Museum of Art, New York"}],"url":"https://www.metmuseum.org/art/collection/search/438817","remoteImageUrl":"https://images.metmuseum.org/CRDImages/ep/original/DP-20101-001.jpg","license":"Public domain · Met Open Access","alphaRefs93":[],"path":"data/revision94/images/ART94-MET-438817.webp","width":1298,"height":1400,"imageRecordUrl":"https://www.metmuseum.org/art/collection/search/438817","imageStatus":"ready","studyPriority":"essential","category":"art","studyNote50":"Met version, 1874; distinct from the Orsay painting illustrated in Alpha 151."},{"assetId":"ART94-BOR-PRO","title":"The Rape of Proserpina","artist":"Gian Lorenzo Bernini","date":"1621–1622","museums":[{"id":"Q199065","name":"Galleria Borghese"}],"url":"https://www.collezionegalleriaborghese.it/opere/ratto-di-proserpina","imageRecordUrl":"https://www.collezionegalleriaborghese.it/opere/ratto-di-proserpina","remoteImageUrl":"https://www.collezionegalleriaborghese.it/uploads/server/files/CCLXVIII.jpg","path":"data/revision94/images/ART94-BOR-PRO.webp","width":888,"height":1400,"imageStatus":"ready","studyPriority":"essential","category":"art","license":"© Galleria Borghese / rights holders; see collection record","alphaRefs93":[233],"aliases93":["The Rape of Proserpina"]},{"assetId":"ART94-BOR-TRUTH","title":"Truth Unveiled by Time","artist":"Gian Lorenzo Bernini","date":"1646–1652","museums":[{"id":"Q199065","name":"Galleria Borghese"}],"url":"https://www.collezionegalleriaborghese.it/opere/la-verita","imageRecordUrl":"https://www.collezionegalleriaborghese.it/opere/la-verita","remoteImageUrl":"https://www.collezionegalleriaborghese.it/uploads/server/files/CCLXXVIII.jpg","path":"data/revision94/images/ART94-BOR-TRUTH.webp","width":1050,"height":1400,"imageStatus":"ready","studyPriority":"essential","category":"art","license":"© Galleria Borghese / rights holders; see collection record","alphaRefs93":[3],"aliases93":["Truth Unveiled by Time"]},{"assetId":"ART94-BOR-PAULINE","title":"Pauline Borghese as Venus Victrix","artist":"Antonio Canova","date":"1804–1808","museums":[{"id":"Q199065","name":"Galleria Borghese"}],"url":"https://www.collezionegalleriaborghese.it/opere/paolina-borghese-bonaparte-come-venere-vincitrice","imageRecordUrl":"https://www.collezionegalleriaborghese.it/opere/paolina-borghese-bonaparte-come-venere-vincitrice","remoteImageUrl":"https://www.collezionegalleriaborghese.it/uploads/server/files/LIV.jpg","path":"data/revision94/images/ART94-BOR-PAULINE.webp","width":1200,"height":949,"imageStatus":"ready","studyPriority":"essential","category":"art","license":"© Galleria Borghese / rights holders; see collection record","alphaRefs93":[3,584],"aliases93":["Pauline Borghese","Venus Victrix"]},{"assetId":"ART94-DEGAS-ORSAY","title":"The Dance Class (Orsay version)","artist":"Edgar Degas","date":"1873–1876","begin":1873,"end":1876,"museums":[{"id":"ORSAY","name":"Musée d’Orsay, Paris"}],"url":"https://www.musee-orsay.fr/fr/oeuvres/la-classe-de-danse-1151","remoteImageUrl":"https://cdn.mediatheque.epmoo.fr/link/3c9igq/mdb1butnusxfi00.jpg","alphaRefs93":[151],"aliases93":["The Dance Class","La Classe de danse"],"path":"data/revision94/images/ART94-DEGAS-ORSAY.webp","imageStatus":"ready","studyPriority":"essential","category":"art","license":"© RMN-Grand Palais / Adrien Didierjean","studyNote50":"Orsay inventory RF 1976. Distinct from the Met version dated 1874.","imageRecordUrl":"https://www.musee-orsay.fr/fr/oeuvres/la-classe-de-danse-1151","width":316,"height":360},{"assetId":"ART106-WAVE","title":"The Great Wave off Kanagawa","artist":"Katsushika Hokusai","date":"c. 1830–1832","begin":1830,"end":1832,"museums":[{"id":"Q160236","name":"The Metropolitan Museum of Art"}],"url":"https://www.metmuseum.org/art/collection/search/56353","imageRecordUrl":"https://www.metmuseum.org/art/collection/search/56353","remoteImageUrl":"https://collectionapi.metmuseum.org/api/collection/v1/iiif/56353/140298/main-image","license":"Public Domain / CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/","credit":"The Met · Henry L. Phillips Collection, Bequest of Henry L. Phillips, 1939 · JP2972","path":"private/media/7a9876bf5d16e4975c1373d8.webp","width":1200,"height":810,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Look for tiny Mount Fuji beneath the crest and the three boats. This is a Japanese woodblock print from Thirty-six Views of Mount Fuji, not an oil painting; size and framing make the mountain seem vulnerable.","revision106":true,"imageScope":"Exact collection object; resized and compressed from the public-domain museum image"},{"assetId":"ART106-SHIVA","title":"Shiva as Lord of Dance (Nataraja)","artist":"Tamil Nadu; Chola-period artist","date":"Late 12th–early 13th century","begin":1175,"end":1225,"museums":[{"id":"Q160236","name":"The Metropolitan Museum of Art"}],"url":"https://www.metmuseum.org/art/collection/search/39329","imageRecordUrl":"https://www.metmuseum.org/art/collection/search/39329","remoteImageUrl":"https://collectionapi.metmuseum.org/api/collection/v1/iiif/39329/171621/main-image","license":"Public Domain / CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/","credit":"The Metropolitan Museum of Art · collection record 39329","path":"private/media/a500377e61325fe6adaf355d.webp","width":901,"height":1200,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"The dancing Shiva combines movement with balance. A drum evokes creation and a flame destruction; the figure underfoot represents illusion. The copper-alloy sculpture belongs to a Hindu context, unlike a Buddha image.","revision106":true,"imageScope":"Exact collection object; resized and compressed from the public-domain museum image"},{"assetId":"ART106-BENIN","title":"Plaque with equestrian oba and attendants","artist":"Ìgùn Ẹ́rọ̀nwwọ̀n brass-casting guild; Edo peoples","date":"c. 1540–1570","begin":1540,"end":1570,"museums":[{"id":"Q160236","name":"The Metropolitan Museum of Art"}],"url":"https://www.metmuseum.org/art/collection/search/310752","imageRecordUrl":"https://www.metmuseum.org/art/collection/search/310752","remoteImageUrl":"https://collectionapi.metmuseum.org/api/collection/v1/iiif/310752/683015/main-image","license":"Public Domain / CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/","credit":"The Met · Michael C. Rockefeller Memorial Collection, Gift of Nelson A. Rockefeller, 1965 · 1978.412.309","path":"private/media/28b030e85938259719c379a5.webp","width":968,"height":1200,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Compare the scale of the king with his attendants: relative size communicates rank. This is cast brass court art from Benin in present-day Nigeria. The wider tradition was dispersed through the British looting of the palace in 1897; provenance is part of its history.","revision106":true,"imageScope":"Exact collection object; resized and compressed from the public-domain museum image"},{"assetId":"ART106-BUDDHA","title":"Buddha, dated 680","artist":"China; Tang dynasty","date":"680","begin":680,"end":680,"museums":[{"id":"Q160236","name":"The Metropolitan Museum of Art"}],"url":"https://www.metmuseum.org/art/collection/search/39756","imageRecordUrl":"https://www.metmuseum.org/art/collection/search/39756","remoteImageUrl":"https://collectionapi.metmuseum.org/api/collection/v1/iiif/39756/156707/main-image","license":"Public Domain / CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/","credit":"The Met · Gift of Enid A. Haupt, 1997 · 1997.442.3","path":"private/media/5967deeafe9477a3b7a00b4c.webp","width":900,"height":1200,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"This marble Buddha is explicitly dated 680 in the collection record. Separate the date of this object from the much longer Tang dynasty (618–907); a dynasty is context, not an exact date for every work.","revision106":true,"imageScope":"Exact collection object; resized and compressed from the public-domain museum image"},{"assetId":"ART106-IZNIK","title":"Bowl with Variation of 'Baba Nakkas' Design","artist":"Attributed to Iznik, Turkey","date":"c. 1500–1525","begin":1500,"end":1525,"museums":[{"id":"Q160236","name":"The Metropolitan Museum of Art"}],"url":"https://www.metmuseum.org/art/collection/search/448664","imageRecordUrl":"https://www.metmuseum.org/art/collection/search/448664","remoteImageUrl":"https://collectionapi.metmuseum.org/api/collection/v1/iiif/448664/898609/main-image","license":"Public Domain / CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/","credit":"The Met · Rogers Fund, 1932 · 32.34","path":"private/media/e3881bf3b8fd197151f8c619.webp","width":1068,"height":1200,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"Blue and white floral decoration lies beneath a transparent glaze on stonepaste. The attribution is to Iznik; the design-family name does not securely identify the individual potter. Notice how ornament follows the curved vessel.","revision106":true,"imageScope":"Exact collection object; resized and compressed from the public-domain museum image"},{"assetId":"ART106-MOCHE","title":"Stirrup Spout Bottle with Portrait Head","artist":"Moche culture, Peru","date":"3rd–5th century","begin":200,"end":500,"museums":[{"id":"Q160236","name":"The Metropolitan Museum of Art"}],"url":"https://www.metmuseum.org/art/collection/search/308531","imageRecordUrl":"https://www.metmuseum.org/art/collection/search/308531","remoteImageUrl":"https://collectionapi.metmuseum.org/api/collection/v1/iiif/308531/675216/main-image","license":"Public Domain / CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/","credit":"The Met · Gift of Mr. and Mrs. Nathan Cummings, 1964 · 64.228.25","path":"private/media/0029897780edc5a22d324af4.webp","width":800,"height":1200,"imageStatus":"ready","category":"art","studyPriority":"essential","studyNote50":"The portrait head is also a ceramic vessel, with a stirrup-shaped spout joining its passages. The Moche context predates the Inca Empire by centuries; shared geography does not mean a single culture or period.","revision106":true,"imageScope":"Exact collection object; resized and compressed from the public-domain museum image"}]