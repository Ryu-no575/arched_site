","support_summary":"The World Bank Group combines financing, knowledge and expertise to reduce poverty and support development.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":159,"canonical_number":null,"revision95":1,"topic74":"World Bank development role","skill74":"context_relation","testedRelation95":"B02:world-bank-development-role","practiceRepetitionKeys95":["TOPIC:world-bank-development-role"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"22d32080962c4ed9df3c540896d50247cebfd83ebd11f9badb9e09564753cc75","fingerprint":"3b68df4b8d45e29b6050","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-160","qid":950160,"nodeId":"REVIEW95-ARCHED-B02-20261007-160","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-160"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"UNICEF children mandate","stem":"Which UN organization has a specific mandate focused on children?","choices":["The International Labour Organization","UNICEF","UNHCR","UNESCO","The International Monetary Fund"],"correctIndex":1,"answer":"UNICEF","explanation":"UNICEF works on children’s rights, survival, education and protection. Its remit is broader than emergency food deliveries alone.","format":"single_best_answer","references":[{"file":"UN