ista Alberti","Filippo Brunelleschi"],"answer":"Donato Bramante","explanation":"Donato Bramante designed Tempietto at San Pietro in Montorio.","work":"Tempietto at San Pietro in Montorio","artist":"Donato Bramante","priority":5,"proof":"Temple of St. Peter in Montorio","format":"single_choice","kind":"author_work","sourceType":"curated_pdf","nodeId":"PDF33-FACT-016"},{"id":"PDF33-Q017-A","source":"STORIA DELL_ARTE.it.en.pdf","page":55,"group":"renaissance-arch","major":"Architecture","era":"Renaissance","stem":"Who designed Santa Maria presso San Satiro?","choices":["Donato Bramante","Michelangelo","Andrea Palladio","Leon Battista Alberti","Filippo Brunelleschi"],"answer":"Donato Bramante","explanation":"Donato Bramante designed Santa Maria presso San Satiro.","work":"Santa Maria presso San Satiro","artist":"Donato Bramante","priority":4,"proof":"church of S.Maria presso S.Satiro","format":"single_choice","kind":"author_work","sourceType":"curated_pdf","nodeId":"PDF33-FACT-017"},{"id":"PDF33-Q018-A","source":"STORIA DELL_ARTE.it.en.pdf","page":64,"group":"renaissance-arch","major":"Architecture","era":"Renaissance","stem":"Which architect designed Villa Rotonda?","choices":["Andrea Palladio","Filippo Brunelleschi","Leon Battista Alberti","Michelangelo","Donato Bramante"],"answer":"Andrea Palladio","explanation":"Andrea Palladio designed Villa Rotonda.","work":"Villa Rotonda","artist":"Andrea Palladio","priority":5,"proof":"The Rotunda","format":"single_choice","kind":"author_work","sourceType":"curated_pdf","nodeId":"PDF33-FACT-018"},{"id":"PDF33-Q019-A","source":"STORIA DELL_ARTE.it.en.pdf","page":64,"group":"renaissance-arch","major":"Architecture","era":"Renaissance","stem":"Which architect is associated with Teatro Olimpico?","choices":["Andrea Palladio","Leon Battista Alberti","Donato Bramante","Michelangelo","Filippo Brunelleschi"],"answer":"Andrea Palladio","explanation":"Andrea Palladio designed Teatro Olimpico.","work":"Teatro Olimpico","artist":"Andrea Pal