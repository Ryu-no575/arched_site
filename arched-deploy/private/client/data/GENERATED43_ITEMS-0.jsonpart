anoboeriarchitetti.net/project/bosco-verticale/"}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v76","editorialStatus74":"ready","skill74":"function","topic74":"Contemporary Milan","difficulty74":"unrated","lineage74":"Original editorial item; Alpha transcription used to benchmark concise options. Not an official CISIA question.","evidence":{"type":"editorial","referenceBasis":"Institutional reference","checkedAt":"2026-10-05"},"editorial75":{"sourceKey":"bosco76","optionWords":[1,1,2,2,1],"difficultyStatus":"Not calibrated with candidates","syllabusArea":"historical-cultural-space-time"},"fingerprint":"e25ce50ac9d920c15049"},{"id":"GEN43-Q01080","qid":1080,"nodeId":"EDITORIAL74-080","relatedNodeIds":["EDITORIAL74-080"],"factIds":["EDITORIAL74-080"],"major":"Architecture","group":"Pienza","stem":"Which pope initiated the transformation of his birthplace into Pienza?","choices":["Urban VIII","Clement VII","Pius II","Julius II","Sixtus V"],"correctIndex":2,"answer":"Pius II","explanation":"Pius II Piccolomini's patronage reshaped the town around its Renaissance centre.","format":"patronage","references":[{"file":"Editorial reference: Pienza","page":null,"verificationUrl":"https://whc.unesco.org/en/list/789/"}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v76","editorialStatus74":"ready","skill74":"patronage","topic74":"Pienza","difficulty74":"unrated","lineage74":"Original editorial item; Alpha transcription used to benchmark concise options. Not an official CISIA question.","evidence":{"type":"editorial","referenceBasis":"Institutional reference","checkedAt":"2026-10-05"},"editorial75":{"sourceKey":"pienza","optionWords":[2,2,2,2,2],"difficultyStatus":"Not calibrated with candidates","syllabusArea":"historical-cultural-space-time"},"fingerprint":"9ff9b6fbcd6b091dd84b"},{"id":"GEN43-Q01081","qid":1081,"nodeId":"EDITORIAL74-081","relatedNodeIds":["EDITORIAL74-081"],"factIds":["EDITORIAL74-081"],"major":"Architecture","group":"P