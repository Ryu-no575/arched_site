hp?search=Hellenistic%20drama%20and%20spatial%20movement","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["eastmed"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-ba02f6038e86","title":"Roman arch, vault and dome","lane":"architecture","start":-300,"end":300,"approx":true,"note":"An arch spans an opening; a barrel vault extends the arch; intersecting barrel vaults form a groin vault. A dome covers a central space. Do not treat all four as synonyms.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Roman%20arch%2C%20vault%20and%20dome","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-880cd69eaee7","title":"First Punic War","lane":"history","start":-264,"end":-241,"approx":false,"note":"Rome and Carthage.","creators":[],"reference":"https://en.wikipedia.org/wiki/First_Punic_War","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-e28cb1002606","title":"Parthian Empire","lane":"history","start":-248,"end":224,"approx":false,"note":"Arsacid kingdom; the founding date is also given as 247 BCE.","creators":[],"reference":"https://en.wikipedia.org/wiki/Parthian_Empire","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-134ac45d8249","title":"Second Punic War","lane":"history","start":-218,"end":-201,"approx":false,"note":"Hannibal's campaign; Cannae and Zama.","creators":[],"reference":"https://en.wikipedia.org/wiki/Second_Punic_War","sourceSheets":[363