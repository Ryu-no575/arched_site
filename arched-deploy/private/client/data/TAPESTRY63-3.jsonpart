m","kind":"both","start":1905,"end":1930,"note":"Expressive distortion; painting groups and architecture have distinct histories.","colour":"#a980a8","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"central","start":1905,"peak":1915,"end":1930},{"region":"other","start":1905,"peak":1915,"end":1930}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-34","title":"Cubism","kind":"art","start":1907,"end":1925,"note":"Early, analytic and synthetic phases; its influence outlasts the core period.","colour":"#8caa83","reference":"https://www.moma.org/collection/terms/cubism","approx":true,"regions72":[{"region":"france","start":1907,"peak":1912,"end":1925},{"region":"central","start":1910,"peak":1918,"end":1925},{"region":"other","start":1912,"peak":1920,"end":1925}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-35","title":"Futurism","kind":"both","start":1909,"end":1944,"note":"Italian emphasis on speed and modernity; distinguish first and later phases.","colour":"#719caf","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"italy","start":1909,"peak":1915,"end":1944},{"region":"other","start":1912,"peak":1918,"end":1930}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-36","title":"Metaphysical painting","kind":"art","start":1910,"end":1925,"note":"Enigmatic spaces and objects; de Chirico and Carrà are key figures.","colour":"#bb9a55","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"italy","start":1910,"peak":1917,"end":1925},{"region":"france",