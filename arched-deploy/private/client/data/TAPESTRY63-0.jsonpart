f creation"},{"id":"t63-7871ad6e2b59","title":"Theogony","lane":"art","start":-700,"end":-700,"approx":true,"note":"Approximate composition; genealogy of the gods.","creators":["Hesiod"],"reference":"https://en.wikipedia.org/wiki/Theogony","sourceSheets":[3633],"sourceMapping":"item","dateType":"year","threads67":["eastmed"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"context"},{"id":"t63-e60c1b08020a","title":"Traditional foundation of Byzantium","lane":"history","start":-667,"end":-667,"approx":false,"note":"Traditional Greek foundation date.","creators":[],"reference":"https://en.wikipedia.org/wiki/Byzantium","sourceSheets":[3633],"sourceMapping":"period context","dateType":"year","dateQualifier":"Traditional","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-7a98e18271f0","title":"Neo-Babylonian Empire","lane":"history","start":-626,"end":-539,"approx":false,"note":"Babylonian kingdom before Persian conquest.","creators":[],"reference":"https://en.wikipedia.org/wiki/Neo-Babylonian_Empire","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t69-ce7f1374c3f6","title":"Doric, Ionic and Corinthian orders","lane":"architecture","start":-600,"end":-300,"approx":true,"note":"Doric capitals are plain; Ionic capitals have volutes; Corinthian capitals use acanthus leaves. Greek Doric columns usually have no base. Roman adaptations differ.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Doric%2C%20Ionic%20and%20Corinthian%20orders","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["eastmed"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-d55244f9a978","title":"Babylonian destruction of Jerusalem","lane":"history","start":-587,"end":-586,"approx":true,"note":"Often dated 587 or 586 BCE; chronology disputed.","creators":[],"reference":"https://en.wikipedia.org/wiki/Siege_of_Jerusalem_(587_BC)","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","dateQualifier":"Uncertain","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-0f1ec01d5889","title":"Achaemenid Empire","lane":"history","start":-550,"end":-330,"approx":false,"note":"Persian empire from Cyrus II to Alexander.","creators":[],"reference":"https://en.wikipedia.org/wiki/Achaemenid_Empire","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-260b7c4328ef","title":"Roman Republic","lane":"history","start":-509,"end":-27,"approx":false,"note":"Traditional start; Augustus marks the imperial settlement.","creators":[],"reference":"https://en.wikipedia.org/wiki/Roman_Republic","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","dateQualifier":"Traditional","threads67":["italy"],"setting67":"Historical setting"},{"id":"t69-ac0fa7e167c1","title":"Classical Greek proportion and idealisation","lane":"art","start":-500,"end":-323,"approx":true,"note":"Idealised anatomy and balance do not mean every work is motionless. Compare the athletic action of Myron with the measured stance associated with Polykleitos.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Classical%20Greek%20proportion%20and%20idealisation","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["eastmed"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-6290b547cf86","title":"Contrapposto and the weight-bearing leg","lane":"art","start":-500,"end":-100,"approx":true,"note":"The body's weight rests primarily on one leg, producing opposed shifts of hips