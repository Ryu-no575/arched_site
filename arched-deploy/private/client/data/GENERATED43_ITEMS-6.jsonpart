s95":["TOPIC:seurat-and-optical-colour"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"9aeab7adf6d291cc349640ff96e2b3866270d9f9ab05cb321165bfe3f4b526e3","fingerprint":"b65793b84df27d45e69f","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"revised_and_adopted"}},{"id":"ARCHED-B100-20261007-026","qid":950026,"nodeId":"REVIEW95-ARCHED-B100-20261007-026","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-026"],"sourceAtlasNodeIds":[],"major":"Art History","group":"The Great Wave","stem":"Hokusai’s famous Great Wave was produced using which medium?","choices":["A stained-glass window","Polychrome woodblock printing","Mosaic made from stone tesserae","Oil painting on a copper panel","Fresco on wet plaster"],"correctIndex":1,"answer":"Polychrome woodblock printing","explanation":"The image belongs to the Japanese ukiyo-e print tradition. Printing from carved blocks allowed multiple impressions, unlike a single painted canvas.","format":"single_best_answer","references":[{"file":"The Metropolitan Museum of Art — Under the Wave off Kanagawa","verificationUrl":"https://www.metmuseum.org/art/collection/search/45434","sourceMetadata95":{"id":"P04","title":"The Metropolitan Museum of Art — Under the Wave off Kanagawa","url":"https://www.metmuseum.org/art/collection/search/45434","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":26,"canonical_number":null,"revision95":1,"topic74":"The Great Wave","skill74":"context_relation","testedRelation95":"B100:the-great-wave","practiceRepetitionKeys95":["TOPIC:the-great-wave"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"ae4fa20cb13148c829f85400d85cd526bee2ca7beb8ccb1f4fa6d4932e20925b","fingerprint":"2f6d57293a80b3cf9960","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-027","qid":950027,"nodeId":"REVIEW95-ARCHED-B100-20261007-027","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-027"],"sourceAtlasNodeIds":[],"major":"Art History","group":"The Scream","stem":"The Scream by Edvard Munch is most closely associated with:","choices":["Neoclassicism","Naturalism","Suprematism","Expressionism","Impressionism"],"correctIndex":3,"answer":"Expressionism","explanation":"Distorted form and intense colour convey psychological anxiety rather than detached observation.","format":"single_best_answer","references":[{"file":"National Museum of Norway — The Scream","verificationUrl":"https://www.nasjonalmuseet.no/en/collection/object/NG.M.00939","sourceMetadata95":{"id":"P05","title":"National Museum of Norway — The Scream","url":"https://www.nasjonalmuseet.no/en/collection/object/NG.M.00939","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":27,"canonical_number":null,"revision95":2,"topic74":"The Scream","skill74":"context_relation","testedRelation95":"B100:the-scream","practiceRepetitionKeys95":["TOPIC:the-scream"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"fb9f395d3709589f9ae877c482785a6337890d685463d74f1f374aa8495e9891","fingerprint":"b90abc86f7a02b9c54ef","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"revised_and_adopted"},"imageId":"ART93-t68-1c449f97fb23","imageDependency":"helpful","mediaReview100":"manual work/creator identification"},{"id":"ARCHED-B100-20261007-029","qid":950029,"nodeId":"REVIEW95-ARCHED-B100-20261007-029","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-029"],"sourceAtlasNodeIds":[],"major":"Art History","group":"Sfumato","stem":"What does sfumato do to painted contours?","choices":["Softens transitions so that outlines are not sharply defined","Builds a surface with thick raised strokes of paint","Sharpens every outline to separate flat colour fields","Replaces tonal modelling with sheets of applied gold","Forms an image entirely from engraved cross-hatching"],"correctIndex":0,"answer":"Softens transitions so that outlines are not sharply defined","explanation":"Sfumato creates gradual, smoky transitions between tones. It concerns the handling of edges and shading, not simply the use of a dark background.","format":"single_best_answer","references":[{"file":"National Gallery — Sfumato","verificationUrl":"https://www.nationalgallery.org.uk/paintings/glossary/sfumato","sourceMetadata95":{"id":"P07","title":"National Gallery — Sfumato","url":"https://www.nationalgallery.org.uk/paintings/glossary/sfumato","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":29,"canonical_number":null,"revision95":1,"topic74":"Sfumato","skill74":"context_relation","testedRelation95":"B100:sfumato","practiceRepetitionKeys95":["TOPIC:sfumato"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"490264996c686011e6fe47580e73512ea8c5d73366cc7e3db36c1ec98719af15","fingerprint":"0c8d53ef3a97636aee7f","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-031","qid":950031,"nodeId":"REVIEW95-ARCHED-B100-20261007-031","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-031"],"sourceAtlasNodeIds":[],"major":"Art History","group":"Cubism","stem":"Which approach is characteristic of Cubism?","choices":["Maintaining a single fixed viewpoint and continuous illusionistic space","Reviving idealized classical figures with carefully closed contours","Combining dream associations through apparently irrational juxtapositions","Emphasizing fleeting outdoor light through rapid colour touches","Fragmenting forms and combining different viewpoints"],"correctIndex":4,"answer":"Fragmenting forms and combining different viewpoints","explanation":"Cubist artists questioned the single fixed viewpoint of traditional perspective. Objects can be broken into planes and reorganized within the picture.","format":"single_best_answer","references":[{"file":"The Metropolitan Museum of Art — Cubism","verificationUrl":"https://www.metmuseum.org/toah/hd/cube/hd_cube.htm","sourceMetadata95":{"id":"P09","title":"The Metropolitan Museum of Art — Cubism","url":"https://www.metmuseum.org/toah/hd/cube/hd_cube.htm","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":31,"canonical_number":null,"revision95":1,"topic74":"Cubism","skill74":"context_relation","testedRelation95":"B100:cubism","practiceRepetitionKeys95":["TOPIC:cubism"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"dc2c60294e7084ce2e99d8d3965166fefca3e3106ba24a7e158077a86f9714a1","fingerprint":"65cb9037339757e3569b","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-032","qid":950032,"nodeId":"REVIEW95-ARCHED-B100-20261007-032","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-032"],"sourceAtlasNodeIds":["HUB-SURREALISM"],"major":"Art History","group":"Surrealism","stem":"Which source of imagery was especially important to Surrealist artists?","choices":["Documentary records of daily social conditions","Transient optical effects of outdoor light","Standardized forms derived from industrial manufacture","Dreams and the unconscious","Classical rules of ideal proportion"],"correctIndex":3,"answer":"Dreams and the unconscious","explanation":"Surrealism explored mental associations beyond ordinary rational control. Dream-like combinations may therefore appear even when individual objects are painted realistically.","format":"single_best_answer","references":[{"file":"The Metropolitan Museum of Art — Surrealism","verificationUrl":"https://www.metmuseum.org/toah/hd/surr/hd_surr.htm","sourceMetadata95":{"id":"P10","title":"The Metropolitan Museum of Art — Surrealism","url":"https://www.metmuseum.org/toah/hd/surr/hd_surr.htm","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":32,"canonical_number":null,"revision95":1,"topic74":"Surrealism","skill74":"context_relation","testedRelation95":"B100:surrealism","practiceRepetitionKeys95":["TOPIC:surrealism"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"077fa05e29d31b151bf9bfe6ae456ca51c55233158679a98127b1e8f38630dcb","fingerprint":"fe36f555b9417bc5c65a","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-034","qid":950034,"nodeId":"REVIEW95-ARCHED-B100-20261007-034","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-034"],"sourceAtlasNodeIds":["ALPHA-B001-Q056","HUB-IMPRESSIONISM","ENT:IMPRESSIONISM"],"major":"Art History","group":"Impressionism","stem":"Which concern is closely associated with Impressionist painting?","choices":["Changing effects of light in modern life and outdoor scenes","Dream associations between apparently unrelated objects","Fragmented objects viewed from several directions at once","Timeless ideal figures with carefully closed contours","Monumental historical narratives centred on heroic examples"],"correctIndex":0,"answer":"Changing effects of light in modern life and outdoor scenes","explanation":"Impressionist painters frequently explored transient light and contemporary experience. Visible brushwork helps record perception rather than conceal the process of painting.","format":"single_best_answer","references":[{"file":"The Metropolitan Museum of Art — Impressionism","verificationUrl":"https://www.metmuseum.org/toah/hd/imml/hd_imml.htm","sourceMetadata95":{"id":"P12","title":"The Metropolitan Museum of Art — Impressionism","url":"https://www.metmuseum.org/toah/hd/imml/hd_imml.htm","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":34,"canonical_number":null,"revision95":1,"topic74":"Impressionism","skill74":"context_relation","testedRelation95":"B100:impressionism","practiceRepetitionKeys95":["TOPIC:impressionism"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"1d656e45bcbead274e3989699c012e571dba0ac7c835afd6f00de80a7cb74a26","fingerprint":"8872b13da8b34c0620d9","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-036","qid":950036,"nodeId":"REVIEW95-ARCHED-B100-20261007-036","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-036"],"sourceAtlasNodeIds":["HUB-BAROQUE-PAINTING"],"major":"Art History","group":"Baroque painting","stem":"Which combination most closely describes a common Baroque pictorial effect?","choices":["Fragmented viewpoints and intersecting geometric planes","Calm idealization and consistently restrained symmetrical balance","Dramatic light, movement and emotionally charged action","Dream-like combinations drawn from unconscious associations","Transient outdoor light rendered through separate colour touc