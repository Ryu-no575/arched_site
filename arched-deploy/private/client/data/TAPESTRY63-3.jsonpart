reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"france","start":1860,"peak":1875,"end":1890},{"region":"other","start":1880,"peak":1888,"end":1890}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-27","title":"Post-Impressionism","kind":"art","start":1880,"end":1905,"note":"A retrospective umbrella for distinct practices, not one organised group.","colour":"#719caf","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"france","start":1880,"peak":1890,"end":1905}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-28","title":"Neo-Impressionism","kind":"art","start":1886,"end":1910,"note":"Systematic colour division and optical mixture.","colour":"#bb9a55","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"france","start":1886,"peak":1895,"end":1910},{"region":"low","start":1887,"peak":1895,"end":1910},{"region":"italy","start":1890,"peak":1900,"end":1910}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-29","title":"Symbolism","kind":"art","start":1880,"end":1910,"note":"Myth, dreams and suggestive imagery across different national contexts.","colour":"#b37d89","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"france","start":1880,"peak":1895,"end":1910},{"region":"low","start":1880,"peak":1895,"end":1910},{"region":"central","start":1885,"peak":1900,"end":1910},{"region":"other","start":1885,"peak":1900,"end":1910}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate,