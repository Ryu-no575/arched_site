://commons.wikimedia.org/wiki/File:Duccio_-_Rucellai_Madonna.jpg","licenseUrl":""}],"questionIds":["ADD45-Q11353","PDF33-Q007-A"],"tapestryIds":["t63-8c0e641c9143"],"museumIds":["PDFART48-7"],"mapIds":[],"note":"Commissioned for Santa Maria Novella; formerly attributed to Cimabue.","creator":"Duccio","assetIds":["PDFART48-7"],"placeId":"MAP51-093"},{"id":"LE102-60663d3e89060946","title":"Ambrogio Lorenzetti","kind":"person","reference":"https://en.wikipedia.org/wiki/Ambrogio_Lorenzetti","aliases":["Ambrogio Lorenzetti"],"photos":[],"questionIds":["GEN43-Q03949","PDF34-Q-070-B","PDF34-CON-016-A"],"tapestryIds":["t63-f513c25f837f"],"museumIds":[],"mapIds":[],"note":"Sienese painter; approximate dates."},{"id":"LE102-ad443d767eb548e9","title":"Santa Croce, Florence","kind":"architecture","reference":"https://en.wikipedia.org/wiki/Basilica_of_Santa_Croce,_Florence","aliases":["Santa Croce, Florence"],"photos":[{"src":"/.netlify/functions/access?action=media&name=057225231cdade009bc5df56.webp","credit":"Diego Delso","license":"CC BY-SA 4.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Bas%C3%ADlica_de_la_Santa_Cruz,_Florencia,_Italia,_2022-09-18,_DD_95.jpg","caption":""}],"questionIds":[],"tapestryIds":["t63-fb32fe650502"],"museumIds":[],"mapIds":[],"note":"Main medieval campaign; consecrated 1442. Design traditionally attributed to Arnolfo.","built":"1294","creator":"Arnolfo di Cambio","placeId":"CH54-038"},{"id":"LE102-28180266eb0abc51","title":"Foundation of the Ottoman dynasty","kind":"history","reference":"https://en.wikipedia.org/wiki/Ottoman_Empire","aliases":["Foundation of the Ottoman dynasty"],"photos":[],"questionIds":[],"tapestryIds":["t63-aa426748eb63"],"museumIds":[],"mapIds":[],"note":"Conventional date associated with Osman I."},{"id":"LE102-815eff2e7dd3d1ce","title":"Guillaume de Machaut","kind":"person","reference":"https://en.wikipedia.org/wiki/Guillaume_de_Machaut","aliases":["Guillaume de Machaut"],"photos":[],"questionIds":[],"tapestryIds":[