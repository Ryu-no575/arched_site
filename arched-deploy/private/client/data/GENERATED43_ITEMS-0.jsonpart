nce is 1789, 1814–15, then 1919.","format":"chronology","references":[{"file":"Tapestry source record: French Revolution begins","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/French_Revolution"}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v76","editorialStatus74":"ready","skill74":"chronology","topic74":"Modern Europe","difficulty74":"unrated","lineage74":"Original editorial item; Alpha transcription used to benchmark concise options. Not an official CISIA question.","evidence":{"type":"editorial","referenceBasis":"Existing dated record","checkedAt":"2026-10-05"},"editorial75":{"sourceKey":"timeline:French Revolution begins","optionWords":[4,4,4,4,4],"difficultyStatus":"Not calibrated with candidates","syllabusArea":"historical-cultural-space-time","tapestryRecordId":"t63-68fb186f8e24"},"fingerprint":"51a8c960f0866e8a5644"},{"id":"GEN43-Q01091","qid":1091,"nodeId":"EDITORIAL74-091","relatedNodeIds":["EDITORIAL74-091"],"factIds":["EDITORIAL74-091"],"major":"History & Politics","group":"Printing","stem":"Gutenberg’s European movable-type printing developed in which century?","choices":["Thirteenth","Fifteenth","Fourteenth","Sixteenth","Seventeenth"],"correctIndex":1,"answer":"Fifteenth","explanation":"Gutenberg's work belongs to the mid-fifteenth century, before Luther's Reformation.","format":"chronology","references":[{"file":"Tapestry source record: Gutenberg's movable-type printing in Europe","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Johannes_Gutenberg"}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v76","editorialStatus74":"ready","skill74":"chronology","topic74":"Printing","difficulty74":"unrated","lineage74":"Original editorial item; Alpha transcription used to benchmark concise options. Not an official CISIA question.","evidence":{"type":"editorial","referenceBasis":"Existing dated record","checkedAt":"2026-10-05"},"editorial75":{"sourceKey":"timeline:Gutenberg's movable-type printin