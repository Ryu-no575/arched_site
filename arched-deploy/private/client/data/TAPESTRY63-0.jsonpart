ear","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-e2557d5bf8b7","title":"Visigothic settlement in Aquitaine","lane":"history","start":418,"end":418,"approx":false,"note":"Kingdom initially centred on Toulouse.","creators":[],"reference":"https://en.wikipedia.org/wiki/Visigothic_Kingdom","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-217ced3b1bd2","title":"Santa Maria Maggiore","lane":"architecture","start":432,"end":440,"approx":false,"note":"Early Christian basilica rebuilt under Sixtus III; later additions are separate phases.","creators":[],"reference":"https://en.wikipedia.org/wiki/Santa_Maria_Maggiore","sourceSheets":[3634],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=68c7cbc6af0ca97fd5be5b4e.webp","credit":"NikonZ7II","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Basilica_di_Santa_Maria_Maggiore_-_Roma.jpg"},"threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-96c8c50dc709","title":"Traditional start of Anglo-Saxon migration","lane":"history","start":449,"end":449,"approx":true,"note":"Migration was a long process; 449 is a traditional date.","creators":[],"reference":"https://en.wikipedia.org/wiki/Anglo-Saxon_settlement_of_Britain","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","dateQualifier":"Traditional","threads67":["britain"],"setting67":"Historical setting"},{"id":"t63-cf54d34b8f1b","title":"Anthemius of Tralles","lane":"people","start":474,"end":534,"approx":true,"note":"Mathematician and architect; dates approximate.","creators":[],"reference":"https://en.wikipedia.org/wiki/Anthemius_of_Tralles","sourceSheets":[3634],"sourceMapping":"period context","dateType":"lifespan","threads67":["eastmed"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-e6d285ed9cd9","title":"Deposition of Romulus Augustulus","lane":"history","start":476,"end":476,"approx":false,"note":"Conventional end of the Western Roman Empire.","creators":[],"reference":"https://en.wikipedia.org/wiki/Romulus_Augustulus","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-29a1ac37754c","title":"Justinian I","lane":"people","start":483,"end":565,"approx":false,"note":"Byzantine emperor.","creators":[],"reference":"https://en.wikipedia.org/wiki/Justinian_I","sourceSheets":[3634],"sourceMapping":"period context","dateType":"lifespan","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-96ac7852e03b","title":"Ostrogothic rule in Italy begins","lane":"history","start":493,"end":493,"approx":false,"note":"Theoderic defeats Odoacer.","creators":[],"reference":"https://en.wikipedia.org/wiki/Ostrogothic_Kingdom","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t69-7eb96ec33ff7","title":"Pendentives and a dome over a square","lane":"architecture","start":500,"end":900,"approx":true,"note":"Curved triangular pendentives mediate between a square bay and a circular dome base. Distinguish them from squinches, which bridge the corners differently.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Pendentives%20and%20a%20dome%20over%20a%20square","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["eastmed"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-623c33a8c37d","title":"Byzantine mosaics and gold grounds","lane":"art","start":500,"end":1400,"approx":true,"note":"Gold tesserae interact with light and can reduce the sense of ordinary space. Frontal, hierarchical images communicate religious authority; technique and function matter.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Byzantine%20mosaics%20and%20gold%20grounds","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["eastmed"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t63-0bb694b5559c","title":"San Vitale, Ravenna","lane":"architecture","start":526,"end":547,"approx":false,"note":"Consecrated in 547; Byzantine mosaics include Justinian and Theodora.","creators":[],"reference":"https://en.wikipedia.org/wiki/Basilica_of_San_Vitale","sourceSheets":[3634],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=2209b01db52ad41726ad4cb6.webp","credit":"Commonists","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Basilica_of_San_Vitale.jpg","scope":"Building as photographed; not a reconstruction of this historical phase."},"threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-8cfe961532fb","title":"Justinian's legal compilation","lane":"history","start":529,"end":534,"approx":false,"note":"First Code 529; revised Code 534; Digest and Institutes 533.","creators":[],"reference":"https://en.wikipedia.org/wiki/Corpus_Juris_Civilis","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-59689100729b","title":"Isidore of Miletus","lane":"people","start":530,"end":550,"approx":true,"note":"Architect; approximate activity period, not established lifespan.","creators":[],"reference":"https://en.wikipedia.org/wiki/Isidore_of_Miletus","sourceSheets":[3634],"sourceMapping":"period context","dateType":"activity","threads67":["eastmed"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-d1e6362a5e10","title":"Hagia Sophia","lane":"architecture","start":532,"end":537,"approx":false,"note":"Justinian's church in Constantinople; original dome rebuilt after its collapse in 558.","creators":["Anthemius of Tralles","Isidore of Miletus"],"reference":"https://en.wikipedia.org/wiki/Hagia_Sophia","sourceSheets":[3634],"sourceMapping":"item","dateType":"period","threads67":["eastmed"],"setting67":"Cultural association · not necessarily the place of creation","image":{"src":"/.netlify/functions/access?action=media&name=38777006d7f33b8918a0ee60.webp","credit":"Adli Wahid","license":"CC BY-SA 3.0","url":"https://commons.wikimedia.org/wiki/File:Hagia_Sophia_(228968325).jpeg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t63-cce3db2e4679","title":"Sant'Apollinare in Classe","lane":"architecture","start":533,"end":549,"approx":true,"note":"Ravenna; consecrated in 549.","creators":[],"reference":"https://en.wikipedia.org/wiki/Basilica_of_Sant'Apollinare_in_Classe","sourceSheets":[3634],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=42dd6b055c9302fe41bb8d32.webp","credit":"Berthold Werner","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Ravenna_BW_1.JPG"},"threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-7bbfbea848de","title":"Lombards enter Italy","lane":"history","start":568,"end":568,"approx":false,"note":"Alboin's invasion.","creators":[],"reference":"https://en.wikipedia.org/wiki/Lombard_Kingdom","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-1d6e1db568af","title":"Muhammad","lane":"people","start":570,"end":632,"approx":true,"note":"Founder of Islam; traditional birth date.","creators":[],"reference":"https://en.wikipedia.org/wiki/Muhammad","sourceSheets":[3634],"sourceMapping":"period context","dateType":"lifespan","dateQualifier":"Traditional","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-639002e27ecc","title":"Reign of Heraclius","lane":"history","start":610,"end":641,"approx":false,"note":"Byzantine emperor.","creators":[],"reference":"https://en.wikipedia.org/wiki/Heraclius","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-b68311675474","title":"Hijra","lane":"history","start":622,"end":622,"approx":false,"note":"Muhammad's migration to Medina; Islamic calendar epoch.","creators":[],"reference":"https://en.wikipedia.org/wiki/Hijrah","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-ef15c210fa30","title":"Death of Muhammad","lane":"history","start":632,"end":632,"approx":false,"note":"Beginning of the caliphal succession.","creators":[],"reference":"https://en.wikipedia.org/wiki/Muhammad","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-29a42d5a6dc9","title":"Lateran Council of 649","lane":"history","start":649,"end":649,"approx":false,"note":"Council under Pope Martin I concerning monothelitism.","creators":[],"reference":"https://en.wikipedia.org/wiki/Lateran_Council_of_649","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-01eb91d3808f","title":"End of the Sasanian Empire","lane":"history","start":651,"end":651,"approx":false,"note":"Death of the last Sasanian ruler.","creators":[],"reference":"https://en.wikipedia.org/wiki/Yazdegerd_III","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-4b819424df70","title":"Umayyad Caliphate","lane":"history","start":661,"end":750,"approx":false,"note":"Damascus-based caliphate.","creators":[],"reference":"https://en.wikipedia.org/wiki/Umayyad_Caliphate","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-170dcdde03a3","title":"Third Council of Constantinople","lane":"history","start":680,"end":681,"approx":false,"note":"Condemns monothelitism.","creators":[],"reference":"https://en.wikipedia.org/wiki/Third_Council_of_Constantinople","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-62a4e2a21842","title":"Battle of Tertry","lane":"history","start":687,"end":687,"approx":false,"note":"Pepin of Herstal consolidates power.","creators":[],"reference":"https://en.wikipedia.org/wiki/Battle_of_Tertry","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t69-5300efa81a53","title":"Iconoclasm and the religious image","lane":"history","start":700,"end":850,"approx":true,"note":"Byzantine disputes concerned the legitimacy of sacred images, not opposition to every form of art. The restoration of icons in 843 is a key marker.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Iconoclasm%20and%20the%20religious%20image","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["eastmed"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-9ebdc4de2500","title":"End of the siege of Constantinople","lane":"history","start":718,"end":718,"approx":false,"note":"Byzantine defence against the Umayyads.","creators":[],"reference":"https://en.wikipedia.org/wiki/Siege_of_Constantinople_(717%E2%80%93718)","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-12ec4137ef61","title":"Battle of Tours / Poitiers","lane":"history","start":732,"end":732,"approx":false,"note":"Charles Martel defeats an Umayyad force.","creators":[],"reference":"https://en.wikipedia.org/wiki/Battle_of_Tours","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-36bac29db89b","title":"Charlemagne","lane":"people","start":742,"end":814,"approx":true,"note":"Birth year disputed: 742, 747 or 748.","creators":[],"reference":"https://en.wikipedia.org/wiki/Charlemagne","sourceSheets":[3634],"sourceMapping":"period context","dateType":"lifespan","dateQualifier":"Uncertain","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-12a7f5c81d07","title":"Abbasid Caliphate: early and Baghdad periods","lane":"history","start":750,"end":1258,"approx":false,"note":"Baghdad founded in 762; Mongol sack in 1258.","creators":[],"reference":"https://en.wikipedia.org/wiki/Abbasid_Caliphate","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-84be9d018aec","title":"Pepin the Short becomes king","lane":"history","start":751,"end":751,"approx":false,"note":"Beginning of Carolingian royal rule.","creators":[],"reference":"https://en.wikipedia.org/wiki/Pepin_the_Short","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-1d81b32e454c","title":"Donation of Pepin","lane":"history","start":754,"end":756,"approx":false,"note":"Papal territorial claims in Italy.","creators":[],"reference":"https://en.wikipedia.org/wiki/Donation_of_Pepin","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-1eee2d95cfd1","title":"Charlemagne conquers the Lombard kingdom","lane":"history","start":774,"end":774,"approx":false,"note":"Pavia falls to the Franks.","creators":[],"reference":"https://en.wikipedia.org/wiki/Siege_of_Pavia_(773%E2%80%93774)","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["italy","france"],"setting67":"Historical setting"},{"id":"t63-fe5d3d5590a8","title":"Palatine Chapel, Aachen","lane":"architecture","start":792,"end":805,"approx":true,"note":"Carolingian octagonal chapel; attributed to Odo of Metz.","creators":[],"reference":"https://en.wikipedia.org/wiki/Palatine_Chapel,_Aachen","sourceSheets":[3635],"sourceMapping":"item","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-33f4dcb13d40","title":"Viking Age","lane":"history","start":793,"end":1066,"approx":true,"note":"Conventional European range; expansion and settlement varied by region.","creators":[],"reference":"https://en.wikipedia.org/wiki/Viking_Age","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-efab7f2bae61","title":"Imperial coronation of Charlemagne","lane":"history","start":800,"end":800,"approx":false,"note":"25 December; Pope Leo III.","creators":[],"reference":"https://en.wikipedia.org/wiki/Charlemagne","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t69-63ff2ceb0094","title":"Carolingian renewal and classical revival","lane":"art","start":800,"end":900,"approx":true,"note":"Court patronage promoted learning, manuscripts and selected ancient models. Revival is a reinterpretation, not an unchanged survival of Roman culture.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Carolingian%20renewal%20and%20classical%20revival","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","central"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t63-c21c760a6cef","title":"Classic Maya collapse","lane":"history","start":800,"end":1000,"approx":true,"note":"Regional process, not one event in 900.","creators":[],"reference":"https://en.wikipedia.org/wiki/Classic_Maya_collapse","sourceSheets":[3635],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-096b47ccfb49","title":"Egbert's overlordship","lane":"history","start":829,"end":829,"approx":false,"note":"Not the definitive unification of England; distinguish 927.","creators":[],"reference":"https://en.wikipedia.org/wiki/Ecgberht,_King_of_Wessex","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["britain"],"setting67":"Historical setting"},{"id":"t63-acdb56bff005","title":"Treaty of Verdun","lane":"history","start":843,"end":843,"approx":false,"note":"Carolingian empire partitioned into three kingdoms.","creators":[],"reference":"https://en.wikipedia.org/wiki/Treaty_of_Verdun","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-7897c01c47e7","title":"Traditional beginning of Rurik's rule","lane":"history","start":862,"end":862,"approx":false,"note":"Traditional chronology of the Rus'.","creators":[],"reference":"https://en.wikipedia.org/wiki/Rurik","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","dateQualifier":"Traditional","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-7470938521f2","title":"Treaty of Meerssen","lane":"history","start":870,"end":870,"approx":false,"note":"Division of Lothair II's kingdom between East and West Francia.","creators":[],"reference":"https://en.wikipedia.org/wiki/Treaty_of_Meerssen","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-0f5c2f1cb48e","title":"Traditional capture of Kyiv by Oleg","lane":"history","start":882,"end":882,"approx":false,"note":"Conventional beginning of Kyiv-centred rule.","creators":[],"reference":"https://en.wikipedia.org/wiki/Oleg_of_Novgorod","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","dateQualifier":"Traditional","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-2ab5eb7ec7b8","title":"Duchy of Normandy established","lane":"history","start":911,"end":911,"approx":false,"note":"Settlement associated with Rollo.","creators":[],"reference":"https://en.wikipedia.org/wiki/Treaty_of_Saint-Clair-sur-Epte","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-7bf2caf46165","title":"Æthelstan unites England","lane":"history","start":927,"end":927,"approx":false,"note":"Often regarded as the first king of all England.","creators":[],"reference":"https://en.wikipedia.org/wiki/%C3%86thelstan","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["britain"],"setting67":"Historical setting"},{"id":"t63-d0e5f09a2805","title":"Battle of Lechfeld","lane":"history","start":955,"end":955,"approx":false,"note":"Otto I defeats the Magyars.","creators":[],"reference":"https://en.wikipedia.org/wiki/Battle_of_Lechfeld","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["central"],"setting67":"Historical setting"},{"id":"t63-0592d323cde1","title":"Imperial coronation of Otto I","lane":"history","start":962,"end":962,"approx":false,"note":"Conventional foundation date of the Holy Roman Empire.","creators":[],"reference":"https://en.wikipedia.org/wiki/Otto_I,_Holy_Roman_Emperor","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["central"],"setting67":"Historical setting"},{"id":"t63-d91f0cc6d289","title":"Hugh Capet becomes king","lane":"history","start":987,"end":987,"approx":false,"note":"Beginning of the Capetian dynasty.","creators":[],"reference":"https://en.wikipedia.org/wiki/Hugh_Capet","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-876b991b23e6","title":"Christianisation of Kievan Rus'","lane":"history","start":988,"end":988,"approx":false,"note":"Traditionally associated with Vladimir I's baptism.","creators":[],"reference":"https://en.wikipedia.org/wiki/Christianization_of_Kievan_Rus'","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","dateQualifier":"Traditional","threads67":["other"],"setting67":"Historical setting"},{"id":"t69-7af46abf2921","title":"Pilgrimage churches and circulation","lane":"architecture","start":1000,"end":1200,"approx":true,"note":"Ambulatories and radiating chapels can accommodate movement around sacred relics while worship continues. Connect spatial planning with liturgical function.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Pilgrimage%20churches%20and%20circulation","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","iberia"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-99dce91286ca","title":"Romanesque: broad European period","lane":"art","start":1000,"end":1200,"approx":true,"note":"Approximate stylistic period; regional boundaries differ and overlap Gothic developments.","creators":[],"reference":"https://en.wikipedia.org/wiki/Romanesque_art","sourceSheets":[3635],"sourceMapping":"item","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","mediaType78":"context"},{"id":"t69-bbcc08d8d5d4","title":"Romanesque: mass, bays and round arches","lane":"architecture","start":1000,"end":1200,"approx":true,"note":"Thick masonry, round arches and strongly articulated bays are common identifiers. Vaulting systems and regional traditions vary; a single round arch is not conclusive.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Romanesque","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","italy","central"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-830e1b05b8cf","title":"William the Conqueror","lane":"people","start":1028,"end":1087,"approx":true,"note":"Approximate birth year.","creators":[],"reference":"https://en.wikipedia.org/wiki/William_the_Conqueror","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-ed8ab5e3be85","title":"Henry IV","lane":"people","start":1050,"end":1106,"approx":false,"note":"Emperor associated with Canossa.","creators":[],"reference":"https://en.wikipedia.org/wiki/Henry_IV,_Holy_Roman_Emperor","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-a08f5b38e809","title":"East–West Schism","lane":"history","start":1054,"end":1054,"approx":false,"note":"Conventional date in a longer estrangement.","creators":[],"reference":"https://en.wikipedia.org/wiki/East%E2%80%93West_Schism","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-e091a055fafd","title":"Pisa Cathedral","lane":"architecture","start":1063,"end":1118,"approx":false,"note":"Romanesque cathedral; begun 1063, consecrated 1118, later enlarged.","creators":[],"reference":"https://en.wikipedia.org/wiki/Pisa_Cathedral","sourceSheets":[3635],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=d5e603dc15ee8bacd3a39199.webp","credit":"Luca Aless","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Pisa_-_Cattedrale_da_Battistero_02.jpg"},"threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-aca148b80ce0","title":"Battle of Hastings and Norman conquest","lane":"history","start":1066,"end":1066,"approx":false,"note":"William defeats Harold II.","creators":[],"reference":"https://en.wikipedia.org/wiki/Battle_of_Hastings","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["britain"],"setting67":"Historical setting"},{"id":"t63-e2125978cf2c","title":"Investiture Controversy","lane":"history","start":1075,"end":1122,"approx":false,"note":"Papal and imperial authority over appointments.","creators":[],"reference":"https://en.wikipedia.org/wiki/Investiture_Controversy","sourceSheets":[3635],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-ee4e7612155e","title":"Walk to Canossa","lane":"history","start":1077,"end":1077,"approx":false,"note":"Henry IV seeks absolution from Gregory VII.","creators":[],"reference":"https://en.wikipedia.org/wiki/Road_to_Canossa","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-5abe97fc5338","title":"Traditional foundation of Bologna University","lane":"history","start":1088,"end":1088,"approx":false,"note":"Conventional institutional foundation date.","creators":[],"reference":"https://en.wikipedia.org/wiki/University_of_Bologna","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","dateQualifier":"Traditional","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-0184ac2bf704","title":"Council of Clermont","lane":"history","start":1095,"end":1095,"approx":false,"note":"Urban II calls for the First Crusade.","creators":[],"reference":"https://en.wikipedia.org/wiki/Council_of_Clermont","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["france"],"setting67":"Historical setting"},{"id":"t63-9f0886fa460a","title":"First Crusade","lane":"history","start":1096,"end":1099,"approx":false,"note":"Jerusalem captured in 1099.","creators":[],"reference":"https://en.wikipedia.org/wiki/First_Crusade","sourceSheets":[3635],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t69-8fccc06b3005","title":"Cathedral, abbey and parish church","lane":"architecture","start":1100,"end":1600,"approx":true,"note":"A cathedral contains a bishop's cathedra; an abbey belongs to a monastic institution; a parish church serves a local community. Size and architectural style do not determine these categories.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Cathedral%2C%20abbey%20and%20parish%20church","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-0ccea97f7174","title":"Frederick Barbarossa","lane":"people","start":1122,"end":1190,"approx":false,"note":"Hohenstaufen emperor.","creators":[],"reference":"https://en.wikipedia.org/wiki/Frederick_Barbarossa","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-0bebbf554f03","title":"Kingdom of Sicily established","lane":"history","start":1130,"end":1130,"approx":false,"note":"Roger II crowned king.","creators":[],"reference":"https://en.wikipedia.org/wiki/Kingdom_of_Sicily","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-7e85b8e8e1e9","title":"Saladin","lane":"people","start":1137,"end":1193,"approx":true,"note":"Birth also given as 1138.","creators":[],"reference":"https://en.wikipedia.org/wiki/Saladin","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t69-10f25f5e896c","title":"Flying buttress and lateral thrust","lane":"architecture","start":1140,"end":1500,"approx":true,"note":"A flying buttress transfers outward thrust across an aisle to an external support. Distinguish the visible arch from the whole buttressing system.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Flying%20buttress%20and%20lateral%20thrust","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-4cf4d37f2996","title":"Gothic: broad European period","lane":"art","start":1140,"end":1500,"approx":true,"note":"A regional stylistic framework, not a precise beginning or ending everywhere.","creators":[],"reference":"https://en.wikipedia.org/wiki/Gothic_art","sourceSheets":[3636],"sourceMapping":"item","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","mediaType78":"context"},{"id":"t69-a6a931d36dfe","title":"Gothic: pointed arch, rib vault and buttress","lane":"architecture","start":1140,"end":1500,"approx":true,"note":"The coordinated structural system channels loads and allows taller interiors and larger windows. Gothic is not defined solely by a pointed arch.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Gothic","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","britain"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-1569c413b62c","title":"Second Crusade","lane":"history","start":1147,"end":1149,"approx":false,"note":"Campaign following the fall of Edessa.","creators":[],"reference":"https://en.wikipedia.org/wiki/Second_Crusade","sourceSheets":[3635],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t69-c0fc3eb496b3","title":"Rose windows, stained glass and cathedral imagery","lane":"art","start":1150,"end":1500,"approx":true,"note":"Coloured glass structures light and conveys religious narratives. Tracery subdivides an opening; it is not the coloured glass itself.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Rose%20windows%2C%20stained%20glass%20and%20cathedral%20imagery","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t63-30c85381e00a","title":"Richard I","lane":"people","start":1157,"end":1199,"approx":false,"note":"King of England; Third Crusade.","creators":[],"reference":"https://en.wikipedia.org/wiki/Richard_I_of_England","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-1dc80a5b7ae8","title":"Notre-Dame de Paris: medieval construction","lane":"architecture","start":1163,"end":1345,"approx":false,"note":"Conventional main construction span; later restorations are separate records.","creators":[],"reference":"https://en.wikipedia.org/wiki/Notre-Dame_de_Paris","sourceSheets":[3636],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=c9b5d3387eedbc3246b0c413.webp","credit":"Ali Sabbagh","license":"CC0","url":"https://commons.wikimedia.org/wiki/File:Notre-Dame_de_Paris,_4_October_2017.jpg","scope":"Building as photographed; not a reconstruction of this historical phase."},"threads67":["france"],"setting67":"Historical setting"},{"id":"t63-063842c4b5d8","title":"John of England","lane":"people","start":1166,"end":1216,"approx":false,"note":"King associated with Magna Carta.","creators":[],"reference":"https://en.wikipedia.org/wiki/John,_King_of_England","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["britain"],"setting67":"Historical setting"},{"id":"t63-05ff2cff61bf","title":"Saladin becomes vizier in Egypt","lane":"history","start":1169,"end":1169,"approx":false,"note":"Ayyubid rule begins in 1171.","creators":[],"reference":"https://en.wikipedia.org/wiki/Saladin","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-39a53b62a58d","title":"Ayyubid dynasty in Egypt","lane":"history","start":1171,"end":1171,"approx":false,"note":"Saladin ends Fatimid rule.","creators":[],"reference":"https://en.wikipedia.org/wiki/Ayyubid_dynasty","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-a0722de5103c","title":"Monreale Cathedral","lane":"architecture","start":1172,"end":1189,"approx":true,"note":"Norman Sicily; Latin-plan church with extensive Byzantine mosaics.","creators":[],"reference":"https://en.wikipedia.org/wiki/Monreale_Cathedral","sourceSheets":[3635],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=85ac256da054ec7ce4f7d735.webp","credit":"Holger Uwe Schmitt","license":"CC BY-SA 4.0","ur