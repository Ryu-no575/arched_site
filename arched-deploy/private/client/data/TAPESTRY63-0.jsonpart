","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","image":{"src":"/.netlify/functions/access?action=media&name=76b2b5795997cfb5a03af84e.webp","credit":"Rabax63","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Ara_Pacis_(SW).jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t63-3e061b75dfbc","title":"Birth of Jesus: estimated range","lane":"history","start":-6,"end":-4,"approx":true,"note":"No year zero; historical estimates differ.","creators":[],"reference":"https://en.wikipedia.org/wiki/Chronology_of_Jesus","sourceSheets":[3633],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-8f69101f0c55","title":"Augustus of Prima Porta","lane":"art","start":1,"end":50,"approx":true,"note":"Surviving marble statue, probably early first century CE; armour refers to earlier diplomatic events.","creators":[],"reference":"https://en.wikipedia.org/wiki/Augustus_of_Prima_Porta","sourceSheets":[3633],"sourceMapping":"item","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=994ab65c27d1e0b9843e670b.webp","credit":"Till Niermann","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Statue-Augustus.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t63-0f9648943c34","title":"Crucifixion of Jesus: proposed dates","lane":"history","start":30,"end":33,"approx":true,"note":"Common proposed years are 30 and 33 CE.","creators":[],"reference":"https://en.wikipedia.org/wiki/Crucifixion_of_Jesus","sourceSheets":[3633,3634],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regi