se,"note":"Polish insurrection against Russian rule.","creators":[],"reference":"https://en.wikipedia.org/wiki/November_Uprising","sourceSheets":[3642],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-fbc4f1c796fa","title":"Walhalla","lane":"architecture","start":1830,"end":1842,"approx":false,"note":"Neoclassical memorial near Regensburg.","creators":["Leo von Klenze"],"reference":"https://en.wikipedia.org/wiki/Walhalla_(memorial)","sourceSheets":[3642],"sourceMapping":"item","dateType":"period","threads67":["central"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t69-b79dd6f1b353","title":"Realism and social subject matter","lane":"art","start":1830,"end":1900,"approx":true,"note":"Ordinary labour and contemporary life can be represented on scales once reserved for elevated subjects. Realism is not identical to photographic accuracy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Realism%20and%20social%20subject%20matter","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-0ca5c7c9849e","title":"Camille Pissarro","lane":"people","start":1830,"end":1903,"approx":false,"note":"Impressionist painter with a period of Neo-Impressionist experimentation.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Camille%20Pissarro","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-226c2c4d475d","title":"Faraday demonstrates electromagnetic induction","lane":"history","start":1831,"end":1831,"approx":false,"note":"Induction underlies electrical generators; distinguish it from the later commercial spread of electric lighting.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Faraday%20demonstrates%20electromagnetic%20induction","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t63-079df48c7778","title":"Young Italy founded","lane":"history","start":1831,"end":1831,"approx":false,"note":"Giuseppe Mazzini's movement.","creators":[],"reference":"https://en.wikipedia.org/wiki/Young_Italy","sourceSheets":[3642,3643],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t68-1cce1b1f9bbc","title":"Édouard Manet","lane":"people","start":1832,"end":1883,"approx":false,"note":"Painter who challenged Salon conventions; associated with but not an exhibitor in the independent Impressionist exhibitions.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=%C3%89douard%20Manet","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-fe6b99c5714e","title":"The Houses of Parliament on Fire","lane":"art","start":1834,"end":1834,"approx":true,"note":"Turner depicted the Westminster fire in multiple works; a specific canvas is not identified by the photo label.","creators":["J. M. W. Turner"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Houses%20of%20Parliament%20on%20Fire","sourceSheets":[3643],"sourceMapping":"contextual identification","dateType":"year","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","dateQualifier":"Source title / version unresolved","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=43f75fa7018560e9ded4c003.webp","credit":"J. M. W. Turner","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Joseph_Mallord_William_Turner%2C_English_-_The_Burning_of_the_Houses_of_Lords_and_Commons%2C_October_16%2C_1834_-_Google_Art_Project.jpg","scope":"Representative work from the series/cycle; the timeline range covers the series, not only this image."},"imageChecked78":"2026-10-05"},{"id":"t68-624ee3c74071","title":"Edgar Degas","lane":"people","start":1834,"end":1917,"approx":false,"note":"Painter, draughtsman and sculptor; composition and movement are central to his work.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Edgar%20Degas","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-0bebdb9741a7","title":"Oliver Twist","lane":"people","start":1837,"end":1839,"approx":true,"note":"Published serially; social criticism of poverty and institutions in industrial Britain.","creators":["Charles Dickens"],"reference":"https://en.wikipedia.org/w/index.php?search=Oliver%20Twist","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-308a79db917a","title":"Reign of Queen Victoria","lane":"history","start":1837,"end":1901,"approx":false,"note":"A period of industrial expansion and empire, not a single artistic style.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Reign%20of%20Queen%20Victoria","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t63-7225f3d2327d","title":"First Dresden Court Theatre","lane":"architecture","start":1838,"end":1841,"approx":false,"note":"Original theatre; destroyed in 1869, later rebuilt to a different design.","creators":["Gottfried Semper"],"reference":"https://en.wikipedia.org/wiki/Semperoper","sourceSheets":[3642],"sourceMapping":"item","dateType":"period","threads67":["central"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t68-e44b884610cb","title":"The Charterhouse of Parma","lane":"people","start":1839,"end":1839,"approx":false,"note":"A French novel set largely in Italy; cultural origin and fictional setting are distinct.","creators":["Stendhal"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Charterhouse%20of%20Parma","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france","italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t63-05102ed6d4bc","title":"The Fighting Temeraire","lane":"art","start":1839,"end":1839,"approx":false,"note":"Exhibited in 1839; depicts the warship's final tow in 1838.","creators":["J. M. W. Turner"],"reference":"https://www.nationalgallery.org.uk/paintings/joseph-mallord-william-turner-the-fighting-temeraire","sourceSheets":[3642],"sourceMapping":"item","dateType":"year","image":{"src":"/.netlify/functions/access?action=media&name=15697e08247fffd7afbccdb6.webp","credit":"J. M. W. Turner · Wikimedia Commons","license":"Public domain (Commons record)","url":"https://commons.wikimedia.org/wiki/File:Turner%2C_J._M._W._-_The_Fighting_T%C3%A9m%C3%A9raire_tugged_to_her_last_Berth_to_be_broken.jpg"},"referenceChecked":"2026-10-05","threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t68-51aacb7e60ef","title":"First Opium War","lane":"history","start":1839,"end":1842,"approx":false,"note":"Britain fought Qing China; the Treaty of Nanjing opened treaty ports and ceded Hong Kong.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20Opium%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-96250dbf2a6d","title":"Photography and changing visual culture","lane":"art","start":1839,"end":1900,"approx":true,"note":"Photographic processes changed portraiture, documentation and artistic composition. Photography did not simply replace painting or make all painted observation unnecessary.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Photography%20and%20changing%20visual%20culture","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","britain"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-72d80d0dcc74","title":"Paul Cézanne","lane":"people","start":1839,"end":1906,"approx":false,"note":"Post-Impressionist painter whose constructed forms influenced Cubism.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paul%20C%C3%A9zanne","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t63-303a62399152","title":"The Slave Ship","lane":"art","start":1840,"end":1840,"approx":false,"note":"Abolitionist subject connected with the Zong massacre; not a literal eyewitness record.","creators":["J. M. W. Turner"],"reference":"https://en.wikipedia.org/wiki/The_Slave_Ship","sourceSheets":[3642],"sourceMapping":"item","dateType":"year","image":{"src":"/.netlify/functions/access?action=media&name=95db5554b1478a49c4f9c216.webp","credit":"J. M. W. Turner · Wikimedia Commons","license":"Public domain (Commons record)","url":"https://commons.wikimedia.org/wiki/File:Slave-ship.jpg"},"threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t68-5e5dbc0b3a78","title":"Palace of Westminster rebuilding","lane":"architecture","start":1840,"end":1860,"approx":true,"note":"Gothic Revival design after the 1834 fire; principal rebuilding extended across decades.","creators":["Charles Barry","Augustus Welby Pugin"],"reference":"https://en.wikipedia.org/w/index.php?search=Palace%20of%20Westminster%20rebuilding","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t63-303327f5afb5","title":"Realism","lane":"art","start":1840,"end":1880,"approx":true,"note":"Approximate nineteenth-century movement; distinguish from the general descriptive term realistic.","creators":[],"reference":"https://en.wikipedia.org/wiki/Realism_(arts)","sourceSheets":[3642,3643],"sourceMapping":"item","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","mediaType78":"context"},{"id":"t68-5bfce3745491","title":"Auguste Rodin","lane":"people","start":1840,"end":1917,"approx":false,"note":"French sculptor; modelling, fragment and expressive gesture challenged academic conventions.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Auguste%20Rodin","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-4b24efb58e06","title":"Claude Monet","lane":"people","start":1840,"end":1926,"approx":false,"note":"Impressionist painter known for changing light and serial treatment of subjects.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Claude%20Monet","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-3ba8c9fdd7c6","title":"Pierre-Auguste Renoir","lane":"people","start":1841,"end":1919,"approx":false,"note":"Impressionist painter whose later figure painting developed in different directions.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Pierre-Auguste%20Renoir","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-9387271f2bcc","title":"Morse demonstrates Washington–Baltimore telegraph","lane":"history","start":1844,"end":1844,"approx":false,"note":"A public demonstration helped establish long-distance electrical communication; not the first experiment with telegraphy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Morse%20demonstrates%20Washington%E2%80%93Baltimore%20telegraph","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t63-af6984aaa731","title":"Rain, Steam and Speed","lane":"art","start":1844,"end":1844,"approx":false,"note":"Railway modernity and atmospheric landscape.","creators":["J. M. W. Turner"],"reference":"https://en.wikipedia.org/wiki/Rain,_Steam_and_Speed_%E2%80%93_The_Great_Western_Railway","sourceSheets":[3642],"sourceMapping":"item","dateType":"year","image":{"src":"/.netlify/functions/access?action=media&name=218477c39a362f8d816a11c6.webp","credit":"Image reference from Wikipedia","license":"Wikipedia non-free reference · reuse not cleared","url":"https://en.wikipedia.org/wiki/File:J._M._W._Turner_-_Rain%2C_Steam_and_Speed_%E2%80%93_The_Great_Western_Railway.jpg","scope":"work"},"threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t63-8e92c3af3c4e","title":"Notre-Dame de Paris: restoration","lane":"architecture","start":1844,"end":1864,"approx":false,"note":"With Jean-Baptiste Lassus until 1857; distinguish restoration from medieval construction.","creators":["Eugène Viollet-le-Duc"],"reference":"https://en.wikipedia.org/wiki/Notre-Dame_de_Paris","sourceSheets":[3642],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=c9b5d3387eedbc3246b0c413.webp","credit":"Ali Sabbagh","license":"CC0","url":"https://commons.wikimedia.org/wiki/File:Notre-Dame_de_Paris,_4_October_2017.jpg","scope":"Building as photographed; not a reconstruction of this historical phase."},"threads67":["france"],"setting67":"Historical setting"},{"id":"t68-586a4792c19f","title":"Friedrich Nietzsche","lane":"people","start":1844,"end":1900,"approx":false,"note":"German philosopher; later political appropriations must be distinguished from his texts.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Friedrich%20Nietzsche","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-bdd478b8fca1","title":"Mexican–American War","lane":"history","start":1846,"end":1848,"approx":false,"note":"US territorial expansion followed the war and the Treaty of Guadalupe Hidalgo.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Mexican%E2%80%93American%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-a54ea99e75b6","title":"Wuthering Heights","lane":"people","start":1847,"end":1847,"approx":false,"note":"A novel exploring destructive passion, social position and inheritance.","creators":["Emily Brontë"],"reference":"https://en.wikipedia.org/w/index.php?search=Wuthering%20Heights","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-2844b1a52d39","title":"February Revolution and French Second Republic","lane":"history","start":1848,"end":1848,"approx":false,"note":"Louis-Philippe fell; the Second Republic preceded Louis-Napoleon's rise to imperial rule.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=February%20Revolution%20and%20French%20Second%20Republic","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-bf48438bbad2","title":"The Communist Manifesto published","lane":"history","start":1848,"end":1848,"approx":false,"note":"Marx and Engels analysed class conflict and capitalism; publication coincided with, but did not cause all, the revolutions.","creators":[],"reference":"https://en.wikipedia.org/wiki/The_Communist_Manifesto","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-9db8a57bd5f4","title":"First Italian War of Independence","lane":"history","start":1848,"end":1849,"approx":false,"note":"Piedmont-Sardinia fought Austria; defeat did not end the unification movement.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20Italian%20War%20of%20Independence","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["italy","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-20dbc44edf8c","title":"Revolutions of 1848 in Europe","lane":"history","start":1848,"end":1849,"approx":false,"note":"Liberal, national and social demands produced different revolutions; avoid treating them as one uniform movement.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Revolutions%20of%201848%20in%20Europe","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["france","central","italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-cfc066343c12","title":"Paul Gauguin","lane":"people","start":1848,"end":1903,"approx":false,"note":"French painter; Polynesian work must be read within colonial contexts.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paul%20Gauguin","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france","other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-73afc7dbf440","title":"Roman Republic of 1849","lane":"history","start":1849,"end":1849,"approx":false,"note":"A short-lived republic ended after French intervention restored papal authority.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Roman%20Republic%20of%201849","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["italy","france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t63-2b9951e3b430","title":"The Stone Breakers","lane":"art","start":1849,"end":1849,"approx":false,"note":"Realist labour scene; original painting destroyed in 1945.","creators":["Gustave Courbet"],"reference":"https://en.wikipedia.org/wiki/The_Stone_Breakers","sourceSheets":[3642,3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=1dc4b51c938c448bbb864b8f.webp","credit":"Gustave Courbet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Gustave_Courbet_-_The_Stonebreakers_-_WGA05457.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t63-7bbc5107f9a7","title":"A Burial at Ornans","lane":"art","start":1849,"end":1850,"approx":false,"note":"Provincial funeral rendered at the scale of history painting.","creators":["Gustave Courbet"],"reference":"https://en.wikipedia.org/wiki/A_Burial_At_Ornans","sourceSheets":[3642,3643],"sourceMapping":"item","dateType":"period","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=e9ab2fb7f06ea54c8617b188.webp","credit":"Gustave Courbet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Gustave_Courbet_-_A_Burial_at_Ornans_-_Google_Art_Project_2.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t63-396cdcdee032","title":"The Sower","lane":"art","start":1850,"end":1850,"approx":false,"note":"Boston painting as a reference example; later variants and prints also exist.","creators":["Jean-François Millet"],"reference":"https://en.wikipedia.org/wiki/The_Sower_(Millet)","sourceSheets":[3642],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=46d837aed5c27a1225e12f4c.webp","credit":"Jean-François Millet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Jean-Fran%C3%A7ois_Millet_-_The_Sower_-_Google_Art_Project.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t69-52ca5b3944f4","title":"The Salon and independent exhibitions","lane":"art","start":1850,"end":1900,"approx":true,"note":"Juries, official exhibitions, dealers and independent shows shaped careers and public reception. Rejection from the Salon and participation in Impressionist exhibitions are different histories.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Salon%20and%20independent%20exhibitions","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-0d2522cb46bf","title":"Crystal Palace","lane":"architecture","start":1851,"end":1851,"approx":false,"note":"Prefabricated iron and glass housed the Great Exhibition; the original Hyde Park structure was later relocated.","creators":["Joseph Paxton"],"reference":"https://en.wikipedia.org/w/index.php?search=Crystal%20Palace","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t63-fa4bb4bc17e1","title":"Foucault's public pendulum demonstration","lane":"history","start":1851,"end":1851,"approx":false,"note":"Paris Panthéon; a marginal annotation in IMG_3636.","creators":[],"reference":"https://en.wikipedia.org/wiki/Foucault_pendulum","sourceSheets":[3636],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t68-08e73f3779d6","title":"Great Exhibition in London","lane":"history","start":1851,"end":1851,"approx":false,"note":"Industrial production and global display were housed in Joseph Paxton's Crystal Palace.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Great%20Exhibition%20in%20London","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-27f6e62af73c","title":"Louis-Napoleon's coup d'état","lane":"history","start":1851,"end":1851,"approx":false,"note":"The coup of 2 December ended the parliamentary basis of the Second Republic.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Louis-Napoleon%27s%20coup%20d%27%C3%A9tat","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-a59364ea2a28","title":"Ophelia","lane":"art","start":1851,"end":1852,"approx":true,"note":"Pre-Raphaelite painting after Shakespeare's Hamlet, combining literary subject and detailed vegetation.","creators":["John Everett Millais"],"reference":"https://en.wikipedia.org/w/index.php?search=Ophelia","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=8e67ca2b55e97439fea57458.webp","credit":"John Everett Millais","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:John_Everett_Millais_-_Ophelia_-_Google_Art_Project.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-924e52cbdc8c","title":"French Second Empire proclaimed","lane":"history","start":1852,"end":1852,"approx":false,"note":"Louis-Napoleon became Napoleon III; distinguish him from Napoleon I.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=French%20Second%20Empire%20proclaimed","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-c0268a877fe2","title":"Crimean War","lane":"history","start":1853,"end":1856,"approx":false,"note":"Russia fought an alliance including the Ottoman Empire, Britain and France; Piedmont-Sardinia joined in 1855.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Crimean%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["eastmed","other","france","britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-1900b7e98d6f","title":"Vincent van Gogh","lane":"people","start":1853,"end":1890,"approx":false,"note":"Dutch painter whose late work developed in France.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Vincent%20van%20Gogh","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["low","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-822e8d1cfb36","title":"Treaty of Kanagawa","lane":"history","start":1854,"end":1854,"approx":false,"note":"US pressure helped open Japanese ports; distinguish this treaty from the later Meiji Restoration.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Kanagawa","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-355d62aeec43","title":"Paris Exposition Universelle","lane":"history","start":1855,"end":1855,"approx":false,"note":"Courbet organised an independent display nearby, useful context for Realism and exhibition politics.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paris%20Exposition%20Universelle","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-f6777af662a9","title":"The Painter's Studio","lane":"art","start":1855,"end":1855,"approx":false,"note":"A large allegorical self-positioning of the artist within society; displayed in his independent pavilion.","creators":["Gustave Courbet"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Painter%27s%20Studio","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=b13579d04222b90fc1d58d39.webp","credit":"Gustave Courbet","license":"Public domain","url":"https://en.wikipedia.org/wiki/The_Painter%27s_Studio","scope":"Exact title and artist matched to existing catalogue"},"mediaType78":"visual-artwork"},{"id":"t68-adf317fb83a0","title":"Treaty of Paris ends Crimean War","lane":"history","start":1856,"end":1856,"approx":false,"note":"The settlement restricted Russian naval power in the Black Sea and altered European diplomacy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Paris%20ends%20Crimean%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france","eastmed","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-66c1b6c7e033","title":"Sigmund Freud","lane":"people","start":1856,"end":1939,"approx":false,"note":"Founder of psychoanalysis; lived and worked in Vienna before exile in London.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Sigmund%20Freud","sourceSheets":[3645],"sourceMapping":"item","dateType":"lifespan","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-8f7b4dba05b5","title":"Madame Bovary","lane":"people","start":1857,"end":1857,"approx":false,"note":"Realist prose examines provincial life and desire; distinguish literary Realism from identical dates in painting.","creators":["Gustave Flaubert"],"reference":"https://en.wikipedia.org/w/index.php?search=Madame%20Bovary","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t63-a86aae5b76f8","title":"The Gleaners","lane":"art","start":1857,"end":1857,"approx":false,"note":"Rural labour and social hierarchy.","creators":["Jean-François Millet"],"reference":"https://en.wikipedia.org/wiki/The_Gleaners","sourceSheets":[3642,3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=0f6899a6a3a23bf6445a16f7.webp","credit":"Jean-François Millet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Jean-Fran%C3%A7ois_Millet_-_Gleaners_-_Google_Art_Project_2.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t63-933fdbe12884","title":"The Angelus","lane":"art","start":1857,"end":1859,"approx":false,"note":"Rural prayer scene; conventional execution range.","creators":["Jean-François Millet"],"reference":"https://en.wikipedia.org/wiki/The_Angelus_(painting)","sourceSheets":[3642,3643],"sourceMapping":"item","dateType":"period","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=61eb1bd6e286d5a1a1fa963e.webp","credit":"Jean-François Millet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:JEAN-FRAN%C3%87OIS_MILLET_-_El_%C3%81ngelus_%28Museo_de_Orsay%2C_1857-1859._%C3%93leo_sobre_lienzo%2C_55.5_x_66_cm%29.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-42e1aca25597","title":"The Bellelli Family","lane":"art","start":1858,"end":1867,"approx":true,"note":"A family portrait whose spatial arrangement conveys emotional distance; commonly dated approximately 1858–1867.","creators":["Edgar Degas"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Bellelli%20Family","sourceSheets":[3644],"sourceMapping":"item","dateType":"period","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=d9d851b0d37ec5e5cdaf3638.webp","credit":"Edgar Degas","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Edgar_Degas_-_The_Bellelli_Family_-_Google_Art_Project.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-cee7344ccaab","title":"On the Origin of Species published","lane":"history","start":1859,"end":1859,"approx":false,"note":"Darwin explained evolution by natural selection; distinguish scientific theory from later political misuse.","creators":[],"reference":"https://en.wikipedia.org/wiki/On_the_Origin_of_Species","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-e0339775f6e3","title":"Second Italian War of Independence","lane":"history","start":1859,"end":1859,"approx":false,"note":"Piedmont-Sardinia and France fought Austria; Lombardy passed towards the emerging Italian state.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Second%20Italian%20War%20of%20Independence","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["italy","france","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-70a8c9f69a10","title":"Georges Seurat","lane":"people","start":1859,"end":1891,"approx":false,"note":"Neo-Impressionist painter who investigated systematic colour juxtaposition.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Georges%20Seurat","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-02be20f6097f","title":"Expedition of the Thousand","lane":"history","start":1860,"end":1860,"approx":false,"note":"Garibaldi's volunteers conquered Sicily and southern Italy before their incorporation into the monarchy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Expedition%20of%20the%20Thousand","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-03223254c2eb","title":"Impressionist colour and visible brushwork","lane":"art","start":1860,"end":1900,"approx":true,"note":"Broken touches and attention to changing light challenge academic finish. Many paintings were reworked in studios; plein-air painting is not the sole defining feature.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Impressionist%20colour%20and%20visible%20brushwork","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-edc7be28c838","title":"Arts and Crafts: design, labour and making","lane":"architecture","start":1860,"end":1914,"approx":true,"note":"The movement connected the quality of design with conditions of production and craft. It included different responses to machinery, not one universal ban on industry.","creators":[],"reference":"https://www.vam.ac.uk/articles/arts-and-crafts-an-introduction","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["britain"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-707db078684b","title":"Kingdom of Italy proclaimed","lane":"history","start":1861,"end":1861,"approx":false,"note":"Proclaimed on 17 March under Victor Emmanuel II; Rome and Venice were not yet included.","creators":[],"reference":"https://www.quirinale.it/it/pagine/simboli-repubblica-tricolore","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-d5d81ee88fad","title":"American Civil War","lane":"history","start":1861,"end":1865,"approx":false,"note":"Union and Confederacy fought over secession and slavery; emancipation and constitutional change followed.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=American%20Civil%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-0579ccd6c1a7","title":"Les Misérables","lane":"people","start":1862,"end":1862,"approx":false,"note":"Historical novel of justice and social exclusion; the 1832 uprising depicted is not the French Revolution of 1789.","creators":["Victor Hugo"],"reference":"https://en.wikipedia.org/w/index.php?search=Les%20Mis%C3%A9rables","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t63-1e956ba9acdf","title":"The Turkish Bath","lane":"art","start":1862,"end":1862,"approx":false,"note":"Late work; imagery recalls earlier bather studies.","creators":["Jean-Auguste-Dominique Ingres"],"reference":"https://en.wikipedia.org/wiki/The_Turkish_Bath","sourceSheets":[3642],"sourceMapping":"item","dateType":"year","image":{"src":"/.netlify/functions/access?action=media&name=884df9f55a56d9d9ccffb379.webp","credit":"Jean-Auguste-Dominique Ingres","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Le_Bain_Turc,_by_Jean_Auguste_Dominique_Ingres,_from_C2RMFFXD.jpg"},"threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t63-ddb1b978068a","title":"The Third-Class Carriage","lane":"art","start":1862,"end":1864,"approx":true,"note":"Several versions exist; this is the conventional date of the Met canvas.","creators":["Honoré Daumier"],"reference":"https://www.metmuseum.org/art/collection/search/436095","sourceSheets":[3642],"sourceMapping":"item","dateType":"period","referenceChecked":"2026-10-05","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=d5445ec1523b7a5a3fd5ddd8.webp","credit":"Honoré Daumier","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Honor%C3%A9_Daumier%2C_The_Third-Class_Carriage_-_The_Metropolitan_Museum_of_Art.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-5eb6572eb873","title":"Gustav Klimt","lane":"people","start":1862,"end":1918,"approx":false,"note":"Viennese Secession painter combining figuration with decorative surfaces.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Gustav%20Klimt","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-dc8bfadbcec7","title":"Emancipation Proclamation takes effect","lane":"history","start":1863,"end":1863,"approx":false,"note":"Applied to enslaved people in areas in rebellion; nationwide abolition followed the Thirteenth Amendment in 1865.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Emancipation%20Proclamation%20takes%20effect","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-1eccc1a94639","title":"Le Déjeuner sur l'herbe","lane":"art","start":1863,"end":1863,"approx":false,"note":"Shown at the Salon des Refusés; references to earlier art coexist with deliberately contemporary figures.","creators":["Édouard Manet"],"reference":"https://en.wikipedia.org/w/index.php?search=Le%20D%C3%A9jeuner%20sur%20l%27herbe","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=e428d13fa1557a059bdb3145.webp","credit":"Édouard Manet · Wikimedia Commons","license":"Rights at source · Commons reference","url":"https://www.musee-orsay.fr/fr/oeuvres/le-dejeuner-sur-lherbe-904","scope":"Exact title and artist matched to existing catalogue"},"mediaType78":"visual-artwork"},{"id":"t68-de39727786e5","title":"London Underground opens","lane":"history","start":1863,"end":1863,"approx":false,"note":"The Metropolitan Railway opened; early services used steam locomotives.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=London%20Underground%20opens","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-44583d12618c","title":"Olympia","lane":"art","start":1863,"end":1863,"approx":false,"note":"Painted in 1863 and exhibited at the Salon in 1865; the contemporary nude challenges conventions of idealised mythological subjects.","creators":["Édouard Manet"],"reference":"https://en.wikipedia.org/w/index.php?search=Olympia","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=fcd7640b23a68346e9baa299.webp","credit":"Édouard Manet","license":"Public domain","url":"https://en.wikipedia.org/wiki/Olympia_%28Manet%29","scope":"Exact title and artist matched to existing catalogue"},"mediaType78":"visual-artwork"},{"id":"t68-973c6c0c3f01","title":"The Birth of Venus","lane":"art","start":1863,"end":1863,"approx":false,"note":"Academic mythological painting; contrast with Manet's contemporary challenges to the Salon.","creators":["Alexandre Cabanel"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Birth%20of%20Venus","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=db551131d6e73f2ef0594e9f.webp","credit":"Alexandre Cabanel","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Alexandre_Cabanel_-_The_Birth_of_Venus_-_Google_Art_Project_2.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-6ebf93470dff","title":"Paul Signac","lane":"people","start":1863,"end":1935,"approx":false,"note":"Neo-Impressionist painter and advocate of Divisionism.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paul%20Signac","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-8c52c99165a6","title":"Edvard Munch","lane":"people","start":1863,"end":1944,"approx":false,"note":"Norwegian artist; psychologically charged imagery contributed to Expressionist developments.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Edvard%20Munch","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-3c89c2a9d9e9","title":"First Geneva Convention","lane":"history","start":1864,"end":1864,"approx":false,"note":"Established protections for wounded soldiers and medical personnel; connect with the Red Cross movement.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20Geneva%20Convention","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-0314889c6375","title":"First International founded","lane":"history","start":1864,"end":1864,"approx":false,"note":"The International Workingmen's Association linked labour movements across national borders.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20International%20founded","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-26ea43effbaa","title":"Henri de Toulouse-Lautrec","lane":"people","start":1864,"end":1901,"approx":false,"note":"Painter and printmaker of Parisian entertainment culture.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Henri%20de%20Toulouse-Lautrec","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-0f8c5d3bbb48","title":"War and Peace","lane":"people","start":1865,"end":1869,"approx":true,"note":"A novel set around the Napoleonic wars; publication and depicted events have different dates.","creators":["Leo Tolstoy"],"reference":"https://en.wikipedia.org/w/index.php?search=War%20and%20Peace","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-26223a60f60e","title":"Austro-Prussian War","lane":"history","start":1866,"end":1866,"approx":false,"note":"Prussian victory changed the German balance of power; Italy gained Venetia through the related settlement.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Austro-Prussian%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central","italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-46286511936f","title":"Crime and Punishment","lane":"people","start":1866,"end":1866,"approx":false,"note":"A novel probing guilt, morality and social conditions.","creators":["Fyodor Dostoevsky"],"reference":"https://en.wikipedia.org/w/index.php?search=Crime%20and%20Punishment","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-019e887e400a","title":"The Origin of the World","lane":"art","start":1866,"end":1866,"approx":false,"note":"A frank bodily image that challenges conventions of representation and spectatorship.","creators":["Gustave Courbet"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Origin%20of%20the%20World","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=24e3426ea301228b942388aa.webp","credit":"Gustave Courbet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Origin-of-the-World.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-cfc5d639790c","title":"Wassily Kandinsky","lane":"people","start":1866,"end":1944,"approx":false,"note":"Russian-born artist active in Germany and France; connected to Der Blaue Reiter and Bauhaus.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Wassily%20Kandinsky","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["other","central","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-a80cd30eb4de","title":"Alaska Purchase","lane":"history","start":1867,"end":1867,"approx":false,"note":"The United States bought Alaska from Russia.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Alaska%20Purchase","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-b4214650024c","title":"Austro-Hungarian Compromise","lane":"history","start":1867,"end":1867,"approx":false,"note":"Created the Dual Monarchy, not a single unified nation-state.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Austro-Hungarian%20Compromise","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-bff01e75d9e7","title":"Das Kapital, volume I published","lane":"history","start":1867,"end":1867,"approx":false,"note":"Marx's critique of capitalist production; distinguish from the 1848 Manifesto.","creators":[],"reference":"https://en.wikipedia.org/wiki/Das_Kapital","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-dbad288d3bf3","title":"Frank Lloyd Wright","lane":"people","start":1867,"end":1959,"approx":false,"note":"American architect associated with organic architecture, Prairie houses and the Guggenheim Museum.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Frank%20Lloyd%20Wright","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-b26608221211","title":"Meiji Restoration","lane":"history","start":1868,"end":1868,"approx":false,"note":"Imperial rule was restored in Japan; state-led modernisation followed.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Meiji%20Restoration","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-871f9c4ea98d","title":"First US transcontinental railroad completed","lane":"history","start":1869,"end":1869,"approx":false,"note":"The rail connection joined at Promontory Summit; engineering and settlement transformed the continent.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20US%20transcontinental%20railroad%20completed","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-153c750b32b9","title":"Suez Canal opens","lane":"history","start":1869,"end":1869,"approx":false,"note":"The canal connected the Mediterranean and Red Sea, changing shipping routes and imperial strategy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Suez%20Canal%20opens","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other","france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-184e80b1ce5e","title":"Henri Matisse","lane":"people","start":1869,"end":1954,"approx":false,"note":"Painter, sculptor and maker of cut-outs; a leading Fauvist.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Henri%20Matisse","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-2e6bb2929b4a","title":"Battle of Sedan","lane":"history","start":1870,"end":1870,"approx":false,"note":"Napoleon III was captured; the defeat preceded the proclamation of the French Third Republic.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20Sedan","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-571983cbccfe","title":"Capture of Rome","lane":"history","start":1870,"end":1870,"approx":false,"note":"Italian troops entered Rome on 20 September; Rome became the capital in 1871.","creators":[],"reference":"https://en.wikipedia.org/wiki/Capture_of_Rome","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-e1eb048bd967","title":"Franco-Prussian War","lane":"history","start":1870,"end":1871,"approx":false,"note":"French defeat ended the Second Empire and accelerated German unification.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Franco-Prussian%20War","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["france","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-28b78178f2b2","title":"German Empire proclaimed","lane":"history","start":1871,"end":1871,"approx":false,"note":"Proclaimed at Versailles under William I, with Bismarck as chancellor.","creators":[],"reference":"https://en.wikipedia.org/wiki/Proclamation_of_the_German_Empire","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central","france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-d781d2f7abff","title":"Paris Commune","lane":"history","start":1871,"end":1871,"approx":false,"note":"A revolutionary government held Paris before its suppression during Bloody Week.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paris%20Commune","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-de54a6dde3f4","title":"Treaty of Frankfurt","lane":"history","start":1871,"end":1871,"approx":false,"note":"Ended the Franco-Prussian War; France ceded Alsace and part of Lorraine to Germany.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Frankfurt","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-01e35d1b8677","title":"Giacomo Balla","lane":"people","start":1871,"end":1958,"approx":false,"note":"Italian Futurist painter concerned with motion and light.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Giacomo%20Balla","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-5ef43c96e111","title":"Impression, Sunrise","lane":"art","start":1872,"end":1872,"approx":false,"note":"The title helped give Impressionism its name after the 1874 exhibition; painted at Le Havre.","creators":["Claude Monet"],"reference":"https://en.wikipedia.org/w/index.php?search=Impression%2C%20Sunrise","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=5d1edc4c259f5be0cfcd7de5.webp","credit":"Claude Monet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Monet_-_Impression%2C_Sunrise.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-95f710288d51","title":"Piet Mondrian","lane":"people","start":1872,"end":1944,"approx":false,"note":"Dutch artist associated with De Stijl and Neo-Plasticism.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Piet%20Mondrian","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["low"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-0aa5f3ada6ca","title":"First Impressionist exhibition","lane":"art","start":1874,"end":1874,"approx":false,"note":"Independent exhibition in Paris; the movement's label developed from critical responses.","creators":["Claude Monet","Edgar Degas","Berthe Morisot","Camille Pissarro","Pierre-Auguste Renoir"],"reference":"https://en.wikipedia.org/wiki/First_Impressionist_Exhibition","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-4c0712eec1a6","title":"Woman with a Parasol","lane":"art","start":1875,"end":1875,"approx":false,"note":"The 1875 canvas depicts Camille and Jean Monet; do not confuse it with later parasol paintings.","creators":["Claude Monet"],"reference":"https://en.wikipedia.org/w/index.php?search=Woman%20with%20a%20Parasol","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=e210eec748020e9e04483e92.webp","credit":"Claude Monet","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Claude_Monet_-_Woman_with_a_Parasol_-_Madame_Monet_and_Her_Son_-_Google_Art_Project.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-8b1557f5190c","title":"Bell's telephone patent","lane":"history","start":1876,"end":1876,"approx":false,"note":"A milestone in telephone development; multiple inventors contributed to the technology.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Bell%27s%20telephone%20patent","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-f6225ff0139e","title":"Dance at Le Moulin de la Galette","lane":"art","start":1876,"end":1876,"approx":false,"note":"A scene of Parisian leisure joining crowded figures and shifting outdoor light.","creators":["Pierre-Auguste Renoir"],"reference":"https://en.wikipedia.org/w/index.php?search=Dance%20at%20Le%20Moulin%20de%20la%20Galette","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","museumAssetId78":"PDFART48-162","image":{"src":"/.netlify/functions/access?action=media&name=4e73c7f3dbf7da834d0436b8.webp","credit":"Pierre-Auguste Renoir","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Renoir,_Pierre-Auguste_-_Dance_at_Le_Moulin_de_la_Galette,_1876.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: Bal du moulin de la Galette · 1876"},"imageChecked78":"2026-10-05"},{"id":"t68-2a176a57f8f2","title":"Constantin Brâncuși","lane":"people","start":1876,"end":1957,"approx":false,"note":"Romanian-born sculptor working in Paris; simplified forms explore essences rather than literal likeness.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Constantin%20Br%C3%A2ncu%C8%99i","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["other","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-9bd515fd02b9","title":"Congress of Berlin","lane":"history","start":1878,"end":1878,"approx":false,"note":"Revised the Treaty of San Stefano and rearranged Balkan territories and sovereignty.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Congress%20of%20Berlin","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central","eastmed","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-d21226673cee","title":"Human, All Too Human","lane":"people","start":1878,"end":1878,"approx":false,"note":"A philosophical work marking a change in Nietzsche's thinking.","creators":["Friedrich Nietzsche"],"reference":"https://en.wikipedia.org/w/index.php?search=Human%2C%20All%20Too%20Human","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-5cd4e0771ac0","title":"Edison's practical incandescent lamp demonstrations","lane":"history","start":1879,"end":1879,"approx":false,"note":"Commercial electric lighting followed many earlier experiments; avoid attributing the entire invention to one person.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Edison%27s%20practical%20incandescent%20lamp%20demonstrations","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-e6dc8c9d8e90","title":"Kazimir Malevich","lane":"people","start":1879,"end":1935,"approx":false,"note":"Founder of Suprematism; black and white squares have distinct dates and versions.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Kazimir%20Malevich","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-564f8224b5b5","title":"Paul Klee","lane":"people","start":1879,"end":1940,"approx":false,"note":"Swiss-born artist and Bauhaus teacher; personal symbolism and colour theory shaped his work.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paul%20Klee","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-4be1d59a0546","title":"The Brothers Karamazov","lane":"people","start":1880,"end":1880,"approx":false,"note":"A philosophical family novel; compare ethical questions with Crime and Punishment.","creators":["Fyodor Dostoevsky"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Brothers%20Karamazov","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-b7e0d1b9bcca","title":"The Thinker","lane":"art","start":1880,"end":1880,"approx":false,"note":"Conceived for The Gates of Hell; enlarged versions and bronze casts have later dates.","creators":["Auguste Rodin"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Thinker","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=31edc6542179030c4e68a6de.webp","credit":"Kaisching","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Le_Penseur_by_Rodin_%28Kunsthalle_Bielefeld%29_2014-04-10.JPG","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-084aa1c97ee0","title":"Isle of the Dead: versions","lane":"art","start":1880,"end":1886,"approx":true,"note":"Böcklin painted five versions; the photo does not identify which one, so no single version is assumed.","creators":["Arnold Böcklin"],"reference":"https://en.wikipedia.org/w/index.php?search=Isle%20of%20the%20Dead%3A%20versions","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=9b089840f1f1c3996e9f1253.webp","credit":"Arnold Böcklin","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Arnold_B%C3%B6cklin_-_Die_Toteninsel_I_%28Basel%2C_Kunstmuseum%29.jpg","scope":"Representative work from the series/cycle; the timeline range covers the series, not only this image."},"imageChecked78":"2026-10-05"},{"id":"t69-dd3d0346fbda","title":"Divisionism and optical colour mixing","lane":"art","start":1880,"end":1900,"approx":true,"note":"Separate strokes or dots of colour are placed beside one another. Divisionism concerns colour separation; Pointillism refers more specifically to a dotted application.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Divisionism%20and%20optical%20colour%20mixing","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","italy"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-dd3ff48ec544","title":"Symbolism and subjective meaning","lane":"art","start":1880,"end":1910,"approx":true,"note":"Dream, myth and suggestion can take priority over everyday observation. Symbolism connects literature and visual art without prescribing one technique.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Symbolism%20and%20subjective%20meaning","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","central"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-3d04f6a1be56","title":"French protectorate established in Tunisia","lane":"history","start":1881,"end":1881,"approx":false,"note":"French colonial expansion intensified rivalry with Italy in the Mediterranean.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=French%20protectorate%20established%20in%20Tunisia","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["france","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-a08af765017e","title":"Pablo Picasso","lane":"people","start":1881,"end":1973,"approx":false,"note":"Spanish artist active in France; his work spans multiple movements and political contexts.","creators":[],"reference":"https://www.moma.org/artists/4609","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["iberia","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-d6c5233e65a5","title":"British occupation of Egypt","lane":"history","start":1882,"end":1882,"approx":false,"note":"Occupation followed military intervention; Egypt's formal status did not simply become a British colony in 1882.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=British%20occupation%20of%20Egypt","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-8a8d867044dd","title":"Execution of Guglielmo Oberdan","lane":"history","start":1882,"end":1882,"approx":false,"note":"An Italian irredentist executed by Austria; the episode became a symbol in nationalist memory.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Execution%20of%20Guglielmo%20Oberdan","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["italy","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-0ba6575cd3b4","title":"Triple Alliance formed","lane":"history","start":1882,"end":1882,"approx":false,"note":"Germany, Austria-Hungary and Italy formed an alliance; Italy later entered World War I on the opposing side.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Triple%20Alliance%20formed","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central","italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-9b6c228873f3","title":"Umberto Boccioni","lane":"people","start":1882,"end":1916,"approx":false,"note":"Futurist painter and sculptor exploring dynamic movement.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Umberto%20Boccioni","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-d09648b35180","title":"Georges Braque","lane":"people","start":1882,"end":1963,"approx":false,"note":"With Picasso, developed Cubism; later work continued beyond its early phases.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Georges%20Braque","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-081dddd265b4","title":"Koch's cholera investigations","lane":"history","start":1883,"end":1883,"approx":false,"note":"Koch identified the cholera bacillus during work in Egypt and India; Pacini had described the organism in 1854.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Koch%27s%20cholera%20investigations","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-07c6780ca9da","title":"Walter Gropius","lane":"people","start":1883,"end":1969,"approx":false,"note":"Founder of Bauhaus; later taught and practised in the United States.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Walter%20Gropius","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["central","other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-cd925aef144f","title":"Berlin Conference on Africa","lane":"history","start":1884,"end":1885,"approx":false,"note":"European powers negotiated rules for colonial claims; African peoples were not represented.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Berlin%20Conference%20on%20Africa","sourceSheets":[3643],"sourceMapping":"item","dateType":"period","threads67":["central","shared","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-3033047cde4b","title":"Home Insurance Building","lane":"architecture","start":1884,"end":1885,"approx":true,"note":"An early Chicago tall-building experiment; the label first skyscraper depends on structural definitions.","creators":["William Le Baron Jenney"],"reference":"https://en.wikipedia.org/w/index.php?search=Home%20Insurance%20Building","sourceSheets":[3644],"sourceMapping":"supplemental context","dateType":"period","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=0d178f654bc89b0f29d88e7e.webp","credit":"Chicago Architectural Photographing Company","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Home_Insurance_Building.JPG","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t68-494084f25637","title":"A Sunday on La Grande Jatte","lane":"art","start":1884,"end":1886,"approx":true,"note":"Systematic dots of colour and a highly organised composition distinguish Neo-Impressionism from a purely spontaneous sketch.","creators":["Georges Seurat"],"reference":"https://en.wikipedia.org/w/index.php?search=A%20Sunday%20on%20La%20Grande%20Jatte","sourceSheets":[3644],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"period","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","museumAssetId78":"ART45-OFFICIAL-65e676a636f4","image":{"src":"/.netlify/functions/access?action=media&name=655f387484a9096b22ea6167.webp","credit":"Georges Seurat · Wikimedia Commons","license":"Rights at source · Commons reference","url":"https://commons.wikimedia.org/wiki/File:A_Sunday_on_La_Grande_Jatte%2C_Georges_Seurat%2C_1884.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: A Sunday Afternoon on the Island of La Grande Jatte · 1886"},"imageChecked78":"2026-10-05"},{"id":"t68-5fe2c625e253","title":"The Burghers of Calais","lane":"art","start":1884,"end":1889,"approx":true,"note":"A group memorial giving individual figures distinct emotional responses rather than one triumphant pose.","creators":["Auguste Rodin"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Burghers%20of%20Calais","sourceSheets":[3643],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"period","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=f8792c53f0bc455840c0dc3d.webp","credit":"Romainberth","license":"CC BY-SA 3.0","url":"https://commons.wikimedia.org/wiki/File:Statue_bourgeois_calais_rodin.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-151ab74854d5","title":"Amedeo Modigliani","lane":"people","start":1884,"end":1920,"approx":false,"note":"Italian artist working in Paris; portraits and sculptures use elongated forms.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Amedeo%20Modigliani","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["italy","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-bc37ccb82f2c","title":"The Potato Eaters","lane":"art","start":1885,"end":1885,"approx":false,"note":"Early dark-toned depiction of rural life, before his brighter southern French palette.","creators":["Vincent van Gogh"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Potato%20Eaters","sourceSheets":[3644],"sourceMapping":"item","dateType":"year","threads67":["low"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=f5d0a43a2abe5c0c3ca32bcb.webp","credit":"Vincent van Gogh","license":"Public domain","url":"https://en.wikipedia.org/wiki/The_Potato_Eaters","scope":"Exact title and artist matched to existing catalogue"},"mediaType78":"visual-artwork"},{"id":"t68-6af11401a6c0","title":"Post-Impressionism","lane":"art","start":1886,"end":1905,"approx":true,"note":"A retrospective umbrella term for diverse approaches, not a unified group with one manifesto.","creators":["Paul Cézanne","Vincent van Gogh","Paul Gauguin","Georges Seurat"],"reference":"https://en.wikipedia.org/w/index.php?search=Post-Impressionism","sourceSheets":[3644],"sourceMapping":"item","dateType":"period","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-952bd50f99e7","title":"Ludwig Mies van der Rohe","lane":"people","start":1886,"end":1969,"approx":false,"note":"Modernist architect and final Bauhaus director, later based in Chicago.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Ludwig%20Mies%20van%20der%20Rohe","sourceSheets":[3645],"sourceMapping":"item","dateType":"lifespan","threads67":["central","other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-569804451228","title":"Le Corbusier","lane":"people","start":1887,"end":1965,"approx":false,"note":"Swiss-born architect and urban theorist; modernist villas and later sculptural buildings differ markedly.","creators":[],"reference":"https://www.moma.org/artists/3426","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["france","central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-1e368bbdf119","title":"Marc Chagall","lane":"people","start":1887,"end":1985,"approx":false,"note":"Artist combining personal memory, Jewish culture and imaginative figures.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Marc%20Chagall","sourceSheets":[3644],"sourceMapping":"item","dateType":"lifespan","threads67":["other","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-1702a47de669","title":"Isle of Life","lane":"art","start":1888,"end":1888,"approx":false,"note":"A counterpart in mood to the Isle of the Dead; compare colour, movement and symbolism.","creators":["Arnold Böcklin"],"reference":"https://en.wikipedia.org/w/index.php?search=Isle%20of%20Life","sourceSheets":[3643],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting6