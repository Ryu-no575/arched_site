9.webp"},{"number":3635,"title":"Sheet 03","file":"IMG_3635.jpeg","src":"/.netlify/functions/access?action=media&name=03f76be9d77ac0d1b2555d2e.webp"},{"number":3636,"title":"Sheet 04","file":"IMG_3636.jpeg","src":"/.netlify/functions/access?action=media&name=bec39f32f8a7e503b7b82434.webp"},{"number":3637,"title":"Sheet 05","file":"IMG_3637.jpeg","src":"/.netlify/functions/access?action=media&name=fb23e4a27d778dd919a6d4bd.webp"},{"number":3638,"title":"Sheet 06","file":"IMG_3638.jpeg","src":"/.netlify/functions/access?action=media&name=97bdab3203a2a950b770defe.webp"},{"number":3639,"title":"Sheet 07","file":"IMG_3639.jpeg","src":"/.netlify/functions/access?action=media&name=952990dbc45b9895bcb7bb27.webp"},{"number":3640,"title":"Sheet 08","file":"IMG_3640.jpeg","src":"/.netlify/functions/access?action=media&name=0b65a2722903a248f6d200b7.webp"},{"number":3641,"title":"Sheet 09","file":"IMG_3641.jpeg","src":"/.netlify/functions/access?action=media&name=080a20f1204fd63ca1c19412.webp"},{"number":3642,"title":"Sheet 10","file":"IMG_3642.jpeg","src":"/.netlify/functions/access?action=media&name=039d12d6dbd3144c592ddc2a.webp"},{"number":3643,"title":"Sheet 11","file":"IMG_3643.jpeg","src":"/.netlify/functions/access?action=media&name=e3cc08142533755a0c4d2097.webp"},{"number":3644,"title":"Sheet 12","file":"IMG_3644.jpeg","src":"/.netlify/functions/access?action=media&name=4de5740361cb88585a4cb784.webp"},{"number":3645,"title":"Sheet 13","file":"IMG_3645.jpeg","src":"/.netlify/functions/access?action=media&name=c066875fae28c440afb4f703.webp"},{"number":3646,"title":"Sheet 14","file":"IMG_3646.jpeg","src":"/.netlify/functions/access?action=media&name=a18249049fc3592b6c2e2f2d.webp"},{"number":3647,"title":"Sheet 15","file":"IMG_3647.jpeg","src":"/.netlify/functions/access?action=media&name=c19c17faaad5a1c90f1c6312.webp"},{"number":3648,"title":"Sheet 16","file":"IMG_3648.jpeg","src":"/.netlify/functions/access?action=media&name=7c57ce42c6cdd13416ac5ef8.webp"}],"coverage":{"status":"Six continuation sheets visually read and merged with the previous ten-sheet catalogue. Identifiable events, creators and works retained; some generic titles and cropped annotations remain unresolved.","pending":["Sheet 1: the isolated Bison label does not identify a cave or object. It is retained in the source image without inventing a date.","Sheets 11–16: some generic artwork titles do not identify a version; these have contextual-identification labels and are not presented as exact transcriptions.","Sheet 16: torn/cropped lower-edge labels and partially visible presidential names cannot all be read. Original source images remain available."],"notes":"Dates distinguish depicted events, creation, publication, treaty signature and entry into force. Source sheets are available for comparison. The catalogue is an editorial study resource, not a guarantee of all possible ARCHED topics. New architecture context items supplement the photographs. V69 concept cards use approximate study windows, not invented dates of origin. They are editorial preparation topics, not verified past-exam questions."},"polities":[{"id":"p65-roman-kings","region":"italy","start":-753,"end":-509,"title":"Roman Kingdom","note":"Traditional chronology; not a securely documented founding year.","reference":"https://en.wikipedia.org/wiki/Roman_Kingdom","approx":true,"ongoing":false},{"id":"p65-roman-republic","region":"italy","start":-509,"end":-27,"title":"Roman Republic","note":"Traditional beginning; imperial settlement in 27 BCE.","reference":"https://en.wikipedia.org/wiki/Roman_Republic","approx":true,"ongoing":false},{"id":"p65-roman-empire","region":"italy","start":-27,"end":395,"title":"Roman Empire","note":"This segment ends at the lasting division of imperial rule in 395, not the extinction of Roman government.","reference":"https://en.wikipedia.org/wiki/Roman_Empire","approx":false,"ongoing":false},{"id":"p65-west-rome","region":"italy","start":395,"end":476,"title":"Western Roman Empire","note":"476 is the conventional endpoint; Julius Nepos retained a claim until 480.","reference":"https://en.wikipedia.org/wiki/Western_Roman_Empire","approx":true,"ongoing":false},{"id":"p65-odoacer","region":"italy","start":476,"end":493,"title":"Odoacer in Italy","note":"Rule in Italy after the deposition of Romulus Augustulus.","reference":"https://en.wikipedia.org/wiki/Odoacer","approx":false,"ongoing":false},{"id":"p65-ostrogoths","region":"italy","start":493,"end":553,"title":"Ostrogothic Italy","note":"Theodoric's conquest to defeat in the Gothic War; resistance continued afterwards.","reference":"https://en.wikipedia.org/wiki/Ostrogothic_Kingdom","approx":false,"ongoing":false},{"id":"p65-lombards","region":"italy","start":568,"end":774,"title":"Lombard Kingdom","note":"Northern kingdom conquered by Charlemagne; southern Lombard duchies continued.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_the_Lombards","approx":false,"ongoing":false},{"id":"p65-papal","region":"italy","start":756,"end":1870,"title":"Papal States","note":"Conventional beginning at the Donation of Pepin; interrupted in the revolutionary and Napoleonic era.","reference":"https://en.wikipedia.org/wiki/Papal_States","approx":true,"ongoing":false},{"id":"p65-venice","region":"italy","start":697,"end":1797,"title":"Republic of Venice","note":"697 is a traditional foundation; state formation was gradual.","reference":"https://en.wikipedia.org/wiki/Republic_of_Venice","approx":true,"ongoing":false},{"id":"p65-florence","region":"italy","start":1115,"end":1532,"title":"Republic of Florence","note":"Conventional republican span; included Medici dominance and interruptions.","reference":"https://en.wikipedia.org/wiki/Republic_of_Florence","approx":true,"ongoing":false},{"id":"p65-tuscany","region":"italy","start":1569,"end":1859,"title":"Grand Duchy of Tuscany","note":"Napoleonic interruptions 1801–1814; annexed to Sardinia in 1860.","reference":"https://en.wikipedia.org/wiki/Grand_Duchy_of_Tuscany","approx":false,"ongoing":false},{"id":"p65-italy","region":"italy","start":1861,"end":1946,"title":"Kingdom of Italy","note":"Proclaimed in 1861; the visible chart stops at 1900, before the kingdom ended.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_Italy","approx":false,"ongoing":false},{"id":"p65-merovingian","region":"france","start":481,"end":751,"title":"Merovingian Franks","note":"Clovis's accession is used as a conventional starting point; multiple Frankish kingdoms existed.","reference":"https://en.wikipedia.org/wiki/Merovingian_dynasty","approx":true,"ongoing":false},{"id":"p65-carolingian","region":"france","start":751,"end":843,"title":"Carolingian realm","note":"Dynastic accession in 751; imperial title from 800; division at Verdun in 843.","reference":"https://en.wikipedia.org/wiki/Carolingian_dynasty","approx":false,"ongoing":false},{"id":"p65-west-francia","region":"france","start":843,"end":987,"title":"West Francia","note":"Partition at Verdun to the Capetian accession; change of dynasty rather than sudden creation of a nation.","reference":"https://en.wikipedia.org/wiki/West_Francia","approx":false,"ongoing":false},{"id":"p65-france-monarchy","region":"france","start":987,"end":1792,"title":"French monarchy","note":"Capetian accession to abolition of monarchy; several dynasties and disputed regimes within this span.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_France","approx":false,"ongoing":false},{"id":"p65-france-republic","region":"france","start":1792,"end":1804,"title":"First French Republic","note":"Republic proclaimed in 1792; Empire proclaimed in 1804.","reference":"https://en.wikipedia.org/wiki/French_First_Republic","approx":false,"ongoing":false},{"id":"p65-france-empire","region":"france","start":1804,"end":1814,"title":"First French Empire","note":"First reign; the Hundred Days of 1815 are a separate restoration.","reference":"https://en.wikipedia.org/wiki/First_French_Empire","approx":false,"ongoing":false},{"id":"p65-france-restoration","region":"france","start":1814,"end":1830,"title":"Bourbon Restoration","note":"Interrupted by the Hundred Days in 1815.","reference":"https://en.wikipedia.org/wiki/Bourbon_Restoration_in_France","approx":false,"ongoing":false},{"id":"p65-france-july","region":"france","start":1830,"end":1848,"title":"July Monarchy","note":"Louis-Philippe's constitutional monarchy.","reference":"https://en.wikipedia.org/wiki/July_Monarchy","approx":false,"ongoing":false},{"id":"p65-france-second-republic","region":"france","start":1848,"end":1852,"title":"Second Republic","note":"Republic established in the revolution of 1848.","reference":"https://en.wikipedia.org/wiki/French_Second_Republic","approx":false,"ongoing":false},{"id":"p65-france-second-empire","region":"france","start":1852,"end":1870,"title":"Second Empire","note":"Napoleon III; collapse during the Franco-Prussian War.","reference":"https://en.wikipedia.org/wiki/Second_French_Empire","approx":false,"ongoing":false},{"id":"p65-france-third","region":"france","start":1870,"end":1940,"title":"Third Republic","note":"Continues beyond this chart's 1900 boundary.","reference":"https://en.wikipedia.org/wiki/French_Third_Republic","approx":false,"ongoing":false},{"id":"p65-visigoths","region":"iberia","start":418,"end":721,"title":"Visigothic Kingdom","note":"Initially based in Gaul; much of Iberia conquered in 711; Septimania survived to 721.","reference":"https://en.wikipedia.org/wiki/Visigothic_Kingdom","approx":false,"ongoing":false},{"id":"p65-cordoba-emirate","region":"iberia","start":756,"end":929,"title":"Emirate of Córdoba","note":"Independent Umayyad emirate; caliphate proclaimed in 929.","reference":"https://en.wikipedia.org/wiki/Emirate_of_C%C3%B3rdoba","approx":false,"ongoing":false},{"id":"p65-cordoba-caliphate","region":"iberia","start":929,"end":1031,"title":"Caliphate of Córdoba","note":"Dissolution followed by taifa kingdoms.","reference":"https://en.wikipedia.org/wiki/Caliphate_of_C%C3%B3rdoba","approx":false,"ongoing":false},{"id":"p65-castile","region":"iberia","start":1230,"end":1715,"title":"Crown of Castile","note":"Permanent union with León in 1230; administrative transformation under the Bourbons.","reference":"https://en.wikipedia.org/wiki/Crown_of_Castile","approx":false,"ongoing":false},{"id":"p65-aragon","region":"iberia","start":1162,"end":1716,"title":"Crown of Aragon","note":"Dynastic composite monarchy; institutions abolished under the Nueva Planta decrees.","reference":"https://en.wikipedia.org/wiki/Crown_of_Aragon","approx":false,"ongoing":false},{"id":"p65-granada","region":"iberia","start":1232,"end":1492,"title":"Nasrid Granada","note":"Conventional foundation in 1232; capitulation to the Catholic Monarchs in 1492.","reference":"https://en.wikipedia.org/wiki/Emirate_of_Granada","approx":true,"ongoing":false},{"id":"p65-portugal","region":"iberia","start":1139,"end":1910,"title":"Kingdom of Portugal","note":"Royal title in 1139; recognition in 1143; Iberian Union 1580–1640.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_Portugal","approx":false,"ongoing":false},{"id":"p65-england","region":"britain","start":927,"end":1649,"title":"Kingdom of England","note":"Unification conventionally dated 927; interrupted by the Commonwealth in 1649–1660. The monarchy was interrupted by the Commonwealth and Protectorate; see the separate restored-kingdom span.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_England","approx":true,"ongoing":false},{"id":"p65-scotland","region":"britain","start":843,"end":1654,"title":"Kingdom of Scotland","note":"843 is a traditional origin; formation of Alba was gradual. Separate royal institutions were interrupted during the Interregnum; annexation to the Commonwealth was proclaimed in 1654.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_Scotland","approx":true,"ongoing":false},{"id":"p65-britain","region":"britain","start":1707,"end":1801,"title":"Kingdom of Great Britain","note":"Political union of England and Scotland.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_Great_Britain","approx":false,"ongoing":false},{"id":"p65-uk","region":"britain","start":1801,"end":2026,"title":"United Kingdom","note":"Union with Ireland in 1801; territorial and name changes in the twentieth century. Ongoing state, not a 2026 extinction date.","reference":"https://en.wikipedia.org/wiki/United_Kingdom","approx":false,"ongoing":true},{"id":"p65-east-francia","region":"central","start":843,"end":962,"title":"East Francia","note":"Eastern kingdom from Verdun; 962 marks Otto I's imperial coronation, not a universally agreed foundation.","reference":"https://en.wikipedia.org/wiki/East_Francia","approx":false,"ongoing":false},{"id":"p65-middle-francia","region":"central","start":843,"end":855,"title":"Middle Francia","note":"Partitioned at Prüm after Lothair I's abdication.","reference":"https://en.wikipedia.org/wiki/Middle_Francia","approx":false,"ongoing":false},{"id":"p65-hre","region":"central","start":962,"end":1806,"title":"Holy Roman Empire","note":"Conventional start at Otto I's coronation; decentralized polity, dissolved in 1806.","reference":"https://en.wikipedia.org/wiki/Holy_Roman_Empire","approx":true,"ongoing":false},{"id":"p65-prussia","region":"central","start":1701,"end":1918,"title":"Kingdom of Prussia","note":"A kingdom within a wider changing German political landscape.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_Prussia","approx":false,"ongoing":false},{"id":"p65-austria","region":"central","start":1804,"end":1867,"title":"Austrian Empire","note":"Established before the dissolution of the Holy Roman Empire.","reference":"https://en.wikipedia.org/wiki/Austrian_Empire","approx":false,"ongoing":false},{"id":"p65-austria-hungary","region":"central","start":1867,"end":1918,"title":"Austria-Hungary","note":"Dual monarchy after the Ausgleich.","reference":"https://en.wikipedia.org/wiki/Austria-Hungary","approx":false,"ongoing":false},{"id":"p65-german-empire","region":"central","start":1871,"end":1918,"title":"German Empire","note":"Unification under Prussian leadership.","reference":"https://en.wikipedia.org/wiki/German_Empire","approx":false,"ongoing":false},{"id":"p65-kievan","region":"eastern","start":882,"end":1240,"title":"Kievan Rus'","note":"Conventional span from Oleg's capture of Kiev to Mongol sack; fragmentation began earlier.","reference":"https://en.wikipedia.org/wiki/Kievan_Rus%27","approx":true,"ongoing":false},{"id":"p65-muscovy","region":"eastern","start":1263,"end":1547,"title":"Grand Duchy of Moscow","note":"Conventional origin; tsardom proclaimed in 1547.","reference":"https://en.wikipedia.org/wiki/Grand_Duchy_of_Moscow","approx":true,"ongoing":false},{"id":"p65-russia-tsar","region":"eastern","start":1547,"end":1721,"title":"Tsardom of Russia","note":"Imperial title adopted under Peter I in 1721.","reference":"https://en.wikipedia.org/wiki/Tsardom_of_Russia","approx":false,"ongoing":false},{"id":"p65-russia-empire","region":"eastern","start":1721,"end":1917,"title":"Russian Empire","note":"Continues beyond the displayed nineteenth century.","reference":"https://en.wikipedia.org/wiki/Russian_Empire","approx":false,"ongoing":false},{"id":"p65-poland-lithuania","region":"eastern","start":1569,"end":1795,"title":"Polish–Lithuanian Commonwealth","note":"Union of Lublin to the Third Partition.","reference":"https://en.wikipedia.org/wiki/Polish%E2%80%93Lithuanian_Commonwealth","approx":false,"ongoing":false},{"id":"p65-byzantine","region":"eastmed","start":395,"end":1204,"title":"Eastern Roman Empire","note":"Chart branches at 395; historians also use 330 or other starting points. Constantinople captured in 1204.","reference":"https://en.wikipedia.org/wiki/Byzantine_Empire","approx":false,"ongoing":false},{"id":"p65-nicaea","region":"eastmed","start":1204,"end":1261,"title":"Empire of Nicaea","note":"One of several Byzantine successor states; recaptured Constantinople in 1261.","reference":"https://en.wikipedia.org/wiki/Empire_of_Nicaea","approx":false,"ongoing":false},{"id":"p65-latin","region":"eastmed","start":1204,"end":1261,"title":"Latin Empire","note":"Crusader state at Constantinople, concurrent with Byzantine successor states.","reference":"https://en.wikipedia.org/wiki/Latin_Empire","approx":false,"ongoing":false},{"id":"p65-byzantine-restored","region":"eastmed","start":1261,"end":1453,"title":"Restored Byzantine Empire","note":"Constantinople recovered in 1261, conquered by the Ottomans in 1453.","reference":"https://en.wikipedia.org/wiki/Byzantine_Empire","approx":false,"ongoing":false},{"id":"p65-ottoman","region":"eastmed","start":1299,"end":1922,"title":"Ottoman Empire","note":"1299 is a conventional origin; expansion was gradual. Sultanate abolished in 1922.","reference":"https://en.wikipedia.org/wiki/Ottoman_Empire","approx":true,"ongoing":false},{"id":"p65-sumer","region":"westasia","start":-3000,"end":-2000,"title":"Sumerian city-states","note":"Approximate cultural-political grouping, not one continuous unified state.","reference":"https://en.wikipedia.org/wiki/Sumer","approx":true,"ongoing":false},{"id":"p65-akkad","region":"westasia","start":-2334,"end":-2154,"title":"Akkadian Empire","note":"Approximate Middle Chronology dates.","reference":"https://en.wikipedia.org/wiki/Akkadian_Empire","approx":true,"ongoing":false},{"id":"p65-assyria","region":"westasia","start":-911,"end":-609,"title":"Neo-Assyrian Empire","note":"Conventional imperial period; fall of the last royal center in 609 BCE.","reference":"https://en.wikipedia.org/wiki/Neo-Assyrian_Empire","approx":true,"ongoing":false},{"id":"p65-babylon","region":"westasia","start":-626,"end":-539,"title":"Neo-Babylonian Empire","note":"Conquered by Cyrus in 539 BCE.","reference":"https://en.wikipedia.org/wiki/Neo-Babylonian_Empire","approx":false,"ongoing":false},{"id":"p65-achaemenid","region":"westasia","start":-550,"end":-330,"title":"Achaemenid Persia","note":"Conventional empire span; conquered by Alexander.","reference":"https://en.wikipedia.org/wiki/Achaemenid_Empire","approx":true,"ongoing":false},{"id":"p65-seleucid","region":"westasia","start":-312,"end":-63,"title":"Seleucid Empire","note":"Conventional Seleucid era to Roman annexation of Syria; territories shrank over time.","reference":"https://en.wikipedia.org/wiki/Seleucid_Empire","approx":true,"ongoing":false},{"id":"p65-parthia","region":"westasia","start":-247,"end":224,"title":"Parthian Empire","note":"Accession is sometimes dated 248 BCE; 247 BCE convention used here.","reference":"https://en.wikipedia.org/wiki/Parthian_Empire","approx":false,"ongoing":false},{"id":"p65-sasanian","region":"westasia","start":224,"end":651,"title":"Sasanian Empire","note":"Ardashir's victory to death of Yazdegerd III.","reference":"https://en.wikipedia.org/wiki/Sasanian_Empire","approx":false,"ongoing":false},{"id":"p65-rashidun","region":"westasia","start":632,"end":661,"title":"Rashidun Caliphate","note":"Conventional period of the first four caliphs.","reference":"https://en.wikipedia.org/wiki/Rashidun_Caliphate","approx":true,"ongoing":false},{"id":"p65-umayyad","region":"westasia","start":661,"end":750,"title":"Umayyad Caliphate","note":"Damascus-based caliphate; Umayyad rule continued separately in Iberia.","reference":"https://en.wikipedia.org/wiki/Umayyad_Caliphate","approx":false,"ongoing":false},{"id":"p65-abbasid","region":"westasia","start":750,"end":1258,"title":"Abbasid Caliphate","note":"Baghdad phase ended in 1258; ceremonial Cairo caliphs continued 1261–1517.","reference":"https://en.wikipedia.org/wiki/Abbasid_Caliphate","approx":false,"ongoing":false},{"id":"p65-seljuk","region":"westasia","start":1037,"end":1194,"title":"Great Seljuk Empire","note":"Coexisted with Abbasid caliphs; not a simple replacement of the caliphate.","reference":"https://en.wikipedia.org/wiki/Seljuk_Empire","approx":false,"ongoing":false},{"id":"p65-mongol","region":"westasia","start":1206,"end":1260,"title":"United Mongol Empire","note":"1260 marks the succession crisis and fragmentation, not the end of all Mongol states.","reference":"https://en.wikipedia.org/wiki/Mongol_Empire","approx":false,"ongoing":false},{"id":"p65-ilkhanate","region":"westasia","start":1256,"end":1335,"title":"Ilkhanate","note":"Mongol-ruled Iran and neighbouring territories.","reference":"https://en.wikipedia.org/wiki/Ilkhanate","approx":false,"ongoing":false},{"id":"p65-timurid","region":"westasia","start":1370,"end":1507,"title":"Timurid Empire","note":"Timur's accession to the fall of Herat; successor traditions continued.","reference":"https://en.wikipedia.org/wiki/Timurid_Empire","approx":false,"ongoing":false},{"id":"p65-safavid","region":"westasia","start":1501,"end":1736,"title":"Safavid Iran","note":"Isfahan fell in 1722; formal dynastic endpoint 1736.","reference":"https://en.wikipedia.org/wiki/Safavid_Iran","approx":false,"ongoing":false},{"id":"p65-qajar","region":"westasia","start":1789,"end":1925,"title":"Qajar Iran","note":"Conventional dynastic span; coronation of Agha Mohammad Khan in 1796.","reference":"https://en.wikipedia.org/wiki/Qajar_Iran","approx":true,"ongoing":false},{"id":"p65-old-egypt","region":"africa","start":-2686,"end":-2181,"title":"Egypt: Old Kingdom","note":"Approximate conventional boundaries; chronology varies.","reference":"https://en.wikipedia.org/wiki/Old_Kingdom_of_Egypt","approx":true,"ongoing":false},{"id":"p65-middle-egypt","region":"africa","start":-2055,"end":-1650,"title":"Egypt: Middle Kingdom","note":"Approximate boundaries; intermediary periods deliberately left as gaps.","reference":"https://en.wikipedia.org/wiki/Middle_Kingdom_of_Egypt","approx":true,"ongoing":false},{"id":"p65-new-egypt","region":"africa","start":-1550,"end":-1070,"title":"Egypt: New Kingdom","note":"Approximate dynastic boundaries.","reference":"https://en.wikipedia.org/wiki/New_Kingdom_of_Egypt","approx":true,"ongoing":false},{"id":"p65-ptolemaic","region":"africa","start":-305,"end":-30,"title":"Ptolemaic Egypt","note":"Ptolemy's royal title to Roman conquest.","reference":"https://en.wikipedia.org/wiki/Ptolemaic_Kingdom","approx":false,"ongoing":false},{"id":"p65-aksum","region":"africa","start":100,"end":940,"title":"Kingdom of Aksum","note":"Very approximate span; origins and decline are not single dated events.","reference":"https://en.wikipedia.org/wiki/Kingdom_of_Aksum","approx":true,"ongoing":false},{"id":"p65-fatimid","region":"africa","start":909,"end":1171,"title":"Fatimid Caliphate","note":"Founded in North Africa; conquered Egypt in 969.","reference":"https://en.wikipedia.org/wiki/Fatimid_Caliphate","approx":false,"ongoing":false},{"id":"p65-ayyubid","region":"africa","start":1171,"end":1250,"title":"Ayyubid Egypt","note":"Egyptian phase only; Ayyubid branches in Syria continued later.","reference":"https://en.wikipedia.org/wiki/Ayyubid_dynasty","approx":false,"ongoing":false},{"id":"p65-mamluk","region":"africa","start":1250,"end":1517,"title":"Mamluk Sultanate","note":"Egypt and Syria; conquered by the Ottomans.","reference":"https://en.wikipedia.org/wiki/Mamluk_Sultanate","approx":false,"ongoing":false},{"id":"p65-mali","region":"africa","start":1235,"end":1600,"title":"Mali Empire","note":"Approximate political span; decline and dissolution gradual and debated.","reference":"https://en.wikipedia.org/wiki/Mali_Empire","approx":true,"ongoing":false},{"id":"p65-songhai","region":"africa","start":1464,"end":1591,"title":"Songhai: imperial phase","note":"Sunni Ali's accession to Moroccan invasion; earlier Songhai states predate this phase.","reference":"https://en.wikipedia.org/wiki/Songhai_Empire","approx":false,"ongoing":false},{"id":"p65-maurya","region":"southasia","start":-322,"end":-185,"title":"Maurya Empire","note":"Approximate conventional dates.","reference":"https://en.wikipedia.org/wiki/Maurya_Empire","approx":true,"ongoing":false},{"id":"p65-gupta","region":"southasia","start":320,"end":550,"title":"Gupta Empire","note":"Approximate imperial phase; regional successor dynasties continued.","reference":"https://en.wikipedia.org/wiki/Gupta_Empire","approx":true,"ongoing":false},{"id":"p65-chola","region":"southasia","start":850,"end":1279,"title":"Imperial Cholas","note":"Approximate beginning of the medieval imperial phase.","reference":"https://en.wikipedia.org/wiki/Chola_dynasty","approx":true,"ongoing":false},{"id":"p65-delhi","region":"southasia","start":1206,"end":1526,"title":"Delhi Sultanate","note":"Five successive dynasties; Lodi defeat at Panipat in 1526.","reference":"https://en.wikipedia.org/wiki/Delhi_Sultanate","approx":false,"ongoing":false},{"id":"p65-vijayanagara","region":"southasia","start":1336,"end":1646,"title":"Vijayanagara Empire","note":"Capital sacked in 1565; later Aravidu rule continued until 1646.","reference":"https://en.wikipedia.org/wiki/Vijayanagara_Empire","approx":false,"ongoing":false},{"id":"p65-mughal-first","region":"southasia","start":1526,"end":1540,"title":"Early Mughal rule","note":"Babur to Humayun's defeat; interrupted by Sur rule.","reference":"https://en.wikipedia.org/wiki/Mughal_Empire","approx":false,"ongoing":false},{"id":"p65-sur","region":"southasia","start":1540,"end":1555,"title":"Sur Empire","note":"Afghan interregnum in northern India.","reference":"https://en.wikipedia.org/wiki/Sur_Empire","approx":false,"ongoing":false},{"id":"p65-mughal","region":"southasia","start":1555,"end":1857,"title":"Restored Mughals","note":"Humayun's return; last emperor deposed in 1857. Some institutional chronologies use 1858 for the final transition.","reference":"https://en.wikipedia.org/wiki/Mughal_Empire","approx":false,"ongoing":false},{"id":"p65-british-india","region":"southasia","start":1858,"end":1947,"title":"British Raj","note":"Crown rule; earlier Company rule was a different political phase.","reference":"https://en.wikipedia.org/wiki/British_Raj","approx":false,"ongoing":false},{"id":"p65-shang","region":"china","start":-1600,"end":-1046,"title":"Shang dynasty","note":"Approximate start and conventional Zhou conquest date.","reference":"https://en.wikipedia.org/wiki/Shang_dynasty","approx":true,"ongoing":false},{"id":"p65-zhou","region":"china","start":-1046,"end":-256,"title":"Zhou dynasty","note":"Western and Eastern Zhou; royal power fragmented long before the end.","reference":"https://en.wikipedia.org/wiki/Zhou_dynasty","approx":false,"ongoing":false},{"id":"p65-qin","region":"china","start":-221,"end":-206,"title":"Qin dynasty","note":"Imperial unification in 221 BCE.","reference":"https://en.wikipedia.org/wiki/Qin_dynasty","approx":false,"ongoing":false},{"id":"p65-western-han","region":"china","start":-206,"end":9,"title":"Western Han","note":"Ends at Wang Mang's usurpation; no historical year zero.","reference":"https://en.wikipedia.org/wiki/Han_dynasty","approx":false,"ongoing":false},{"id":"p65-xin","region":"china","start":9,"end":23,"title":"Xin dynasty","note":"Wang Mang's rule; followed by civil war.","reference":"https://en.wikipedia.org/wiki/Xin_dynasty","approx":false,"ongoing":false},{"id":"p65-eastern-han","region":"china","start":25,"end":220,"title":"Eastern Han","note":"Restoration under Guangwu.","reference":"https://en.wikipedia.org/wiki/Han_dynasty","approx":false,"ongoing":false},{"id":"p65-sui","region":"china","start":581,"end":618,"title":"Sui dynasty","note":"Dynastic foundation 581; reunification completed in 589.","reference":"https://en.wikipedia.org/wiki/Sui_dynasty","approx":false,"ongoing":false},{"id":"p65-tang","region":"china","start":618,"end":907,"title":"Tang dynasty","note":"Interrupted by Wu Zhou 690–705; dates show the broad dynastic span.","reference":"https://en.wikipedia.org/wiki/Tang_dynasty","approx":false,"ongoing":false},{"id":"p65-song","region":"china","start":960,"end":1279,"title":"Song dynasty","note":"Northern and Southern Song; other states ruled northern China after 1127.","reference":"https://en.wikipedia.org/wiki/Song_dynasty","approx":false,"ongoing":false},{"id":"p65-yuan","region":"china","start":1271,"end":1368,"title":"Yuan dynasty","note":"Dynastic title in 1271; conquest of Southern Song completed in 1279.","reference":"https://en.wikipedia.org/wiki/Yuan_dynasty","approx":false,"ongoing":false},{"id":"p65-ming","region":"china","start":1368,"end":1644,"title":"Ming dynasty","note":"Beijing fell in 1644; Southern Ming claimants continued afterwards.","reference":"https://en.wikipedia.org/wiki/Ming_dynasty","approx":false,"ongoing":false},{"id":"p65-qing","region":"china","start":1636,"end":1912,"title":"Qing dynasty","note":"Name proclaimed in 1636; Beijing taken in 1644; abdication in 1912. Museum period labels often begin at 1644.","reference":"https://en.wikipedia.org/wiki/Qing_dynasty","approx":false,"ongoing":false},{"id":"p65-kamakura","region":"japan","start":1185,"end":1333,"title":"Kamakura shogunate","note":"De facto establishment in 1185; shogunal title granted in 1192.","reference":"https://en.wikipedia.org/wiki/Kamakura_shogunate","approx":false,"ongoing":false},{"id":"p65-ashikaga","region":"japan","start":1336,"end":1573,"title":"Ashikaga shogunate","note":"Authority fragmented in the Sengoku era.","reference":"https://en.wikipedia.org/wiki/Ashikaga_shogunate","approx":false,"ongoing":false},{"id":"p65-tokugawa","region":"japan","start":1603,"end":1868,"title":"Tokugawa shogunate","note":"Shogunal appointment to Meiji Restoration.","reference":"https://en.wikipedia.org/wiki/Tokugawa_shogunate","approx":false,"ongoing":false},{"id":"p65-meiji","region":"japan","start":1868,"end":1912,"title":"Meiji era","note":"An imperial era, not the lifetime of the Japanese state.","reference":"https://en.wikipedia.org/wiki/Meiji_era","approx":false,"ongoing":false},{"id":"p65-maya","region":"americas","start":250,"end":900,"title":"Classic Maya city-states","note":"Approximate cultural period, not a unified empire; Maya societies continued after 900.","reference":"https://en.wikipedia.org/wiki/Maya_civilization","approx":true,"ongoing":false},{"id":"p65-aztec","region":"americas","start":1428,"end":1521,"title":"Aztec Triple Alliance","note":"Alliance of Tenochtitlan, Texcoco and Tlacopan; defeated in the Spanish conquest.","reference":"https://en.wikipedia.org/wiki/Aztec_Empire","approx":false,"ongoing":false},{"id":"p65-inca","region":"americas","start":1438,"end":1533,"title":"Inca Empire","note":"Conventional imperial phase; Neo-Inca resistance continued until 1572.","reference":"https://en.wikipedia.org/wiki/Inca_Empire","approx":true,"ongoing":false},{"id":"p65-new-spain","region":"americas","start":1535,"end":1821,"title":"Viceroyalty of New Spain","note":"Colonial administration; geographical extent changed.","reference":"https://en.wikipedia.org/wiki/New_Spain","approx":false,"ongoing":false},{"id":"p65-usa","region":"americas","start":1776,"end":2026,"title":"United States","note":"Independence declared in 1776; recognized in 1783. Ongoing state; 2026 is not an extinction date.","reference":"https://en.wikipedia.org/wiki/United_States","approx":false,"ongoing":true},{"id":"p65-brazil","region":"americas","start":1822,"end":1889,"title":"Empire of Brazil","note":"Independence to republican coup.","reference":"https://en.wikipedia.org/wiki/Empire_of_Brazil","approx":false,"ongoing":false},{"id":"p108-italy-republic","region":"italy","start":1946,"end":2026,"title":"Italian Republic","note":"The 1946 referendum replaced the monarchy. The republican Constitution entered into force in 1948; these are distinct milestones.","reference":"https://www.quirinale.it/it/pagine/simboli-repubblica-tricolore","approx":false,"ongoing":true,"revision108":true},{"id":"p108-france-vichy","region":"france","start":1940,"end":1944,"title":"Vichy regime / French State","note":"Vichy exercised authority under occupation and collaboration. Free France contested its legitimacy; this label does not describe unified control of all French territory.","reference":"https://www.economie.gouv.fr/saef/gouvernements-provisoires-republique-1944-1947","approx":false,"ongoing":false,"revision108":true},{"id":"p108-france-free","region":"france","start":1940,"end":1944,"title":"Free France and liberation authorities","note":"The Free French movement and subsequent liberation bodies opposed Vichy and Axis occupation. Their coexistence should not be read as two tidy national borders.","reference":"https://www.elysee.fr/charles-de-gaulle","approx":false,"ongoing":false,"revision108":true},{"id":"p108-france-provisional","region":"france","start":1944,"end":1946,"title":"Provisional Government of the French Republic","note":"The provisional government restored republican legality after liberation. The 1946 Constitution opened the Fourth Republic; transitional institutions continued into 1947.","reference":"https://www.assemblee-nationale.fr/dyn/histoire-et-patrimoine/deuxieme-guerre-mondiale/gouvernement-provisoire-de-la-republique-francaise-et-restauration-de-la-legalite-republicaine","approx":false,"ongoing":false,"revision108":true},{"id":"p108-france-fourth","region":"france","start":1946,"end":1958,"title":"Fourth French Republic","note":"A parliamentary republic under the Constitution of 27 October 1946. Its replacement in 1958 marks a constitutional change, not the creation of a new territory.","reference":"https://www.elysee.fr/la-presidence/les-textes-fondateurs","approx":false,"ongoing":false,"revision108":true},{"id":"p108-france-fifth","region":"france","start":1958,"end":2026,"title":"Fifth French Republic","note":"The Constitution of 1958 established the Fifth Republic. The regime is distinct from the changing presidents elected within it.","reference":"https://www.elysee.fr/la-presidence/les-textes-fondateurs","approx":false,"ongoing":true,"revision108":true},{"id":"p108-germany-weimar","region":"central","start":1918,"end":1933,"title":"Weimar Republic","note":"The monarchy fell in 1918; the Weimar Constitution followed in 1919. The name distinguishes the parliamentary era from both imperial and Nazi Germany.","reference":"https://www.bundestag.de/en/parliament/history/parliamentarism/weimar/weimar-200326","approx":false,"ongoing":false,"revision108":true},{"id":"p108-germany-nazi","region":"central","start":1933,"end":1945,"title":"Germany under Nazi dictatorship","note":"The Nazi dictatorship dismantled parliamentary democracy. Its territorial expansion and occupation policies cannot be represented by a fixed Central European border.","reference":"https://www.bundestag.de/en/parliament/history/parliamentarism/third_reich/third_reich-200358","approx":false,"ongoing":false,"revision108":true},{"id":"p108-germany-occupation","region":"central","start":1945,"end":1949,"title":"Allied-occupied Germany","note":"Germany was administered in occupation zones after defeat in 1945. Two German states were established in 1949.","reference":"https://www.bundestag.de/en/parliament/history/parliamentarism","approx":false,"ongoing":false,"revision108":true},{"id":"p108-germany-frg","region":"central","start":1949,"end":2026,"title":"Federal Republic of Germany","note":"Founded in 1949; German unity in 1990 extended the Federal Republic. Before 1990, the German Democratic Republic existed alongside it.","reference":"https://www.bundestag.de/en/parliament/history/parliamentarism","approx":false,"ongoing":true,"revision108":true},{"id":"p108-germany-gdr","region":"central","start":1949,"end":1990,"title":"German Democratic Republic","note":"The East German state existed alongside the Federal Republic until reunification in 1990. Shared dates here indicate coexistence, not equal territory.","reference":"https://www.bundestag.de/en/parliament/history/parliamentarism/gdr/gdr-200348","approx":false,"ongoing":false,"revision108":true},{"id":"p108-britain-commonwealth","region":"britain","start":1649,"end":1653,"title":"Commonwealth of England","note":"The monarchy and House of Lords were abolished in 1649. Parliamentary republican rule preceded the Protectorate.","reference":"https://www.parliament.uk/about/living-heritage/evolutionofparliament/parliamentaryauthority/civilwar/overview/","approx":false,"ongoing":false,"revision108":true},{"id":"p108-britain-protectorate","region":"britain","start":1653,"end":1659,"title":"Protectorate of England, Scotland and Ireland","note":"Oliver Cromwell and then Richard Cromwell served as Lord Protector. The Protectorate was part of the wider Interregnum, not a royal dynasty.","reference":"https://www.royal.uk/interregnum-1649-1660","approx":false,"ongoing":false,"revision108":true},{"id":"p108-britain-commonwealth-restored","region":"britain","start":1659,"end":1660,"title":"Restored Commonwealth","note":"The Commonwealth was briefly restored after the Protectorate. The monarchy returned under Charles II in 1660.","reference":"https://www.parliament.uk/about/living-heritage/evolutionofparliament/parliamentaryauthority/civilwar/overview/","approx":false,"ongoing":false,"revision108":true},{"id":"p108-england-restored","region":"britain","start":1660,"end":1707,"title":"Restored Kingdom of England","note":"The Restoration ended the Interregnum. England and Scotland remained distinct kingdoms until the Acts of Union of 1707.","reference":"https://www.parliament.uk/about/living-heritage/evolutionofparliament/parliamentaryauthority/civilwar/overview/","approx":false,"ongoing":false,"revision108":true},{"id":"p108-scotland-restored","region":"britain","start":1660,"end":1707,"title":"Restored Kingdom of Scotland","note":"Scotland's separate institutions were restored in 1660. The political union with England followed in 1707.","reference":"https://www.parliament.uk/about/living-heritage/evolutionofparliament/legislativescrutiny/act-of-union-1707/","approx":false,"ongoing":false,"revision108":true},{"id":"p108-netherlands-kingdom","region":"low","start":1815,"end":2026,"title":"Kingdom of the Netherlands","note":"The kingdom established in 1815 initially included the southern provinces. Belgian secession in 1830 and recognition in 1839 changed its territorial extent.","reference":"https://www.royal-house.nl/topics/history/history-of-the-kingdom-of-the-netherlands","approx":false,"ongoing":true,"revision108":true},{"id":"p108-belgium-kingdom","region":"low","start":1830,"end":2026,"title":"Kingdom of Belgium","note":"Belgium separated from the Netherlands in 1830. Recognition by the Netherlands in 1839 is a later milestone.","reference":"https://www.royal-house.nl/topics/history/history-of-the-kingdom-of-the-netherlands","approx":false,"ongoing":true,"revision108":true},{"id":"p108-russia-provisional","region":"eastern","start":1917,"end":1917,"title":"Russian Provisional Government","note":"Between the fall of the monarchy and the Bolshevik seizure of power in 1917. With year-level dating, several competing authorities appear in the same year.","reference":"https://history.state.gov/historicaldocuments/frus1918Russiav01/papers","approx":false,"ongoing":false,"revision108":true},{"id":"p108-russia-soviet","region":"eastern","start":1917,"end":1922,"title":"Soviet Russia: early revolutionary period","note":"Bolshevik rule emerged during revolution and civil war. The Russian Soviet republic was not yet identical to the later multinational Soviet Union.","reference":"https://history.state.gov/milestones/1914-1920/bullitt-mission","approx":false,"ongoing":false,"revision108":true},{"id":"p108-ussr","region":"eastern","start":1922,"end":1991,"title":"Union of Soviet Socialist Republics","note":"A union of Soviet republics, not simply a renamed Russian Empire. The union dissolved in 1991.","reference":"https://history.state.gov/milestones/1989-1992/collapse-soviet-union","approx":false,"ongoing":false,"revision108":true},{"id":"p108-russia-federation","region":"eastern","start":1991,"end":2026,"title":"Russian Federation: post-Soviet period","note":"This span marks the post-Soviet period. Other former Soviet republics became independent states; this regional column does not imply that they are part of Russia.","reference":"https://history.state.gov/milestones/1989-1992/collapse-soviet-union","approx":false,"ongoing":true,"revision108":true},{"id":"p108-batavian","region":"low","start":1795,"end":1806,"title":"Batavian Republic","note":"A republic established under French influence, followed by the Kingdom of Holland. The Dutch Republic before 1795 had a different political structure.","reference":"https://www.royal-house.nl/topics/history/history-of-the-kingdom-of-the-netherlands","approx":false,"ongoing":false,"revision108":true},{"id":"p108-holland","region":"low","start":1806,"end":1810,"title":"Kingdom of Holland","note":"Louis Napoleon ruled the kingdom before its incorporation into the French Empire in 1810.","reference":"https://www.royal-house.nl/topics/history/kings-and-queens","approx":false,"ongoing":false,"revision108":true},{"id":"p108-netherlands-annexed","region":"low","start":1810,"end":1813,"title":"Netherlands within the French Empire","note":"This is a period of annexation, not an independent Dutch kingdom.","reference":"https://www.royal-house.nl/topics/history/kings-and-queens","approx":false,"ongoing":false,"revision108":true},{"id":"p108-netherlands-principality","region":"low","start":1813,"end":1815,"title":"Sovereign Principality of the United Netherlands","note":"Independence was restored under a sovereign prince before the kingdom was proclaimed in 1815.","reference":"https://www.royal-house.nl/topics/history/history-of-the-kingdom-of-the-netherlands","approx":false,"ongoing":false,"revision108":true},{"id":"p108-turkey","region":"eastmed","start":1923,"end":2026,"title":"Republic of Turkey / Türkiye","note":"The republic was proclaimed in 1923 following the end of the Ottoman sultanate. It represents one state in this broader regional column.","reference":"https://www.mfa.gov.tr/message-of-president-erdogan-on-the-republic-day.en.mfa","approx":false,"ongoing":true,"revision108":true},{"id":"p108-roc-mainland","region":"china","start":1912,"end":1949,"title":"Republic of China: mainland period","note":"The republic followed the Qing dynasty, but central control was fragmented. The 1949 boundary marks the government’s move to Taiwan, not the disappearance of the Republic of China.","reference":"https://history.state.gov/milestones/1899-1913/chinese-rev","approx":false,"ongoing":false,"revision108":true},{"id":"p108-prc","region":"china","start":1949,"end":2026,"title":"People’s Republic of China","note":"The PRC was proclaimed in 1949 on the mainland. This political chronology does not resolve territorial claims.","reference":"https://history.state.gov/milestones/1945-1952/chinese-rev","approx":false,"ongoing":true,"revision108":true},{"id":"p108-roc-taiwan","region":"china","start":1949,"end":2026,"title":"Republic of China government on Taiwan","note":"The Republic of China government relocated to Taiwan in 1949. It is shown alongside the PRC to avoid erasing the distinct political chronology.","reference":"https://history.state.gov/milestones/1945-1952/chinese-rev","approx":false,"ongoing":true,"revision108":true}],"transitions":[{"source":"p65-roman-kings","target":"p65-roman-republic","year":-509,"label":"Traditional republican transition","kind":"transition"},{"source":"p65-roman-republic","target":"p65-roman-empire","year":-27,"label":"Augustan settlement","kind":"transition"},{"source":"p65-roman-empire","target":"p65-west-rome","year":395,"label":"Western imperial court","kind":"division"},{"source":"p65-roman-empire","target":"p65-byzantine","year":395,"label":"Eastern imperial court","kind":"division"},{"source":"p65-west-rome","target":"p65-odoacer","year":476,"label":"Deposition in Italy","kind":"conquest"},{"source":"p65-odoacer","target":"p65-ostrogoths","year":493,"label":"Theodoric defeats Odoacer","kind":"conquest"},{"source":"p65-lombards","target":"p65-carolingian","year":774,"label":"Charlemagne conquers Lombard kingdom","kind":"conquest"},{"source":"p65-merovingian","target":"p65-carolingian","year":751,"label":"Pippin becomes king","kind":"transition"},{"source":"p65-carolingian","target":"p65-west-francia","year":843,"label":"Verdun: western kingdom","kind":"division"},{"source":"p65-carolingian","target":"p65-middle-francia","year":843,"label":"Verdun: middle kingdom","kind":"division"},{"source":"p65-carolingian","target":"p65-east-francia","year":843,"label":"Verdun: eastern kingdom","kind":"division"},{"source":"p65-west-francia","target":"p65-france-monarchy","year":987,"label":"Capetian accession","kind":"transition"},{"source":"p65-france-monarchy","target":"p65-france-republic","year":1792,"label":"Monarchy abolished","kind":"transition"},{"source":"p65-france-republic","target":"p65-france-empire","year":1804,"label":"Empire proclaimed","kind":"transition"},{"source":"p65-france-empire","target":"p65-france-restoration","year":1814,"label":"Bourbon restoration","kind":"transition"},{"source":"p65-france-restoration","target":"p65-france-july","year":1830,"label":"July Revolution","kind":"transition"},{"source":"p65-france-july","target":"p65-france-second-republic","year":1848,"label":"February Revolution","kind":"transition"},{"source":"p65-france-second-republic","target":"p65-france-second-empire","year":1852,"label":"Empire proclaimed","kind":"transition"},{"source":"p65-france-second-empire","target":"p65-france-third","year":1870,"label":"Republic proclaimed","kind":"transition"},{"source":"p65-cordoba-emirate","target":"p65-cordoba-caliphate","year":929,"label":"Caliphal title adopted","kind":"transition"},{"source":"p65-england","target":"p65-britain","year":1707,"label":"Acts of Union","kind":"union"},{"source":"p65-scotland","target":"p65-britain","year":1707,"label":"Acts of Union","kind":"union"},{"source":"p65-britain","target":"p65-uk","year":1801,"label":"Union with Ireland","kind":"union"},{"source":"p65-east-francia","target":"p65-hre","year":962,"label":"Otto I crowned emperor","kind":"transition"},{"source":"p65-austria","target":"p65-austria-hungary","year":1867,"label":"Austro-Hungarian Compromise","kind":"transition"},{"source":"p65-prussia","target":"p65-german-empire","year":1871,"label":"Prussian-led unification; Prussia continues","kind":"union"},{"source":"p65-muscovy","target":"p65-russia-tsar","year":1547,"label":"Ivan IV crowned tsar","kind":"transition"},{"source":"p65-russia-tsar","target":"p65-russia-empire","year":1721,"label":"Imperial title adopted","kind":"transition"},{"source":"p65-byzantine","target":"p65-nicaea","year":1204,"label":"Byzantine successor state","kind":"division"},{"source":"p65-byzantine","target":"p65-latin","year":1204,"label":"Crusader capture of Constantinople","kind":"conquest"},{"source":"p65-nicaea","target":"p65-byzantine-restored","year":1261,"label":"Constantinople recovered","kind":"transition"},{"source":"p65-latin","target":"p65-byzantine-restored","year":1261,"label":"End of Latin rule in Constantinople","kind":"conquest"},{"source":"p65-byzantine-restored","target":"p65-ottoman","year":1453,"label":"Conquest of Constantinople; Ottoman state predates it","kind":"conquest"},{"source":"p65-babylon","target":"p65-achaemenid","year":-539,"label":"Cyrus conquers Babylon","kind":"conquest"},{"source":"p65-parthia","target":"p65-sasanian","year":224,"label":"Ardashir defeats Artabanus","kind":"conquest"},{"source":"p65-rashidun","target":"p65-umayyad","year":661,"label":"Umayyad accession","kind":"transition"},{"source":"p65-umayyad","target":"p65-abbasid","year":750,"label":"Abbasid Revolution","kind":"conquest"},{"source":"p65-abbasid","target":"p65-ilkhanate","year":1258,"label":"Mongol sack of Baghdad","kind":"conquest"},{"source":"p65-mongol","target":"p65-ilkhanate","year":1256,"label":"Hulagu's western state","kind":"division"},{"source":"p65-fatimid","target":"p65-ayyubid","year":1171,"label":"Saladin ends Fatimid rule in Egypt","kind":"transition"},{"source":"p65-ayyubid","target":"p65-mamluk","year":1250,"label":"Mamluk rule begins in Egypt","kind":"transition"},{"source":"p65-mamluk","target":"p65-ottoman","year":1517,"label":"Ottoman conquest of Egypt","kind":"conquest"},{"source":"p65-delhi","target":"p65-mughal-first","year":1526,"label":"First Battle of Panipat","kind":"conquest"},{"source":"p65-mughal-first","target":"p65-sur","year":1540,"label":"Humayun defeated","kind":"conquest"},{"source":"p65-sur","target":"p65-mughal","year":1555,"label":"Mughal restoration","kind":"conquest"},{"source":"p65-western-han","target":"p65-xin","year":9,"label":"Wang Mang's usurpation","kind":"transition"},{"source":"p65-sui","target":"p65-tang","year":618,"label":"Tang foundation","kind":"transition"},{"source":"p65-song","target":"p65-yuan","year":1279,"label":"Mongol conquest of Southern Song","kind":"conquest"},{"source":"p65-yuan","target":"p65-ming","year":1368,"label":"Ming capture of Dadu","kind":"conquest"},{"source":"p65-ming","target":"p65-qing","year":1644,"label":"Qing entry into Beijing; not conquest of all Ming territories","kind":"conquest"},{"source":"p65-tokugawa","target":"p65-meiji","year":1868,"label":"Meiji Restoration","kind":"transition"}],"regions":[{"id":"italy","title":"Italy & Rome","color":"#aa5d4c"},{"id":"france","title":"France & Franks","color":"#547d99"},{"id":"iberia","title":"Iberia","color":"#a48339"},{"id":"britain","title":"Britain","color":"#88739d"},{"id":"central","title":"Central Europe","color":"#687e6b"},{"id":"eastern","title":"Eastern Europe","color":"#8f7660"},{"id":"eastmed","title":"East Mediterranean","color":"#448b91"},{"id":"westasia","title":"West & Central Asia","color":"#b9824a"},{"id":"africa","title":"Egypt & Africa","color":"#937c35"},{"id":"southasia","title":"South Asia","color":"#bd737a"},{"id":"china","title":"China","color":"#a86165"},{"id":"japan","title":"Japan","color":"#8379a3"},{"id":"americas","title":"Americas","color":"#559083"},{"id":"southeastasia","title":"Southeast Asia","color":"#708e59"},{"id":"oceania","title":"Oceania","color":"#4e9296"},{"id":"low","title":"Low Countries","color":"#ae8546"}],"worldCoverage":{"end":1900,"note":"Selected political and cultural histories to 1900. Regional columns are reading guides, not fixed borders. Blank areas indicate gaps in this selection, not an absence of societies. Survival lines show political or cultural duration, never territory or power.","references":["https://www.metmuseum.org/essays/byzantium-ca-330-1453","https://www.metmuseum.org/toah/ht/08/ssa.html","https://www.metmuseum.org/toah/ht/07/eac.html","https://www.metmuseum.org/essays/han-dynasty-206-b-c-220-a-d"]},"chapters66":[{"id":"chapter66-0","start":-30000,"end":-3000,"title":"Before states","note":"Settlement, ritual and the first visual cultures precede the territorial states below.","centres":[{"key":"Early communities","title":"Europe and the Mediterranean","note":"Material evidence, not a single state"}]},{"id":"chapter66-1","start":-3000,"end":-800,"title":"Cities and kingdoms","note":"Egyptian and Near Eastern state formation provides the wider setting for Aegean cultures.","centres":[{"key":"Egypt","title":"Nile kingdoms","note":"Monumental religious and royal building"},{"key":"Mesopotamia","title":"Cities and empires","note":"Urban institutions and writing"},{"key":"Aegean","title":"Minoan and Mycenaean worlds","note":"Palatial centres and Mediterranean exchange"}]},{"id":"chapter66-2","start":-800,"end":-323,"title":"The Greek world","note":"Independent Greek cities coexist and compete; Persia and then Macedon reshape the balance.","centres":[{"key":"Greek cities","title":"Athens and Sparta","note":"Different political and cultural centres"},{"key":"Persia","title":"Achaemenid empire","note":"Imperial neighbour and opponent"},{"key":"Macedon","title":"Philip II and Alexander","note":"Fourth-century expansion"}]},{"id":"chapter66-3","start":-323,"end":-27,"title":"Hellenistic kingdoms → Rome","note":"Alexander's empire fragments; Rome expands through Mediterranean wars.","centres":[{"key":"Hellenistic kingdoms","title":"Successor courts","note":"Greek culture across a wider world"},{"key":"p65-roman-republic","title":"Rome","note":"Republican expansion"}]},{"id":"chapter66-4","start":-27,"end":395,"title":"The Roman Mediterranean","note":"Imperial government and roads connect a large Mediterranean world; Christianity develops within it.","centres":[{"key":"p65-roman-empire","title":"Roman Empire","note":"Political and architectural centre"},{"key":"Eastern neighbours","title":"Parthia and Sasanian Persia","note":"Rivals beyond Rome's eastern frontier"}]},{"id":"chapter66-5","start":395,"end":632,"title":"A divided Roman inheritance","note":"Western imperial rule ends while the eastern court continues; kingdoms transform the western landscape.","centres":[{"key":"Western kingdoms","title":"Italy and the Franks","note":"New political centres"},{"key":"p65-byzantine","title":"Eastern Roman Empire","note":"Constantinople and Justinian"},{"key":"Christian institutions","title":"Rome and monasteries","note":"Religious and cultural continuity"}]},{"id":"chapter66-6","start":632,"end":800,"title":"Caliphates and the Franks","note":"Islamic expansion transforms the Mediterranean; Frankish rulers consolidate power in the west.","centres":[{"key":"Franks","title":"Merovingians → Carolingians","note":"Western consolidation"},{"key":"p65-byzantine","title":"Constantinople","note":"Eastern imperial continuity"},{"key":"Caliphates","title":"Umayyads → Abbasids","note":"New political and intellectual centres"}]},{"id":"chapter66-7","start":800,"end":1000,"title":"From empire to kingdoms","note":"Charlemagne's imperial project is followed by partitions; western and eastern kingdoms develop.","centres":[{"key":"Frankish successors","title":"West, Middle and East Francia","note":"Verdun and later partitions"},{"key":"p65-byzantine","title":"Eastern Roman Empire","note":"A separate imperial tradition"},{"key":"Northern kingdoms","title":"England and Scandinavia","note":"Consolidation and exchange"}]},{"id":"chapter66-8","start":1000,"end":1204,"title":"Kings, emperors and the Church","note":"Papacy, empire and monarchies compete; crusades and expanding towns connect societies.","centres":[{"key":"Empire and papacy","title":"Central Europe and Italy","note":"Competing claims to authority"},{"key":"Western monarchies","title":"France and England","note":"Growing royal institutions"},{"key":"p65-byzantine","title":"Byzantium and the eastern Mediterranean","note":"Crusading encounters"}]},{"id":"chapter66-9","start":1204,"end":1300,"title":"Cities, courts and trade","note":"Mediterranean networks and urban patronage grow alongside kingdoms and religious institutions.","centres":[{"key":"Italian cities","title":"Communes and merchants","note":"Trade and civic building"},{"key":"p65-france-monarchy","title":"France","note":"Royal power and Gothic centres"},{"key":"Eastern Mediterranean","title":"Byzantine successor states","note":"After the Fourth Crusade"}]},{"id":"chapter66-10","start":1300,"end":1400,"title":"Crisis and renewal","note":"Plague, war and church disputes reshape society; Italian urban cultures remain major artistic centres.","centres":[{"key":"Italian cities","title":"Florence and Siena","note":"Civic and religious patronage"},{"key":"France and England","title":"Hundred Years' War","note":"Dynastic conflict"},{"key":"p65-ottoman","title":"Ottoman expansion","note":"A rising southeastern power"}]},{"id":"chapter66-11","start":1400,"end":1494,"title":"Italian Renaissance centres","note":"Florence, Rome and Venice develop different forms of patronage; western monarchies consolidate.","centres":[{"key":"p65-florence","title":"Florence","note":"Medici networks and humanism"},{"key":"p65-papal","title":"Rome","note":"Renewed papal patronage"},{"key":"p65-venice","title":"Venice","note":"Maritime trade and painting"}]},{"id":"chapter66-12","start":1494,"end":1517,"title":"Italy in a wider struggle","note":"French and Spanish intervention in Italy overlaps with major Renaissance commissions and Atlantic expansion.","centres":[{"key":"Italian courts","title":"Rome, Florence and Venice","note":"Cultural centres under pressure"},{"key":"France and Spain","title":"Wars in Italy","note":"Competing monarchies"},{"key":"Portugal and Spain","title":"Atlantic routes","note":"Expansion beyond Europe"}]},{"id":"chapter66-13","start":1517,"end":1600,"title":"Reformation and rival empires","note":"Religious division and Catholic reform intersect with Habsburg, French and Ottoman competition.","centres":[{"key":"Habsburg realms","title":"Spain and the Empire","note":"Dynastic power across territories"},{"key":"p65-france-monarchy","title":"France","note":"Monarchy and religious conflict"},{"key":"p65-ottoman","title":"Ottoman Empire","note":"Mediterranean and southeastern rivalry"}]},{"id":"chapter66-14","start":1600,"end":1648,"title":"Baroque Europe at war","note":"Rome is a major centre of Baroque patronage while the Thirty Years' War transforms European politics.","centres":[{"key":"p65-papal","title":"Rome","note":"Baroque patronage"},{"key":"Habsburg and French realms","title":"Continental rivalry","note":"War and diplomacy"},{"key":"Dutch Republic","title":"Trade and urban culture","note":"A distinct patronage environment"}]},{"id":"chapter66-15","start":1648,"end":1715,"title":"Courts and commercial powers","note":"French court culture, Dutch commerce and English political change coexist in a contested European balance.","centres":[{"key":"p65-france-monarchy","title":"France","note":"Louis XIV and Versailles"},{"key":"Dutch Republic","title":"Maritime commerce","note":"Cities, markets and art"},{"key":"p65-england","title":"England → Britain","note":"Constitutional and commercial change"}]},{"id":"chapter66-16","start":1715,"end":1789,"title":"Enlightenment and global rivalry","note":"Britain and France compete overseas; Austria, Prussia and Russia are important continental powers.","centres":[{"key":"Britain and France","title":"Commerce and empire","note":"Global rivalry"},{"key":"Austria and Prussia","title":"Central Europe","note":"Dynastic and military competition"},{"key":"p65-russia-empire","title":"Russia","note":"A major eastern power"}]},{"id":"chapter66-17","start":1789,"end":1815,"title":"Revolution and Napoleon","note":"Revolutionary politics and Napoleonic wars transform institutions, borders and artistic subject matter.","centres":[{"key":"Revolutionary France","title":"Republic → Empire","note":"Political rupture and expansion"},{"key":"Coalitions","title":"Britain, Austria, Prussia and Russia","note":"Changing alliances"},{"key":"Italian states","title":"Reform and occupation","note":"Revolutionary and imperial transformations"}]},{"id":"chapter66-18","start":1815,"end":1848,"title":"Restoration and new movements","note":"The Vienna settlement meets liberal and national movements; industry changes society and patronage.","centres":[{"key":"Continental courts","title":"Austria, Russia and Prussia","note":"Restoration and diplomacy"},{"key":"Britain and France","title":"Industry and political change","note":"Different paths of reform"},{"key":"Italy and Greece","title":"National movements","note":"Challenges to the settlement"}]},{"id":"chapter66-19","start":1848,"end":1871,"title":"Revolution and unification","note":"Revolutions and later state-building reshape Italy and Germany; Realism examines contemporary society.","centres":[{"key":"Italian states → Italy","title":"Risorgimento","note":"Political unification"},{"key":"Prussia and German states","title":"German unification","note":"Changing central European balance"},{"key":"France and Britain","title":"Empire and industry","note":"Major political and cultural centres"}]},{"id":"chapter66-20","start":1871,"end":1900,"title":"Industrial and imperial Europe","note":"The united German Empire joins the established powers; urban growth and empire frame later nineteenth-century culture.","centres":[{"key":"p65-german-empire","title":"German Empire","note":"A new unified major power"},{"key":"Britain and France","title":"Industry and empire","note":"Global and cultural influence"},{"key":"p65-italy","title":"Kingdom of Italy","note":"A new national framework"}]},{"id":"chapter68-0","start":1900,"end":1914,"title":"Modernity and rival empires","note":"Industrial change, colonial competition and artistic experiments share this period without a single common cause.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]},{"id":"chapter68-1","start":1914,"end":1919,"title":"World war and revolution","note":"War transforms states, societies and artistic networks.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]},{"id":"chapter68-2","start":1919,"end":1933,"title":"New societies, unstable peace","note":"Democratic experiments, dictatorships and modern design coexist.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]},{"id":"chapter68-3","start":1933,"end":1945,"title":"Dictatorship and global war","note":"Repression, genocide and war reshape European society and culture.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]},{"id":"chapter68-4","start":1945,"end":1960,"title":"Reconstruction and divided Europe","note":"Cold War confrontation develops alongside reconstruction, decolonisation and European cooperation.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]},{"id":"chapter68-5","start":1960,"end":1989,"title":"Cold War, protest and new art","note":"Consumer society, civil-rights struggles, decolonisation and experimental art develop unevenly.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]},{"id":"chapter68-6","start":1989,"end":2012,"title":"European integration and a changing world","note":"The end of the Cold War is followed by European integration and new global crises.","centres":[{"key":"Europe","title":"European contexts","note":"Follow country threads and the explicit relationships between entries."},{"key":"International","title":"International setting","note":"Wider-world events provide context for European developments."}]}],"focusNotes66":"Europe-centred editorial reading periods, not quantitative power rankings. Three illustrative centres per period are not an exhaustive list; chapter boundaries are not the foundation or extinction dates of states. Original dated polity records remain available in details.","import68":{"added":378,"merged":15,"addedImages":9,"unresolvedTitles":["Horse and Rider","Seated Woman","Spatial Construction: series","Composition VII","Composition with Red, Blue and Yellow","The Houses of Parliament on Fire","Blue monochromes: series","Spatial Concept, Expectations: series"],"sourceSheets":[3643,3644,3645,3646,3647,3648],"endYear":2011},"import69":{"concepts":104,"links":104,"unmatched":[]},"styles71":[{"id":"style71-0","title":"Prehistoric art","kind":"art","start":-30000,"end":-3000,"note":"Cave images, portable sculpture and ritual objects; dates vary greatly by region.","colour":"#c38b65","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"other","start":-30000,"peak":-15000,"end":-3000},{"region":"france","start":-30000,"peak":-15000,"end":-8000},{"region":"iberia","start":-30000,"peak":-15000,"end":-8000}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-1","title":"Ancient Egyptian","kind":"both","start":-3100,"end":-30,"note":"Long-lived traditions with major changes across kingdoms and dynasties.","colour":"#a980a8","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"other","start":-3100,"peak":-1400,"end":-30}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-2","title":"Mesopotamian","kind":"both","start":-3500,"end":-539,"note":"Sumerian, Akkadian, Babylonian and Assyrian traditions are not one uniform style.","colour":"#8caa83","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"other","start":-3500,"peak":-1800,"end":-539}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-3","title":"Minoan & Mycenaean","kind":"both","start":-2000,"end":-1100,"note":"Aegean palace cultures; distinguish Minoan frescoes from Mycenaean citadels.","colour":"#719caf","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"eastmed","start":-2000,"peak":-1500,"end":-1100}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-4","title":"Archaic Greek","kind":"both","start":-700,"end":-480,"note":"Kouroi, korai and developing temple orders.","colour":"#bb9a55","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"eastmed","start":-700,"peak":-550,"end":-480},{"region":"italy","start":-650,"peak":-530,"end":-480}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-5","title":"Classical Greek","kind":"both","start":-480,"end":-323,"note":"Classical sculpture and temples; several phases coexist.","colour":"#b37d89","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"eastmed","start":-480,"peak":-420,"end":-323},{"region":"italy","start":-480,"peak":-400,"end":-323}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-6","title":"Hellenistic","kind":"both","start":-323,"end":-31,"note":"Expressive bodies, spatial drama and diverse regional traditions.","colour":"#649c96","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"eastmed","start":-323,"peak":-180,"end":-31},{"region":"other","start":-300,"peak":-150,"end":-31},{"region":"italy","start":-250,"peak":-100,"end":-31}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-7","title":"Etruscan","kind":"both","start":-800,"end":-100,"note":"Tombs, terracotta and temple traditions of pre-Roman Italy.","colour":"#938abc","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":-800,"peak":-500,"end":-100}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-8","title":"Roman","kind":"both","start":-500,"end":400,"note":"Republican and imperial practices; arches, vaults, concrete and portraiture.","colour":"#c38b65","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":-500,"peak":100,"end":400},{"region":"france","start":-50,"peak":150,"end":400},{"region":"iberia","start":-150,"peak":100,"end":400},{"region":"britain","start":43,"peak":180,"end":400},{"region":"eastmed","start":-100,"peak":200,"end":400},{"region":"other","start":-100,"peak":150,"end":400}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-9","title":"Early Christian","kind":"both","start":200,"end":600,"note":"Christian imagery and basilicas develop within the late Roman world.","colour":"#a980a8","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":200,"peak":400,"end":600},{"region":"eastmed","start":250,"peak":450,"end":600},{"region":"other","start":250,"peak":450,"end":600}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-10","title":"Byzantine","kind":"both","start":330,"end":1453,"note":"Icons, mosaics and domed sacred space; distinguish early, middle and late phases.","colour":"#8caa83","reference":"https://www.metmuseum.org/essays/byzantium-ca-330-1453","approx":true,"regions72":[{"region":"eastmed","start":330,"peak":1000,"end":1453},{"region":"italy","start":450,"peak":550,"end":800},{"region":"italy","start":1000,"peak":1150,"end":1300},{"region":"other","start":900,"peak":1200,"end":1453}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-11","title":"Carolingian & Ottonian","kind":"both","start":750,"end":1050,"note":"Medieval revivals of imperial imagery, architecture and manuscript traditions.","colour":"#719caf","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"france","start":750,"peak":820,"end":920},{"region":"central","start":780,"peak":980,"end":1050},{"region":"italy","start":800,"peak":950,"end":1050}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-12","title":"Romanesque","kind":"both","start":1000,"end":1200,"note":"Round arches, vaults, sculpture and pilgrimage churches; regional dates differ.","colour":"#bb9a55","reference":"https://www.metmuseum.org/essays/romanesque-art","approx":true,"regions72":[{"region":"france","start":1000,"peak":1100,"end":1200},{"region":"italy","start":1000,"peak":1120,"end":1200},{"region":"central","start":1000,"peak":1120,"end":1200},{"region":"iberia","start":1030,"peak":1130,"end":1200},{"region":"britain","start":1066,"peak":1130,"end":1200}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-13","title":"Gothic","kind":"both","start":1140,"end":1550,"note":"Pointed arches, ribs, buttresses and stained glass; survives alongside Renaissance forms.","colour":"#b37d89","reference":"https://www.metmuseum.org/essays/gothic-art","approx":true,"regions72":[{"region":"france","start":1140,"peak":1250,"end":1500},{"region":"britain","start":1175,"peak":1300,"end":1550},{"region":"central","start":1200,"peak":1350,"end":1550},{"region":"iberia","start":1200,"peak":1400,"end":1550},{"region":"italy","start":1220,"peak":1350,"end":1500},{"region":"low","start":1220,"peak":1400,"end":1550}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-14","title":"Italian Trecento","kind":"art","start":1250,"end":1400,"note":"Cimabue, Giotto and the Sienese painters; a bridge with medieval traditions.","colour":"#649c96","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":1250,"peak":1330,"end":1400}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-15","title":"Early Renaissance","kind":"both","start":1400,"end":1490,"note":"Perspective, classical forms and new approaches to the human figure in Italy.","colour":"#938abc","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":1400,"peak":1450,"end":1490}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-16","title":"High Renaissance","kind":"both","start":1490,"end":1527,"note":"Leonardo, Raphael, Michelangelo and Bramante; dates are a study convention.","colour":"#c38b65","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":1490,"peak":1510,"end":1527}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-17","title":"Northern Renaissance","kind":"art","start":1400,"end":1600,"note":"Netherlandish and German developments overlap Italian Renaissance traditions.","colour":"#a980a8","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"low","start":1400,"peak":1460,"end":1600},{"region":"central","start":1450,"peak":1520,"end":1600},{"region":"france","start":1490,"peak":1540,"end":1600},{"region":"britain","start":1520,"peak":1550,"end":1600}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-18","title":"Mannerism","kind":"both","start":1520,"end":1600,"note":"Elongation, tension, artifice and experiments with classical rules.","colour":"#8caa83","reference":"https://www.metmuseum.org/essays/mannerism-bronzino-1503-1572-and-his-contemporaries","approx":true,"regions72":[{"region":"italy","start":1520,"peak":1550,"end":1600},{"region":"france","start":1530,"peak":1560,"end":1600},{"region":"central","start":1560,"peak":1590,"end":1600},{"region":"iberia","start":1570,"peak":1590,"end":1600}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-19","title":"Baroque","kind":"both","start":1600,"end":1750,"note":"Theatrical space, movement and varied religious and secular patronage.","colour":"#719caf","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"italy","start":1600,"peak":1650,"end":1750},{"region":"low","start":1600,"peak":1640,"end":1700},{"region":"iberia","start":1600,"peak":1650,"end":1750},{"region":"france","start":1620,"peak":1680,"end":1750},{"region":"central","start":1650,"peak":1720,"end":1750},{"region":"britain","start":1660,"peak":1710,"end":1750}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-20","title":"Rococo","kind":"both","start":1700,"end":1780,"note":"Ornamental interiors, lightness and courtly painting; uneven regional adoption.","colour":"#bb9a55","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"france","start":1700,"peak":1730,"end":1780},{"region":"central","start":1720,"peak":1750,"end":1780},{"region":"italy","start":1720,"peak":1750,"end":1780}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-21","title":"Neoclassicism","kind":"both","start":1750,"end":1850,"note":"Renewed engagement with antiquity, archaeology and classical order.","colour":"#b37d89","reference":"https://www.metmuseum.org/essays/neoclassicism","approx":true,"regions72":[{"region":"italy","start":1750,"peak":1780,"end":1850},{"region":"france","start":1760,"peak":1800,"end":1850},{"region":"britain","start":1750,"peak":1800,"end":1850},{"region":"central","start":1770,"peak":1820,"end":1850},{"region":"other","start":1780,"peak":1820,"end":1850}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-22","title":"Romanticism","kind":"art","start":1780,"end":1850,"note":"Imagination, emotion, landscape and the sublime; overlaps Neoclassicism.","colour":"#649c96","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"britain","start":1780,"peak":1820,"end":1850},{"region":"central","start":1780,"peak":1810,"end":1850},{"region":"france","start":1800,"peak":1830,"end":1850},{"region":"iberia","start":1790,"peak":1820,"end":1850}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-23","title":"Gothic Revival","kind":"architecture","start":1740,"end":1900,"note":"A later revival, not the medieval Gothic period.","colour":"#938abc","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"britain","start":1740,"peak":1850,"end":1900},{"region":"france","start":1820,"peak":1860,"end":1900},{"region":"central","start":1800,"peak":1850,"end":1900},{"region":"other","start":1830,"peak":1870,"end":1900}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-24","title":"Realism","kind":"art","start":1840,"end":1880,"note":"Modern life and ordinary subjects; avoid confusing movement and generic realism.","colour":"#c38b65","reference":"https://www.metmuseum.org/toah/","approx":true,"regions72":[{"region":"france","start":1840,"peak":1855,"end":1880},{"region":"italy","start":1850,"peak":1865,"end":1880},{"region":"other","start":1850,"peak":1870,"end":1880}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-25","title":"Pre-Raphaelites","kind":"art","start":1848,"end":1900,"note":"British detail, colour and literary or medieval subjects.","colour":"#a980a8","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"britain","start":1848,"peak":1860,"end":1900}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-26","title":"Impressionism","kind":"art","start":1860,"end":1890,"note":"Light, modern life and independent exhibitions; individual careers extend further.","colour":"#8caa83","