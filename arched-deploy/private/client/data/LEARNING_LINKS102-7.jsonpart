ntrance","built":"c. 1632–1653","era":"c. 1632–1653","period103":"baroque","kinds103":["architecture"],"styles103":["Mughal"],"entityId":"LE106-WORLD106-02","photo":null,"mapIds":["WORLD106-02"],"start106":1632,"end106":1653,"photoLookup108":{"title":"Taj Mahal"}},{"id":"WORLD106-03","title":"Borobudur","kind":"architecture","reference":"https://whc.unesco.org/en/list/592/","country":"Indonesia","city":"Central Java","lat":-7.608,"lon":110.204,"style":"Buddhist; Syailendra","note":"A Buddhist monument with square terraces below circular platforms and a crowning stupa. The ascending route organizes reliefs and repeated stupas into a spatial sequence.","coordinateSource":"https://whc.unesco.org/en/list/592/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 750–850","era":"c. 750–850","period103":"medieval","kinds103":["architecture"],"styles103":["Buddhist; Syailendra"],"entityId":"LE106-WORLD106-03","photo":null,"mapIds":["WORLD106-03"],"start106":750,"end106":850,"photoLookup108":{"title":"Borobudur"}},{"id":"WORLD106-04","title":"Petra","kind":"archaeology","reference":"https://whc.unesco.org/en/list/326/","country":"Jordan","city":"Wadi Musa","lat":30.329,"lon":35.444,"style":"Nabataean; Hellenistic influences","note":"Nabataean Petra combined caravan commerce, rock-cut architecture and careful water management. Carved facades do not mean that every part of the city was cut into rock.","coordinateSource":"https://whc.unesco.org/en/list/326/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 300 BCE–100","era":"c. 300 BCE–100","period103":"ancient","kinds103":["archaeology"],"styles103":["Nabataean; Hellenistic influences"],"entityId":"LE106-WORLD106-04","photo":null,"mapIds":["WORLD106-04"],"start106":-300,"end106":100,"photoLookup108":{"title":"Petra"}},{"id":"WORLD106-05","title":"Machu Picchu","kind":"archaeology","reference":"https://whc.unesco.org/en/list/274/","country":"Peru","city":"Cusco region","lat":-13.163,"lon":-72.545,"style":"Inca","note":"The Inca site joins stone buildings, terraces and steep mountain terrain. Its fifteenth-century setting distinguishes it from earlier Andean cultures such as the Moche.","coordinateSource":"https://whc.unesco.org/en/list/274/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1400–1500","era":"c. 1400–1500","period103":"renaissance","kinds103":["archaeology"],"styles103":["Inca"],"entityId":"LE106-WORLD106-05","photo":null,"mapIds":["WORLD106-05"],"start106":1400,"end106":1500,"photoLookup108":{"title":"Machu Picchu"}},{"id":"WORLD106-06","title":"Chichén Itzá","kind":"archaeology","reference":"https://whc.unesco.org/en/list/483/","country":"Mexico","city":"Yucatán","lat":20.684,"lon":-88.568,"style":"Maya; Toltec connections","note":"Temple pyramids, a large ball court and other monuments show a Maya city with wider Mesoamerican connections. Do not confuse it with Teotihuacan in central Mexico.","coordinateSource":"https://whc.unesco.org/en/list/483/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 600–1200","era":"c. 600–1200","period103":"medieval","kinds103":["archaeology"],"styles103":["Maya; Toltec connections"],"entityId":"LE106-WORLD106-06","photo":null,"mapIds":["WORLD106-06"],"start106":600,"end106":1200,"photoLookup108":{"title":"Chichen Itza"}},{"id":"WORLD106-07","title":"Teotihuacan","kind":"archaeology","reference":"https://whc.unesco.org/en/list/414/","country":"Mexico","city":"Valley of Mexico","lat":19.692,"lon":-98.844,"style":"Mesoamerican urbanism","note":"The Avenue of the Dead links monumental precincts including the Sun and Moon pyramids. The city flourished many centuries before the Aztec Empire; its builders should not be labelled Aztec.","coordinateSource":"https://whc.unesco.org/en/list/414/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1–700","era":"c. 1–700","period103":"ancient","kinds103":["archaeology"],"styles103":["Mesoamerican urbanism"],"entityId":"LE106-WORLD106-07","photo":null,"mapIds":["WORLD106-07"],"start106":1,"end106":700,"photoLookup108":{"title":"Teotihuacan"}},{"id":"WORLD106-08","title":"Rapa Nui: moai","kind":"sculpture","reference":"https://whc.unesco.org/en/list/715/","country":"Chile","city":"Rapa Nui","lat":-27.125,"lon":-109.277,"style":"Polynesian; Rapa Nui","note":"The moai are monumental stone figures associated with a Polynesian island society. Many stand on ceremonial platforms called ahu. The range is a broad period, not a date for every statue.","coordinateSource":"https://whc.unesco.org/en/list/715/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1000–1600","era":"c. 1000–1600","period103":"medieval","kinds103":["sculpture"],"styles103":["Polynesian; Rapa Nui"],"entityId":"LE106-WORLD106-08","photo":null,"mapIds":["WORLD106-08"],"start106":1000,"end106":1600,"photoLookup108":{"title":"Moai"}},{"id":"WORLD106-09","title":"Himeji Castle","kind":"architecture","reference":"https://whc.unesco.org/en/list/661/","country":"Japan","city":"Himeji","lat":34.839,"lon":134.694,"style":"Japanese castle architecture","note":"White plastered surfaces cover a sophisticated timber castle. Gates, walls and routes form a defensive system: its appearance is not simply ornamental.","coordinateSource":"https://whc.unesco.org/en/list/661/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1601–1609","era":"c. 1601–1609","period103":"baroque","kinds103":["architecture"],"styles103":["Japanese castle architecture"],"entityId":"LE106-WORLD106-09","photo":null,"mapIds":["WORLD106-09"],"start106":1601,"end106":1609,"photoLookup108":{"title":"Himeji Castle"}},{"id":"WORLD106-10","title":"Forbidden City","kind":"architecture","reference":"https://whc.unesco.org/en/list/439/","country":"China","city":"Beijing","lat":39.916,"lon":116.397,"style":"Ming and Qing imperial architecture","note":"Beijing's imperial palace developed as a hierarchy of courts and halls along an axis. The initial Ming construction dates do not imply that every surviving structure is original.","coordinateSource":"https://whc.unesco.org/en/list/439/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1406–1420","era":"c. 1406–1420","period103":"renaissance","kinds103":["architecture"],"styles103":["Ming and Qing imperial architecture"],"entityId":"LE106-WORLD106-10","photo":null,"mapIds":["WORLD106-10"],"start106":1406,"end106":1420,"photoLookup108":{"title":"Forbidden City"}},{"id":"WORLD106-11","title":"Temple of Heaven","kind":"architecture","reference":"https://whc.unesco.org/en/list/881/","country":"China","city":"Beijing","lat":39.883,"lon":116.407,"style":"Chinese imperial ritual architecture","note":"This ceremonial complex relates imperial ritual to ideas of heaven and earth. Read its symbolism and layout as a religious-political landscape rather than a residential palace.","coordinateSource":"https://whc.unesco.org/en/list/881/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1406–1420","era":"c. 1406–1420","period103":"renaissance","kinds103":["architecture"],"styles103":["Chinese imperial ritual architecture"],"entityId":"LE106-WORLD106-11","photo":null,"mapIds":["WORLD106-11"],"start106":1406,"end106":1420,"photoLookup108":{"title":"Temple of Heaven"}},{"id":"WORLD106-12","title":"Potala Palace","kind":"architecture","reference":"https://whc.unesco.org/en/list/707/","country":"China","city":"Lhasa","lat":29.658,"lon":91.117,"style":"Tibetan Buddhist architecture","note":"The palace was a winter residence of the Dalai Lama and a centre of Tibetan Buddhist authority. Its major seventeenth-century development stands on a site with earlier history.","coordinateSource":"https://whc.unesco.org/en/list/707/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1600–1700","era":"c. 1600–1700","period103":"baroque","kinds103":["architecture"],"styles103":["Tibetan Buddhist architecture"],"entityId":"LE106-WORLD106-12","photo":null,"mapIds":["WORLD106-12"],"start106":1600,"end106":1700,"photoLookup108":{"title":"Potala Palace"}},{"id":"WORLD106-13","title":"Lalibela: rock-hewn churches","kind":"church","reference":"https://whc.unesco.org/en/list/18/","country":"Ethiopia","city":"Lalibela","lat":12.032,"lon":39.043,"style":"Ethiopian Christian rock-hewn architecture","note":"Eleven medieval churches were carved from rock and connected by trenches and passages. Excavating spaces and leaving structural masses produces architecture by subtraction.","coordinateSource":"https://whc.unesco.org/en/list/18/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1200–1300","era":"c. 1200–1300","period103":"medieval","kinds103":["church"],"styles103":["Ethiopian Christian rock-hewn architecture"],"entityId":"LE106-WORLD106-13","photo":null,"mapIds":["WORLD106-13"],"start106":1200,"end106":1300,"photoLookup108":{"title":"Rock-Hewn Churches, Lalibela"}},{"id":"WORLD106-14","title":"Great Zimbabwe","kind":"archaeology","reference":"https://whc.unesco.org/en/list/364/","country":"Zimbabwe","city":"Masvingo","lat":-20.267,"lon":30.933,"style":"Shona stone architecture","note":"The ruins record a Shona urban and trading centre. Carefully fitted granite walls, especially the Great Enclosure, challenge the idea that monumental African architecture was limited to Egypt.","coordinateSource":"https://whc.unesco.org/en/list/364/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1100–1500","era":"c. 1100–1500","period103":"medieval","kinds103":["archaeology"],"styles103":["Shona stone architecture"],"entityId":"LE106-WORLD106-14","photo":null,"mapIds":["WORLD106-14"],"start106":1100,"end106":1500,"photoLookup108":{"title":"Great Zimbabwe"}},{"id":"WORLD106-15","title":"Djenné: historic town","kind":"architecture","reference":"https://whc.unesco.org/en/list/116/","country":"Mali","city":"Djenné","lat":13.906,"lon":-4.555,"style":"Sahelian earthen architecture","note":"Earthen construction links the town's buildings to local materials and continuing maintenance. The range describes a historic urban phase, not the construction date of today's Great Mosque.","coordinateSource":"https://whc.unesco.org/en/list/116/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1400–1600","era":"c. 1400–1600","period103":"renaissance","kinds103":["architecture"],"styles103":["Sahelian earthen architecture"],"entityId":"LE106-WORLD106-15","photo":null,"mapIds":["WORLD106-15"],"start106":1400,"end106":1600,"photoLookup108":{"title":"Great Mosque of Djenné"},"photoScope108":"Great Mosque of Djenné, within the historic town; the current mosque is later than the urban phase"},{"id":"WORLD106-16","title":"Persepolis","kind":"archaeology","reference":"https://whc.unesco.org/en/list/114/","country":"Iran","city":"Fars","lat":29.935,"lon":52.891,"style":"Achaemenid Persian","note":"Darius I began the Achaemenid palace complex on a monumental terrace. Reliefs and ceremonial spaces expressed imperial authority; this is not a Greek polis.","coordinateSource":"https://whc.unesco.org/en/list/114/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 518 BCE–330 BCE","era":"c. 518 BCE–330 BCE","period103":"ancient","kinds103":["archaeology"],"styles103":["Achaemenid Persian"],"entityId":"LE106-WORLD106-16","photo":null,"mapIds":["WORLD106-16"],"start106":-518,"end106":-330,"photoLookup108":{"title":"Persepolis"}},{"id":"WORLD106-17","title":"Sanchi","kind":"architecture","reference":"https://whc.unesco.org/en/list/524/","country":"India","city":"Madhya Pradesh","lat":23.479,"lon":77.739,"style":"Buddhist stupas","note":"Stupas, gateways and other remains trace a long Buddhist history beginning in the Mauryan period. The stupa is a sacred mound or reliquary monument, not an ordinary dwelling.","coordinateSource":"https://whc.unesco.org/en/list/524/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 300 BCE–1200","era":"c. 300 BCE–1200","period103":"ancient","kinds103":["architecture"],"styles103":["Buddhist stupas"],"entityId":"LE106-WORLD106-17","photo":null,"mapIds":["WORLD106-17"],"start106":-300,"end106":1200,"photoLookup108":{"title":"Sanchi"}},{"id":"WORLD106-18","title":"Khajuraho","kind":"architecture","reference":"https://whc.unesco.org/en/list/240/","country":"India","city":"Madhya Pradesh","lat":24.852,"lon":79.92,"style":"Chandella; Hindu and Jain temples","note":"The surviving temples combine towered sanctuaries with extensive sculpture. Both Hindu and Jain monuments are represented; reducing the site to erotic imagery misses its wider religious programme.","coordinateSource":"https://whc.unesco.org/en/list/240/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 950–1050","era":"c. 950–1050","period103":"medieval","kinds103":["architecture"],"styles103":["Chandella; Hindu and Jain temples"],"entityId":"LE106-WORLD106-18","photo":null,"mapIds":["WORLD106-18"],"start106":950,"end106":1050,"photoLookup108":{"title":"Khajuraho Group of Monuments"}},{"id":"WORLD106-19","title":"Bagan","kind":"architecture","reference":"https://whc.unesco.org/en/list/1588/","country":"Myanmar","city":"Mandalay region","lat":21.173,"lon":94.859,"style":"Buddhist sacred landscape","note":"Thousands of Buddhist monuments form a landscape shaped by patronage and merit-making. The selected range describes the principal building era, not every restoration.","coordinateSource":"https://whc.unesco.org/en/list/1588/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1000–1300","era":"c. 1000–1300","period103":"medieval","kinds103":["architecture"],"styles103":["Buddhist sacred landscape"],"entityId":"LE106-WORLD106-19","photo":null,"mapIds":["WORLD106-19"],"start106":1000,"end106":1300,"photoLookup108":{"title":"Bagan"}},{"id":"WORLD106-20","title":"Samarkand","kind":"architecture","reference":"https://whc.unesco.org/en/list/603/","country":"Uzbekistan","city":"Samarkand","lat":39.655,"lon":66.975,"style":"Timurid","note":"Samarkand links Silk Road exchange with Timurid monuments and scholarship. The Registan, Bibi-Khanum Mosque and Ulugh Beg's observatory have different functions and building histories.","coordinateSource":"https://whc.unesco.org/en/list/603/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1300–1500","era":"c. 1300–1500","period103":"medieval","kinds103":["architecture"],"styles103":["Timurid"],"entityId":"LE106-WORLD106-20","photo":null,"mapIds":["WORLD106-20"],"start106":1300,"end106":1500,"photoLookup108":{"title":"Registan"},"photoScope108":"Registan, one ensemble within Samarkand"},{"id":"WORLD106-21","title":"Hampi","kind":"archaeology","reference":"https://whc.unesco.org/en/list/241/","country":"India","city":"Karnataka","lat":15.335,"lon":76.462,"style":"Vijayanagara; Dravidian","note":"The former Vijayanagara capital brings together temples, royal structures and a dramatic rocky landscape. The ruins belong to a major southern Indian kingdom, not to Mughal Agra.","coordinateSource":"https://whc.unesco.org/en/list/241/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1300–1600","era":"c. 1300–1600","period103":"medieval","kinds103":["archaeology"],"styles103":["Vijayanagara; Dravidian"],"entityId":"LE106-WORLD106-21","photo":null,"mapIds":["WORLD106-21"],"start106":1300,"end106":1600,"photoLookup108":{"title":"Hampi"}},{"id":"WORLD106-22","title":"Konark Sun Temple","kind":"architecture","reference":"https://whc.unesco.org/en/list/246/","country":"India","city":"Odisha","lat":19.887,"lon":86.094,"style":"Kalinga; Hindu","note":"The temple gives architectural form to the chariot of Surya, the sun god. Carved wheels and horses turn an entire building into a religious image.","coordinateSource":"https://whc.unesco.org/en/list/246/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 1200–1300","era":"c. 1200–1300","period103":"medieval","kinds103":["architecture"],"styles103":["Kalinga; Hindu"],"entityId":"LE106-WORLD106-22","photo":null,"mapIds":["WORLD106-22"],"start106":1200,"end106":1300,"photoLookup108":{"title":"Konark Sun Temple"}},{"id":"WORLD106-23","title":"Mogao Caves","kind":"architecture","reference":"https://whc.unesco.org/en/list/440/","country":"China","city":"Dunhuang","lat":40.134,"lon":94.81,"style":"Buddhist cave art","note":"Wall paintings and sculpture preserve many centuries of Buddhist art along the Silk Road. The caves also connect art history with manuscripts and intercultural exchange.","coordinateSource":"https://whc.unesco.org/en/list/440/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 366–1400","era":"c. 366–1400","period103":"ancient","kinds103":["architecture"],"styles103":["Buddhist cave art"],"entityId":"LE106-WORLD106-23","photo":null,"mapIds":["WORLD106-23"],"start106":366,"end106":1400,"photoLookup108":{"title":"Mogao Caves"}},{"id":"WORLD106-24","title":"Longmen Grottoes","kind":"sculpture","reference":"https://whc.unesco.org/en/list/1003/","country":"China","city":"Luoyang","lat":34.555,"lon":112.478,"style":"Northern Wei and Tang Buddhist sculpture","note":"Rock-cut Buddhist images reveal changing styles and patronage, especially under Northern Wei and Tang rule. Compare carved stone at Longmen with painted cave interiors at Mogao.","coordinateSource":"https://whc.unesco.org/en/list/1003/maps/","coordinatePrecision106":"Representative site position, rounded; not a boundary or entrance","built":"c. 493–750","era":"c. 493–750","period103":"ancient","kinds103":["sculpture"],"styles103":["Northern Wei and Tang Buddhist sculpture"],"entityId":"LE106-WORLD106-24","photo":null,"mapIds":["WORLD106-24"],"start106":493,"end106":750,"photoLookup108":{"title":"Longmen Grottoes"}},{"id":"WORLD108-01","title":"Stonehenge","kind":"archaeology","reference":"https://whc.unesco.org/en/list/373/","lat":51.179,"lon":-1.826,"country":"United Kingdom","city":"Wiltshire","style":"Neolithic and Bronze Age","built":"c. 3000 BCE – 1600 BCE","start106":-3000,"end106":-1600,"creator":"","note":"Megalithic construction combines upright stones and lintels. Study the monument as a sequence of prehistoric phases rather than a building made at one moment.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Neolithic and Bronze Age"],"period103":"ancient","entityId":"LE108-WORLD108-01","mapIds":["WORLD108-01"],"photo":null,"photoLookup108":{"title":"Stonehenge"},"revision108":true},{"id":"WORLD108-02","title":"Skara Brae","kind":"archaeology","reference":"https://whc.unesco.org/en/list/514/","lat":59.049,"lon":-3.343,"country":"United Kingdom","city":"Orkney","style":"Neolithic settlement","built":"c. 3100 BCE – 2500 BCE","start106":-3100,"end106":-2500,"creator":"","note":"Stone-built houses preserve domestic space and fittings. Compare this settlement with ceremonial stone circles: prehistoric architecture also includes everyday dwellings.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Neolithic settlement"],"period103":"ancient","entityId":"LE108-WORLD108-02","mapIds":["WORLD108-02"],"photo":null,"photoLookup108":{"title":"Skara Brae"},"revision108":true},{"id":"WORLD108-03","title":"Newgrange","kind":"archaeology","reference":"https://whc.unesco.org/en/list/659/","lat":53.695,"lon":-6.475,"country":"Ireland","city":"County Meath","style":"Neolithic passage tomb","built":"c. 3300 BCE – 2900 BCE","start106":-3300,"end106":-2900,"creator":"","note":"A passage leads into a chamber within a mound. Its carved stones and relationship to the winter solstice connect burial architecture, imagery and the seasonal cycle.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Neolithic passage tomb"],"period103":"ancient","entityId":"LE108-WORLD108-03","mapIds":["WORLD108-03"],"photo":null,"photoLookup108":{"title":"Newgrange"},"revision108":true},{"id":"WORLD108-04","title":"Mycenae","kind":"archaeology","reference":"https://whc.unesco.org/en/list/941/","lat":37.731,"lon":22.756,"country":"Greece","city":"Argolis","style":"Mycenaean Bronze Age","built":"c. 1600 BCE – 1100 BCE","start106":-1600,"end106":-1100,"creator":"","note":"Fortification walls, the Lion Gate and tholos tombs belong to Bronze Age Greece. They precede the Classical temples of fifth-century BCE Athens.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Mycenaean Bronze Age"],"period103":"ancient","entityId":"LE108-WORLD108-04","mapIds":["WORLD108-04"],"photo":null,"photoLookup108":{"title":"Mycenae"},"revision108":true},{"id":"WORLD108-05","title":"Delphi","kind":"archaeology","reference":"https://whc.unesco.org/en/list/393/","lat":38.482,"lon":22.498,"country":"Greece","city":"Phocis","style":"Ancient Greek sanctuary","built":"c. 800 BCE – 300 BCE","start106":-800,"end106":-300,"creator":"","note":"The sanctuary of Apollo linked an oracle, treasuries, temples and athletic competition. Its hillside setting differs from a regular urban grid.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Ancient Greek sanctuary"],"period103":"ancient","entityId":"LE108-WORLD108-05","mapIds":["WORLD108-05"],"photo":null,"photoLookup108":{"title":"Delphi"},"revision108":true},{"id":"WORLD108-06","title":"Olympia","kind":"archaeology","reference":"https://whc.unesco.org/en/list/517/","lat":37.638,"lon":21.63,"country":"Greece","city":"Elis","style":"Ancient Greek sanctuary","built":"c. 800 BCE – 400 CE","start106":-800,"end106":400,"creator":"","note":"A sanctuary of Zeus and the setting of the ancient Olympic Games. Religious monuments and athletic spaces belong to the same complex.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Ancient Greek sanctuary"],"period103":"ancient","entityId":"LE108-WORLD108-06","mapIds":["WORLD108-06"],"photo":null,"photoLookup108":{"title":"Olympia, Greece"},"revision108":true},{"id":"WORLD108-07","title":"Ephesus","kind":"archaeology","reference":"https://whc.unesco.org/en/list/1018/","lat":37.94,"lon":27.341,"country":"Turkey","city":"Selçuk","style":"Hellenistic and Roman urbanism","built":"c. 300 BCE – 300 CE","start106":-300,"end106":300,"creator":"","note":"The Library of Celsus and theatre exemplify monumental urban life. Distinguish the Roman city remains from the earlier fame of the Temple of Artemis.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Hellenistic and Roman urbanism"],"period103":"ancient","entityId":"LE108-WORLD108-07","mapIds":["WORLD108-07"],"photo":null,"photoLookup108":{"title":"Ephesus"},"revision108":true},{"id":"WORLD108-08","title":"Carthage","kind":"archaeology","reference":"https://whc.unesco.org/en/list/37/","lat":36.853,"lon":10.324,"country":"Tunisia","city":"Tunis","style":"Punic and Roman","built":"c. 800 BCE – 500 CE","start106":-800,"end106":500,"creator":"","note":"A Phoenician foundation became Rome's great Mediterranean rival. The archaeological site also contains a later Roman city; its remains do not all belong to one culture.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Punic and Roman"],"period103":"ancient","entityId":"LE108-WORLD108-08","mapIds":["WORLD108-08"],"photo":null,"photoLookup108":{"title":"Carthage"},"revision108":true},{"id":"WORLD108-09","title":"Leptis Magna","kind":"archaeology","reference":"https://whc.unesco.org/en/list/183/","lat":32.638,"lon":14.291,"country":"Libya","city":"Al Khums","style":"Roman imperial urbanism","built":"1–300","start106":1,"end106":300,"creator":"","note":"Public buildings, streets and harbour remains reveal a major Roman city in North Africa. Compare provincial Roman urbanism with monuments in Rome itself.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Roman imperial urbanism"],"period103":"ancient","entityId":"LE108-WORLD108-09","mapIds":["WORLD108-09"],"photo":null,"photoLookup108":{"title":"Leptis Magna"},"revision108":true},{"id":"WORLD108-10","title":"Timgad","kind":"archaeology","reference":"https://whc.unesco.org/en/list/194/","lat":35.484,"lon":6.468,"country":"Algeria","city":"Batna","style":"Roman town planning","built":"100–300","start106":100,"end106":300,"creator":"","note":"Trajan founded the colony in 100 CE. The orthogonal street network makes it useful for learning cardo, decumanus and Roman planning beyond Italy.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Roman town planning"],"period103":"ancient","entityId":"LE108-WORLD108-10","mapIds":["WORLD108-10"],"photo":null,"photoLookup108":{"title":"Timgad"},"revision108":true},{"id":"WORLD108-11","title":"Ajanta Caves","kind":"archaeology","reference":"https://whc.unesco.org/en/list/242/","lat":20.552,"lon":75.703,"country":"India","city":"Maharashtra","style":"Buddhist rock-cut architecture","built":"c. 200 BCE – 600 CE","start106":-200,"end106":600,"creator":"","note":"Monastic spaces, worship halls, paintings and sculpture form a Buddhist cave complex. Distinguish this context from Ellora's multiple religious traditions.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Buddhist rock-cut architecture"],"period103":"ancient","entityId":"LE108-WORLD108-11","mapIds":["WORLD108-11"],"photo":null,"photoLookup108":{"title":"Ajanta Caves"},"revision108":true},{"id":"WORLD108-12","title":"Ellora Caves","kind":"architecture","reference":"https://whc.unesco.org/en/list/243/","lat":20.026,"lon":75.179,"country":"India","city":"Maharashtra","style":"Buddhist, Hindu and Jain rock-cut architecture","built":"600–1000","start106":600,"end106":1000,"creator":"","note":"Buddhist, Hindu and Jain monuments coexist at Ellora. The Kailasa temple demonstrates how subtractive carving can produce an apparently freestanding architectural mass.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Buddhist, Hindu and Jain rock-cut architecture"],"period103":"medieval","entityId":"LE108-WORLD108-12","mapIds":["WORLD108-12"],"photo":null,"photoLookup108":{"title":"Ellora Caves"},"revision108":true},{"id":"WORLD108-13","title":"Elephanta Caves","kind":"archaeology","reference":"https://whc.unesco.org/en/list/244/","lat":18.964,"lon":72.931,"country":"India","city":"Mumbai harbour","style":"Hindu rock-cut architecture","built":"400–600","start106":400,"end106":600,"creator":"","note":"The principal cave centres on Shiva and monumental sculptural programmes. It should not be classified as a Buddhist monastery simply because it is rock-cut.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["archaeology"],"styles103":["Hindu rock-cut architecture"],"period103":"ancient","entityId":"LE108-WORLD108-13","mapIds":["WORLD108-13"],"photo":null,"photoLookup108":{"title":"Elephanta Caves"},"revision108":true},{"id":"WORLD108-14","title":"Fatehpur Sikri","kind":"architecture","reference":"https://whc.unesco.org/en/list/255/","lat":27.094,"lon":77.668,"country":"India","city":"Uttar Pradesh","style":"Mughal","built":"1571–1585","start106":1571,"end106":1585,"creator":"","note":"Akbar's planned capital combines courtly and religious spaces. Compare it with the later Taj Mahal: both are Mughal, but one is a city and the other a mausoleum.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Mughal"],"period103":"renaissance","entityId":"LE108-WORLD108-14","mapIds":["WORLD108-14"],"photo":null,"photoLookup108":{"title":"Fatehpur Sikri"},"revision108":true},{"id":"WORLD108-15","title":"Humayun's Tomb","kind":"architecture","reference":"https://whc.unesco.org/en/list/232/","lat":28.593,"lon":77.25,"country":"India","city":"Delhi","style":"Mughal garden tomb","built":"1560–1572","start106":1560,"end106":1572,"creator":"","note":"A monumental tomb set in a formal garden, important for the development of Mughal funerary architecture. Its function and setting provide context for the later Taj Mahal.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Mughal garden tomb"],"period103":"renaissance","entityId":"LE108-WORLD108-15","mapIds":["WORLD108-15"],"photo":null,"photoLookup108":{"title":"Humayun's Tomb"},"revision108":true},{"id":"WORLD108-16","title":"Qutb Minar","kind":"architecture","reference":"https://whc.unesco.org/en/list/233/","lat":28.524,"lon":77.185,"country":"India","city":"Delhi","style":"Delhi Sultanate","built":"1199–1369","start106":1199,"end106":1369,"creator":"","note":"The tall minaret belongs to an early Islamic monumental complex in Delhi. Its long construction history predates the Mughal period.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Delhi Sultanate"],"period103":"medieval","entityId":"LE108-WORLD108-16","mapIds":["WORLD108-16"],"photo":null,"photoLookup108":{"title":"Qutb Minar"},"revision108":true},{"id":"WORLD108-17","title":"Tōdai-ji","kind":"architecture","reference":"https://whc.unesco.org/en/list/870/","lat":34.689,"lon":135.84,"country":"Japan","city":"Nara","style":"Japanese Buddhist temple","built":"700–800","start106":700,"end106":800,"creator":"","note":"An eighth-century Buddhist foundation associated with the Great Buddha. Present buildings include later reconstructions, so foundation and surviving fabric have different dates.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Japanese Buddhist temple"],"period103":"medieval","entityId":"LE108-WORLD108-17","mapIds":["WORLD108-17"],"photo":null,"photoLookup108":{"title":"Tōdai-ji"},"revision108":true},{"id":"WORLD108-18","title":"Itsukushima Shrine","kind":"architecture","reference":"https://whc.unesco.org/en/list/776/","lat":34.296,"lon":132.32,"country":"Japan","city":"Miyajima","style":"Shinto shrine architecture","built":"1100–1200","start106":1100,"end106":1200,"creator":"","note":"The shrine's relationship to tidal water and the sacred island is central to its design. The twelfth-century development should not be confused with the dates of later repairs.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Shinto shrine architecture"],"period103":"medieval","entityId":"LE108-WORLD108-18","mapIds":["WORLD108-18"],"photo":null,"photoLookup108":{"title":"Itsukushima Shrine"},"revision108":true},{"id":"WORLD108-19","title":"Brasília: civic centre","kind":"architecture","reference":"https://whc.unesco.org/en/list/445/","lat":-15.8,"lon":-47.862,"country":"Brazil","city":"Brasília","style":"Modernist urban planning","built":"1956–1960","start106":1956,"end106":1960,"creator":"Urban plan: Lúcio Costa; civic buildings: Oscar Niemeyer","note":"Lúcio Costa's urban plan and Oscar Niemeyer's civic buildings make Brasília a key modernist capital. Urban layout and individual buildings are related but distinct design scales.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Modernist urban planning"],"period103":"postwar","entityId":"LE108-WORLD108-19","mapIds":["WORLD108-19"],"photo":null,"photoLookup108":{"title":"Praça dos Três Poderes"},"revision108":true},{"id":"WORLD108-20","title":"Chandigarh Capitol Complex","kind":"architecture","reference":"https://whc.unesco.org/en/list/1321/","lat":30.758,"lon":76.808,"country":"India","city":"Chandigarh","style":"Modernism","built":"1950–1965","start106":1950,"end106":1965,"creator":"Le Corbusier","note":"Le Corbusier's governmental complex connects exposed concrete, monumental form and climate-conscious design. It belongs to a planned city developed after Indian independence.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Modernism"],"period103":"postwar","entityId":"LE108-WORLD108-20","mapIds":["WORLD108-20"],"photo":null,"photoLookup108":{"title":"Chandigarh Capitol Complex"},"revision108":true},{"id":"WORLD108-21","title":"Zollverein: Shaft XII","kind":"architecture","reference":"https://whc.unesco.org/en/list/975/","lat":51.486,"lon":7.043,"country":"Germany","city":"Essen","style":"Industrial Modernism","built":"1928–1932","start106":1928,"end106":1932,"creator":"Fritz Schupp and Martin Kremmer","note":"The coal-mining complex links industrial production with carefully ordered modern architecture. Later reuse makes it useful for comparing original function and heritage adaptation.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Industrial Modernism"],"period103":"modern","entityId":"LE108-WORLD108-21","mapIds":["WORLD108-21"],"photo":null,"photoLookup108":{"title":"Zollverein Coal Mine Industrial Complex"},"revision108":true},{"id":"WORLD108-22","title":"Le Havre: reconstructed centre","kind":"architecture","reference":"https://whc.unesco.org/en/list/1181/","lat":49.493,"lon":0.107,"country":"France","city":"Le Havre","style":"Reinforced-concrete reconstruction","built":"1945–1964","start106":1945,"end106":1964,"creator":"Auguste Perret and team","note":"Auguste Perret led the postwar rebuilding of the city centre. A consistent structural vocabulary and urban plan show modern reconstruction at the scale of a whole district.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Reinforced-concrete reconstruction"],"period103":"postwar","entityId":"LE108-WORLD108-22","mapIds":["WORLD108-22"],"photo":null,"photoLookup108":{"title":"Le Havre"},"revision108":true},{"id":"WORLD108-23","title":"White City of Tel Aviv","kind":"architecture","reference":"https://whc.unesco.org/en/list/1096/","lat":32.077,"lon":34.773,"country":"Israel","city":"Tel Aviv","style":"Modern Movement","built":"1930–1950","start106":1930,"end106":1950,"creator":"","note":"Modernist buildings adapt European design ideas to local climatic conditions. The district illustrates the international circulation and local transformation of architectural principles.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Modern Movement"],"period103":"modern","entityId":"LE108-WORLD108-23","mapIds":["WORLD108-23"],"photo":null,"photoLookup108":{"title":"White City (Tel Aviv)"},"revision108":true},{"id":"WORLD108-24","title":"Fallingwater","kind":"architecture","reference":"https://whc.unesco.org/en/list/1496/","lat":39.906,"lon":-79.467,"country":"United States","city":"Pennsylvania","style":"Organic architecture","built":"1935–1939","start106":1935,"end106":1939,"creator":"Frank Lloyd Wright","note":"Frank Lloyd Wright's house joins cantilevered terraces with a waterfall and rocky site. Learn the relationship between structure, interior space and landscape rather than treating the house as an isolated object.","coordinatePrecision106":"Representative position of the named site; dates describe the selected historical phase, not every surviving structure.","kinds103":["architecture"],"styles103":["Organic architecture"],"period103":"modern","entityId":"LE108-WORLD108-24","mapIds":["WORLD108-24"],"photo":null,"photoLookup108":{"title":"Fallingwater"},"revision108":true}]}