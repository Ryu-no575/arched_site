54","subject":"View on the Cannaregio Canal, Venice","value":"Francesco Guardi","group":"Francesco Guardi","major":"Art History","era":"Other","relation":"artist","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://www.nga.gov/collection/art-object-page.254.html"}],"explanation74":"View on the Cannaregio Canal, Venice (c. 1775-1780) is catalogued as a work by Francesco Guardi."},{"id":"EXP77-3613","nodeId":"EXP77-3613","anchor":"NGA61-61392","subject":"A Scene from The Beggar's Opera","value":"William Hogarth","group":"William Hogarth","major":"Art History","era":"Other","relation":"artist","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://www.nga.gov/collection/art-object-page.61392.html"}],"explanation74":"A Scene from The Beggar's Opera (1728/1729) is catalogued as a work by William Hogarth."},{"id":"EXP77-3614","nodeId":"EXP77-3614","anchor":"NGA61-46502","subject":"Madame Alexandre Kohler","value":"Paul Gauguin","group":"Paul Gauguin","major":"Art History","era":"Modern","relation":"artist","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://www.nga.gov/collection/art-object-page.46502.html"}],"explanation74":"Madame Alexandre Kohler (1887/1888) is catalogued as a work by Paul Gauguin."},{"id":"EXP77-3615","nodeId":"EXP77-3615","anchor":"PDFART48-58","subject":"The Three Philosophers","value":"Kunsthistorisches Museum","group":"Giorgione","major":"Art History","era":"Other","relation":"collection","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://commons.wikimedia.org/wiki/File:Giorgione_-_Three_Philosophers_-_Google_Art_Project.jpg"}],"explanation74":"The collection record places this work in Kunsthistorisches Museum."},{"id":"EXP77-3616","nodeId":"EXP77-3616","anchor":"NGA61-46113","subject":"Madame David","value":"Jacques-Louis David","group":"Jacques-Louis David","major":"Art History","era":"Modern","relation":"artist","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://www.nga.gov/collection/art-object-page.46113.html"}],"explanation74":"Madame David (1813) is catalogued as a work by Jacques-Louis David."},{"id":"EXP77-3617","nodeId":"EXP77-3617","anchor":"NGA61-46108","subject":"Venus Adorned by the Graces","value":"Annibale Carracci","group":"Annibale Carracci","major":"Art History","era":"Other","relation":"artist","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://www.nga.gov/collection/art-object-page.46108.html"}],"explanation74":"Venus Adorned by the Graces (1590/1595) is catalogued as a work by Annibale Carracci."},{"id":"EXP77-3618","nodeId":"EXP77-3618","anchor":"NGA61-505","subject":"The Visitation with Saint Nicholas and Saint Anthony Abbot","value":"Piero di Cosimo","group":"Piero di Cosimo","major":"Art History","era":"Other","relation":"artist","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://www.nga.gov/collection/art-object-page.505.html"}],"explanation74":"The Visitation with Saint Nicholas and Saint Anthony Abbot (c. 1489/1490) is catalogued as a work by Piero di Cosimo."},{"id":"EXP77-3619","nodeId":"EXP77-3619","anchor":"ART45-Q693746","subject":"The Monk by the Sea","value":"Alte Nationalgalerie","group":"Caspar David Friedrich","major":"Art History","era":"Modern","relation":"collection","references":[{"file":"Museum collection record","page":null,"verificationUrl":"https://commons.wikimedia.org/wiki/File:Friedrich%2C_Caspar_David_-_M%C3%B6nch_am_Meer_-_Alte_Nationalgalerie_in_Berlin.jpg"}],"explanation74":"The collection record places this work in Alte Nationalgalerie."},{"id":"EXP77-3620","nodeId":"EXP77-3620","anchor":"NGA61-32687","subject":"The Italian Comedians","value":"Antoine Watteau","group":"Antoine Watteau","major":"Art History","era":"Other","relation":"artist","references":[{"file":"Museum collection record","page":null,"veri