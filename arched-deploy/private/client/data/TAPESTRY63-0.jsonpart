g":"item","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","image":{"src":"/.netlify/functions/access?action=media&name=197c9afd1ed3a9a8e8a06bfa.webp","credit":"Ethan Doyle White","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Baths_of_Caracalla,_facing_Caldarium.jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t63-b27c003d3c22","title":"Mani and the emergence of Manichaeism","lane":"history","start":216,"end":276,"approx":true,"note":"The founder's approximate lifetime frames the emergence of the religion; not the total duration of the tradition.","creators":[],"reference":"https://en.wikipedia.org/wiki/Manichaeism","sourceSheets":[3633,3634],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-c7641c64ea68","title":"Sasanian Empire","lane":"history","start":224,"end":651,"approx":false,"note":"Persian dynasty succeeding the Arsacids.","creators":[],"reference":"https://en.wikipedia.org/wiki/Sasanian_Empire","sourceSheets":[3633,3634],"sourceMapping":"period context","dateType":"period","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-8ce038357e72","title":"Diocletian","lane":"people","start":244,"end":311,"approx":true,"note":"Roman emperor; birth/death dates vary.","creators":[],"reference":"https://en.wikipedia.org/wiki/Diocletian","sourceSheets":[3633,3634],"sourceMapping":"period context","dateType":"lifespan","dateQualifier":"Uncertain","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-cba975813d03","title":"Decian persecution","lane":"history","start":250,"end":250,"approx":false,"note":"Empire-wide sacrifice requirement under Decius.","creators":[],"reference":"https://en.wikipedia.org/wiki/Decian_persecution","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-e87f6b2d4db2","title":"Constantine I","lane":"people","start":272,"end":337,"approx":true,"note":"Roman emperor.","creators":[],"reference":"https://en.wikipedia.org/wiki/Constantine_the_Great","sourceSheets":[3634],"sourceMapping":"period context","dateType":"lifespan","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-a67bb8dafe41","title":"Reign of Diocletian","lane":"history","start":284,"end":305,"approx":false,"note":"Administrative and military reforms.","creators":[],"reference":"https://en.wikipedia.org/wiki/Diocletian","sourceSheets":[3634],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-1cbaad9129d1","title":"Tetrarchy established","lane":"history","start":293,"end":293,"approx":false,"note":"Diocletian, Maximian, Galerius and Constantius Chlorus.","creators":[],"reference":"https://en.wikipedia.org/wiki/Tetrarchy","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t69-f1a4bced97b1","title":"Early Christian basilica and central plan","lane":"architecture","start":300,"end":600,"approx":true,"note":"Longitudinal basilicas organise movement towards an apse; centrally planned martyria and baptisteries emphasise a central point. Building function matters.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Early%20Christian%20basilica%20and%20central%20plan","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy","eastmed"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-e0a8fdf319c0","title":"Apse, nave, aisles and transept","lane":"architecture","start":300,"end":700,"approx":true,"note":"The nave is the principal longitudinal space; aisles run alongside it; a transept crosses it; an apse often terminates the sanctuary. Not every church contains all four.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Apse%2C%20nave%2C%20aisles%20and%20transept","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-539d3a256e25","title":"Battle of the Milvian Bridge","lane":"history","start":312,"end":312,"approx":false,"note":"Constantine defeats Maxentius.","creators":[],"reference":"https://en.wikipedia.org/wiki/Battle_of_the_Milvian_Bridge","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-f01d531f4eac","title":"Edict of Milan","lane":"history","start":313,"end":313,"approx":false,"note":"Constantine and Licinius agree religious toleration.","creators":[],"reference":"https://en.wikipedia.org/wiki/Edict_of_Milan","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-18d134f96eb1","title":"First Council of Nicaea","lane":"history","start":325,"end":325,"approx":false,"note":"Nicene creed and the Arian controversy.","creators":[],"reference":"https://en.wikipedia.org/wiki/First_Council_of_Nicaea","sourceSheets":[3634],"sourceMapping":"period context","dateType":"year","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-c1600339b121","title":"Dedication of Constantinople","lane":"history","start":330,"end":330,"approx":false,"note":"Constantine's imperial capital.","creators":[],"reference":"https://en.wikipedia.org/wiki/Constantinople","so