_reviewed","publication_ready":true,"previewOnly95":false,"version":"editorial-v101","difficulty74":"unrated","references":[],"evidenceStatus101":"editorial factual review; individual external verification not claimed","nodeId":"FACT101-ARCHED-NEW101-0070","relatedNodeIds":["FACT101-ARCHED-NEW101-0070"],"fingerprint":"1d894225a6dff39c9c5c","semanticKey101":"525d04654474905bd6a42e2502acad3743ebbade825eba52578a9244c6424485","practiceRepetitionKeys95":["FACT:ARCHED-NEW101-0070"],"testedRelation95":"v101:8aad52163c7d8d015008"},{"id":"ARCHED-NEW101-0071","qid":1010071,"major":"Design","stem":"Which label is associated with Achille and Pier Giacomo Castiglioni's Arco lamp?","choices":["Zanotta","Kartell","Flos","Olivetti","Brionvega"],"answer":"Flos","correctIndex":2,"explanation":"Flos produced Arco, which combines a heavy marble base with an arched metal stem.","group":"Italian lighting","topic74":"Italian lighting","format":"context_relation","skill74":"context_relation","task101":"context_relation","examLanguages":["en","it"],"scope":"shared","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"version":"editorial-v101","difficulty74":"unrated","references":[],"evidenceStatus101":"editorial factual review; individual external verification not claimed","nodeId":"FACT101-ARCHED-NEW101-0071","relatedNodeIds":["FACT101-ARCHED-NEW101-0071"],"fingerprint":"7fe52f65511c22c6aa2a","semanticKey101":"2243801e0e79bb13da73d794dcd8c326fba1e90d5c730cec89523643c9fc51b4","practiceRepetitionKeys95":["FACT:ARCHED-NEW101-0071"],"testedRelation95":"v101:f2302d0e706e3182a718"},{"id":"ARCHED-NEW101-0072","qid":1010072,"major":"Design","stem":"The Memphis group's furniture is especially associated with:","choices":["Unornamented monastic oak","Archaeological reconstruction","Strictly monochrome steel","Patterned laminates and bold colours","Hand-carved medieval tracery"],"answer":"Patterned laminates and bold colours","correctIndex