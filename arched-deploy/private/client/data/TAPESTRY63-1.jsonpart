ion.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Hitler%20appointed%20German%20chancellor","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-934d553fd165","title":"New Deal begins","lane":"history","start":1933,"end":1933,"approx":false,"note":"Roosevelt's programmes addressed relief, recovery and reform during the Depression.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=New%20Deal%20begins","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-fe1a883bfa01","title":"Reichstag fire and emergency decree","lane":"history","start":1933,"end":1933,"approx":false,"note":"The fire was used to justify suspension of civil liberties and repression of opponents.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Reichstag%20fire%20and%20emergency%20decree","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-f109a0396876","title":"United States recognises the Soviet Union","lane":"history","start":1933,"end":1933,"approx":false,"note":"Formal diplomatic relations were established under Roosevelt.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=United%20States%20recognises%20the%20Soviet%20Union","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-46b0189aad99","title":"The Holocaust and Nazi racial persecution","lane":"history","start":1933,"end":1945,"approx":true,"note":"The systematic murder of six million Jews occurred within wider Nazi persecution and mass killing. Distinguish ghettos, concentration camps and extermination centres.","creators