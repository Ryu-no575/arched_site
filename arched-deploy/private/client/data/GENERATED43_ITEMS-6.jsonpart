],"correctIndex":0,"answer":"Subjects, attributes and symbols represented in images","explanation":"Iconography asks what an image represents and how it can be recognized. A key, halo or particular gesture can help identify a figure or subject.","format":"single_best_answer","references":[{"file":"National Gallery — Iconography","verificationUrl":"https://www.nationalgallery.org.uk/paintings/glossary/iconography","sourceMetadata95":{"id":"P16","title":"National Gallery — Iconography","url":"https://www.nationalgallery.org.uk/paintings/glossary/iconography","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":38,"canonical_number":null,"revision95":1,"topic74":"Iconography","skill74":"context_relation","testedRelation95":"B100:iconography","practiceRepetitionKeys95":["TOPIC:iconography"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"91daef0905aa67cb35d5663c8a4e46efbca6745c0e209403351cb1d97c9ba5d7","fingerprint":"776ed6e3e3649a06c260","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-046","qid":950046,"nodeId":"REVIEW95-ARCHED-B100-20261007-046","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-046"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Luther’s Ninety-Five Theses","stem":"Luther’s Ninety-Five Theses chiefly challenged the practice surrounding:","choices":["Investiture","Pilgrimages","Monastic vows","Tithes","Indulgences"],"correc