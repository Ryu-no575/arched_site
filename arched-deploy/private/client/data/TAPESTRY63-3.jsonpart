":"france","start":1950,"peak":1960,"end":1980},{"region":"other","start":1955,"peak":1967,"end":1980}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-51","title":"Pop Art","kind":"art","start":1955,"end":1970,"note":"Mass media, consumer imagery and different British and American contexts.","colour":"#719caf","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"britain","start":1955,"peak":1962,"end":1970},{"region":"other","start":1958,"peak":1965,"end":1970}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-52","title":"Minimalism","kind":"art","start":1960,"end":1975,"note":"Reduced forms, seriality and the viewer's space.","colour":"#bb9a55","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"other","start":1960,"peak":1967,"end":1975}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-53","title":"Conceptual art","kind":"art","start":1960,"end":1980,"note":"The idea and its presentation become central; practice continues later.","colour":"#b37d89","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"other","start":1960,"peak":1970,"end":1980},{"region":"britain","start":1965,"peak":1972,"end":1980},{"region":"central","start":1965,"peak":1972,"end":1980}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-54","title":"Arte Povera","kind":"art","start":1967,"end":1980,"note":"An Italian tendency using heterogeneous materials; named in 1967.","colour":"#649c96","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"italy","start":1967,"peak":1970,"end":1980}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-55","title":"Land Art","kind":"art","start":1965,"end":1985,"note":"Landscape, site and process; documentation can be part of the work.","colour":"#938abc","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"other","start":1965,"peak":1972,"end":1985},{"region":"britain","start":1967,"peak":1975,"end":1985}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-56","title":"High-tech architecture","kind":"architecture","start":1970,"end":2000,"note":"Visible structural and servicing systems; continuing influence.","colour":"#c38b65","reference":"https://www.moma.org/collection/terms/","approx":true,"regions72":[{"region":"britain","start":1970,"peak":1985,"end":2000},{"region":"france","start":1970,"peak":1985,"end":2000},{"region":"italy","start":1970,"peak":1985,"end":2000},{"region":"other","start":1980,"peak":1990,"end":2000}],"regionalMethod72":"Qualitative study reconstruction. Dates and colour strength are approximate, not measured prevalence; parallel centres do not imply a single origin."},{"id":"style71-57","title":"Postmodernism","kind":"both","start":1970,"end":1995,"note":"Pluralism, quotation and challenges to modernist orthodoxies.","colour":"#a980a8","reference":"https://www.vam.ac.uk/articles/what-is-postmodernism/","approx":true,"regions72":[{"region":"other","start":1970,"peak":1985,"end":1995},{"region":"italy","start":1970,"peak":1980,"end":1995},{"region":"britain","start":1975,"peak":1985,"end":1995},{"region":