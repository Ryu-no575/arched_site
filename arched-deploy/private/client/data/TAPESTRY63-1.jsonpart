s.wikimedia.org/wiki/File:Grand_Canal,_Looking_Northeast_from_Palazo_Balbi_toward_the_Rialto_Bridge.jpg"},"referenceChecked":"2026-10-05","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t63-3e2fd7aaaab3","title":"Gulliver's Travels","lane":"art","start":1726,"end":1726,"approx":false,"note":"Satire of politics, society and human reason.","creators":["Jonathan Swift"],"reference":"https://en.wikipedia.org/wiki/Gulliver's_Travels","sourceSheets":[3641],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"context"},{"id":"t63-d154aea2706b","title":"Chiswick House","lane":"architecture","start":1726,"end":1729,"approx":false,"note":"Palladian villa designed by Lord Burlington; Kent contributed interiors and landscape.","creators":["William Kent"],"reference":"https://en.wikipedia.org/wiki/Chiswick_House","sourceSheets":[3641],"sourceMapping":"item","dateType":"period","threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-f2d8b72fe4b3","title":"Thomas Gainsborough","lane":"people","start":1727,"end":1788,"approx":false,"note":"Painter.","creators":[],"reference":"https://en.wikipedia.org/wiki/Thomas_Gainsborough","sourceSheets":[3641],"sourceMapping":"period context","dateType":"lifespan","threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-533123a47afb","title":"Robert Adam","lane":"people","start":1728,"end":1792,"approx":false,"note":"Architect.","creators":[],"reference":"https://en.wikipedia.org/wiki/Robert_Adam","sourceSheets":[3641],"sourceMapping":"period context","dateType":"lifespan","threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-10bab5eaa375","title":"Étienne-Louis Boullée","lane":"people","start":