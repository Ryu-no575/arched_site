:"Eruption of Vesuvius","lane":"history","start":79,"end":79,"approx":false,"note":"Pompeii and Herculaneum.","creators":[],"reference":"https://en.wikipedia.org/wiki/Eruption_of_Mount_Vesuvius_in_79_AD","sourceSheets":[3633,3634],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-19ce2a318e42","title":"Arch of Titus","lane":"architecture","start":81,"end":81,"approx":false,"note":"Commemorates the Flavian victory in Judaea.","creators":[],"reference":"https://en.wikipedia.org/wiki/Arch_of_Titus","sourceSheets":[3633],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","image":{"src":"/.netlify/functions/access?action=media&name=691c58bc205794fcfe08e8f2.webp","credit":"Jebulon","license":"CC0","url":"https://commons.wikimedia.org/wiki/File:Arch_Titus,_Forum_Romanum,_Rome,_Italy.jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t63-4f7da074134c","title":"Five Good Emperors","lane":"history","start":96,"end":180,"approx":false,"note":"Nerva, Trajan, Hadrian, Antoninus Pius, Marcus Aurelius.","creators":[],"reference":"https://en.wikipedia.org/wiki/Nerva%E2%80%93Antonine_dynasty","sourceSheets":[3633,3634],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-f24f479a5551","title":"Trajan's Column","lane":"architecture","start":113,"end":113,"approx":false,"note":"Dedicated in 113; spiral relief narrates the Dacian campaigns.","creators":[],"reference":"https://en.wikipedia.org/wiki/Trajan's_Column","sourceSheets":[3633],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","image":{"src":"/.netlify/functions/access?action=media&name=b9ae33c784fe3c7e55ea2ec4.webp","credit":"Livioandronico2013",