ajor US naval victory over Japan in the Pacific.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20Midway","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-18a3a8ca79ff","title":"Battle of Stalingrad","lane":"history","start":1942,"end":1943,"approx":false,"note":"A major turning point on the Eastern Front; German forces surrendered in February 1943.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20Stalingrad","sourceSheets":[3647],"sourceMapping":"item","dateType":"period","threads67":["central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-b17a4d75cc82","title":"Cairo and Tehran conferences","lane":"history","start":1943,"end":1943,"approx":false,"note":"Separate Allied meetings addressed Asian and European war strategy; participants differed.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Cairo%20and%20Tehran%20conferences","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-c77edd7fb09d","title":"Italian armistice announced","lane":"history","start":1943,"end":1943,"approx":false,"note":"Announced on 8 September after signature on 3 September; occupation and civil conflict followed.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Italian%20armistice%20announced","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-5c70094fc3da","title":"D-Day: Normandy landings","lane":"history","start":1944,"end":1944,"approx":false,"note":"Allied landings on 6 June opened a major western front.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=D-Day%3A%20Normandy%20landings","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["france","britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-959e78c8a864","title":"Liberation of Paris","lane":"history","start":1944,"end":1944,"approx":false,"note":"Paris was liberated in August through resistance action and Allied advance.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Liberation%20of%20Paris","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-26e17f7d5436","title":"Liberation of Rome","lane":"history","start":1944,"end":1944,"approx":false,"note":"Allied forces entered Rome on 4 June, two days before D-Day.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Liberation%20of%20Rome","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["italy","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-7b8bf9d1ffde","title":"Battle of the Bulge","lane":"history","start":1944,"end":1945,"approx":false,"note":"A German winter offensive in the Ardennes failed to reverse the Allied advance.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20the%20Bulge","sourceSheets":[3647],"sourceMapping":"item","dateType":"period","threads67":["central","low","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-a2645d585272","title":"Atomic bombings of Hiroshima and Nagasaki","lane":"history","start":1945,"end":1945,"approx":false,"note":"The US bombed Hiroshima on 6 August and Nagasaki on 9 August; the human consequences were catastrophic.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Atomic%20bombings%20of%20Hiroshima%20and%20Nagasaki","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-dedf04291c50","title":"German surrender and VE Day","lane":"history","start":1945,"end":1945,"approx":false,"note":"Surrender was signed on 7 May and took effect on 8 May in western Europe; 9 May is commemorated in Russia.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=German%20surrender%20and%20VE%20Day","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["central","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-25e7b405ed08","title":"Japan surrenders","lane":"history","start":1945,"end":1945,"approx":false,"note":"Surrender was announced on 15 August and formally signed on 2 September.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Japan%20surrenders","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-7a3754037d78","title":"Liberation of Auschwitz","lane":"history","start":1945,"end":1945,"approx":false,"note":"Soviet forces liberated the Nazi concentration and extermination camp on 27 January.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Liberation%20of%20Auschwitz","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-dd194bda57b4","title":"Mussolini killed and Hitler dies","lane":"history","start":1945,"end":1945,"approx":false,"note":"Mussolini was executed on 28 April; Hitler died by suicide on 30 April. These are distinct events.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Mussolini%20killed%20and%20Hitler%20dies","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["italy","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-4390763e86ac","title":"Potsdam Conference","lane":"history","start":1945,"end":1945,"approx":false,"note":"Allied leaders met in July–August to address postwar Germany and other unresolved issues.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Potsdam%20Conference","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["central","other","britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-d08abf0fcf2b","title":"United Nations founded","lane":"history","start":1945,"end":1945,"approx":false,"note":"The UN Charter entered into force on 24 October; distinguish from the June signing conference.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=United%20Nations%20founded","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-1c24fd952c0a","title":"Yalta Conference","lane":"history","start":1945,"end":1945,"approx":false,"note":"Allied leaders discussed the postwar settlement and the planned United Nations.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Yalta%20Conference","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-5437c78248a4","title":"Nuremberg trials","lane":"history","start":1945,"end":1946,"approx":false,"note":"The main International Military Tribunal tried leading Nazi officials; subsequent trials followed.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Nuremberg%20trials","sourceSheets":[3647],"sourceMapping":"item","dateType":"period","threads67":["central","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-6379eefac812","title":"Postwar reconstruction and collective housing","lane":"architecture","start":1945,"end":1970,"approx":true,"note":"Housing shortages, welfare policies and construction technology shaped postwar projects. The social programme and the architectural form must be examined together.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Postwar%20reconstruction%20and%20collective%20housing","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","britain"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-2dfe8455b83c","title":"Decolonisation and unequal independence","lane":"history","start":1945,"end":1980,"approx":true,"note":"Political independence followed diverse negotiations and wars. Economic dependence and inherited borders often remained, so independence was not one uniform endpoint.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Decolonisation%20and%20unequal%20independence","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["other","shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-2f07c6438cb6","title":"Welfare states and the mixed economy","lane":"history","start":1945,"end":1990,"approx":true,"note":"Public services, social insurance and economic intervention expanded in different national forms. A welfare state is not equivalent to a fully state-owned economy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Welfare%20states%20and%20the%20mixed%20economy","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["britain","shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-03a297ccdd91","title":"Cold War: containment and deterrence","lane":"history","start":1945,"end":1991,"approx":true,"note":"Containment aimed to limit Soviet expansion; deterrence sought to discourage attack through threatened costs. Proxy wars and diplomacy were also central.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Cold%20War","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-95ac9a6d0de3","title":"First Indochina War begins","lane":"history","start":1946,"end":1946,"approx":false,"note":"The conflict between France and the Viet Minh preceded French withdrawal and partition arrangements in 1954.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20Indochina%20War%20begins","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["france","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-610b1ddb41af","title":"Iron Curtain speech","lane":"history","start":1946,"end":1946,"approx":false,"note":"Churchill's speech in Fulton described the division of Europe and called for Anglo-American cooperation.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Iron%20Curtain%20speech","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-ac0dea4b7067","title":"Italian republic referendum","lane":"history","start":1946,"end":1946,"approx":false,"note":"Voting on 2–3 June chose a republic; Enrico De Nicola became provisional head of state later that month.","creators":[],"reference":"https://www.quirinale.it/it/pagine/2-giugno-1946-2-giugno-2016","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-063b5b74da66","title":"Cominform founded","lane":"history","start":1947,"end":1947,"approx":false,"note":"A Soviet-led coordination body for communist parties, distinct from the earlier Comintern.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Cominform%20founded","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-51fb84a3b691","title":"Indian independence and Partition","lane":"history","start":1947,"end":1947,"approx":false,"note":"British India became India and Pakistan amid mass displacement and violence.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Indian%20independence%20and%20Partition","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-525332e3121a","title":"Marshall Plan announced","lane":"history","start":1947,"end":1947,"approx":false,"note":"A European recovery programme announced in June; implementation began in 1948.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Marshall%20Plan%20announced","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-f433458ff075","title":"Truman Doctrine","lane":"history","start":1947,"end":1947,"approx":false,"note":"US aid to Greece and Turkey became a landmark in Cold War containment policy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Truman%20Doctrine","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other","eastmed"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-6c7ced50f1c8","title":"Brussels Treaty","lane":"history","start":1948,"end":1948,"approx":false,"note":"Created the Western Union; the Western European Union followed the modified treaty in 1954.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Brussels%20Treaty","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["britain","france","low"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-5e8f86a16268","title":"Gandhi assassinated","lane":"history","start":1948,"end":1948,"approx":false,"note":"Gandhi was killed in January after Indian independence and Partition.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Gandhi%20assassinated","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-8b16289d5866","title":"Israel declares independence","lane":"history","start":1948,"end":1948,"approx":false,"note":"The declaration on 14 May preceded an expanding Arab–Israeli war; consequences included mass Palestinian displacement.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Israel%20declares%20independence","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-c83bca916a1e","title":"Italian Constitution enters into force","lane":"history","start":1948,"end":1948,"approx":false,"note":"Effective 1 January; the republican referendum was in 1946, not 1948.","creators":[],"reference":"https://en.wikipedia.org/wiki/Constitution_of_Italy","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-f3729b05595c","title":"OEEC established","lane":"history","start":1948,"end":1948,"approx":false,"note":"Coordinated European recovery cooperation; the OECD succeeded it in 1961.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=OEEC%20established","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-4f0a9b305a3d","title":"Republic of Korea and North Korea established","lane":"history","start":1948,"end":1948,"approx":false,"note":"Two rival states emerged on the divided Korean peninsula.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Republic%20of%20Korea%20and%20North%20Korea%20established","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-cd2447240dd6","title":"Berlin Blockade and Airlift","lane":"history","start":1948,"end":1949,"approx":false,"note":"Soviet blockade of western Berlin prompted an Allied airlift; the blockade ended in May 1949.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Berlin%20Blockade%20and%20Airlift","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["central","other","britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-bfa3e5d58344","title":"Federal Republic of Germany established","lane":"history","start":1949,"end":1949,"approx":false,"note":"The Basic Law took effect in May; Adenauer became chancellor in September.","creators":[],"reference":"https://en.wikipedia.org/wiki/West_Germany","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-3a68a48f2df6","title":"German Democratic Republic established","lane":"history","start":1949,"end":1949,"approx":false,"note":"The East German state was proclaimed in October in the Soviet occupation zone.","creators":[],"reference":"https://en.wikipedia.org/wiki/East_Germany","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-8e642606a646","title":"NATO founded","lane":"history","start":1949,"end":1949,"approx":false,"note":"The North Atlantic Treaty was signed on 4 April; West Germany joined only in 1955.","creators":[],"reference":"https://nato.int/en/about-us/organization/founding-treaty","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-af5cd43a0b7c","title":"People's Republic of China proclaimed","lane":"history","start":1949,"end":1949,"approx":false,"note":"Mao proclaimed the PRC on 1 October following communist victory on the mainland.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=People%27s%20Republic%20of%20China%20proclaimed","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-2cf0372e31ac","title":"NATO, Warsaw Pact and non-alignment","lane":"history","start":1949,"end":1991,"approx":true,"note":"The two military alliances structured much of Europe, but not every state belonged to either bloc. Non-alignment did not mean an absence of international interests.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=NATO%2C%20Warsaw%20Pact%20and%20non-alignment","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-f108e44753b8","title":"India becomes a republic","lane":"history","start":1950,"end":1950,"approx":false,"note":"Its constitution came into effect on 26 January.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=India%20becomes%20a%20republic","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-1476337f50c7","title":"Schuman Declaration","lane":"history","start":1950,"end":1950,"approx":false,"note":"Proposed pooling coal and steel production; a major step towards European integration.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Schuman%20Declaration","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["france","central","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-2150713273b5","title":"Korean War","lane":"history","start":1950,"end":1953,"approx":false,"note":"War began in June 1950; an armistice, not a peace treaty, ended major fighting in July 1953.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Korean%20War","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-11fbcb477877","title":"Notre-Dame du Haut, Ronchamp","lane":"architecture","start":1950,"end":1955,"approx":true,"note":"Sculptural concrete forms distinguish this chapel from the geometric white villas of the 1920s.","creators":["Le Corbusier"],"reference":"https://en.wikipedia.org/w/index.php?search=Notre-Dame%20du%20Haut%2C%20Ronchamp","sourceSheets":[3647],"sourceMapping":"supplemental context","dateType":"period","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-ad1f597b68fc","title":"Pop Art emerges","lane":"art","start":1950,"end":1960,"approx":true,"note":"British and American strands use mass media and consumer imagery in different ways.","creators":["Richard Hamilton","Andy Warhol","Roy Lichtenstein"],"reference":"https://en.wikipedia.org/w/index.php?search=Pop%20Art%20emerges","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["britain","other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t69-cdbf7b093e00","title":"Brutalism, exposed materials and social programmes","lane":"architecture","start":1950,"end":1970,"approx":true,"note":"Brutalism is associated with exposed construction and forceful form, often in public buildings. Not every concrete building is Brutalist, and the label has several origins.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Brutalism%2C%20exposed%20materials%20and%20social%20programmes","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["britain","shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-d2d377be824c","title":"Pop Art, reproduction and consumer imagery","lane":"art","start":1950,"end":1970,"approx":true,"note":"Commercial imagery, celebrity and repetition question distinctions between fine art and mass culture. Pop can be critical, ambiguous or fascinated rather than uniformly celebratory.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Pop%20Art%2C%20reproduction%20and%20consumer%20imagery","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["britain","other"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-ee4319a7bbb7","title":"European integration: ECSC, EEC and EU","lane":"history","start":1950,"end":1993,"approx":true,"note":"Coal and steel cooperation preceded the EEC; Maastricht established the EU later. Signature and entry into force are different dates; the Council of Europe is a separate organisation.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=European%20integration","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-1d31ab639f4f","title":"Treaty of Paris establishes ECSC","lane":"history","start":1951,"end":1951,"approx":false,"note":"Signed in 1951 and effective in 1952; the Coal and Steel Community united six founding states.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Paris%20establishes%20ECSC","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["france","central","italy","low"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-e4ea1b0eb335","title":"Unité d'Habitation in Marseille completed","lane":"architecture","start":1952,"end":1952,"approx":false,"note":"A postwar collective housing prototype combining apartments with shared services.","creators":["Le Corbusier"],"reference":"https://en.wikipedia.org/w/index.php?search=Unit%C3%A9%20d%27Habitation%20in%20Marseille%20completed","sourceSheets":[3647],"sourceMapping":"supplemental context","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-7a5680fb7185","title":"Stalin dies","lane":"history","start":1953,"end":1953,"approx":false,"note":"His death opened a struggle for succession and later changes in Soviet policy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Stalin%20dies","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-606a9ba6cd68","title":"Geneva agreements on Indochina","lane":"history","start":1954,"end":1954,"approx":false,"note":"The settlement ended the First Indochina War and temporarily divided Vietnam.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Geneva%20agreements%20on%20Indochina","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["france","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-40be293dd4cf","title":"Paris Agreements","lane":"history","start":1954,"end":1954,"approx":false,"note":"Prepared West German sovereignty and NATO membership and established the Western European Union framework.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paris%20Agreements","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central","britain","france","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-8f3cd8e6faed","title":"Warsaw Pact formed","lane":"history","start":1955,"end":1955,"approx":false,"note":"Formed after West Germany joined NATO; the two alliances structured much of Cold War Europe.","creators":[],"reference":"https://www.nato.int/cps/en/natohq/declassified_138294.htm","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-1567a6f536c5","title":"Hungarian uprising","lane":"history","start":1956,"end":1956,"approx":false,"note":"A revolt against Soviet-backed rule was suppressed by Soviet military intervention.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Hungarian%20uprising","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-4b6a1365ec28","title":"Khrushchev's Secret Speech","lane":"history","start":1956,"end":1956,"approx":false,"note":"Denounced aspects of Stalin's rule; de-Stalinisation had uneven limits.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Khrushchev%27s%20Secret%20Speech","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-bba9f1c1e6c8","title":"Suez Crisis","lane":"history","start":1956,"end":1956,"approx":false,"note":"Britain, France and Israel attacked Egypt after canal nationalisation; international pressure forced withdrawal.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Suez%20Crisis","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["britain","france","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-b9eb8d737ff9","title":"International Atomic Energy Agency established","lane":"history","start":1957,"end":1957,"approx":false,"note":"An international body for cooperation and safeguards in the peaceful use of nuclear technology.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=International%20Atomic%20Energy%20Agency%20established","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-c8162e658969","title":"Treaties of Rome signed","lane":"history","start":1957,"end":1957,"approx":false,"note":"Signed on 25 March; the EEC and Euratom treaties entered into force on 1 January 1958.","creators":[],"reference":"https://www.europarl.europa.eu/about-parliament/en/in-the-past/the-parliament-and-the-treaties/treaty-of-rome","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["italy","france","central","low"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-8dc592d23639","title":"Cuban Revolution","lane":"history","start":1959,"end":1959,"approx":false,"note":"Castro's movement overthrew Batista; Cold War alignment developed in the following years.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Cuban%20Revolution","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-bf1e282c4bdb","title":"Solomon R. Guggenheim Museum opens","lane":"architecture","start":1959,"end":1959,"approx":false,"note":"The New York museum's spiral ramp organises a continuous exhibition route.","creators":["Frank Lloyd Wright"],"reference":"https://en.wikipedia.org/wiki/Solomon_R._Guggenheim_Museum","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=b4535881c2987e5afb983468.webp","credit":"Ajay Suresh from New York, NY, USA","license":"CC BY 2.0","url":"https://commons.wikimedia.org/wiki/File:Solomon_R._Guggenheim_Museum_(48059131351).jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t68-b40bfd62dfc5","title":"Blue monochromes: series","lane":"art","start":1960,"end":1960,"approx":true,"note":"Klein made multiple blue monochromes; the sheet does not identify a specific work or inventory number.","creators":["Yves Klein"],"reference":"https://en.wikipedia.org/w/index.php?search=Blue%20monochromes%3A%20series","sourceSheets":[3647],"sourceMapping":"contextual identification","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","dateQualifier":"Source title / version unresolved","mediaType78":"visual-artwork","museumAssetId78":"M77-MOMA-80103","image":{"src":"/.netlify/functions/access?action=media&name=5d8085a21fdbcfa4eed893ff.webp","credit":"Yves Klein","license":"Image © respective rights holders · MoMA collection","url":"https://www.moma.org/collection/works/80103","scope":"Representative work from the series/cycle; the timeline range covers the series, not only this image. Shown: Blue Monochrome · 1961"},"imageChecked78":"2026-10-05"},{"id":"t68-d9e0d9ec2422","title":"OPEC founded","lane":"history","start":1960,"end":1960,"approx":false,"note":"Oil-producing states founded the organisation in Baghdad in September.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=OPEC%20founded","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-43937a98fd45","title":"Year of Africa","lane":"history","start":1960,"end":1960,"approx":false,"note":"Seventeen African countries gained independence, within a longer and uneven decolonisation process.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Year%20of%20Africa","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-65894a09bc50","title":"Conceptual art","lane":"art","start":1960,"end":1970,"approx":true,"note":"The idea, proposition or instruction can take priority over a unique crafted object.","creators":["Joseph Kosuth","Sol LeWitt"],"reference":"https://en.wikipedia.org/w/index.php?search=Conceptual%20art","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["shared"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-2dc976dc461e","title":"Land art","lane":"art","start":1960,"end":1970,"approx":true,"note":"Works engage sites and landscapes; not every work shares the same environmental ethics.","creators":["Robert Smithson"],"reference":"https://en.wikipedia.org/w/index.php?search=Land%20art","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-05fef4bb7648","title":"Minimalism","lane":"art","start":1960,"end":1970,"approx":true,"note":"Industrial materials, repetition and the viewer's bodily relation to space challenge traditional composition.","creators":["Donald Judd","Carl Andre"],"reference":"https://en.wikipedia.org/w/index.php?search=Minimalism","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t69-b90426723968","title":"Minimalism: serial form and the viewer's body","lane":"art","start":1960,"end":1970,"approx":true,"note":"Repeated industrial forms and real spatial relationships shift attention from expressive brushwork to the viewer's encounter with objects.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Minimalism","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["other"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-2578853cd51e","title":"Civil rights, feminism and social movements","lane":"history","start":1960,"end":1980,"approx":true,"note":"Movements challenged legal and social inequalities through different goals and strategies. Compare voting rights, workplace rights and broader forms of social power.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Civil%20rights%2C%20feminism%20and%20social%20movements","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-60141c2bafaa","title":"Conceptual art, instructions and documentation","lane":"art","start":1960,"end":1980,"approx":true,"note":"The proposition or process may be central while objects, photographs or text document it. Conceptual art does not mean that material presentation is always irrelevant.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Conceptual%20art%2C%20instructions%20and%20documentation","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-8d3d1dbbd0aa","title":"Land art and site specificity","lane":"art","start":1960,"end":1980,"approx":true,"note":"A work's location and physical conditions can be constitutive of it. Moving documentation into a museum is not equivalent to relocating the original site.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Land%20art%20and%20site%20specificity","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["other"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-158553c2fc72","title":"Performance, body art and temporary work","lane":"art","start":1960,"end":1980,"approx":true,"note":"An action, duration or bodily presence can form the work. Surviving photographs or videos may be documentation rather than the original event itself.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Performance%2C%20body%20art%20and%20temporary%20work","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-c84ac4097676","title":"Berlin Wall construction begins","lane":"history","start":1961,"end":1961,"approx":false,"note":"East German authorities began closing the border on 13 August.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Berlin%20Wall%20construction%20begins","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-6833d0768625","title":"Gagarin's first human spaceflight","lane":"history","start":1961,"end":1961,"approx":false,"note":"Vostok 1 orbited Earth on 12 April.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Gagarin%27s%20first%20human%20spaceflight","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-c6ed89a09ade","title":"Campbell's Soup Cans","lane":"art","start":1962,"end":1962,"approx":false,"note":"Serial presentation links consumer goods, repetition and art display.","creators":["Andy Warhol"],"reference":"https://en.wikipedia.org/w/index.php?search=Campbell%27s%20Soup%20Cans","sourceSheets":[3647],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","museumAssetId78":"M77-MOMA-79809","image":{"src":"/.netlify/functions/access?action=media&name=8c71502d5ec62828ec83c580.webp","credit":"Andy Warhol","license":"Image © respective rights holders · MoMA collection","url":"https://www.moma.org/collection/works/79809","scope":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: Campbell's Soup Cans · 1962"},"imageChecked78":"2026-10-05"},{"id":"t68-0540cb66932e","title":"Cuban Missile Crisis","lane":"history","start":1962,"end":1962,"approx":false,"note":"A US–Soviet confrontation over missiles in Cuba brought the Cold War close to nuclear conflict.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Cuban%20Missile%20Crisis","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-54fa48f16adc","title":"Drowning Girl","lane":"art","start":1963,"end":1963,"approx":false,"note":"Pop Art transforms a comic-book source through cropping, scale and painterly reconstruction.","creators":["Roy Lichtenstein"],"reference":"https://en.wikipedia.org/w/index.php?search=Drowning%20Girl","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","museumAssetId78":"M77-MOMA-80249","image":{"src":"/.netlify/functions/access?action=media&name=99a1de58ae6d6b0ac8627c33.webp","credit":"Roy Lichtenstein","license":"Image © respective rights holders · MoMA collection","url":"https://www.moma.org/collection/works/80249","scope":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: Drowning Girl · 1963"},"imageChecked78":"2026-10-05"},{"id":"t68-239d90664330","title":"John F. Kennedy assassinated","lane":"history","start":1963,"end":1963,"approx":false,"note":"The US president was killed in Dallas on 22 November.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=John%20F.%20Kennedy%20assassinated","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-b322d0b665af","title":"Spatial Concept, Expectations: series","lane":"art","start":1965,"end":1965,"approx":true,"note":"Slashed canvases investigate real space; the sheet labels a series, not one uniquely dated canvas.","creators":["Lucio Fontana"],"reference":"https://en.wikipedia.org/w/index.php?search=Spatial%20Concept%2C%20Expectations%3A%20series","sourceSheets":[3646],"sourceMapping":"contextual identification","dateType":"year","threads67":["italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","dateQualifier":"Source title / version unresolved","mediaType78":"visual-artwork","museumAssetId78":"M77-MOMA-79637","image":{"src":"/.netlify/functions/access?action=media&name=d430361fd6eecea3ff62e8ec.webp","credit":"Lucio Fontana","license":"Image © respective rights holders · MoMA collection","url":"https://www.moma.org/collection/works/79637","scope":"Representative work from the series/cycle; the timeline range covers the series, not only this image. Shown: Spatial Concept: Expectations · 1959"},"imageChecked78":"2026-10-05"},{"id":"t68-41f4d136f827","title":"Arte Povera named","lane":"art","start":1967,"end":1967,"approx":false,"note":"An Italian critical grouping using humble materials and questioning cultural institutions.","creators":["Germano Celant"],"reference":"https://en.wikipedia.org/wiki/Arte_Povera","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-fc7b668a1e73","title":"European Communities Merger Treaty takes effect","lane":"history","start":1967,"end":1967,"approx":false,"note":"A single Commission and Council served the Communities; the separate treaties did not simply disappear.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=European%20Communities%20Merger%20Treaty%20takes%20effect","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-f03a18851a08","title":"Arte Povera and unconventional materials","lane":"art","start":1967,"end":1980,"approx":true,"note":"Artists used materials such as earth, cloth, wood and industrial components to question established artistic and economic values. Povera does not describe a lack of artistic skill.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Arte%20Povera%20and%20unconventional%20materials","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-4b29577f27ba","title":"Martin Luther King Jr. and Robert Kennedy assassinated","lane":"history","start":1968,"end":1968,"approx":false,"note":"King was killed in April and Kennedy in June; distinguish their roles and circumstances.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Martin%20Luther%20King%20Jr.%20and%20Robert%20Kennedy%20assassinated","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-443f576165ac","title":"Prague Spring and Warsaw Pact invasion","lane":"history","start":1968,"end":1968,"approx":false,"note":"Czechoslovak reform efforts were suppressed by an invasion in August.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Prague%20Spring%20and%20Warsaw%20Pact%20invasion","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-801652e3c3d3","title":"Apollo 11 Moon landing","lane":"history","start":1969,"end":1969,"approx":false,"note":"Armstrong and Aldrin landed on the Moon; Collins remained in lunar orbit.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Apollo%2011%20Moon%20landing","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-fb476bcfcf5f","title":"Postmodern architecture and historical quotation","lane":"architecture","start":1970,"end":1990,"approx":true,"note":"Historical reference, symbolism and critiques of modernist uniformity take multiple forms. Postmodern is not a label for every building constructed after 1970.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Postmodern%20architecture%20and%20historical%20quotation","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-c02592f5bdbd","title":"High-tech architecture and expressed services","lane":"architecture","start":1970,"end":2000,"approx":true,"note":"Structure and building services may be made visually prominent. Exposed ducts alone are insufficient to identify the movement or architect.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=High-tech%20architecture%20and%20expressed%20services","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["britain","france"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-aabd24d12920","title":"Sydney Opera House opens","lane":"architecture","start":1973,"end":1973,"approx":false,"note":"Opened after a long construction process; Utzon left the project in 1966.","creators":["Jørn Utzon"],"reference":"https://en.wikipedia.org/wiki/Sydney_Opera_House","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=68fd5d07dd7a011236cd1b39.webp","credit":"Bernard Spragg. NZ from Christchurch, New Zealand","license":"CC0","url":"https://commons.wikimedia.org/wiki/File:Sydney_Australia._(21339175489).jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t68-9a6a55d7dc1f","title":"Khmer Rouge rule in Cambodia","lane":"history","start":1975,"end":1979,"approx":false,"note":"Pol Pot's regime perpetrated mass killings, forced labour and widespread persecution.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Khmer%20Rouge%20rule%20in%20Cambodia","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-586528e7061c","title":"Year of three popes","lane":"history","start":1978,"end":1978,"approx":false,"note":"Paul VI died, John Paul I had a brief papacy, and John Paul II was elected.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Year%20of%20three%20popes","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-44b78a5cecc2","title":"Iranian Revolution and Islamic Republic","lane":"history","start":1979,"end":1979,"approx":false,"note":"The monarchy fell and an Islamic Republic was established; the revolution brought together competing forces.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Iranian%20Revolution%20and%20Islamic%20Republic","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-b3018dedd875","title":"Transavanguardia named","lane":"art","start":1979,"end":1979,"approx":false,"note":"An Italian critical label associated with a return to expressive painting.","creators":["Achille Bonito Oliva"],"reference":"https://en.wikipedia.org/wiki/Transavantgarde","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t69-59cb77b75243","title":"Deconstructivist architectural form","lane":"architecture","start":1980,"end":2000,"approx":true,"note":"Fragmentation and disrupted geometries challenge expectations of stable composition. The 1988 MoMA exhibition grouped diverse architects, not a single construction system.","creators":[],"reference":"https://www.moma.org/calendar/exhibitions/1813?locale=en","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-056b75a1d3e1","title":"Chernobyl nuclear disaster","lane":"history","start":1986,"end":1986,"approx":false,"note":"A reactor accident on 26 April had widespread environmental and political consequences.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Chernobyl%20nuclear%20disaster","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-9614e43295db","title":"Fall of the Berlin Wall","lane":"history","start":1989,"end":1989,"approx":false,"note":"Border crossings opened on 9 November; German reunification followed in 1990.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Fall%20of%20the%20Berlin%20Wall","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-cc2ddaa5734f","title":"Malta Summit","lane":"history","start":1989,"end":1989,"approx":false,"note":"Bush and Gorbachev met during the rapid transformation of Cold War Europe.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Malta%20Summit","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-8495714b738c","title":"Tiananmen Square crackdown","lane":"history","start":1989,"end":1989,"approx":false,"note":"Chinese authorities violently suppressed a protest movement in June.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Tiananmen%20Square%20crackdown","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-ed7b257a701d","title":"Globalisation and economic interdependence","lane":"history","start":1989,"end":2008,"approx":true,"note":"Cross-border trade, finance, production and information increased interdependence. These processes predate 1989 and do not erase national institutions or inequalities.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Globalisation%20and%20economic%20interdependence","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-a36e80562565","title":"German reunification","lane":"history","start":1990,"end":1990,"approx":false,"note":"The German Democratic Republic joined the Federal Republic on 3 October.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=German%20reunification","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-f18cb569fc3d","title":"Dissolution of the Soviet Union","lane":"history","start":1991,"end":1991,"approx":false,"note":"The USSR ceased to exist in December; successor states followed different political paths.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Dissolution%20of%20the%20Soviet%20Union","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-93bcf7591cca","title":"Maastricht Treaty signed","lane":"history","start":1992,"end":1992,"approx":false,"note":"Signed on 7 February; the European Union formally began when the treaty entered into force in 1993.","creators":[],"reference":"https://european-union.europa.eu/principles-countries-history/history-eu/1990-99_en","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-49e132b50907","title":"European Union established","lane":"history","start":1993,"end":1993,"approx":false,"note":"The Maastricht Treaty entered into force on 1 November.","creators":[],"reference":"https://eur-lex.europa.eu/collection/eu-law/treaties/treaties-founding.html?locale=en","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05"},{"id":"t68-013f78bb29b1","title":"NAFTA enters into force","lane":"history","start":1994,"end":1994,"approx":false,"note":"A trade agreement between Canada, Mexico and the United States; later replaced by USMCA.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=NAFTA%20enters%20into%20force","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-cade75e570dc","title":"September 11 attacks","lane":"history","start":2001,"end":2001,"approx":false,"note":"Al-Qaeda attacks in the United States reshaped international security policy.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=September%2011%20attacks","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-2bc69ad18e52","title":"Lehman Brothers bankruptcy","lane":"history","start":2008,"end":2008,"approx":false,"note":"The September collapse intensified the global financial crisis; the crisis had begun earlier.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Lehman%20Brothers%20bankruptcy","sourceSheets":[3648],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-902246beb578","title":"Arab Spring uprisings begin","lane":"history","start":2010,"end":2011,"approx":false,"note":"Beginning in Tunisia in late 2010, protests spread in 2011 with different outcomes by country.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Arab%20Spring%20uprisings%20begin","sourceSheets":[3648],"sourceMapping":"item","dateType":"period","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t106-WORLD106-01","title":"Angkor","lane":"architecture","start":800,"end":1500,"approx":true,"note":"Angkor combines temples, reservoirs and urban infrastructure. Angkor Wat and the Bayon belong to different building campaigns; the long range describes the city, not one temple.","creators":[],"reference":"https://whc.unesco.org/en/list/668/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southeastasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-02","title":"Taj Mahal","lane":"architecture","start":1632,"end":1653,"approx":true,"note":"Shah Jahan commissioned this mausoleum for Mumtaz Mahal. Read the white marble tomb together with its garden and symmetrical complex; it is a funerary monument, not a royal residence.","creators":[],"reference":"https://whc.unesco.org/en/list/252/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-03","title":"Borobudur","lane":"architecture","start":750,"end":850,"approx":true,"note":"A Buddhist monument with square terraces below circular platforms and a crowning stupa. The ascending route organizes reliefs and repeated stupas into a spatial sequence.","creators":[],"reference":"https://whc.unesco.org/en/list/592/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southeastasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-04","title":"Petra","lane":"architecture","start":-300,"end":100,"approx":true,"note":"Nabataean Petra combined caravan commerce, rock-cut architecture and careful water management. Carved facades do not mean that every part of the city was cut into rock.","creators":[],"reference":"https://whc.unesco.org/en/list/326/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["westasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-05","title":"Machu Picchu","lane":"architecture","start":1400,"end":1500,"approx":true,"note":"The Inca site joins stone buildings, terraces and steep mountain terrain. Its fifteenth-century setting distinguishes it from earlier Andean cultures such as the Moche.","creators":[],"reference":"https://whc.unesco.org/en/list/274/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["americas"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-06","title":"Chichén Itzá","lane":"architecture","start":600,"end":1200,"approx":true,"note":"Temple pyramids, a large ball court and other monuments show a Maya city with wider Mesoamerican connections. Do not confuse it with Teotihuacan in central Mexico.","creators":[],"reference":"https://whc.unesco.org/en/list/483/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["americas"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-07","title":"Teotihuacan","lane":"architecture","start":1,"end":700,"approx":true,"note":"The Avenue of the Dead links monumental precincts including the Sun and Moon pyramids. The city flourished many centuries before the Aztec Empire; its builders should not be labelled Aztec.","creators":[],"reference":"https://whc.unesco.org/en/list/414/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["americas"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-08","title":"Rapa Nui: moai","lane":"architecture","start":1000,"end":1600,"approx":true,"note":"The moai are monumental stone figures associated with a Polynesian island society. Many stand on ceremonial platforms called ahu. The range is a broad period, not a date for every statue.","creators":[],"reference":"https://whc.unesco.org/en/list/715/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["oceania"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-09","title":"Himeji Castle","lane":"architecture","start":1601,"end":1609,"approx":true,"note":"White plastered surfaces cover a sophisticated timber castle. Gates, walls and routes form a defensive system: its appearance is not simply ornamental.","creators":[],"reference":"https://whc.unesco.org/en/list/661/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["japan"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-10","title":"Forbidden City","lane":"architecture","start":1406,"end":1420,"approx":true,"note":"Beijing's imperial palace developed as a hierarchy of courts and halls along an axis. The initial Ming construction dates do not imply that every surviving structure is original.","creators":[],"reference":"https://whc.unesco.org/en/list/439/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["china"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-11","title":"Temple of Heaven","lane":"architecture","start":1406,"end":1420,"approx":true,"note":"This ceremonial complex relates imperial ritual to ideas of heaven and earth. Read its symbolism and layout as a religious-political landscape rather than a residential palace.","creators":[],"reference":"https://whc.unesco.org/en/list/881/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["china"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-12","title":"Potala Palace","lane":"architecture","start":1600,"end":1700,"approx":true,"note":"The palace was a winter residence of the Dalai Lama and a centre of Tibetan Buddhist authority. Its major seventeenth-century development stands on a site with earlier history.","creators":[],"reference":"https://whc.unesco.org/en/list/707/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["china"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-13","title":"Lalibela: rock-hewn churches","lane":"architecture","start":1200,"end":1300,"approx":true,"note":"Eleven medieval churches were carved from rock and connected by trenches and passages. Excavating spaces and leaving structural masses produces architecture by subtraction.","creators":[],"reference":"https://whc.unesco.org/en/list/18/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-14","title":"Great Zimbabwe","lane":"architecture","start":1100,"end":1500,"approx":true,"note":"The ruins record a Shona urban and trading centre. Carefully fitted granite walls, especially the Great Enclosure, challenge the idea that monumental African architecture was limited to Egypt.","creators":[],"reference":"https://whc.unesco.org/en/list/364/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-15","title":"Djenné: historic town","lane":"architecture","start":1400,"end":1600,"approx":true,"note":"Earthen construction links the town's buildings to local materials and continuing maintenance. The range describes a historic urban phase, not the construction date of today's Great Mosque.","creators":[],"reference":"https://whc.unesco.org/en/list/116/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-16","title":"Persepolis","lane":"architecture","start":-518,"end":-330,"approx":true,"note":"Darius I began the Achaemenid palace complex on a monumental terrace. Reliefs and ceremonial spaces expressed imperial authority; this is not a Greek polis.","creators":[],"reference":"https://whc.unesco.org/en/list/114/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["westasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-17","title":"Sanchi","lane":"architecture","start":-300,"end":1200,"approx":true,"note":"Stupas, gateways and other remains trace a long Buddhist history beginning in the Mauryan period. The stupa is a sacred mound or reliquary monument, not an ordinary dwelling.","creators":[],"reference":"https://whc.unesco.org/en/list/524/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-18","title":"Khajuraho","lane":"architecture","start":950,"end":1050,"approx":true,"note":"The surviving temples combine towered sanctuaries with extensive sculpture. Both Hindu and Jain monuments are represented; reducing the site to erotic imagery misses its wider religious programme.","creators":[],"reference":"https://whc.unesco.org/en/list/240/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-19","title":"Bagan","lane":"architecture","start":1000,"end":1300,"approx":true,"note":"Thousands of Buddhist monuments form a landscape shaped by patronage and merit-making. The selected range describes the principal building era, not every restoration.","creators":[],"reference":"https://whc.unesco.org/en/list/1588/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southeastasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-20","title":"Samarkand","lane":"architecture","start":1300,"end":1500,"approx":true,"note":"Samarkand links Silk Road exchange with Timurid monuments and scholarship. The Registan, Bibi-Khanum Mosque and Ulugh Beg's observatory have different functions and building histories.","creators":[],"reference":"https://whc.unesco.org/en/list/603/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["westasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-21","title":"Hampi","lane":"architecture","start":1300,"end":1600,"approx":true,"note":"The former Vijayanagara capital brings together temples, royal structures and a dramatic rocky landscape. The ruins belong to a major southern Indian kingdom, not to Mughal Agra.","creators":[],"reference":"https://whc.unesco.org/en/list/241/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-22","title":"Konark Sun Temple","lane":"architecture","start":1200,"end":1300,"approx":true,"note":"The temple gives architectural form to the chariot of Surya, the sun god. Carved wheels and horses turn an entire building into a religious image.","creators":[],"reference":"https://whc.unesco.org/en/list/246/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-23","title":"Mogao Caves","lane":"architecture","start":366,"end":1400,"approx":true,"note":"Wall paintings and sculpture preserve many centuries of Buddhist art along the Silk Road. The caves also connect art history with manuscripts and intercultural exchange.","creators":[],"reference":"https://whc.unesco.org/en/list/440/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["china"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-WORLD106-24","title":"Longmen Grottoes","lane":"architecture","start":493,"end":750,"approx":true,"note":"Rock-cut Buddhist images reveal changing styles and patronage, especially under Northern Wei and Tang rule. Compare carved stone at Longmen with painted cave interiors at Mogao.","creators":[],"reference":"https://whc.unesco.org/en/list/1003/","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["china"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"building","dateQualifier":"approximate phase","revision106":true},{"id":"t106-ART106-WAVE","title":"The Great Wave off Kanagawa","lane":"art","start":1830,"end":1832,"approx":true,"note":"Look for tiny Mount Fuji beneath the crest and the three boats. This is a Japanese woodblock print from Thirty-six Views of Mount Fuji, not an oil painting; size and framing make the mountain seem vulnerable.","creators":["Katsushika Hokusai"],"reference":"https://www.metmuseum.org/art/collection/search/56353","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["japan"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"visual-artwork","dateQualifier":"approximate phase","revision106":true,"image":{"src":"/.netlify/functions/access?action=media&name=7a9876bf5d16e4975c1373d8.webp","credit":"The Met · Henry L. Phillips Collection, Bequest of Henry L. Phillips, 1939 · JP2972","license":"Public Domain / CC0","url":"https://www.metmuseum.org/art/collection/search/56353","scope":"Exact collection object"}},{"id":"t106-ART106-SHIVA","title":"Shiva as Lord of Dance (Nataraja)","lane":"art","start":1175,"end":1225,"approx":true,"note":"The dancing Shiva combines movement with balance. A drum evokes creation and a flame destruction; the figure underfoot represents illusion. The copper-alloy sculpture belongs to a Hindu context, unlike a Buddha image.","creators":["Tamil Nadu; Chola-period artist"],"reference":"https://www.metmuseum.org/art/collection/search/39329","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"visual-artwork","dateQualifier":"approximate phase","revision106":true,"image":{"src":"/.netlify/functions/access?action=media&name=a500377e61325fe6adaf355d.webp","credit":"The Metropolitan Museum of Art · collection record 39329","license":"Public Domain / CC0","url":"https://www.metmuseum.org/art/collection/search/39329","scope":"Exact collection object"}},{"id":"t106-ART106-BENIN","title":"Plaque with equestrian oba and attendants","lane":"art","start":1540,"end":1570,"approx":true,"note":"Compare the scale of the king with his attendants: relative size communicates rank. This is cast brass court art from Benin in present-day Nigeria. The wider tradition was dispersed through the British looting of the palace in 1897; provenance is part of its history.","creators":["Ìgùn Ẹ́rọ̀nwwọ̀n brass-casting guild; Edo peoples"],"reference":"https://www.metmuseum.org/art/collection/search/310752","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"visual-artwork","dateQualifier":"approximate phase","revision106":true,"image":{"src":"/.netlify/functions/access?action=media&name=28b030e85938259719c379a5.webp","credit":"The Met · Michael C. Rockefeller Memorial Collection, Gift of Nelson A. Rockefeller, 1965 · 1978.412.309","license":"Public Domain / CC0","url":"https://www.metmuseum.org/art/collection/search/310752","scope":"Exact collection object"}},{"id":"t106-ART106-BUDDHA","title":"Buddha, dated 680","lane":"art","start":680,"end":680,"approx":false,"note":"This marble Buddha is explicitly dated 680 in the collection record. Separate the date of this object from the much longer Tang dynasty (618–907); a dynasty is context, not an exact date for every work.","creators":["China; Tang dynasty"],"reference":"https://www.metmuseum.org/art/collection/search/39756","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"year","threads67":["china"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"visual-artwork","dateQualifier":"object","revision106":true,"image":{"src":"/.netlify/functions/access?action=media&name=5967deeafe9477a3b7a00b4c.webp","credit":"The Met · Gift of Enid A. Haupt, 1997 · 1997.442.3","license":"Public Domain / CC0","url":"https://www.metmuseum.org/art/collection/search/39756","scope":"Exact collection object"}},{"id":"t106-ART106-IZNIK","title":"Bowl with Variation of 'Baba Nakkas' Design","lane":"art","start":1500,"end":1525,"approx":true,"note":"Blue and white floral decoration lies beneath a transparent glaze on stonepaste. The attribution is to Iznik; the design-family name does not securely identify the individual potter. Notice how ornament follows the curved vessel.","creators":["Attributed to Iznik, Turkey"],"reference":"https://www.metmuseum.org/art/collection/search/448664","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["westasia"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"visual-artwork","dateQualifier":"approximate phase","revision106":true,"image":{"src":"/.netlify/functions/access?action=media&name=e3881bf3b8fd197151f8c619.webp","credit":"The Met · Rogers Fund, 1932 · 32.34","license":"Public Domain / CC0","url":"https://www.metmuseum.org/art/collection/search/448664","scope":"Exact collection object"}},{"id":"t106-ART106-MOCHE","title":"Stirrup Spout Bottle with Portrait Head","lane":"art","start":200,"end":500,"approx":true,"note":"The portrait head is also a ceramic vessel, with a stirrup-shaped spout joining its passages. The Moche context predates the Inca Empire by centuries; shared geography does not mean a single culture or period.","creators":["Moche culture, Peru"],"reference":"https://www.metmuseum.org/art/collection/search/308531","referenceChecked":true,"referenceCheckedAt":"9 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["americas"],"setting67":"Selected cultural context; dates describe the recorded phase","mediaType78":"visual-artwork","dateQualifier":"approximate phase","revision106":true,"image":{"src":"/.netlify/functions/access?action=media&name=0029897780edc5a22d324af4.webp","credit":"The Met · Gift of Mr. and Mrs. Nathan Cummings, 1964 · 64.228.25","license":"Public Domain / CC0","url":"https://www.metmuseum.org/art/collection/search/308531","scope":"Exact collection object"}},{"id":"t108-WORLD108-01","title":"Stonehenge","lane":"architecture","start":-3000,"end":-1600,"approx":true,"note":"Megalithic construction combines upright stones and lintels. Study the monument as a sequence of prehistoric phases rather than a building made at one moment.","creators":[],"reference":"https://whc.unesco.org/en/list/373/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["britain"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-02","title":"Skara Brae","lane":"architecture","start":-3100,"end":-2500,"approx":true,"note":"Stone-built houses preserve domestic space and fittings. Compare this settlement with ceremonial stone circles: prehistoric architecture also includes everyday dwellings.","creators":[],"reference":"https://whc.unesco.org/en/list/514/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["britain"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-03","title":"Newgrange","lane":"architecture","start":-3300,"end":-2900,"approx":true,"note":"A passage leads into a chamber within a mound. Its carved stones and relationship to the winter solstice connect burial architecture, imagery and the seasonal cycle.","creators":[],"reference":"https://whc.unesco.org/en/list/659/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["britain"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-04","title":"Mycenae","lane":"architecture","start":-1600,"end":-1100,"approx":true,"note":"Fortification walls, the Lion Gate and tholos tombs belong to Bronze Age Greece. They precede the Classical temples of fifth-century BCE Athens.","creators":[],"reference":"https://whc.unesco.org/en/list/941/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["eastmed"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-05","title":"Delphi","lane":"architecture","start":-800,"end":-300,"approx":true,"note":"The sanctuary of Apollo linked an oracle, treasuries, temples and athletic competition. Its hillside setting differs from a regular urban grid.","creators":[],"reference":"https://whc.unesco.org/en/list/393/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["eastmed"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-06","title":"Olympia","lane":"architecture","start":-800,"end":400,"approx":true,"note":"A sanctuary of Zeus and the setting of the ancient Olympic Games. Religious monuments and athletic spaces belong to the same complex.","creators":[],"reference":"https://whc.unesco.org/en/list/517/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["eastmed"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-07","title":"Ephesus","lane":"architecture","start":-300,"end":300,"approx":true,"note":"The Library of Celsus and theatre exemplify monumental urban life. Distinguish the Roman city remains from the earlier fame of the Temple of Artemis.","creators":[],"reference":"https://whc.unesco.org/en/list/1018/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["eastmed"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-08","title":"Carthage","lane":"architecture","start":-800,"end":500,"approx":true,"note":"A Phoenician foundation became Rome's great Mediterranean rival. The archaeological site also contains a later Roman city; its remains do not all belong to one culture.","creators":[],"reference":"https://whc.unesco.org/en/list/37/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-09","title":"Leptis Magna","lane":"architecture","start":1,"end":300,"approx":true,"note":"Public buildings, streets and harbour remains reveal a major Roman city in North Africa. Compare provincial Roman urbanism with monuments in Rome itself.","creators":[],"reference":"https://whc.unesco.org/en/list/183/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-10","title":"Timgad","lane":"architecture","start":100,"end":300,"approx":true,"note":"Trajan founded the colony in 100 CE. The orthogonal street network makes it useful for learning cardo, decumanus and Roman planning beyond Italy.","creators":[],"reference":"https://whc.unesco.org/en/list/194/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["africa"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-11","title":"Ajanta Caves","lane":"architecture","start":-200,"end":600,"approx":true,"note":"Monastic spaces, worship halls, paintings and sculpture form a Buddhist cave complex. Distinguish this context from Ellora's multiple religious traditions.","creators":[],"reference":"https://whc.unesco.org/en/list/242/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-12","title":"Ellora Caves","lane":"architecture","start":600,"end":1000,"approx":true,"note":"Buddhist, Hindu and Jain monuments coexist at Ellora. The Kailasa temple demonstrates how subtractive carving can produce an apparently freestanding architectural mass.","creators":[],"reference":"https://whc.unesco.org/en/list/243/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-13","title":"Elephanta Caves","lane":"architecture","start":400,"end":600,"approx":true,"note":"The principal cave centres on Shiva and monumental sculptural programmes. It should not be classified as a Buddhist monastery simply because it is rock-cut.","creators":[],"reference":"https://whc.unesco.org/en/list/244/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-14","title":"Fatehpur Sikri","lane":"architecture","start":1571,"end":1585,"approx":true,"note":"Akbar's planned capital combines courtly and religious spaces. Compare it with the later Taj Mahal: both are Mughal, but one is a city and the other a mausoleum.","creators":[],"reference":"https://whc.unesco.org/en/list/255/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-15","title":"Humayun's Tomb","lane":"architecture","start":1560,"end":1572,"approx":true,"note":"A monumental tomb set in a formal garden, important for the development of Mughal funerary architecture. Its function and setting provide context for the later Taj Mahal.","creators":[],"reference":"https://whc.unesco.org/en/list/232/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-16","title":"Qutb Minar","lane":"architecture","start":1199,"end":1369,"approx":true,"note":"The tall minaret belongs to an early Islamic monumental complex in Delhi. Its long construction history predates the Mughal period.","creators":[],"reference":"https://whc.unesco.org/en/list/233/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-17","title":"Tōdai-ji","lane":"architecture","start":700,"end":800,"approx":true,"note":"An eighth-century Buddhist foundation associated with the Great Buddha. Present buildings include later reconstructions, so foundation and surviving fabric have different dates.","creators":[],"reference":"https://whc.unesco.org/en/list/870/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["japan"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-18","title":"Itsukushima Shrine","lane":"architecture","start":1100,"end":1200,"approx":true,"note":"The shrine's relationship to tidal water and the sacred island is central to its design. The twelfth-century development should not be confused with the dates of later repairs.","creators":[],"reference":"https://whc.unesco.org/en/list/776/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["japan"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-19","title":"Brasília: civic centre","lane":"architecture","start":1956,"end":1960,"approx":false,"note":"Lúcio Costa's urban plan and Oscar Niemeyer's civic buildings make Brasília a key modernist capital. Urban layout and individual buildings are related but distinct design scales.","creators":["Urban plan: Lúcio Costa; civic buildings: Oscar Niemeyer"],"reference":"https://whc.unesco.org/en/list/445/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["americas"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-20","title":"Chandigarh Capitol Complex","lane":"architecture","start":1950,"end":1965,"approx":false,"note":"Le Corbusier's governmental complex connects exposed concrete, monumental form and climate-conscious design. It belongs to a planned city developed after Indian independence.","creators":["Le Corbusier"],"reference":"https://whc.unesco.org/en/list/1321/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["southasia"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-21","title":"Zollverein: Shaft XII","lane":"architecture","start":1928,"end":1932,"approx":false,"note":"The coal-mining complex links industrial production with carefully ordered modern architecture. Later reuse makes it useful for comparing original function and heritage adaptation.","creators":["Fritz Schupp and Martin Kremmer"],"reference":"https://whc.unesco.org/en/list/975/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["central"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-22","title":"Le Havre: reconstructed centre","lane":"architecture","start":1945,"end":1964,"approx":false,"note":"Auguste Perret led the postwar rebuilding of the city centre. A consistent structural vocabulary and urban plan show modern reconstruction at the scale of a whole district.","creators":["Auguste Perret and team"],"reference":"https://whc.unesco.org/en/list/1181/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["france"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-23","title":"White City of Tel Aviv","lane":"architecture","start":1930,"end":1950,"approx":false,"note":"Modernist buildings adapt European design ideas to local climatic conditions. The district illustrates the international circulation and local transformation of architectural principles.","creators":[],"reference":"https://whc.unesco.org/en/list/1096/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["eastmed"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true},{"id":"t108-WORLD108-24","title":"Fallingwater","lane":"architecture","start":1935,"end":1939,"approx":false,"note":"Frank Lloyd Wright's house joins cantilevered terraces with a waterfall and rocky site. Learn the relationship between structure, interior space and landscape rather than treating the house as an isolated object.","creators":["Frank Lloyd Wright"],"reference":"https://whc.unesco.org/en/list/1496/","referenceChecked":true,"referenceCheckedAt":"10 Oct 2026","sourceSheets":[],"sourceMapping":"institution","dateType":"period","threads67":["americas"],"setting67":"Selected construction or cultural phase","mediaType78":"architecture","dateQualifier":"phase, not all surviving fabric","revision108":true}],"edges":[{"from":"t63-eff698784975","to":"t63-1e91be5893d7","label":"Creator / contributor","type":"creator"},{"from":"t63-c03fe5695171","to":"t63-3d58dd23eb05","label":"Creator / contributor","type":"creator"},{"from":"t63-35de9f699240","to":"t63-badbb42d6186","label":"Creator / contributor","type":"creator"},{"from":"t63-456b606312bd","to":"t63-03dc9215ae54","label":"Creator / contributor","type":"creator"},{"from":"t63-730d1d811584","to":"t63-03dc9215ae54","label":"Creator / contributor","type":"creator"},{"from":"t63-e145d583437d","to":"t63-03dc9215ae54","label":"Creator / contributor","type":"creator"},{"from":"t63-668273af8ddb","to":"t63-68b505031471","label":"Creator / contributor","type":"creator"},{"from":"t63-8ad5f2444cb8","to":"t63-8103a5e6f190","label":"Creator / contributor","type":"creator"},{"from":"t63-5bdad2022390","to":"