:"lifespan","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-8c0e641c9143","title":"Rucellai Madonna","lane":"art","start":1285,"end":1285,"approx":false,"note":"Commissioned for Santa Maria Novella; formerly attributed to Cimabue.","creators":["Duccio"],"reference":"https://en.wikipedia.org/wiki/Rucellai_Madonna","sourceSheets":[3636],"sourceMapping":"item","dateType":"year","image":{"src":"/.netlify/functions/access?action=media&name=416a10bf7e802ce68e457650.webp","credit":"Gleb Simonov","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Duccio_-_Rucellai_Madonna.jpg"},"threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t63-f513c25f837f","title":"Ambrogio Lorenzetti","lane":"people","start":1290,"end":1348,"approx":true,"note":"Sienese painter; approximate dates.","creators":[],"reference":"https://en.wikipedia.org/wiki/Ambrogio_Lorenzetti","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-fb32fe650502","title":"Santa Croce, Florence","lane":"architecture","start":1294,"end":1442,"approx":true,"note":"Main medieval campaign; consecrated 1442. Design traditionally attributed to Arnolfo.","creators":["Arnolfo di Cambio"],"reference":"https://en.wikipedia.org/wiki/Basilica_of_Santa_Croce,_Florence","sourceSheets":[3636],"sourceMapping":"item","dateType":"period","dateQualifier":"Traditional","image":{"src":"/.netlify/functions/access?action=media&name=057225231cdade009bc5df56.webp","credit":"Diego Delso","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Bas%C3%ADlica_de_la_Santa_Cruz,_Florencia,_Italia,_2022-09-18,_DD_95.jpg"},"threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-80cc2270872b","title":"Florence Cathedral: foundation","lane":"architecture","start":1296,"end":1296,"approx":false,"note":"Construction begins; Brunelleschi's dome is a later phase.","creators":["Arnolfo di Cambio"],"reference":"https://en.wikipedia.org/wiki/Florence_Cathedral","sourceSheets":[3635],"sourceMapping":"item","dateType":"year","image":{"src":"/.netlify/functions/access?action=media&name=f198a613a24e71aef0043577.webp","credit":"Gary Campbell-Hall","license":"CC BY 2.0","url":"https://commons.wikimedia.org/wiki/File:Cattedrale_di_Santa_Maria_del_Fiore_%E2%80%93_Il_Duomo_di_Firenze.jpg","scope":"Building as photographed; not a reconstruction of this historical phase."},"threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-aa426748eb63","title":"Foundation of the Ottoman dynasty","lane":"history","start":1299,"end":1299,"approx":true,"note":"Conventional date associated with Osman I.","creators":[],"reference":"https://en.wikipedia.org/wiki/Ottoman_Empire","sourceSheets":[3635],"sourceMapping":"period context","dateType":"year","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-8ecf04cbb75b","title":"Guillaume de Machaut","lane":"people","start":1300,"end":1377,"approx":true,"note":"Composer and poet; birth approximate.","creators":[],"reference":"https://en.wikipedia.org/wiki/Guillaume_de_Machaut","sourceSheets":[3636],"sourceMapping":"period context","dateType":"lifespan","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t69-80c505ac0141","title":"Giotto and pictorial space","lane":"art","start":1300,"end":1400,"approx":true,"note":"Weight, gesture and spatial organisation make figures interact convincingly. Giotto's spatial experiments precede the formal theory of single-point linear perspective.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Giotto%20and%20pictorial%20space","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t69-1fdf795da618","title":"Humanism and the studia humanitatis","lane":"history","start":1300,"end":1500,"approx":true,"note":"Humanism emphasised the study of rhetoric, grammar, poetry, history and moral philosophy through ancient texts. It was not simply atheism or an interest in human anatomy.","creators":[],"reference":"https://www.metmuseum.org/essays/architecture-in-renaissance-italy","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-084fdfcc4e9f","title":"Outrage of Anagni","lane":"history","start":1303,"end":1303,"approx":false,"note":"Boniface VIII and agents of Philip IV.","creators":[],"reference":"https://en.wikipedia.org/wiki/Outrage_of_Anagni","sourceSheets":[3636],"sourceMapping":"period context","dateType":"year","threads67":["italy"],"setting67":"Historical setting"},{"id":"t63-8deb8e6e5394","title":"Scrovegni Chapel frescoes","lane":"art","start":1303,"end":1305,"approx":true,"note":"Padua; narrative cycle of Mary and Christ.","creators":["Giotto"],"reference":"https://en.wikipedia.org/wiki/Scrovegni_Chapel","sourceSheets":[3636],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=8f920a7a57c4cb98f9e2d3d5.webp","credit":"Zairon","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Padova_Cappella_degli_Scrovegni_Innen_Langhaus_West_5.jpg","scope":"work"},"threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork"},{"id":"t63-446b1a7309b7","title":"Petrarch","lane":"people","start":1304,"end":1374,"approx":false,"note":"Poet and humanist.","cr