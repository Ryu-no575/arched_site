://en.wikipedia.org/wiki/Hundred_Years%27_War","sourceMetadata95":{"id":"B03-S-Hundred_Years","key":"Hundred_Years","title":"Encyclopaedia reference — Hundred Years' War","url":"https://en.wikipedia.org/wiki/Hundred_Years%27_War","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":340,"canonical_number":null,"revision95":1,"topic74":"Hundred Years War dynastic conflict","skill74":"context_relation","testedRelation95":"B03:hundred-years-war-dynastic-conflict","practiceRepetitionKeys95":["TOPIC:hundred-years-war-dynastic-conflict"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"24cadfa6d46dba13eedd6dd17097b4617959dc58289f331ae35b614b795a4715","fingerprint":"b2af5e0439c99ada6666","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B03-20261007-341","qid":950341,"nodeId":"REVIEW95-ARCHED-B03-20261007-341","relatedNodeIds":["REVIEW95-ARCHED-B03-20261007-341"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Ottoman and Byzantine capitals","stem":"After the Ottoman conquest of 1453, Constantinople became what?","choices":["The capital of a revived Latin crusader empire","The capital of the Safavid Persian Empire","The capital of the Ottoman Empire","A Venetian colony governed directly from Venice","An independent republic governed by Byzantine merchants"],"correctIndex":2,"answer":"The capital of the Ottoman Empire","explanation":"The conquest ended the Byzantine Empire and made the city an Ottoman imperial capital. Its earlier Byzantine monuments then acquired new uses and additions.","format":"context_relation","references":[{"file":"Encyclopaedia reference — Fall of Constantinople","verificationUrl":"https://en.wikipedia.org/wiki/Fall_of_Constantinople","sourceMetadata95":{"id":"B03-S-Constantinople_1453","key":"Constantinople_1453","title":"Encyclopaedia reference — Fall of Constantinople","url":"https://en.wikipedia.org/wiki/Fall_of_Constantinople","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":341,"canonical_number":null,"revision95":1,"topic74":"Ottoman and Byzantine capitals","skill74":"context_relation","testedRelation95":"B03:ottoman-and-byzantine-capitals","practiceRepetitionKeys95":["TOPIC:ottoman-and-byzantine-capitals"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"5be629a81ee53633840c8920303d8cce83da9d7f8aa586576485c4bc4f92cc21","fingerprint":"ee540a5f6cb08ea57593","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B03-20261007-342","qid":950342,"nodeId":"REVIEW95-ARCHED-B03-20261007-342","relatedNodeIds":["REVIEW95-ARCHED-B03-20261007-342"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Exploration routes","stem":"Which navigator is correctly matched with a voyage?","choices":["Christopher Columbus — rounding Africa to reach India","Vasco da Gama — Europe to India around southern Africa","James Cook — completing the first circumnavigation","Ferdinand Magellan — reaching India around the Cape in 1498","Vasco da Gama — crossing the Atlantic to the Caribbean in 1492"],"correctIndex":1,"answer":"Vasco da Gama — Europe to India around southern Africa","explanation":"Da Gama reached India by sea in 1498 after sailing around southern Africa. The route connected European and Indian Ocean trading worlds without a canal through Egypt.","format":"matching","references":[{"file":"Encyclopaedia reference — Vasco da Gama","verificationUrl":"https://en.wikipedia.org/wiki/Vasco_da_Gama","sourceMetadata95":{"id":"B03-S-Da_Gama","key":"Da_Gama","title":"Encyclopaedia reference — Vasco da Gama","url":"https://en.wikipedia.org/wiki/Vasco_da_Gama","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":342,"canonical_number":null,"revision95":1,"topic74":"Exploration routes","skill74":"context_relation","testedRelation95":"B03:exploration-routes","practiceRepetitionKeys95":["TOPIC:exploration-routes"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"1918bdbd47163425c6140a4abef13aaa61b9c888ac445ba52d35b1cdf3049724","fingerprint":"439905146528656809ac","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B03-20261007-352","qid":950352,"nodeId":"REVIEW95-ARCHED-B03-20261007-352","relatedNodeIds":["REVIEW95-ARCHED-B03-20261007-352"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"German unification and Prussia","stem":"Which statesman and kingdom were central to German unification in 1871?","choices":["Ludwig II — Bavaria","Otto von Bismarck — Prussia","Napoleon III — France","Klemens von Metternich — Austria","Camillo Cavour — Piedmont-Sardinia"],"correctIndex":1,"answer":"Otto von Bismarck — Prussia","explanation":"Bismarck was the leading Prussian statesman in the process that culminated in the German Empire in 1871. This was distinct from the Italian unification associated with Cavour and Garibaldi.","format":"matching","references":[{"file":"Encyclopaedia reference — Unification of Germany","verificationUrl":"https://en.wikipedia.org/wiki/Unification_of_Germany","sourceMetadata95":{"id":"B03-S-German_unification","key":"German_unification","title":"Encyclopaedia reference — Unification of Germany","url":"https://en.wikipedia.org/wiki/Unification_of_Germany","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":352,"canonical_number":null,"revision95":1,"topic74":"German unification and Prussia","skill74":"context_relation","testedRel