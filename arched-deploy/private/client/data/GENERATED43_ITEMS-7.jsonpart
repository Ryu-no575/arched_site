rs"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"02bb5937e27cf53c8dfb97e640cd7b8dafd7403eb6e8d4bf8435ea2b60e3051c","fingerprint":"5dc340c64949d7cad1a6","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B03-20261007-243","qid":950243,"nodeId":"REVIEW95-ARCHED-B03-20261007-243","relatedNodeIds":["REVIEW95-ARCHED-B03-20261007-243"],"sourceAtlasNodeIds":["NOJI45-39"],"major":"Architecture","group":"Barcelona Pavilion and modern classicism","stem":"Mies van der Rohe's Barcelona Pavilion was designed as what?","choices":["A nineteenth-century railway station","A permanent royal residence commissioned by Louis XIV","A municipal housing block built after 1945","A medieval chapter house","Germany's pavilion for the 1929 international exposition"],"correctIndex":4,"answer":"Germany's pavilion for the 1929 international exposition","explanation":"The pavilion was an exhibition building. Its original function helps explain its open spatial composition rather than a conventional sequence of domestic rooms.","format":"context_relation","references":[{"file":"Encyclopaedia reference — Barcelona Pavilion","verificationUrl":"https://en.wikipedia.org/wiki/Barcelona_Pavilion","sourceMetadata95":{"id":"B03-S-Barcelona_Pavilion","key":"Barcelona_Pavilion","title":"Encyclopaedia reference — Barcelona Pavilion","url":"https://en.wikipedia.org/wiki/Barcelona_Pavilion","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","