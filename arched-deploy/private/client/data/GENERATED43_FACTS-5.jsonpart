wiki/Tiberius","checkedOnline86":false,"atlasSeedId":"PDF35-CAND-f8faebde5492bc","atlasSeedTitle":"Person · Augustus Caesar (63 BC – AD 14)","sourceReferences":[{"file":"tira miss u.pdf","pages":[8]}]}],"explanation74":"Tiberius became emperor after Augustus and continued the Julio-Claudian dynasty.","sourceAtlasNodeIds":["PDF35-CAND-f8faebde5492bc"],"questionId86":"GEN43-Q04554"},{"id":"REVISION86-4555","nodeId":"REVISION86-4555","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"Which Frankish ruler was Charlemagne's father?","value":"Pepin the Short","group":"History & Politics","major":"History & Politics","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Pepin_the_Short","checkedOnline86":false,"atlasSeedId":"PDF34-CAND-472c649f19d8","atlasSeedTitle":"Person · Charlemagne","sourceReferences":[{"file":"Important people from the past year papers By~Kaan Özhan.pdf","pages":[45]}]}],"explanation74":"Pepin the Short was the first Carolingian king of the Franks and Charlemagne's father.","sourceAtlasNodeIds":["PDF34-CAND-472c649f19d8"],"questionId86":"GEN43-Q04555"},{"id":"REVISION86-4556","nodeId":"REVISION86-4556","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"Which dynasty ruled France under Louis XIV?","value":"Bourbon","group":"History & Politics","major":"History & Politics","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Louis_XIV","checkedOnline86":false,"atlasSeedId":"PROSPECT-01495","atlasSeedTitle":"Connect Louis XIV to a contemporary event","sourceReferences":[]}],"explanation74":"Louis XIV belonged to the Bourbon dynasty.","sourceAtlasNodeIds":["PROSPECT-01495"],"questionId86":"GEN43-Q04556"},{"id":"REVISION86-4557","nodeId":"REVISION86-4557","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"Henry IV of France issued the Edict of Nantes chiefly to grant rights to which group?","value":"Huguenots","group":"History & Politics","major":"History & Politics","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Edict_of_Nantes","checkedOnline86":false,"atlasSeedId":"EXP77-1660","atlasSeedTitle":"Henry IV of France · lifespan","sourceReferences":[]}],"explanation74":"The edict granted French Protestants defined religious and civil rights.","sourceAtlasNodeIds":["EXP77-1660"],"questionId86":"GEN43-Q04557"},{"id":"REVISION86-4558","nodeId":"REVISION86-4558","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"Which Russian ruler founded Saint Petersburg?","value":"Peter the Great","group":"History & Politics","major":"History & Politics","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Saint_Petersburg","checkedOnline86":false,"atlasSeedId":"EXP77-1838","atlasSeedTitle":"Peter the Great · lifespan","sourceReferences":[]}],"explanation74":"Peter the Great founded the city as part of his effort to open Russia toward Europe.","sourceAtlasNodeIds":["EXP77-1838"],"questionId86":"GEN43-Q04558"},{"id":"REVISION86-4559","nodeId":"REVISION86-4559","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"Which monarch was on the English throne during the defeat of the Spanish Armada?","value":"Elizabeth I","group":"History & Politics","major":"History & Politics","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Spanish_Armada","checkedOnline86":false,"atlasSeedId":"EXP77-1698","atlasSeedTitle":"Elizabeth I · lifespan","sourceReferences":[]}],"explanation74":"The Spanish Armada failed against England during Elizabeth I's reign.","sourceAtlasNodeIds":["EXP77-1698"],"questionId86":"GEN43-Q04559"},{"id":"REVISION86-4560","nodeId":"REVISION86-4560","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"Which dynasty did Victor Emmanuel II belong to?","value":"Savoy","group":"History & Politics","major":"History & Politics","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Victor_Emmanuel_II","checkedOnline86":false,"atlasSeedId":"PDF35-CAND-94246e88655954","atlasSeedTitle":"Person · Victor Emmanuel II","sourceReferences":[{"file":"tira miss u.pdf","pages":[39]}]}],"explanation74":"Victor Emmanuel II belonged to the House of Savoy.","sourceAtlasNodeIds":["PDF35-CAND-94246e88655954"],"questionId86":"GEN43-Q04560"},{"id":"REVISION86-4561","nodeId":"REVISION86-4561","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Mozart's The Magic Flute was originally written to be performed in which language?","value":"German","group":"Language & Literature","major":"Language & Literature","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/The_Magic_Flute","checkedOnline86":false,"atlasSeedId":"PDF34-CAND-e6fa89decac4","atlasSeedTitle":"Context · The Magic Flute","sourceReferences":[{"file":"Important people from the past year papers By~Kaan Özhan.pdf","pages":[25]}]}],"explanation74":"The Magic Flute is a German-language Singspiel with spoken dialogue.","sourceAtlasNodeIds":["PDF34-CAND-e6fa89decac4"],"questionId86":"GEN43-Q04561"},{"id":"REVISION86-4562","nodeId":"REVISION86-4562","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Which instrument is especially associated with Chopin's solo compositions?","value":"Piano","group":"Language & Literature","major":"Language & Literature","relation":"context relation","references":[{"file":"Original question from an Atlas topic","verificationUrl":"https://en.wikipedia.org/wiki/Fr%C3%A9d%C3%A9ric_Chopin","checkedOnline86":false,"atlasSeedId":"PDF34-CAND-4b7807c731ee","atlasSeedTitle":"Person · Frédéric Chopin","sourceReferences":[{"file":"Important people from 