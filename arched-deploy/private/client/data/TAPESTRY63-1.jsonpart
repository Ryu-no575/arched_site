,"approx":true,"note":"Montesquieu's analysis distinguishes legislative, executive and judicial power. It should not be confused with Rousseau's account of the general will.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Separation%20of%20powers","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-3c4125b963c3","title":"Jacques-Louis David","lane":"people","start":1748,"end":1825,"approx":false,"note":"Painter.","creators":[],"reference":"https://en.wikipedia.org/wiki/Jacques-Louis_David","sourceSheets":[3641],"sourceMapping":"period context","dateType":"lifespan","threads67":["france"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-b2e6b216b7c9","title":"Tom Jones","lane":"art","start":1749,"end":1749,"approx":false,"note":"Novel first published in 1749.","creators":["Henry Fielding"],"reference":"https://en.wikipedia.org/wiki/The_History_of_Tom_Jones,_a_Foundling","sourceSheets":[3641],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"context"},{"id":"t63-6d281d184032","title":"Imaginary Prisons: first edition","lane":"art","start":1749,"end":1750,"approx":true,"note":"Etching series; substantially reworked second edition in 1761.","creators":["Giovanni Battista Piranesi"],"reference":"https://en.wikipedia.org/wiki/Carceri_d'invenzione","sourceSheets":[3641],"sourceMapping":"item","dateType":"period","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=0d7fa8af48b86525ad9b7095.webp","credit":"Giovanni Battista Piranesi","license":"CC0","url":"https://co