edia.org/w/index.php?search=Oliver%20Twist","aliases":["Oliver Twist"],"photos":[],"questionIds":[],"tapestryIds":["t68-0bebdb9741a7"],"museumIds":[],"mapIds":[],"note":"Published serially; social criticism of poverty and institutions in industrial Britain.","creator":"Charles Dickens"},{"id":"LE102-75f0a48fcaa047da","title":"Reign of Queen Victoria","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Reign%20of%20Queen%20Victoria","aliases":["Reign of Queen Victoria"],"photos":[],"questionIds":[],"tapestryIds":["t68-308a79db917a"],"museumIds":[],"mapIds":[],"note":"A period of industrial expansion and empire, not a single artistic style."},{"id":"LE102-617c5e8defe56930","title":"First Dresden Court Theatre","kind":"architecture","reference":"https://en.wikipedia.org/wiki/Semperoper","aliases":["First Dresden Court Theatre"],"photos":[],"questionIds":["GEN43-Q01432"],"tapestryIds":["t63-7225f3d2327d"],"museumIds":[],"mapIds":[],"note":"Original theatre; destroyed in 1869, later rebuilt to a different design.","built":"1838","creator":"Gottfried Semper","lat":51.05444444,"lon":13.73527778,"coordinateSource":"https://en.wikipedia.org/wiki/Semperoper","resolvedTitle102":"Semperoper","placeId":"LE102-617c5e8defe56930"},{"id":"LE102-5e1a77e41dd4e36d","title":"The Charterhouse of Parma","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=The%20Charterhouse%20of%20Parma","aliases":["The Charterhouse of Parma"],"photos":[],"questionIds":[],"tapestryIds":["t68-e44b884610cb"],"museumIds":[],"mapIds":[],"note":"A French novel set largely in Italy; cultural origin and fictional setting are distinct.","creator":"Stendhal"},{"id":"LE102-a097028e250c0d3d","title":"The Fighting Temeraire","kind":"art","reference":"https://www.nationalgallery.org.uk/paintings/joseph-mallord-william-turner-the-fighting-temeraire","aliases":["The Fighting Temeraire"],"photos":[{"src":"/.netlify/functions/access?action=media&name=15697e08247fffd7afbccdb6.webp"