itics","group":"Congress of Vienna","stem":"A central aim of the Congress of Vienna was the restoration of:","choices":["Universal suffrage","Colonial free trade","Italian political unity","A balance of power","A European republic"],"correctIndex":3,"answer":"A balance of power","explanation":"The settlement sought a stable European order after the Napoleonic Wars.","format":"single_best_answer","references":[{"file":"UK National Archives — Congress of Vienna","verificationUrl":"https://www.nationalarchives.gov.uk/education/resources/congress-vienna/","sourceMetadata95":{"id":"H12","title":"UK National Archives — Congress of Vienna","url":"https://www.nationalarchives.gov.uk/education/resources/congress-vienna/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":51,"canonical_number":null,"revision95":2,"topic74":"Congress of Vienna","skill74":"context_relation","testedRelation95":"B100:congress-of-vienna","practiceRepetitionKeys95":["TOPIC:congress-of-vienna"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"c4ef83bc6dc63904654aa46e6e3b853a0f0c66e2477e45509cf0f0559245e9c8","fingerprint":"6df5489e83f28e32b309","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"revised_and_adopted"}},{"id":"ARCHED-B100-20261007-052","qid":950052,"nodeId":"REVIEW95-ARCHED-B100-20261007-052","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-052"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Risorgimento","stem":"What historical process does the term Risorgimento usually describe?","choices":["The movement towards Italian national unification","The Italian resistance movement during the Second World War","The revival of classical learning in Renaissance Italy","Italy’s rapid economic growth after the Second World War","The Catholic response to the Protestant Reformation"],"correctIndex":0,"answer":"The movement towards Italian national unification","explanation":"The Risorgimento includes political, military and cultural movements connected with the formation of a unified Italian state. It is distinct from the Renaissance.","format":"single_best_answer","references":[{"file":"Museo Nazionale del Risorgimento Italiano","verificationUrl":"https://www.museorisorgimentotorino.it/","sourceMetadata95":{"id":"H13","title":"Museo Nazionale del Risorgimento Italiano","url":"https://www.museorisorgimentotorino.it/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":52,"canonical_number":null,"revision95":1,"topic74":"Risorgimento","skill74":"context_relation","testedRelation95":"B100:risorgimento","practiceRepetitionKeys95":["TOPIC:risorgimento"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"7f026fc499d660418d39cf832d79dc328423f4537ea241ee8c7affbe82f61591","fingerprint":"9cd25be8195bbdd8b328","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-053","qid"