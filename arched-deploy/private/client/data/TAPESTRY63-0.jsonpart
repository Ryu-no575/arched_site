"creators":[],"reference":"https://en.wikipedia.org/wiki/Chartres_Cathedral","sourceSheets":[3635],"sourceMapping":"item","dateType":"period","image":{"src":"/.netlify/functions/access?action=media&name=3923c7c5bda4de9eabb437b6.webp","credit":"Olvr","license":"CC BY-SA 3.0","url":"https://commons.wikimedia.org/wiki/File:Notre_Dame_de_Chartres.jpg"},"threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-42a97e683199","title":"Frederick II","lane":"people","start":1194,"end":1250,"approx":false,"note":"Emperor and patron; Sixth Crusade.","creators":[],"reference":"https://en.wikipedia.org/wiki/Frederick_II,_Holy_Roman_Emperor","sourceSheets":[3635],"sourceMapping":"period context","dateType":"lifespan","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t69-26d3c46f012c","title":"Scholasticism and medieval universities","lane":"history","start":1200,"end":1400,"approx":true,"note":"Scholastic thinkers used reasoned disputation to examine theological and philosophical problems. Universities developed distinct legal and institutional forms.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Scholasticism%20and%20medieval%20universities","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-6a0c80c4b86d","title":"Fourth Crusade","lane":"history","start":1202,"end":1204,"approx":false,"note":"Diversion to Constantinople.","creators":[],"reference":"https://en.wikipedia.org/wiki/Fourth_Crusade","sourceSheets":[3635],"sourceMapping":"period context","dateType":"period","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-d4e24399f2f5","title":"Sack of Constantinople","lane":"history","start":1204,"end":1204,"approx":false,"not