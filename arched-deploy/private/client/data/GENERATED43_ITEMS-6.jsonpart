practiceRepetitionKeys95":["TOPIC:un-security-council"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"00b246e6fcc43c698dd861d5662dddc595d543d2d8e1c4c2f529834d88b6bbc4","fingerprint":"3e05a8574912b00aea1b","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-061","qid":950061,"nodeId":"REVIEW95-ARCHED-B100-20261007-061","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-061"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Intangible heritage","stem":"Which example best fits UNESCO’s concept of intangible cultural heritage?","choices":["A traditional craft practice passed between generations","An archaeological site containing Roman temples","A medieval stone castle","A distinctive natural rock formation","An original Renaissance painting"],"correctIndex":0,"answer":"A traditional craft practice passed between generations","explanation":"Intangible heritage concerns living practices, expressions, knowledge and skills. Its transmission is central; it is not limited to monuments or museum objects.","format":"single_best_answer","references":[{"file":"UNESCO — What is Intangible Cultural Heritage?","verificationUrl":"https://ich.unesco.org/en/what-is-intangible-heritage-00003","sourceMetadata95":{"id":"C03","title":"UNESCO — What is Intangible Cultural Heritage?","url":"https://ich.unesco.org/en/what-is-intangible-heritage-00003","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":61,"canonical_number":null,"revision95":1,"topic74":"Intangible heritage","skill74":"context_relation","testedRelation95":"B100:intangible-heritage","practiceRepetitionKeys95":["TOPIC:intangible-heritage"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"6837ceb0a64b33f65bb04192fe4e1c4c25f64a6328579af240ed1a33f3f80c9d","fingerprint":"e1928440c436969ea229","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-064","qid":950064,"nodeId":"REVIEW95-ARCHED-B100-20261007-064","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-064"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Referendum","stem":"What is a referendum?","choices":["A vote taken privately by cabinet ministers","An election to choose legislative representatives","A court ruling on the legality of a government measure","A poll estimating public opinion from a sample","A direct vote by the electorate on a specific question"],"correctIndex":4,"answer":"A direct vote by the electorate on a specific question","explanation":"A referendum asks eligible voters to decide a stated issue directly. It differs from choosing representatives in a general election and from conducting an opinion poll.","format":"single_best_answer","references":[{"file":"UK Parliament — Referendum","verificationUrl":"https://www.parliament.uk/site-information/glossary/referendum/","sourceMetadata95":{"id":"C06","title":"UK Parliament — Referendum","url":"https://www.parliament.uk/site-information/glossary/referendum/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":64,"canonical_number":null,"revision95":1,"topic74":"Referendum","skill74":"context_relation","testedRelation95":"B100:referendum","practiceRepetitionKeys95":["TOPIC:referendum"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"c3c01fe604c76dfd81a299a38537cc80d8957886704db81b0d8308b31834637c","fingerprint":"74654343aa9144d4ee2f","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-068","qid":950068,"nodeId":"REVIEW95-ARCHED-B100-20261007-068","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-068"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Unemployment","stem":"Which person most clearly meets the standard statistical idea of unemployment?","choices":["A retiree who does not want paid work","A person choosing not to work and not available for a job","Someone without work who is available and actively seeking a job","A student neither working nor seeking a job","A full-time worker temporarily on annual leave"],"correctIndex":2,"answer":"Someone without work who is available and actively seeking a job","explanation":"Unemployment is not simply the absence of a job. Standard measures distinguish unemployment from being outside the labour force.","format":"single_best_answer","references":[{"file":"International Labour Organization — Unemployment rate","verificationUrl":"https://ilostat.ilo.org/resources/concepts-and-definitions/description-unemployment-rate/","sourceMetadata95":{"id":"C10","title":"International Labour Organization — Unemployment rate","url":"https://ilostat.ilo.org/resources/concepts-and-definitions/description-unemployment-rate/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":68,"canonical_number":null,"revision95":1,"topic74":"Unemployment","skill74":"context_relation","testedRelation95":"B100:unemployment","practiceRepetitionKeys95":["TOPIC:unemployment"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"03af7f324f7f5b927783dcf499a812fa7228f2928b145d1aae50d6f6ac9d1883","fingerprint":"61878c383ee2b54371bb","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-069","qid":950069,"nodeId":"REVIEW95-ARCHED-B100-20261007-069","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-069"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Trade deficit","stem":"A country has a trade deficit when, over the relevant period, what is true?","choices":["Government spending exceeds tax revenue","Domestic investment falls below its level a year earlier","The currency loses value against every other currency","The value of exports exceeds the value of imports","The value of imports exceeds the value of exports"],"correctIndex":4,"answer":"The value of imports exceeds the value of exports","explanation":"A trade deficit describes a balance between imports and exports. It is not the same measure as a government budget deficit or public debt.","format":"single_best_answer","references":[{"file":"US Bureau of Economic Analysis — International trade","verificationUrl":"https://www.bea.gov/resources/learning-center/what-to-know-international-trade","sourceMetadata95":{"id":"C11","title":"US Bureau of Economic Analysis — International trade","url":"https://www.bea.gov/resources/learning-center/what-to-know-international-trade","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":69,"canonical_number":null,"revision95":1,"topic74":"Trade deficit","skill74":"context_relation","testedRelation95":"B100:trade-deficit","practiceRepetitionKeys95":["TOPIC:trade-deficit"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"7db8b5718986b0f2e28f877ae8ab8c07b9735bdef1496466aec46cc2b56fee63","fingerprint":"422c18af724403837e23","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-070","qid":950070,"nodeId":"REVIEW95-ARCHED-B100-20261007-070","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-070"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Opportunity cost","stem":"What is the opportunity cost of choosing one option?","choices":["The sum of every available alternative’s price","The money already spent and impossible to recover","The value of the best alternative that is given up","The largest possible benefit from every option combined","Any payment made only after the decision is reversed"],"correctIndex":2,"answer":"The value of the best alternative that is given up","explanation":"Scarcity means that choosing one use of time or resources can exclude another. Opportunity cost focuses on the next-best forgone alternative, not all alternatives added together.","format":"single_best_answer","references":[{"file":"Federal Reserve Bank of St. Louis — Opportunity Cost","verificationUrl":"https://www.stlouisfed.org/open-vault/2020/january/what-is-opportunity-cost","sourceMetadata95":{"id":"C12","title":"Federal Reserve Bank of St. Louis — Opportunity Cost","url":"https://www.stlouisfed.org/open-vault/2020/january/what-is-opportunity-cost","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":70,"canonical_number":null,"revision95":1,"topic74":"Opportunity cost","skill74":"context_relation","testedRelation95":"B100:opportunity-cost","practiceRepetitionKeys95":["TOPIC:opportunity-cost"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"07e6030eb5886f608189c08d15a12844396c1e6e8dae538bfc0b8bf7089acc2e","fingerprint":"acbcbc01fa27dfef6d53","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-071","qid":950071,"nodeId":"REVIEW95-ARCHED-B100-20261007-071","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-071"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Progressive taxation","stem":"What makes an income tax progressive?","choices":["The share of income paid in tax rises as income rises","The share of income paid in tax falls as income rises","Only consumption, rather than any income, is taxed","Everyone pays the same proportion of income","Everyone pays the same cash amount regardless of income"],"correctIndex":0,"answer":"The share of income paid in tax rises as income rises","explanation":"Progressivity concerns the tax burden relative to income. Merely paying a larger cash amount does not by itself establish a progressive structure.","format":"single_best_answer","references":[{"file":"US Internal Revenue Service — Understanding Taxes: Progressive Taxes","verificationUrl":"https://apps.irs.gov/app/understandingTaxes/student/whys_thm03_les03.jsp","sourceMetadata95":{"id":"C13","title":"US Internal Revenue Service — Understanding Taxes: Progressive Taxes","url":"https://apps.irs.gov/app/understandingTaxes/student/whys_thm03_les03.jsp","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":71,"canonical_number":null,"revision95":1,"topic74":"Progressive taxation","skill74":"context_relation","testedRelation95":"B100:progressive-taxation","practiceRepetitionKeys95":["TOPIC:progressive-taxation"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"7b8a694123f35e6ee3f514bc100aaab62aa0b1aeff395b1791939bf9ea2cc343","fingerprint":"81c8da06ef7096141ab4","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-072","qid":950072,"nodeId":"REVIEW95-ARCHED-B100-20261007-072","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-072"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Public goods","stem":"Why is street lighting commonly used as an example of a public good?","choices":["Its value cannot be included in measures of economic activity","One person’s use need not reduce others’ use, and excluding passers-by is difficult","It is impossible for a private company to maintain the lamps","Free access alone is sufficient to define any public good","Public ownership alone makes any service a public good"],"correctIndex":1,"answer":"One person’s use need not reduce others’ use, and excluding passers-by is difficult","explanation":"The key ideas are non-rivalry and difficulty of exclusion. A good does not become a public good merely because a government happens to own it.","format":"single_best_answer","references":[{"file":"International Monetary Fund — Public Goods","verificationUrl":"https://www.imf.org/en/Publications/fandd/issues/2021/12/Global-public-goods-Chin-basics","sourceMetadata95":{"id":"C14","title":"International Monetary Fund — Public Goods","url":"https://www.imf.org/en/Publications/fandd/issues/2021/12/Global-public-goods-Chin-basics","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":72,"canonical_number":null,"revision95":1,"topic74":"Public goods","skill74":"context_relation","testedRelation95":"B100:public-goods","practiceRepetitionKeys95":["TOPIC:public-goods"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"d2bba3fccc7ad9d79643887fdd77924aef26fd5e3916a7f4b632e2406be7f9c4","fingerprint":"7cad2a3cf6a917a53da3","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-074","qid":950074,"nodeId":"REVIEW95-ARCHED-B100-20261007-074","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-074"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Suez Canal route","stem":"What long detour can ships often avoid by using the Suez Canal?","choices":["Sailing around the coast of Australia","Sailing around the northern tip of Greenland","Sailing around the southern tip of Africa","Sailing around the islands of Japan","Sailing around the southern tip of South America"],"correctIndex":2,"answer":"Sailing around the southern tip of Africa","explanation":"Suez connects the Mediterranean with the Red Sea, shortening many routes between Europe and Asia. The comparable shortcut through Central America is the Panama Canal.","format":"single_best_answer","references":[{"file":"Suez Canal Authority — About Suez Canal","verificationUrl":"https://www.suezcanal.gov.eg/English/About/SuezCanal/Pages/AboutSuezCanal.aspx","sourceMetadata95":{"id":"G02","title":"Suez Canal Authority — About Suez Canal","url":"https://www.suezcanal.gov.eg/English/About/SuezCanal/Pages/AboutSuezCanal.aspx","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":74,"canonical_number":null,"revision95":1,"topic74":"Suez Canal route","skill74":"context_relation","testedRelation95":"B100:suez-canal-route","practiceRepetitionKeys95":["TOPIC:suez-canal-route"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"f03080864439a27ebc4aa0bc3d08aef10762fac2343718eafda4e713aa1e13c9","fingerprint":"0616e8ed244595dd7929","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-075","qid":950075,"nodeId":"REVIEW95-ARCHED-B100-20261007-075","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-075"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Bosphorus","stem":"The Bosphorus passes through which major city?","choices":["Barcelona","Marseille","Alexandria","Lisbon","Istanbul"],"correctIndex":4,"answer":"Istanbul","explanation":"Istanbul occupies both sides of the Bosphorus, between its European and Asian shores. The strait is a geographic feature, not simply a political boundary line.","format":"single_best_answer","references":[{"file":"UNESCO — Historic Areas of Istanbul","verificationUrl":"https://whc.unesco.org/en/list/356/","sourceMetadata95":{"id":"G03","title":"UNESCO — Historic Areas of Istanbul","url":"https://whc.unesco.org/en/list/356/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":75,"canonical_number":null,"revision95":1,"topic74":"Bosphorus","skill74":"context_relation","testedRelation95":"B100:bosphorus","practiceRepetitionKeys95":["TOPIC:bosphorus"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"31103baef6ac1c5792ee9a7a965d7cfa7e5c3bc871e93a5586fd3c1d26d641c3","fingerprint":"b34eb65e9bb223e7b133","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-076","qid":950076,"nodeId":"REVIEW95-ARCHED-B100-20261007-076","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-076"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Alps","stem":"Which mountain system forms much of Italy’s northern boundary region?","choices":["The Pyrenees","The Alps","The Balkan Mountains","The Carpathians","The Scandinavian Mountains"],"correctIndex":1,"answer":"The Alps","explanation":"The Alps connect and divide several central and southern European regions. The Apennines, by contrast, extend along much of the Italian peninsula.","format":"single_best_answer","references":[{"file":"Alpine Convention — The Alps","verificationUrl":"https://www.alpconv.org/en/home/topics/","sourceMetadata95":{"id":"G04","title":"Alpine Convention — The Alps","url":"https://www.alpconv.org/en/home/topics/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":76,"canonical_number":null,"revision95":1,"topic74":"Alps","skill74":"context_relation","testedRelation95":"B100:alps","practiceRepetitionKeys95":["TOPIC:alps"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"7001df4c36906667499c33696a969cb2e4538d4f2485ed29d996d9a0c0b6f7d4","fingerprint":"beec83d70a7a8ea2d3ac","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-078","qid":950078,"nodeId":"REVIEW95-ARCHED-B100-20261007-078","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-078"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"River delta","stem":"How does a river delta generally form?","choices":["A glacier excavates a U-shaped mountain valley","Sediment accumulates where a river enters a larger body of water","Wind removes fine particles from a dry basin","Waves cut a cliff back along an exposed rocky coast","A river erodes a steep gorge upstream"],"correctIndex":1,"answer":"Sediment accumulates where a river enters a larger body of water","explanation":"As a river slows on entering a sea or lake, it can deposit sediment. Not every river mouth develops a large delta, because waves, tides and sediment supply also matter.","format":"single_best_answer","references":[{"file":"US Geological Survey — Delta","verificationUrl":"https://www.usgs.gov/special-topics/water-science-school/science/rivers-streams-and-creeks","sourceMetadata95":{"id":"G06","title":"US Geological Survey — Delta","url":"https://www.usgs.gov/special-topics/water-science-school/science/rivers-streams-and-creeks","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":78,"canonical_number":null,"revision95":1,"topic74":"River delta","skill74":"context_relation","testedRelation95":"B100:river-delta","practiceRepetitionKeys95":["TOPIC:river-delta"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"c25f87cce570c14ff2adcaa71dedcb899b93d977852e27a91b80e1f6d335d46f","fingerprint":"e0ff2d067b054f6e07ae","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-079","qid":950079,"nodeId":"REVIEW95-ARCHED-B100-20261007-079","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-079"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Latitude","stem":"What does latitude measure?","choices":["Height above mean sea level","Distance travelled along a road between two cities","The local difference between high and low tide","Angular distance north or south of the Equator","Angular distance east or west of a reference meridian"],"correctIndex":3,"answer":"Angular distance north or south of the Equator","explanation":"Latitude describes north–south position using the Equator as reference. Longitude describes east–west position using a reference meridian.","format":"single_best_answer","references":[{"file":"NOAA National Ocean Service — Latitude and Longitude","verificationUrl":"https://oceanservice.noaa.gov/facts/latitude.html","sourceMetadata95":{"id":"G07","title":"NOAA National Ocean Service — Latitude and Longitude","url":"https://oceanservice.noaa.gov/facts/latitude.html","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":79,"canonical_number":null,"revision95":1,"topic74":"Latitude","skill74":"context_relation","testedRelation95":"B100:latitude","practiceRepetitionKeys95":["TOPIC:latitude"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"e15b2e2e92c8e2b2e96f3d174e07d7547777817590e9afc207add6216b3fd347","fingerprint":"ff2047451f5151011ea7","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-080","qid":950080,"nodeId":"REVIEW95-ARCHED-B100-20261007-080","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-080"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Longitude and local time","stem":"Why does local solar time change as longitude changes?","choices":["Earth’s axial tilt causes different seasons","Earth’s orbit produces an annual change in distance from the Sun","Earth rotates, bringing different meridians towards the Sun in turn","Latitude determines the height of the Sun at midday","Changes in atmospheric pressure alter the duration of an hour"],"correctIndex":2,"answer":"Earth rotates, bringing different meridians towards the Sun in turn","explanation":"East–west position is connected to the timing of the Sun’s apparent movement. Civil time zones are human arrangements and do not follow meridians perfectly.","format":"single_best_answer","references":[{"file":"Royal Museums Greenwich — Longitude","verificationUrl":"https://www.rmg.co.uk/stories/topics/what-longitude","sourceMetadata95":{"id":"G08","title":"Royal Museums Greenwich — Longitude","url":"https://www.rmg.co.uk/stories/topics/what-longitude","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":80,"canonical_number":null,"revision95":1,"topic74":"Longitude and local time","skill74":"context_relation","testedRelation95":"B100:longitude-and-local-time","practiceRepetitionKeys95":["TOPIC:longitude-and-local-time"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"1828c47e3c872c712e8763917f35c04b3a868ef69bf2a78550b40577b5f05e4e","fingerprint":"c268a4d2bf40909a5bbb","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-081","qid":950081,"nodeId":"REVIEW95-ARCHED-B100-20261007-081","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-081"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Mediterranean climate","stem":"Which seasonal pattern is characteristic of a Mediterranean climate?","choices":["Hot wet summers and severely cold snowy winters","Generally dry summers and wetter, mild winters","Very low rainfall in every season","Rainfall in every season with cool summers and mild winters","Wet summers and relatively dry winters"],"correctIndex":1,"answer":"Generally dry summers and wetter, mild winters","explanation":"The term refers to a climatic pattern found beyond the Mediterranean region as well. It does not mean that every day in winter is wet or every summer day is rainless.","format":"single_best_answer","references":[{"file":"UK Met Office — Climate zones","verificationUrl":"https://www.metoffice.gov.uk/weather/climate/climate-explained/climate-zones","sourceMetadata95":{"id":"G09","title":"UK Met Office — Climate zones","url":"https://www.metoffice.gov.uk/weather/climate/climate-explained/climate-zones","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":81,"canonical_number":null,"revision95":1,"topic74":"Mediterranean climate","skill74":"context_relation","testedRelation95":"B100:mediterranean-climate","practiceRepetitionKeys95":["TOPIC:mediterranean-climate"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"76edc5156d989e978f51b0aadaef6406f287eba875900add29bfc86adffdf922","fingerprint":"9682741be311fe2ed74e","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-082","qid":950082,"nodeId":"REVIEW95-ARCHED-B100-20261007-082","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-082"],"sourceAtlasNodeIds":[],"major":"Geography & Civics","group":"Urbanization","stem":"What does urbanization usually mean in population studies?","choices":["An increase in total national population alone","Expansion of a city’s built-up area without any change in population shares","A rise in the share of manufacturing in the economy","Concentration of all political power in the capital","An increasing proportion of people living in urban areas"],"correctIndex":4,"answer":"An increasing proportion of people living in urban areas","explanation":"Urbanization concerns the urban share of a population. It is not identical to the physical expansion of a single city or to overall population growth.","format":"single_best_answer","references":[{"file":"United Nations Population Division — World Urbanization Prospects","verificationUrl":"https://population.un.org/wup/","sourceMetadata95":{"id":"G10","title":"United Nations Population Division — World Urbanization Prospects","url":"https://population.un.org/wup/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":82,"canonical_number":null,"revision95":1,"topic74":"Urbanization","skill74":"context_relation","testedRelation95":"B100:urbanization","practiceRepetitionKeys95":["TOPIC:urbanization"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"a6f0778aff66136e67c650790b6d30467209d640355485c29e5a810df9d5475a","fingerprint":"3e82de8e281b5e3cb95c","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-083","qid":950083,"nodeId":"REVIEW95-ARCHED-B100-20261007-083","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-083"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Odyssey","stem":"What is the central journey in Homer’s Odyssey?","choices":["Achilles’s participation in the fighting at Troy","Odysseus’s return home after the Trojan War","Jason’s expedition in search of the Golden Fleece","Aeneas’s journey to found a new homeland in Italy","Dante’s passage through the Christian afterlife"],"correctIndex":1,"answer":"Odysseus’s return home after the Trojan War","explanation":"The Odyssey follows a difficult homecoming, while the Iliad centres on an episode of the Trojan War itself. The two epics are related but not interchangeable.","format":"single_best_answer","references":[{"file":"Perseus Digital Library, Tufts University — Homer, Odyssey","verificationUrl":"https://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.01.0136","sourceMetadata95":{"id":"L01","title":"Perseus Digital Library, Tufts University — Homer, Odyssey","url":"https://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.01.0136","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":83,"canonical_number":null,"revision95":1,"topic74":"Odyssey","skill74":"context_relation","testedRelation95":"B100:odyssey","practiceRepetitionKeys95":["TOPIC:odyssey"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"8a39910e07956afc9e46cdf67d23262b75d2714415c83de6cb4417f483587244","fingerprint":"7b3ee49184fbbadeaa54","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-085","qid":950085,"nodeId":"REVIEW95-ARCHED-B100-20261007-085","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-085"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Don Quixote","stem":"Don Quixote’s adventures repeatedly expose the gap between what?","choices":["Romantic ideals of chivalry and ordinary reality","Religious obedience and conflict within a monastic community","Family duty and rival claims to a royal succession","Imperial conquest and the resistance of ancient city-states","Divine judgment and a soul’s passage through the afterlife"],"correctIndex":0,"answer":"Romantic ideals of chivalry and ordinary reality","explanation":"Cervantes’s hero interprets the world through books of chivalry, often misrecognizing what he encounters. This tension drives both the humour and the novel’s larger questions.","format":"single_best_answer","references":[{"file":"Biblioteca Virtual Miguel de Cervantes — Don Quijote","verificationUrl":"https://www.cervantesvirtual.com/portales/miguel_de_cervantes/su_obra_quijote/","sourceMetadata95":{"id":"L03","title":"Biblioteca Virtual Miguel de Cervantes — Don Quijote","url":"https://www.cervantesvirtual.com/portales/miguel_de_cervantes/su_obra_quijote/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":85,"canonical_number":null,"revision95":1,"topic74":"Don Quixote","skill74":"context_relation","testedRelation95":"B100:don-quixote","practiceRepetitionKeys95":["TOPIC:don-quixote"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"5e2e987d426d704eb909481c1adeb69f7fa6a1fe3af88fa2239288d71144cd14","fingerprint":"6f38adcecd889b0d560a","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-086","qid":950086,"nodeId":"REVIEW95-ARCHED-B100-20261007-086","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-086"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Frankenstein","stem":"In Mary Shelley’s novel, who is Victor Frankenstein?","choices":["The name given to the creature itself","The Arctic explorer who records the framing narrative","The person who creates the living creature","The creator’s father","The creator’s childhood friend and travelling companion"],"correctIndex":2,"answer":"The person who creates the living creature","explanation":"Frankenstein is the creator’s surname. Confusing creator and creature can obscure the novel’s questions about responsibility for what one brings into the world.","format":"single_best_answer","references":[{"file":"Bodleian Libraries — The Shelley-Godwin Archive","verificationUrl":"http://shelleygodwinarchive.org/contents/frankenstein/","sourceMetadata95":{"id":"L04","title":"Bodleian Libraries — The Shelley-Godwin Archive","url":"http://shelleygodwinarchive.org/contents/frankenstein/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":86,"canonical_number":null,"revision95":1,"topic74":"Frankenstein","skill74":"context_relation","testedRelation95":"B100:frankenstein","practiceRepetitionKeys95":["TOPIC:frankenstein"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"548cf17bff3c046205601c1b632f1bfdf33a7226e7e7e3d59c3d4f7487b915f4","fingerprint":"60fe45be54e9e7779e50","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-087","qid":950087,"nodeId":"REVIEW95-ARCHED-B100-20261007-087","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-087"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Nineteen Eighty-Four","stem":"Which concern is central to George Orwell’s Nineteen Eighty-Four?","choices":["The collision of chivalric fantasy with ordinary experience","Political control through surveillance and manipulation of truth","The prolonged homecoming of a warrior after an ancient war","The responsibility of a scientist for a creature he makes","Marriage and social advancement in a provincial community"],"correctIndex":1,"answer":"Political control through surveillance and manipulation of truth","explanation":"Orwell’s dystopia links political domination to control over information, language and memory. It is not a neutral prediction of every feature of the actual year 1984.","format":"single_best_answer","references":[{"file":"The Orwell Foundation — Nineteen Eighty-Four","verificationUrl":"https://www.orwellfoundation.com/the-orwell-foundation/orwell/books-by-orwell/nineteen-eighty-four/","sourceMetadata95":{"id":"L05","title":"The Orwell Foundation — Nineteen Eighty-Four","url":"https://www.orwellfoundation.com/the-orwell-foundation/orwell/books-by-orwell/nineteen-eighty-four/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":87,"canonical_number":null,"revision95":1,"topic74":"Nineteen Eighty-Four","skill74":"context_relation","testedRelation95":"B100:nineteen-eighty-four","practiceRepetitionKeys95":["TOPIC:nineteen-eighty-four"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"8dcb0b9dd9c0bfd157665112b1a09cd75d2b093e4f5589abed15c34b05acdaf9","fingerprint":"173f626eab375ab6c4ea","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-088","qid":950088,"nodeId":"REVIEW95-ARCHED-B100-20261007-088","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-088"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"A Doll’s House","stem":"Which issue is central to Ibsen’s A Doll’s House?","choices":["Individual autonomy and the expectations of marriage","An artist’s bargain with a supernatural tempter","The imperial conquest of an ancient Mediterranean state","The succession struggles of rival royal dynasties","An organized industrial uprising against factory owners"],"correctIndex":0,"answer":"Individual autonomy and the expectations of marriage","explanation":"The play examines the roles assigned within marriage and the conflict between social expectations and personal independence. Its title is not an indication that it is a children’s puppet play.","format":"single_best_answer","references":[{"file":"University of Oslo — Henrik Ibsen’s writings: A Doll’s House","verificationUrl":"https://www.ibsen.uio.no/DRVIT_Du%7CDuht.xhtml","sourceMetadata95":{"id":"L06","title":"University of Oslo — Henrik Ibsen’s writings: A Doll’s House","url":"https://www.ibsen.uio.no/DRVIT_Du%7CDuht.xhtml","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":88,"canonical_number":null,"revision95":1,"topic74":"A Doll’s House","skill74":"context_relation","testedRelation95":"B100:a-doll-s-house","practiceRepetitionKeys95":["TOPIC:a-dolls-house"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"eeea4a79a8d0f87205d3038c85a2ffe6bfdb253f9ec477b97d5c2a7b081246a3","fingerprint":"7f23c26534fab33ee541","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-089","qid":950089,"nodeId":"REVIEW95-ARCHED-B100-20261007-089","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-089"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Opera recognition","stem":"Which of these works is an opera?","choices":["Bach’s Brandenburg Concertos","Vivaldi’s The Four Seasons","Mozart’s The Magic Flute","Beethoven’s Fifth Symphony","Bach’s Goldberg Variations"],"correctIndex":2,"answer":"Mozart’s The Magic Flute","explanation":"The Magic Flute is a staged dramatic work with singing. The other choices are instrumental works, even though their forms and instrumental forces differ.","format":"single_best_answer","references":[{"file":"English National Opera — The Magic Flute","verificationUrl":"https://www.eno.org/operas/the-magic-flute/","sourceMetadata95":{"id":"L07","title":"English National Opera — The Magic Flute","url":"https://www.eno.org/operas/the-magic-flute/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":89,"canonical_number":null,"revision95":1,"topic74":"Opera recognition","skill74":"context_relation","testedRelation95":"B100:opera-recognition","practiceRepetitionKeys95":["TOPIC:opera-recognition"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"b79d50542d2a65aa11e08d4bb6597a1515cb71a05f19dc6a90cb6857bab2a44e","fingerprint":"34bab027c319864e38c7","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-090","qid":950090,"nodeId":"REVIEW95-ARCHED-B100-20261007-090","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-090"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Concerto","stem":"What is a typical feature of a solo concerto?","choices":["A choral work performed without an orchestra","A large orchestral work without a featured soloist","A featured solo instrument interacts with an orchestra","An unaccompanied composition for a single instrument","A fully staged musical drama with singers and acting"],"correctIndex":2,"answer":"A featured solo instrument interacts with an orchestra","explanation":"The relationship between soloist and ensemble is central to the solo concerto. It is a musical form, not merely a synonym for any public concert.","format":"single_best_answer","references":[{"file":"Philharmonia Orchestra — Musical Dictionary","verificationUrl":"https://philharmonia.co.uk/resources/musical-dictionary/","sourceMetadata95":{"id":"L08","title":"Philharmonia Orchestra — Musical Dictionary","url":"https://philharmonia.co.uk/resources/musical-dictionary/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":90,"canonical_number":null,"revision95":1,"topic74":"Concerto","skill74":"context_relation","testedRelation95":"B100:concerto","practiceRepetitionKeys95":["TOPIC:concerto"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"f357b2643b2bb56f15e74f0effa82d637e98fa8ab7505d3dd91405f01fffb43a","fingerprint":"0202da62a3bccf44e06a","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-091","qid":950091,"nodeId":"REVIEW95-ARCHED-B100-20261007-091","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-091"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Italian neorealism","stem":"Which tendency is associated with Italian neorealist cinema?","choices":["Dream imagery detached from contemporary social conditions","Lavish studio fantasies centred on idealized aristocratic life","Stories of ordinary people filmed with an emphasis on everyday social conditions","Abstract animation intended to eliminate recognizable everyday settings","Monumental ancient-history spectacles as the exclusive model"],"correctIndex":2,"answer":"Stories of ordinary people filmed with an emphasis on everyday social conditions","explanation":"Neorealist films often engage postwar social life, locations and ordinary people. These are tendencies rather than an absolute rule about every actor or every shot.","format":"single_best_answer","references":[{"file":"British Film Institute — A beginner’s guide to Italian neorealism","verificationUrl":"https://www.bfi.org.uk/features/beginners-guide-italian-neorealism","sourceMetadata95":{"id":"L09","title":"British Film Institute — A beginner’s guide to Italian neorealism","url":"https://www.bfi.org.uk/features/beginners-guide-italian-neorealism","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":91,"canonical_number":null,"revision95":1,"topic74":"Italian neorealism","skill74":"context_relation","testedRelation95":"B100:italian-neorealism","practiceRepetitionKeys95":["TOPIC:italian-neorealism"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"133de5c3ab19400004f0fc3e46b2f3d14a6ffab095d26f8c3ea61bd4255aba8d","fingerprint":"cfb7a42cd45b278c39b1","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-092","qid":950092,"nodeId":"REVIEW95-ARCHED-B100-20261007-092","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-092"],"sourceAtlasNodeIds":[],"major":"Language & Literature","group":"Silent-film intertitles","stem":"What were intertitles used for in many silent films?","choices":["Printing translated dialogue along the bottom of a continuing shot","Recording synchronized dialogue as part of a sound track","Displaying dialogue or information on text cards between shots","Indicating camera movement in an unpublished shooting script","Listing the cast and crew as the film’s concluding credits"],"correctIndex":2,"answer":"Displaying dialogue or information on text cards between shots","explanation":"Silent films could convey written dialogue and narrative information through intertitles. “Silent” therefore does not mean that audiences saw no language on screen.","format":"single_best_answer","references":[{"file":"Library of Congress — Silent Film","verificationUrl":"https://www.loc.gov/collections/national-screening-room/about-this-collection/","sourceMetadata95":{"id":"L10","title":"Library of Congress — Silent Film","url":"https://www.loc.gov/collections/national-screening-room/about-this-collection/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":92,"canonical_number":null,"revision95":1,"topic74":"Silent-film intertitles","skill74":"context_relation","testedRelation95":"B100:silent-film-intertitles","practiceRepetitionKeys95":["TOPIC:silent-film-intertitles"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"88cf8e1f4298a9825a6ceee09699e43e8895645b7e1fb6d754dc6119987dfb45","fingerprint":"414aba16b13ec60748bc","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-094","qid":950094,"nodeId":"REVIEW95-ARCHED-B100-20261007-094","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-094"],"sourceAtlasNodeIds":[],"major":"Science & Tech","group":"Marie Curie","stem":"Marie Curie’s research is especially associated with which phenomenon?","choices":["Planetary orbital mechanics","Continental drift","Botanical classification","The circulation of blood","Radioactivity"],"correctIndex":4,"answer":"Radioactivity","explanation":"Curie’s work on radioactivity included investigations of radioactive elements. Recognizing her field matters more here than memorizing a list of biographical dates.","format":"single_best_answer","references":[{"file":"Nobel Prize — Marie Curie: Facts","verificationUrl":"https://www.nobelprize.org/prizes/physics/1903/marie-curie/facts/","sourceMetadata95":{"id":"T02","title":"Nobel Prize — Marie Curie: Facts","url":"https://www.nobelprize.org/prizes/physics/1903/marie-curie/facts/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":94,"canonical_number":null,"revision95":1,"topic74":"Marie Curie","skill74":"context_relation","testedRelation95":"B100:marie-curie","practiceRepetitionKeys95":["TOPIC:marie-curie"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"52eaccff03477107b7046a1fbab12bc96b70d542f14554363e618e4c429abab7","fingerprint":"d462329a4beb1908b405","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-096","qid":950096,"nodeId":"REVIEW95-ARCHED-B100-20261007-096","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-096"],"sourceAtlasNodeIds":[],"major":"Science & Tech","group":"World Wide Web","stem":"What did the World Wide Web add to the use of computer networks?","choices":["A method for routing every packet through the physical Internet","A satellite-based method of determining geographic position","A system for linking and accessing documents through hypertext","A public-key encryption method for protecting messages","A system whose sole function was exchanging electronic mail"],"correctIndex":2,"answer":"A system for linking and accessing documents through hypertext","explanation":"The Web is a service built on network infrastructure, not another name for the entire Internet. Its linked documents made information sharing much easier.","format":"single_best_answer","references":[{"file":"CERN — The birth of the Web","verificationUrl":"https://home.cern/science/computing/birth-web","sourceMetadata95":{"id":"T04","title":"CERN — The birth of the Web","url":"https://home.cern/science/computing/birth-web","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":96,"canonical_number":null,"revision95":1,"topic74":"World Wide Web","skill74":"context_relation","testedRelation95":"B100:world-wide-web","practiceRepetitionKeys95":["TOPIC:world-wide-web"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"776aab7a79f74e5404d93fad8d28d16fe18e8b88edf1be8829b9b33310fddc2d","fingerprint":"74efb608c6a274c472cf","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B100-20261007-097","qid":950097,"nodeId":"REVIEW95-ARCHED-B100-20261007-097","relatedNodeIds":["REVIEW95-ARCHED-B100-20261007-097"],"sourceAtlasNodeIds":[],"major":"Science & Tech","group":"Greenhouse effect","stem":"Greenhouse gases warm Earth’s surface and lower atmosphere mainly by interacting with what?","choices":["X-rays produced in the upper atmosphere","Ultraviolet radiation from the Sun only","Incoming visible sunlight only","Outgoing infrared radiation","Sound waves generated by human activity"],"correctIndex":3,"answer":"Outgoing infrared radiation","explanation":"The surface emits infrared radiation after absorbing energy. Greenhouse gases absorb and re-emit infrared radiation, affecting how energy leaves the climate system.","format":"single_best_answer","references":[{"file":"NASA — What is the greenhouse effect?","verificationUrl":"https://science.nasa.gov/climate-change/faq/what-is-the-greenhouse-effect/","sourceMetadata95":{"id":"T05","title":"NASA — What is the greenhouse effect?","url":"https://science.nasa.gov/climate-change/faq/what-is-the-greenhouse-effect/","verification_status":"reference_supplied; see retrieval report","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":97,"canonical_number":null,"revision95":1,"topic74":"Greenhouse effect","skill74":"context_relation","testedRelation95":"B100:greenhouse-effect","practiceRepetitionKeys95":["TOPIC:greenhouse-effect"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"4bca3e86d9170234d43b26b8c584df49f03d2b1795dd926c7dbcef425b8255e4","fingerprint":"072e08500972fc89dfde","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B02-20261007-101","qid":950101,"nodeId":"REVIEW95-ARCHED-B02-20261007-101","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-101"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Petra rock-cut architecture","stem":"How were many monumental tomb facades at Petra made?","choices":["By assembling timber panels","By casting concrete in steel moulds","By carving the natural rock face","By stacking fired-clay bricks","By stretching fabric over frames"],"correctIndex":2,"answer":"By carving the natural rock face","explanation":"Rock-cut architecture removes material from a cliff instead of assembling every wall from separate blocks. Petra also contains freestanding buildings, so the claim is not about every structure at the site.","format":"single_best_answer","references":[{"file":"UNESCO — Petra","verificationUrl":"https://whc.unesco.org/en/list/326/","sourceMetadata95":{"id":"B02-A01","title":"UNESCO — Petra","url":"https://whc.unesco.org/en/list/326/","support_summary":"Petra includes monumental tomb and temple facades carved directly into the rock.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":101,"canonical_number":null,"revision95":1,"topic74":"Petra rock-cut architecture","skill74":"context_relation","testedRelation95":"B02:petra-rock-cut-architecture","practiceRepetitionKeys95":["TOPIC:petra-rock-cut-architecture"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"35d899c6927d95227426786c0a4b3f304a06282287bed4d01bd46f6fce84d71b","fingerprint":"66e6a1777f3c43b6a927","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-102","qid":950102,"nodeId":"REVIEW95-ARCHED-B02-20261007-102","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-102"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Borobudur religious tradition","stem":"Borobudur in Java is principally associated with which religious tradition?","choices":["Islam","Buddhism","Judaism","Christianity","Shinto"],"correctIndex":1,"answer":"Buddhism","explanation":"Its stupas and Buddha images form a Buddhist sacred monument. The arrangement of its terraces gives architectural form to religious ideas, rather than merely providing a viewing platform.","format":"single_best_answer","references":[{"file":"UNESCO — Borobudur Temple Compounds","verificationUrl":"https://whc.unesco.org/en/list/592/","sourceMetadata95":{"id":"B02-A02","title":"UNESCO — Borobudur Temple Compounds","url":"https://whc.unesco.org/en/list/592/","support_summary":"Borobudur is a Buddhist monument in Java; its terraces and stupas express Buddhist cosmology.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":102,"canonical_number":null,"revision95":1,"topic74":"Borobudur religious tradition","skill74":"context_relation","testedRelation95":"B02:borobudur-religious-tradition","practiceRepetitionKeys95":["TOPIC:borobudur-religious-tradition"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"77ea5c16531798782301f7d06fbaf6355e9269cfb9b2d9d51636ca647bdf31d1","fingerprint":"bf912265e7e511661965","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-103","qid":950103,"nodeId":"REVIEW95-ARCHED-B02-20261007-103","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-103"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Angkor Khmer heritage","stem":"Angkor Wat belongs to the architectural heritage of which empire?","choices":["The Khmer Empire","The Ottoman Empire","The Inca Empire","The Aztec Empire","The Byzantine Empire"],"correctIndex":0,"answer":"The Khmer Empire","explanation":"Angkor was a centre of Khmer power in Southeast Asia. Associating the monument with its civilization is more useful than memorizing the dates of individual restorations.","format":"single_best_answer","references":[{"file":"UNESCO — Angkor","verificationUrl":"https://whc.unesco.org/en/list/668/","sourceMetadata95":{"id":"B02-A03","title":"UNESCO — Angkor","url":"https://whc.unesco.org/en/list/668/","support_summary":"Angkor contains capitals and temples of the Khmer Empire, including Angkor Wat.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":103,"canonical_number":null,"revision95":1,"topic74":"Angkor Khmer heritage","skill74":"context_relation","testedRelation95":"B02:angkor-khmer-heritage","practiceRepetitionKeys95":["TOPIC:angkor-khmer-heritage"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"5f7e7efff584b416cebb127cf3760c9d55f5dab0e2bc02e0205366d94ea0ee30","fingerprint":"cdac356edba39b86551e","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-104","qid":950104,"nodeId":"REVIEW95-ARCHED-B02-20261007-104","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-104"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Taj Mahal funerary function","stem":"What was the central building of the Taj Mahal complex created to be?","choices":["A mausoleum","A defensive citadel","An astronomical observatory","A public market","A royal audience hall"],"correctIndex":0,"answer":"A mausoleum","explanation":"Shah Jahan commissioned the monument in memory of Mumtaz Mahal. Although the complex contains other buildings, the famous central marble building is a tomb.","format":"single_best_answer","references":[{"file":"UNESCO — Taj Mahal","verificationUrl":"https://whc.unesco.org/en/list/252/","sourceMetadata95":{"id":"B02-A04","title":"UNESCO — Taj Mahal","url":"https://whc.unesco.org/en/list/252/","support_summary":"Shah Jahan built the white marble mausoleum in memory of Mumtaz Mahal.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":104,"canonical_number":null,"revision95":1,"topic74":"Taj Mahal funerary function","skill74":"context_relation","testedRelation95":"B02:taj-mahal-funerary-function","practiceRepetitionKeys95":["TOPIC:taj-mahal-funerary-function"],"workIds95":[],"evidenceStatus95":"supp