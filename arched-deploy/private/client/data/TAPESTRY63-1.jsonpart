prox":false,"note":"Stopped the German advance towards Paris; followed by prolonged trench warfare.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=First%20Battle%20of%20the%20Marne","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-62af444df3e5","title":"Mystery and Melancholy of a Street","lane":"art","start":1914,"end":1914,"approx":false,"note":"Arcades, shadows and an isolated figure produce the enigmatic atmosphere of Metaphysical painting.","creators":["Giorgio de Chirico"],"reference":"https://en.wikipedia.org/w/index.php?search=Mystery%20and%20Melancholy%20of%20a%20Street","sourceSheets":[3645],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["italy"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=f700664876abdd3751ae799c.webp","credit":"Giorgio de Chirico","license":"Copyrighted artwork; reproduction from Wikipedia. Commercial-use permission not established.","url":"https://en.wikipedia.org/wiki/File:Giorgio_de_Chirico_-_Mystery_and_Melancholy_of_a_Street_%281914%29.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-c342f86a53d1","title":"Panama Canal opens","lane":"history","start":1914,"end":1914,"approx":false,"note":"The canal connected Atlantic and Pacific shipping routes.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Panama%20Canal%20opens","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-3b66dca6d225","title":"First World War","lane":"history","start":1914,"end":1918,"approx":false,"note":"Industrial warfare, rival alliances and imperial competition transformed Europe; the Western Front armistice was 11 November 1918.","creators":[],"reference":"https://en.wikipedia.org/wiki/World_War_I","sourceSheets":[3645],"sourceMapping":"item","dateType":"period","threads67":["central","france","britain","italy","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-6c737be7c36c","title":"Black Square","lane":"art","start":1915,"end":1915,"approx":false,"note":"A foundational Suprematist work; multiple later versions exist.","creators":["Kazimir Malevich"],"reference":"https://en.wikipedia.org/w/index.php?search=Black%20Square","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=0fdf38d28b955a875cc4f440.webp","credit":"Kazimir Malevich","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Kazimir_Malevich%2C_1915%2C_Black_Suprematic_Square%2C_oil_on_linen_canvas%2C_79.5_x_79.5_cm%2C_Tretyakov_Gallery%2C_Moscow.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-90266f628f28","title":"Treaty of London","lane":"history","start":1915,"end":1915,"approx":false,"note":"Secret Allied promises preceded Italy's entry into the war against Austria-Hungary.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20London","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy","britain","france","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-9c42dfd259ec","title":"Hussein–McMahon correspondence","lane":"history","start":1915,"end":1916,"approx":false,"note":"Wartime correspondence over Arab independence contained disputed territorial interpretations.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Hussein%E2%80%93McMahon%20correspondence","sourceSheets":[3645],"sourceMapping":"item","dateType":"period","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-bfc75352d2b3","title":"Suprematism and Constructivism","lane":"art","start":1915,"end":1930,"approx":true,"note":"Suprematism emphasises autonomous geometric form; Constructivist practices often connect materials, construction and social production. The movements overlap historically but are not identical.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Suprematism%20and%20Constructivism","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["other"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-a3b355f60704","title":"Dada emerges in Zurich","lane":"art","start":1916,"end":1916,"approx":false,"note":"Wartime anti-establishment experimentation; Dada developed differently across cities.","creators":["Hugo Ball","Tristan Tzara"],"reference":"https://en.wikipedia.org/wiki/Dada","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-001d434ddfa1","title":"Sykes–Picot Agreement","lane":"history","start":1916,"end":1916,"approx":false,"note":"A secret agreement envisaged spheres of influence in Ottoman Arab territories.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Sykes%E2%80%93Picot%20Agreement","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["britain","france","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-771f86f10b7b","title":"Readymade and the artist's act of selection","lane":"art","start":1916,"end":1930,"approx":true,"note":"A manufactured object can enter art through selection and presentation. A readymade is not simply a sculpture made from any unusual material.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Readymade%20and%20the%20artist%27s%20act%20of%20selection","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france","other"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-d5fa5d8c1bbc","title":"Balfour Declaration","lane":"history","start":1917,"end":1917,"approx":false,"note":"British support for a national home for the Jewish people in Palestine included a clause on the rights of existing non-Jewish communities.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Balfour%20Declaration","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["britain","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-fc58ae0e61bc","title":"Russian February and October Revolutions","lane":"history","start":1917,"end":1917,"approx":false,"note":"Tsarist rule fell, followed by Bolshevik seizure of power; calendar conventions explain the month names.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Russian%20February%20and%20October%20Revolutions","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-0412ff8a53cd","title":"United States enters World War I","lane":"history","start":1917,"end":1917,"approx":false,"note":"US entry in April altered Allied resources and the diplomatic balance.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=United%20States%20enters%20World%20War%20I","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-ad44ece2e4a6","title":"De Stijl and Neo-Plasticism","lane":"art","start":1917,"end":1931,"approx":true,"note":"Restricted colour, orthogonal relationships and compositional balance link painting, furniture and architecture. Mondrian's painting and Rietveld's buildings are distinct applications.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=De%20Stijl%20and%20Neo-Plasticism","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["low"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-9cb6fe7c4591","title":"Armistice of 11 November","lane":"history","start":1918,"end":1918,"approx":false,"note":"Ended fighting between Germany and the Allies; the peace treaty followed in 1919.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Armistice%20of%2011%20November","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-e0edde4a13f5","title":"White on White","lane":"art","start":1918,"end":1918,"approx":false,"note":"Suprematist painting reduces form and colour to subtle relationships.","creators":["Kazimir Malevich"],"reference":"https://en.wikipedia.org/w/index.php?search=White%20on%20White","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","museumAssetId78":"M77-MOMA-80385","image":{"src":"/.netlify/functions/access?action=media&name=37a5da4d0a9b973c1a314cca.webp","credit":"Kazimir Malevich","license":"Image © respective rights holders · MoMA collection","url":"https://www.moma.org/collection/works/80385","scope":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: Suprematist Composition: White on White · 1918"},"imageChecked78":"2026-10-05"},{"id":"t68-d7872ffe7487","title":"Wilson's Fourteen Points","lane":"history","start":1918,"end":1918,"approx":false,"note":"A programme for peace; the eventual treaties did not adopt all of its principles.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Wilson%27s%20Fourteen%20Points","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-7b8d77565445","title":"D'Annunzio occupies Fiume","lane":"history","start":1919,"end":1919,"approx":false,"note":"A nationalist occupation challenged the postwar settlement; distinguish from the 1924 annexation treaty.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=D%27Annunzio%20occupies%20Fiume","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-de0ef9a9ea79","title":"Paris Peace Conference","lane":"history","start":1919,"end":1919,"approx":false,"note":"The conference negotiated several treaties and the League of Nations framework.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Paris%20Peace%20Conference","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-d7be04437461","title":"Treaty of Versailles","lane":"history","start":1919,"end":1919,"approx":false,"note":"The German peace settlement imposed territorial, military and financial terms.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Versailles","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france","central","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-4036d07208cd","title":"Weimar Constitution adopted","lane":"history","start":1919,"end":1919,"approx":false,"note":"Established Germany's parliamentary republic; later collapse was not inevitable at its founding.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Weimar%20Constitution%20adopted","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-76a9835e0445","title":"Spatial Construction: series","lane":"art","start":1919,"end":1920,"approx":true,"note":"Constructivist exploration of space; the source does not securely specify one construction.","creators":["Naum Gabo"],"reference":"https://en.wikipedia.org/w/index.php?search=Spatial%20Construction%3A%20series","sourceSheets":[3645],"sourceMapping":"contextual identification","dateType":"period","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","dateQualifier":"Source title / version unresolved","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=a64c2073c03ac8db1ca343c1.webp","credit":"Naum Gabo","license":"CC0","url":"https://commons.wikimedia.org/wiki/File:Kuspit3-27-2.jpg","scope":"Contextual example: Gabo's Kinetic Construction (Standing Wave), 1919–1920, shown through documentation/reconstruction. The source's generic Spatial Construction title remains unresolved."},"imageChecked78":"2026-10-05"},{"id":"t68-678586ce1ccc","title":"Einstein Tower","lane":"architecture","start":1919,"end":1921,"approx":true,"note":"Expressionist observatory in Potsdam; appearance and actual mixed construction should not be confused.","creators":["Erich Mendelsohn"],"reference":"https://en.wikipedia.org/w/index.php?search=Einstein%20Tower","sourceSheets":[3645],"sourceMapping":"supplemental context","dateType":"period","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=ec66c7de61417e85bc5bfeaf.webp","credit":"Ideophagous","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Einstein_Tower_(48113).jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t68-0e4ffd289c59","title":"Bauhaus school","lane":"architecture","start":1919,"end":1933,"approx":true,"note":"Founded in Weimar, moved to Dessau and then Berlin; closed under Nazi pressure in 1933.","creators":["Walter Gropius","Hannes Meyer","Ludwig Mies van der Rohe"],"reference":"https://www.bauhaus.de/de/das_bauhaus/","sourceSheets":[3645],"sourceMapping":"item","dateType":"period","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","referenceChecked":"2026-10-05","image":{"src":"/.netlify/functions/access?action=media&name=df9e46847396fcdfa9590168.webp","credit":"Gunnar Klack","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:2020-09-18-Bauhaus-Dessau-Werkstattfluegel-Ecke-2.jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t69-ba09c05d63cd","title":"Bauhaus: workshop, industry and changing directors","lane":"architecture","start":1919,"end":1933,"approx":true,"note":"Gropius, Meyer and Mies led different phases. The school changed location and priorities; Bauhaus cannot be reduced to one fixed visual style.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Bauhaus","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["central"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-5b8ffc30b278","title":"Bloody Christmas in Fiume","lane":"history","start":1920,"end":1920,"approx":false,"note":"Italian forces ended D'Annunzio's occupation in December.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Bloody%20Christmas%20in%20Fiume","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-733f9bef18b3","title":"League of Nations begins operating","lane":"history","start":1920,"end":1920,"approx":false,"note":"An attempt at collective security after World War I; the United States did not join.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=League%20of%20Nations%20begins%20operating","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-c4589956dda7","title":"Curtain wall versus load-bearing wall","lane":"architecture","start":1920,"end":1940,"approx":true,"note":"A curtain wall encloses a building while the structural frame carries primary loads. A glass facade is not automatically a curtain wall.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Curtain%20wall%20versus%20load-bearing%20wall","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["central","other"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-192da3928b42","title":"International Style and modernist diversity","lane":"architecture","start":1920,"end":1940,"approx":true,"note":"The 1932 exhibition and book popularised a formal category. Functionalism, social housing programmes and regional modernisms cannot all be reduced to that category.","creators":[],"reference":"https://www.vam.ac.uk/articles/what-was-modernism","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-20e8ced6fa6d","title":"Italian Rationalism and political context","lane":"architecture","start":1920,"end":1940,"approx":true,"note":"Geometric clarity and modern materials coexisted with Fascist commissions. Formal innovation alone does not identify the politics of a patron or architect.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Italian%20Rationalism%20and%20political%20context","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-0d2232f0f090","title":"Pilotis, free plan and free facade","lane":"architecture","start":1920,"end":1940,"approx":true,"note":"Le Corbusier's Five Points also include horizontal windows and roof gardens. A frame separates structural support from partitions and the external enclosure.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Pilotis%2C%20free%20plan%20and%20free%20facade","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-8e1fda07f8be","title":"Reinforced concrete and cantilevers","lane":"architecture","start":1920,"end":1970,"approx":true,"note":"Steel reinforcement helps concrete resist tensile forces. A cantilever projects beyond its support; its structural action differs from a simple span supported at both ends.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Reinforced%20concrete%20and%20cantilevers","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["shared"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t68-80fb824aad6d","title":"March on Rome","lane":"history","start":1922,"end":1922,"approx":false,"note":"Fascist pressure preceded the king's appointment of Mussolini as prime minister; dictatorship consolidated later.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=March%20on%20Rome","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-683799ff4039","title":"Soviet Union founded","lane":"history","start":1922,"end":1922,"approx":false,"note":"The USSR was established in December 1922, not in 1917.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Soviet%20Union%20founded","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-8c8ca2588103","title":"French and Belgian occupation of the Ruhr","lane":"history","start":1923,"end":1923,"approx":false,"note":"A reparations crisis intensified economic and political instability in Germany.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=French%20and%20Belgian%20occupation%20of%20the%20Ruhr","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france","low","central"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-21db2b536832","title":"Republic of Turkey proclaimed","lane":"history","start":1923,"end":1923,"approx":false,"note":"Atatürk's republic followed the collapse of the Ottoman Empire and a war of independence.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Republic%20of%20Turkey%20proclaimed","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["eastmed"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-49259928cc80","title":"Roy Lichtenstein","lane":"people","start":1923,"end":1997,"approx":false,"note":"American Pop artist drawing on commercial printing and comics.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Roy%20Lichtenstein","sourceSheets":[3646],"sourceMapping":"item","dateType":"lifespan","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-f6ee02824c7c","title":"Dawes Plan","lane":"history","start":1924,"end":1924,"approx":false,"note":"Restructured German reparations payments and encouraged US loans.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Dawes%20Plan","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-e90aa082f91e","title":"Matteotti murdered and Aventine Secession","lane":"history","start":1924,"end":1924,"approx":false,"note":"The socialist deputy's murder provoked an opposition withdrawal; the crisis preceded consolidation of Fascist dictatorship.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Matteotti%20murdered%20and%20Aventine%20Secession","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-9fbfe699f824","title":"Surrealist Manifesto published","lane":"art","start":1924,"end":1924,"approx":false,"note":"An organised movement explored dreams, automatism and the unconscious.","creators":["André Breton"],"reference":"https://en.wikipedia.org/wiki/Surrealist_Manifesto","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"context"},{"id":"t68-306f01e1a89c","title":"Treaty of Rome on Fiume","lane":"history","start":1924,"end":1924,"approx":false,"note":"Fiume passed to Italy; distinguish this agreement from the European integration treaties of 1957.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Rome%20on%20Fiume","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t69-a966abfd1d69","title":"Surrealist automatism and dream imagery","lane":"art","start":1924,"end":1940,"approx":true,"note":"Automatism reduces deliberate control; illusionistic dream imagery is another Surrealist strategy. Dalí's detailed rendering should not stand for every Surrealist method.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Surrealist%20automatism%20and%20dream%20imagery","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["france"],"setting67":"Historical / cultural study context","kind69":"concept","mediaType78":"context"},{"id":"t68-07c84a5aabbe","title":"Locarno Treaties","lane":"history","start":1925,"end":1925,"approx":false,"note":"Diplomatic agreements guaranteed Germany's western borders; eastern borders did not receive identical guarantees.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Locarno%20Treaties","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["central","france","britain","low","italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-db291121a832","title":"Yellow–Red–Blue","lane":"art","start":1925,"end":1925,"approx":false,"note":"Painted during Kandinsky's Bauhaus period; structured geometry coexists with freer forms.","creators":["Wassily Kandinsky"],"reference":"https://en.wikipedia.org/w/index.php?search=Yellow%E2%80%93Red%E2%80%93Blue","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=021a9fd650384cc773e741a5.webp","credit":"Wassily Kandinsky","license":"Public domain","url":"https://it.wikipedia.org/wiki/Giallo%2C_rosso%2C_blu","scope":"Exact title and artist matched to existing catalogue"},"mediaType78":"visual-artwork"},{"id":"t68-c5124ad24706","title":"Bauhaus building in Dessau","lane":"architecture","start":1925,"end":1926,"approx":true,"note":"Glass curtain walls and interlocking functional volumes express the school's industrial orientation.","creators":["Walter Gropius"],"reference":"https://en.wikipedia.org/wiki/Bauhaus_Dessau","sourceSheets":[3645],"sourceMapping":"supplemental context","dateType":"period","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=df9e46847396fcdfa9590168.webp","credit":"Gunnar Klack","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:2020-09-18-Bauhaus-Dessau-Werkstattfluegel-Ecke-2.jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t68-ea3348df8766","title":"Robert Rauschenberg","lane":"people","start":1925,"end":2008,"approx":false,"note":"American artist whose Combines connect painting, sculpture and everyday objects.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Robert%20Rauschenberg","sourceSheets":[3646],"sourceMapping":"item","dateType":"lifespan","threads67":["other"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-5c9994310026","title":"Baird demonstrates television","lane":"history","start":1926,"end":1926,"approx":false,"note":"A public demonstration of a working television system; broadcasting developed in later stages.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Baird%20demonstrates%20television","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-568766a50cc2","title":"Fleming discovers penicillin's antibacterial effect","lane":"history","start":1928,"end":1928,"approx":false,"note":"Clinical production and widespread use required later work by other researchers.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Fleming%20discovers%20penicillin%27s%20antibacterial%20effect","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["britain"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-67e5463898ca","title":"Kellogg–Briand Pact","lane":"history","start":1928,"end":1928,"approx":false,"note":"Signatories renounced war as national policy; enforcement proved weak.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Kellogg%E2%80%93Briand%20Pact","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["france","other","shared"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-2b0f5f6d10a4","title":"Villa Savoye","lane":"architecture","start":1928,"end":1931,"approx":true,"note":"A built expression of modernist design principles; location at Poissy is distinct from the architect's Swiss origins.","creators":["Le Corbusier","Pierre Jeanneret"],"reference":"https://en.wikipedia.org/w/index.php?search=Villa%20Savoye","sourceSheets":[3644],"sourceMapping":"supplemental context","dateType":"period","threads