e correction","practiceRepetitionKeys95":["FACT:ARCHED-NEW101-0114"],"testedRelation95":"v101:ad9aa69caaac836b9e8e"},{"id":"ARCHED-NEW101-0115","qid":1010115,"major":"History & Politics","stem":"The Declaration of the Rights of Woman and of the Female Citizen was written by:","choices":["George Sand","Mary Shelley","Olympe de Gouges","Simone de Beauvoir","Madame de Staël"],"answer":"Olympe de Gouges","correctIndex":2,"explanation":"De Gouges challenged women's exclusion from the rights proclaimed during the French Revolution.","group":"Political documents","topic74":"Political documents","format":"context_relation","skill74":"context_relation","task101":"context_relation","examLanguages":["en","it"],"scope":"shared","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"version":"editorial-v101","difficulty74":"unrated","references":[],"evidenceStatus101":"editorial factual review; individual external verification not claimed","nodeId":"FACT101-ARCHED-NEW101-0115","relatedNodeIds":["FACT101-ARCHED-NEW101-0115"],"fingerprint":"be51fd030b4c970f4053","semanticKey101":"84296e6ddf86db3d458ae7ba2738a42423896c79745247b1d842100c514f5d31","editorialRevision101":"specific factual/distractor/duplicate correction","practiceRepetitionKeys95":["FACT:ARCHED-NEW101-0115"],"testedRelation95":"v101:e46bdfd0227ee5c81d04"},{"id":"ARCHED-NEW101-0116","qid":1010116,"major":"History & Politics","stem":"The National Assembly emerged from representatives of which estate in 1789?","choices":["Provincial nobility alone","First Estate","Third Estate","Royal household","Second Estate"],"answer":"Third Estate","correctIndex":2,"explanation":"Third Estate deputies took the initiative in claiming to represent the nation.","group":"French Revolution","topic74":"French Revolution","format":"context_relation","skill74":"context_relation","task101":"context_relation","examLanguages":["en","it"],"scope":"shared","editorialStatus74":"ready","rev