[{"id":"GEN43-Q01001","qid":1001,"nodeId":"EDITORIAL74-001","relatedNodeIds":["EDITORIAL74-001"],"factIds":["EDITORIAL74-001"],"major":"Architecture","group":"Gothic","stem":"Which Gothic element carries vault thrust across an aisle to an external pier?","choices":["Flying buttress","Triforium","Archivolt","Clerestory","Trumeau"],"correctIndex":0,"answer":"Flying buttress","explanation":"They transfer lateral thrust away from the high nave walls, helping permit larger windows.","format":"function","references":[{"file":"Editorial reference: Gothic","page":null,"verificationUrl":"https://www.metmuseum.org/essays/gothic-art"}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v76","editorialStatus74":"ready","skill74":"function","topic74":"Gothic","difficulty74":"unrated","lineage74":"Original editorial item; Alpha transcription used to benchmark concise options. Not an official CISIA question.","evidence":{"type":"editorial","referenceBasis":"Institutional reference","checkedAt":"2026-10-05"},"editorial75":{"sourceKey":"gothic","optionWords":[2,1,1,1,1],"difficultyStatus":"Not calibrated with candidates","syllabusArea":"historical-cultural-space-time"},"fingerprint":"842678e6ff306b26bb85"},{"id":"GEN43-Q01002","qid":1002,"nodeId":"EDITORIAL74-002","relatedNodeIds":["EDITORIAL74-002"],"factIds":["EDITORIAL74-002"],"major":"Architecture","group":"Gothic","stem":"Which combination characterizes the structural system of a mature Gothic cathedral?","choices":["Timber trusses and diaphragm arches","Rib vaults and flying buttresses","Domes and pendentives","Corbel vaults and ashlar walls","Barrel vaults and continuous walls"],"correctIndex":1,"answer":"Rib vaults and flying buttresses","explanation":"Ribs and buttresses concentrate and redirect structural forces; modern steel systems are anachronistic.","format":"distinction","references":[{"file":"Editorial reference: Gothic","page":null,"verificationUrl":"https://www.metmuseum.org/essays/gothic-art"}],"exa