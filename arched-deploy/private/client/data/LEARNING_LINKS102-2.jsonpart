ikipedia.org/w/index.php?search=German%20occupation%20of%20Czech%20lands","aliases":["German occupation of Czech lands"],"photos":[],"questionIds":[],"tapestryIds":["t68-5754f262450d"],"museumIds":[],"mapIds":[],"note":"The occupation destroyed the remaining Czech state's independence after Munich."},{"id":"LE102-a918b2e77ab58a83","title":"Germany invades Poland","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Germany%20invades%20Poland","aliases":["Germany invades Poland"],"photos":[],"questionIds":[],"tapestryIds":["t68-2427b0b30a32"],"museumIds":[],"mapIds":[],"note":"The invasion on 1 September was followed by British and French declarations of war on 3 September."},{"id":"LE102-7808dd9f2644f0c3","title":"Molotov–Ribbentrop Pact","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Molotov%E2%80%93Ribbentrop%20Pact","aliases":["Molotov–Ribbentrop Pact"],"photos":[],"questionIds":["GEN43-Q03826","ARCHED-NEW101-0135","ARCHED-NEW101-0503"],"tapestryIds":["t68-e80c3faaf9bf"],"museumIds":[],"mapIds":[],"note":"A non-aggression agreement with secret protocols divided spheres of influence in eastern Europe."},{"id":"LE102-2fc594b34b733fcd","title":"Second World War","kind":"history","reference":"https://en.wikipedia.org/wiki/World_War_II","aliases":["Second World War"],"photos":[],"questionIds":["ARCHED-B03-20261007-374","ARCHED-NEW99-0514","ARCHED-NEW101-0136","ALPHA-B004-Q303","ALPHA-B003-Q254","ALPHA-B004-Q323","ALPHA-B004-Q305","ALPHA-B004-Q348","ALPHA-B009-Q810","ALPHA-B011-Q952","ALPHA-B011-Q953","ALPHA-B011-Q956"],"tapestryIds":["t68-3eb1969fd236"],"museumIds":[],"mapIds":[],"note":"European war began with Germany's invasion of Poland; it became a global conflict with distinct theatres and end dates."},{"id":"LE102-ba14863bbd6cc1d6","title":"Churchill becomes prime minister","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Churchill%20becomes%20prime%20minister","aliases":["Churchill becomes prime minister"],"photos":[],"questionIds":["ARCHED-NEW101-0462"],"tapestryIds":["t68-2ce1426f66f1"],"museumIds":[],"mapIds":[],"note":"He took office in May as Germany's western offensive began."},{"id":"LE102-e73410d1a31c3d97","title":"De Gaulle's Appeal of 18 June","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=De%20Gaulle%27s%20Appeal%20of%2018%20June","aliases":["De Gaulle's Appeal of 18 June"],"photos":[],"questionIds":[],"tapestryIds":["t68-38587dc52678"],"museumIds":[],"mapIds":[],"note":"The broadcast from London called for continued resistance and became a symbol of Free France."},{"id":"LE102-25a2c726af785057","title":"Dunkirk evacuation","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Dunkirk%20evacuation","aliases":["Dunkirk evacuation"],"photos":[],"questionIds":["ARCHED-NEW101-0465","ARCHED-NEW101-0522"],"tapestryIds":["t68-a02ed037f357"],"museumIds":[],"mapIds":[],"note":"Allied troops were evacuated; successful evacuation was not a battlefield victory over the German offensive."},{"id":"LE102-6e3c4cbbf8a7b57d","title":"Fall of France and Vichy regime","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Fall%20of%20France%20and%20Vichy%20regime","aliases":["Fall of France and Vichy regime"],"photos":[],"questionIds":[],"tapestryIds":["t68-6619ddcf53c7"],"museumIds":[],"mapIds":[],"note":"Military defeat and an armistice led to occupation and an authoritarian collaborationist regime."},{"id":"LE102-bcecee79ee36edd4","title":"German invasion of Denmark and Norway","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=German%20invasion%20of%20Denmark%20and%20Norway","aliases":["German invasion of Denmark and Norway"],"photos":[],"questionIds":[],"tapestryIds":["t68-adb7f64030aa"],"museumIds":[],"mapIds":[],"note":"The April campaign extended the war into northern Europe."},{"id":"LE102-0b3ed1ada5d88d39","title":"Abstract Expressionism emerges","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Abstract%20Expressionism%20emerges","aliases":["Abstract Expressionism emerges"],"photos":[],"questionIds":[],"tapestryIds":["t68-1c0108f23561"],"museumIds":[],"mapIds":[],"note":"A diverse postwar New York movement; action painting and colour-field approaches are distinct tendencies.","creator":"Jackson Pollock, Willem de Kooning, Mark Rothko"},{"id":"LE102-63320017b02ab7ea","title":"Action painting and colour-field painting","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Action%20painting%20and%20colour-field%20painting","aliases":["Action painting and colour-field painting"],"photos":[],"questionIds":[],"tapestryIds":["t69-0046a19bede8"],"museumIds":[],"mapIds":[],"note":"Pollock's gestural processes differ from Rothko's broad colour fields. Both sit within a diverse Abstract Expressionist context."},{"id":"LE102-e0fe6e814e20c4c3","title":"Atlantic Charter","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Atlantic%20Charter","aliases":["Atlantic Charter"],"photos":[],"questionIds":["ARCHED-NEW101-0137","ARCHED-NEW101-0533","ARCHED-NEW101-0535"],"tapestryIds":["t68-905eb7fc45c9"],"museumIds":[],"mapIds":[],"note":"Roosevelt and Churchill stated wartime and postwar principles before US entry into the war."},{"id":"LE102-03ef92fa38a7718c","title":"Attack on Pearl Harbor","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Attack%20on%20Pearl%20Harbor","aliases":["Attack on Pearl Harbor"],"photos":[],"questionIds":[],"tapestryIds":["t68-5ae612b6a3bf"],"museumIds":[],"mapIds":[],"note":"7 December in Hawaii, 8 December in Japan; the date difference in the photo reflects time zones."},{"id":"LE102-7dff19229c06cd62","title":"Operation Barbarossa","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Operation%20Barbarossa","aliases":["Operation Barbarossa"],"photos":[],"questionIds":["GEN43-Q01143"],"tapestryIds":["t68-3e5acaf9843d"],"museumIds":[],"mapIds":[],"note":"Germany invaded the Soviet Union, breaking the 1939 non-aggression pact."},{"id":"LE102-357438a2a03cebe6","title":"Roosevelt's Four Freedoms speech","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Roosevelt%27s%20Four%20Freedoms%20speech","aliases":["Roosevelt's Four Freedoms speech"],"photos":[],"questionIds":["ARCHED-NEW101-0488"],"tapestryIds":["t68-652ffc7e21dd"],"museumIds":[],"mapIds":[],"note":"Outlined freedom of speech, worship, from want and from fear."},{"id":"LE102-a49dec42fc9b9b00","title":"Battle of Midway","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20Midway","aliases":["Battle of Midway"],"photos":[],"questionIds":[],"tapestryIds":["t68-1fd9e8923b25"],"museumIds":[],"mapIds":[],"note":"A major US naval victory over Japan in the Pacific."},{"id":"LE102-c426085bf14f1366","title":"Battle of Stalingrad","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20Stalingrad","aliases":["Battle of Stalingrad"],"photos":[],"questionIds":[],"tapestryIds":["t68-18a3a8ca79ff"],"museumIds":[],"mapIds":[],"note":"A major turning point on the Eastern Front; German forces surrendered in February 1943."},{"id":"LE102-3e28441548207af5","title":"Cairo and Tehran conferences","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Cairo%20and%20Tehran%20conferences","aliases":["Cairo and Tehran conferences"],"photos":[],"questionIds":[],"tapestryIds":["t68-b17a4d75cc82"],"museumIds":[],"mapIds":[],"note":"Separate Allied meetings addressed Asian and European war strategy; participants differed."},{"id":"LE102-c1d07a0232a5ca88","title":"Italian armistice announced","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Italian%20armistice%20announced","aliases":["Italian armistice announced"],"photos":[],"questionIds":["ARCHED-NEW101-0455"],"tapestryIds":["t68-c77edd7fb09d"],"museumIds":[],"mapIds":[],"note":"Announced on 8 September after signature on 3 September; occupation and civil conflict followed."},{"id":"LE102-b5ad610f98f706b7","title":"D-Day: Normandy landings","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=D-Day%3A%20Normandy%20landings","aliases":["D-Day: Normandy landings"],"photos":[],"questionIds":[],"tapestryIds":["t68-5c70094fc3da"],"museumIds":[],"mapIds":[],"note":"Allied landings on 6 June opened a major western front."},{"id":"LE102-4809244a48b7a599","title":"Liberation of Paris","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Liberation%20of%20Paris","aliases":["Liberation of Paris"],"photos":[],"questionIds":[],"tapestryIds":["t68-959e78c8a864"],"museumIds":[],"mapIds":[],"note":"Paris was liberated in August through resistance action and Allied advance."},{"id":"LE102-eda2bf36cf75502b","title":"Liberation of Rome","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Liberation%20of%20Rome","aliases":["Liberation of Rome"],"photos":[],"questionIds":[],"tapestryIds":["t68-26e17f7d5436"],"museumIds":[],"mapIds":[],"note":"Allied forces entered Rome on 4 June, two days before D-Day."},{"id":"LE102-6257e9210f71b2e2","title":"Battle of the Bulge","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20the%20Bulge","aliases":["Battle of the Bulge"],"photos":[],"questionIds":["ALPHA-B007-Q493"],"tapestryIds":["t68-7b8bf9d1ffde"],"museumIds":[],"mapIds":[],"note":"A German winter offensive in the Ardennes failed to reverse the Allied advance."},{"id":"LE102-47be5167997f9b80","title":"Atomic bombings of Hiroshima and Nagasaki","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Atomic%20bombings%20of%20Hiroshima%20and%20Nagasaki","aliases":["Atomic bombings of Hiroshima and Nagasaki"],"photos":[],"questionIds":["ARCHED-NEW101-0505","ARCHED-NEW101-0506"],"tapestryIds":["t68-a2645d585272"],"museumIds":[],"mapIds":[],"note":"The US bombed Hiroshima on 6 August and Nagasaki on 9 August; the human consequences were catastrophic."},{"id":"LE102-0b11b7a7fa4900bc","title":"German surrender and VE Day","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=German%20surrender%20and%20VE%20Day","aliases":["German surrender and VE Day"],"photos":[],"questionIds":[],"tapestryIds":["t68-dedf04291c50"],"museumIds":[],"mapIds":[],"note":"Surrender was signed on 7 May and took effect on 8 May in western Europe; 9 May is commemorated in Russia."},{"id":"LE102-4e9fbc2e547b3f53","title":"Japan surrenders","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Japan%20surrenders","aliases":["Japan surrenders"],"photos":[],"questionIds":["ARCHED-NEW101-0523"],"tapestryIds":["t68-25e7b405ed08"],"museumIds":[],"mapIds":[],"note":"Surrender was announced on 15 August and formally signed on 2 September."},{"id":"LE102-ade591064e1feadc","title":"Liberation of Auschwitz","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Liberation%20of%20Auschwitz","aliases":["Liberation of Auschwitz"],"photos":[],"questionIds":[],"tapestryIds":["t68-7a3754037d78"],"museumIds":[],"mapIds":[],"note":"Soviet forces liberated the Nazi concentration and extermination camp on 27 January."},{"id":"LE102-653dd863b2f03021","title":"Mussolini killed and Hitler dies","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Mussolini%20killed%20and%20Hitler%20dies","aliases":["Mussolini killed and Hitler dies"],"photos":[],"questionIds":[],"tapestryIds":["t68-dd194bda57b4"],"museumIds":[],"mapIds":[],"note":"Mussolini was executed on 28 April; Hitler died by suicide on 30 April. These are distinct events."},{"id":"LE102-3a4a3a07dd9e7c04","title":"Potsdam Conference","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Potsdam%20Conference","aliases":["Potsdam Conference"],"photos":[],"questionIds":[],"tapestryIds":["t68-4390763e86ac"],"museumIds":[],"mapIds":[],"note":"Allied leaders met in July–August to address postwar Germany and other unresolved issues."},{"id":"LE102-91b427237270d0cb","title":"United Nations founded","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=United%20Nations%20founded","aliases":["United Nations founded"],"photos":[],"questionIds":[],"tapestryIds":["t68-d08abf0fcf2b"],"museumIds":[],"mapIds":[],"note":"The UN Charter entered into force on 24 October; distinguish from the June signing conference."},{"id":"LE102-233d1fc8d2229ffd","title":"Yalta Conference","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Yalta%20Conference","aliases":["Yalta Conference"],"photos":[],"questionIds":["ARCHED-NEW99-0912","ARCHED-NEW101-0467","ALPHA-B002-Q141"],"tapestryIds":["t68-1c24fd952c0a"],"museumIds":[],"mapIds":[],"note":"Allied leaders discussed the postwar settlement and the planned United Nations."},{"id":"LE102-6de9f4f51089ebc4","title":"Nuremberg trials","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Nuremberg%20trials","aliases":["Nuremberg trials"],"photos":[],"questionIds":["ALPHA-B005-Q444"],"tapestryIds":["t68-5437c78248a4"],"museumIds":[],"mapIds":[],"note":"The main International Military Tribunal tried leading Nazi officials; subsequent trials followed."},{"id":"LE102-3fd91db1a4feebf9","title":"Postwar reconstruction and collective housing","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Postwar%20reconstruction%20and%20collective%20housing","aliases":["Postwar reconstruction and collective housing"],"photos":[],"questionIds":[],"tapestryIds":["t69-6379eefac812"],"museumIds":[],"mapIds":[],"note":"Housing shortages, welfare policies and construction technology shaped postwar projects. The social programme and the architectural form must be examined together.","built":"1945"},{"id":"LE102-8a7d8cfd90ac04b5","title":"Decolonisation and unequal independence","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Decolonisation%20and%20unequal%20independence","aliases":["Decolonisation and unequal independence"],"photos":[],"questionIds":[],"tapestryIds":["t69-2dfe8455b83c"],"museumIds":[],"mapIds":[],"note":"Political independence followed diverse negotiations and wars. Economic dependence and inherited borders often remained, so independence was not one uniform endpoint."},{"id":"LE102-e51dd0ce3d17066a","title":"Welfare states and the mixed economy","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Welfare%20states%20and%20the%20mixed%20economy","aliases":["Welfare states and the mixed economy"],"photos":[],"questionIds":[],"tapestryIds":["t69-2f07c6438cb6"],"museumIds":[],"mapIds":[],"note":"Public services, social insurance and economic intervention expanded in different national forms. A welfare state is not equivalent to a fully state-owned economy."},{"id":"LE102-9e0b20d3941ac49b","title":"Cold War: containment and deterrence","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Cold%20War","aliases":["Cold War: containment and deterrence"],"photos":[],"questionIds":[],"tapestryIds":["t69-03a297ccdd91"],"museumIds":[],"mapIds":[],"note":"Containment aimed to limit Soviet expansion; deterrence sought to discourage attack through threatened costs. Proxy wars and diplomacy were also central."},{"id":"LE102-47794fa0a19ca677","title":"First Indochina War begins","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=First%20Indochina%20War%20begins","aliases":["First Indochina War begins"],"photos":[],"questionIds":[],"tapestryIds":["t68-95ac9a6d0de3"],"museumIds":[],"mapIds":[],"note":"The conflict between France and the Viet Minh preceded French withdrawal and partition arrangements in 1954."},{"id":"LE102-000099f76a8003ca","title":"Iron Curtain speech","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Iron%20Curtain%20speech","aliases":["Iron Curtain speech"],"photos":[],"questionIds":[],"tapestryIds":["t68-610b1ddb41af"],"museumIds":[],"mapIds":[],"note":"Churchill's speech in Fulton described the division of Europe and called for Anglo-American cooperation."},{"id":"LE102-32b67760dcf0a826","title":"Italian republic referendum","kind":"history","reference":"https://www.quirinale.it/it/pagine/2-giugno-1946-2-giugno-2016","aliases":["Italian republic referendum"],"photos":[],"questionIds":["GEN43-Q01537","ARCHED-NEW101-0501","ARCHED-NEW101-0518"],"tapestryIds":["t68-ac0dea4b7067"],"museumIds":[],"mapIds":[],"note":"Voting on 2–3 June chose a republic; Enrico De Nicola became provisional head of state later that month."},{"id":"LE102-83ca51fcdb0ea6af","title":"Cominform founded","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Cominform%20founded","aliases":["Cominform founded"],"photos":[],"questionIds":[],"tapestryIds":["t68-063b5b74da66"],"museumIds":[],"mapIds":[],"note":"A Soviet-led coordination body for communist parties, distinct from the earlier Comintern."},{"id":"LE102-1262823e39290996","title":"Indian independence and Partition","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Indian%20independence%20and%20Partition","aliases":["Indian independence and Partition"],"photos":[],"questionIds":["ARCHED-NEW101-0503"],"tapestryIds":["t68-51fb84a3b691"],"museumIds":[],"mapIds":[],"note":"British India became India and Pakistan amid mass displacement and violence."},{"id":"LE102-b2e3ca09d5981686","title":"Marshall Plan announced","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Marshall%20Plan%20announced","aliases":["Marshall Plan announced"],"photos":[],"questionIds":[],"tapestryIds":["t68-525332e3121a"],"museumIds":[],"mapIds":[],"note":"A European recovery programme announced in June; implementation began in 1948."},{"id":"LE102-6627858bad236d49","title":"Truman Doctrine","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Truman%20Doctrine","aliases":["Truman Doctrine"],"photos":[],"questionIds":["GEN43-Q01137","ARCHED-NEW101-0460","ARCHED-NEW101-0470"],"tapestryIds":["t68-f433458ff075"],"museumIds":[],"mapIds":[],"note":"US aid to Greece and Turkey became a landmark in Cold War containment policy."},{"id":"LE102-43e08dea0f19deea","title":"Brussels Treaty","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Brussels%20Treaty","aliases":["Brussels Treaty"],"photos":[],"questionIds":[],"tapestryIds":["t68-6c7ced50f1c8"],"museumIds":[],"mapIds":[],"note":"Created the Western Union; the Western European Union followed the modified treaty in 1954."},{"id":"LE102-6f39c07e1863a7f8","title":"Gandhi assassinated","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Gandhi%20assassinated","aliases":["Gandhi assassinated"],"photos":[],"questionIds":["ARCHED-NEW101-0458","ARCHED-NEW101-0468"],"tapestryIds":["t68-5e8f86a16268"],"museumIds":[],"mapIds":[],"note":"Gandhi was killed in January after Indian independence and Partition."},{"id":"LE102-ff841ad4267496da","title":"Israel declares independence","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Israel%20declares%20independence","aliases":["Israel declares independence"],"photos":[],"questionIds":[],"tapestryIds":["t68-8b16289d5866"],"museumIds":[],"mapIds":[],"note":"The declaration on 14 May preceded an expanding Arab–Israeli war; consequences included mass Palestinian displacement."},{"id":"LE102-55de223cba8804d2","title":"Italian Constitution enters into force","kind":"history","reference":"https://en.wikipedia.org/wiki/Constitution_of_Italy","aliases":["Italian Constitution enters into force"],"photos":[],"questionIds":["GEN43-Q01659","ARCHED-NEW101-0474","ARCHED-NEW101-0510"],"tapestryIds":["t68-c83bca916a1e"],"museumIds":[],"mapIds":[],"note":"Effective 1 January; the republican referendum was in 1946, not 1948."},{"id":"LE102-4a7736fd5005be05","title":"OEEC established","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=OEEC%20established","aliases":["OEEC established"],"photos":[],"questionIds":[],"tapestryIds":["t68-f3729b05595c"],"museumIds":[],"mapIds":[],"note":"Coordinated European recovery cooperation; the OECD succeeded it in 1961."},{"id":"LE102-c389bc3749edf1b7","title":"Republic of Korea and North Korea established","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Republic%20of%20Korea%20and%20North%20Korea%20established","aliases":["Republic of Korea and North Korea established"],"photos":[],"questionIds":[],"tapestryIds":["t68-4f0a9b305a3d"],"museumIds":[],"mapIds":[],"note":"Two rival states emerged on the divided Korean peninsula."},{"id":"LE102-abff991b27781e6b","title":"Berlin Blockade and Airlift","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Berlin%20Blockade%20and%20Airlift","aliases":["Berlin Blockade and Airlift"],"photos":[],"questionIds":["ARCHED-NEW101-0138"],"tapestryIds":["t68-cd2447240dd6"],"museumIds":[],"mapIds":[],"note":"Soviet blockade of western Berlin prompted an Allied airlift; the blockade ended in May 1949."},{"id":"LE102-1114e59d9549cf8f","title":"Federal Republic of Germany established","kind":"history","reference":"https://en.wikipedia.org/wiki/West_Germany","aliases":["Federal Republic of Germany established"],"photos":[],"questionIds":[],"tapestryIds":["t68-bfa3e5d58344"],"museumIds":[],"mapIds":[],"note":"The Basic Law took effect in May; Adenauer became chancellor in September."},{"id":"LE102-30aab622cc59956f","title":"German Democratic Republic established","kind":"history","reference":"https://en.wikipedia.org/wiki/East_Germany","aliases":["German Democratic Republic established"],"photos":[],"questionIds":[],"tapestryIds":["t68-3a68a48f2df6"],"museumIds":[],"mapIds":[],"note":"The East German state was proclaimed in October in the Soviet occupation zone."},{"id":"LE102-a9010864a90e3aa3","title":"NATO founded","kind":"history","reference":"https://nato.int/en/about-us/organization/founding-treaty","aliases":["NATO founded"],"photos":[],"questionIds":[],"tapestryIds":["t68-8e642606a646"],"museumIds":[],"mapIds":[],"note":"The North Atlantic Treaty was signed on 4 April; West Germany joined only in 1955."},{"id":"LE102-474109be2835da7b","title":"People's Republic of China proclaimed","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=People%27s%20Republic%20of%20China%20proclaimed","aliases":["People's Republic of China proclaimed"],"photos":[],"questionIds":[],"tapestryIds":["t68-af5cd43a0b7c"],"museumIds":[],"mapIds":[],"note":"Mao proclaimed the PRC on 1 October following communist victory on the mainland."},{"id":"LE102-808e0126bff75fe5","title":"NATO, Warsaw Pact and non-alignment","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=NATO%2C%20Warsaw%20Pact%20and%20non-alignment","aliases":["NATO, Warsaw Pact and non-alignment"],"photos":[],"questionIds":[],"tapestryIds":["t69-2cf0372e31ac"],"museumIds":[],"mapIds":[],"note":"The two military alliances structured much of Europe, but not every state belonged to either bloc. Non-alignment did not mean an absence of international interests."},{"id":"LE102-288fb299beefcc6e","title":"India becomes a republic","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=India%20becomes%20a%20republic","aliases":["India becomes a republic"],"photos":[],"questionIds":[],"tapestryIds":["t68-f108e44753b8"],"museumIds":[],"mapIds":[],"note":"Its constitution came into effect on 26 January."},{"id":"LE102-b021542fb605aa92","title":"Schuman Declaration","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Schuman%20Declaration","aliases":["Schuman Declaration"],"photos":[],"questionIds":[],"tapestryIds":["t68-1476337f50c7"],"museumIds":[],"mapIds":[],"note":"Proposed pooling coal and steel production; a major step towards European integration."},{"id":"LE102-1d05820e6a62d7ae","title":"Korean War","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Korean%20War","aliases":["Korean War"],"photos":[],"questionIds":[],"tapestryIds":["t68-2150713273b5"],"museumIds":[],"mapIds":[],"note":"War began in June 1950; an armistice, not a peace treaty, ended major fighting in July 1953."},{"id":"LE102-c3395aee8e037dd4","title":"Notre-Dame du Haut, Ronchamp","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Notre-Dame%20du%20Haut%2C%20Ronchamp","aliases":["Notre-Dame du Haut, Ronchamp","Notre-Dame du Haut","Ronchamp chapel"],"photos":[],"questionIds":[],"tapestryIds":["t68-11fbcb477877"],"museumIds":[],"mapIds":[],"note":"Sculptural concrete forms distinguish this chapel from the geometric white villas of the 1920s.","built":"1950","creator":"Le Corbusier","placeId":"CH54-011"},{"id":"LE102-28825c2cd45d4d50","title":"Pop Art emerges","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Pop%20Art%20emerges","aliases":["Pop Art emerges"],"photos":[],"questionIds":[],"tapestryIds":["t68-ad1f597b68fc"],"museumIds":[],"mapIds":[],"note":"British and American strands use mass media and consumer imagery in different ways.","creator":"Richard Hamilton, Andy Warhol, Roy Lichtenstein"},{"id":"LE102-157ff2d287371921","title":"Brutalism, exposed materials and social programmes","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Brutalism%2C%20exposed%20materials%20and%20social%20programmes","aliases":["Brutalism, exposed materials and social programmes"],"photos":[],"questionIds":[],"tapestryIds":["t69-cdbf7b093e00"],"museumIds":[],"mapIds":[],"note":"Brutalism is associated with exposed construction and forceful form, often in public buildings. Not every concrete building is Brutalist, and the label has several origins.","built":"1950"},{"id":"LE102-03500115d4758941","title":"Pop Art, reproduction and consumer imagery","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Pop%20Art%2C%20reproduction%20and%20consumer%20imagery","aliases":["Pop Art, reproduction and consumer imagery"],"photos":[],"questionIds":[],"tapestryIds":["t69-d2d377be824c"],"museumIds":[],"mapIds":[],"note":"Commercial imagery, celebrity and repetition question distinctions between fine art and mass culture. Pop can be critical, ambiguous or fascinated rather than uniformly celebratory."},{"id":"LE102-bff00ab070fd1f29","title":"European integration: ECSC, EEC and EU","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=European%20integration","aliases":["European integration: ECSC, EEC and EU"],"photos":[],"questionIds":[],"tapestryIds":["t69-ee4319a7bbb7"],"museumIds":[],"mapIds":[],"note":"Coal and steel cooperation preceded the EEC; Maastricht established the EU later. Signature and entry into force are different dates; the Council of Europe is a separate organisation."},{"id":"LE102-63b21c70ee5dc7ba","title":"Treaty of Paris establishes ECSC","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Paris%20establishes%20ECSC","aliases":["Treaty of Paris establishes ECSC"],"photos":[],"questionIds":[],"tapestryIds":["t68-1d31ab639f4f"],"museumIds":[],"mapIds":[],"note":"Signed in 1951 and effective in 1952; the Coal and Steel Community united six founding states."},{"id":"LE102-0b4f04bfb7839b9e","title":"Unité d'Habitation in Marseille completed","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Unit%C3%A9%20d%27Habitation%20in%20Marseille%20completed","aliases":["Unité d'Habitation in Marseille completed"],"photos":[],"questionIds":[],"tapestryIds":["t68-e4ea1b0eb335"],"museumIds":[],"mapIds":[],"note":"A postwar collective housing prototype combining apartments with shared services.","built":"1952","creator":"Le Corbusier"},{"id":"LE102-8bbee91991fa2957","title":"Stalin dies","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Stalin%20dies","aliases":["Stalin dies"],"photos":[],"questionIds":["ARCHED-NEW101-0506"],"tapestryIds":["t68-7a5680fb7185"],"museumIds":[],"mapIds":[],"note":"His death opened a struggle for succession and later changes in Soviet policy."},{"id":"LE102-9c95a188ef798477","title":"Geneva agreements on Indochina","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Geneva%20agreements%20on%20Indochina","aliases":["Geneva agreements on Indochina"],"photos":[],"questionIds":[],"tapestryIds":["t68-606a9ba6cd68"],"museumIds":[],"mapIds":[],"note":"The settlement ended the First Indochina War and temporarily divided Vietnam."},{"id":"LE102-2fa3061402d29394","title":"Paris Agreements","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Paris%20Agreements","aliases":["Paris Agreements"],"photos":[],"questionIds":[],"tapestryIds":["t68-40be293dd4cf"],"museumIds":[],"mapIds":[],"note":"Prepared West German sovereignty and NATO membership and established the Western European Union framework."},{"id":"LE102-eca1d79b821506e1","title":"Warsaw Pact formed","kind":"history","reference":"https://www.nato.int/cps/en/natohq/declassified_138294.htm","aliases":["Warsaw Pact formed"],"photos":[],"questionIds":["ARCHED-NEW101-0511"],"tapestryIds":["t68-8f3cd8e6faed"],"museumIds":[],"mapIds":[],"note":"Formed after West Germany joined NATO; the two alliances structured much of Cold War Europe."},{"id":"LE102-94af88ca55d4f03d","title":"Hungarian uprising","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Hungarian%20uprising","aliases":["Hungarian uprising"],"photos":[],"questionIds":["GEN43-Q01139","ARCHED-NEW101-0140","ARCHED-NEW101-0505","ARCHED-NEW101-0523","ARCHED-NEW101-0530"],"tapestryIds":["t68-1567a6f536c5"],"museumIds":[],"mapIds":[],"note":"A revolt against Soviet-backed rule was suppressed by Soviet military intervention."},{"id":"LE102-63eb8e4027a55b03","title":"Khrushchev's Secret Speech","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Khrushchev%27s%20Secret%20Speech","aliases":["Khrushchev's Secret Speech"],"photos":[],"questionIds":["ARCHED-NEW101-0481"],"tapestryIds":["t68-4b6a1365ec28"],"museumIds":[],"mapIds":[],"note":"Denounced aspects of Stalin's rule; de-Stalinisation had uneven limits."},{"id":"LE102-2d13c0f7136d4a4e","title":"Suez Crisis","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Suez%20Crisis","aliases":["Suez Crisis"],"photos":[],"questionIds":["GEN43-Q04481","ARCHED-NEW99-0462"],"tapestryIds":["t68-bba9f1c1e6c8"],"museumIds":[],"mapIds":[],"note":"Britain, France and Israel attacked Egypt after canal nationalisation; international pressure forced withdrawal."},{"id":"LE102-adbbbd28b64ba34d","title":"International Atomic Energy Agency established","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=International%20Atomic%20Energy%20Agency%20established","aliases":["International Atomic Energy Agency established"],"photos":[],"questionIds":["ARCHED-NEW101-0458","ARCHED-NEW101-0463","ARCHED-NEW101-0470"],"tapestryIds":["t68-b9eb8d737ff9"],"museumIds":[],"mapIds":[],"note":"An international body for cooperation and safeguards in the peaceful use of nuclear technology."},{"id":"LE102-82c2eaad5ed8d83d","title":"Treaties of Rome signed","kind":"history","reference":"https://www.europarl.europa.eu/about-parliament/en/in-the-past/the-parliament-and-the-treaties/treaty-of-rome","aliases":["Treaties of Rome signed"],"photos":[],"questionIds":["GEN43-Q01599","ARCHED-NEW101-0467","ARCHED-NEW101-0532"],"tapestryIds":["t68-c8162e658969"],"museumIds":[],"mapIds":[],"note":"Signed on 25 March; the EEC and Euratom treaties entered into force on 1 January 1958."},{"id":"LE102-70b1a391e08b1073","title":"Cuban Revolution","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Cuban%20Revolution","aliases":["Cuban Revolution"],"photos":[],"questionIds":["ARCHED-NEW101-0475"],"tapestryIds":["t68-8dc592d23639"],"museumIds":[],"mapIds":[],"note":"Castro's movement overthrew Batista; Cold War alignment developed in the following years."},{"id":"LE102-dad903e39146f3d3","title":"Solomon R. Guggenheim Museum opens","kind":"architecture","reference":"https://en.wikipedia.org/wiki/Solomon_R._Guggenheim_Museum","aliases":["Solomon R. Guggenheim Museum opens","Solomon R. Guggenheim Museum"],"photos":[{"src":"/.netlify/functions/access?action=media&name=b4535881c2987e5afb983468.webp","sourceUrl":"https://commons.wikimedia.org/wiki/File:Solomon_R._Guggenheim_Museum_(48059131351).jpg","credit":"Ajay Suresh from New York, NY, USA","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","width":960,"height":540,"file":"Solomon_R._Guggenheim_Museum_(48059131351).jpg"}],"questionIds":["GEN43-Q01381","ARCHED-NEW101-0193","ARCHED-NEW101-0194","ARCHED-NEW101-0251","ARCHED-NEW101-0365","ADD45-Q11302","NEWDER-023"],"tapestryIds":["t68-bf1e282c4bdb"],"museumIds":[],"mapIds":[],"note":"The New York museum's spiral ramp organises a continuous exhibition route.","built":"1959","creator":"Frank Lloyd Wright","city":"New York","style":"Organic architecture","era":"Postwar","lat":40.78305556,"lon":-73.95888889,"coordinateSource":"https://en.wikipedia.org/wiki/Solomon_R._Guggenheim_Museum","resolvedTitle102":"Solomon R. Guggenheim Museum","placeId":"LE102-dad903e39146f3d3"},{"id":"LE102-6d4a34706d4fc07d","title":"Blue monochromes: series","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Blue%20monochromes%3A%20series","aliases":["Blue monochromes: series"],"photos":[{"src":"/.netlify/functions/access?action=media&name=5d8085a21fdbcfa4eed893ff.webp","credit":"Yves Klein","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/80103","caption":"Representative work from the series/cycle; the timeline range covers the series, not only this image. Shown: Blue Monochrome · 1961"}],"questionIds":[],"tapestryIds":["t68-b40bfd62dfc5"],"museumIds":[],"mapIds":[],"note":"Klein made multiple blue monochromes; the sheet does not identify a specific work or inventory number.","creator":"Yves Klein"},{"id":"LE102-d446980580d4c90a","title":"OPEC founded","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=OPEC%20founded","aliases":["OPEC founded"],"photos":[],"questionIds":["ARCHED-NEW101-0460","ARCHED-NEW101-0503"],"tapestryIds":["t68-d9e0d9ec2422"],"museumIds":[],"mapIds":[],"note":"Oil-producing states founded the organisation in Baghdad in September."},{"id":"LE102-c8f6874ade1bdff0","title":"Year of Africa","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Year%20of%20Africa","aliases":["Year of Africa"],"photos":[],"questionIds":["GEN43-Q01281"],"tapestryIds":["t68-43937a98fd45"],"museumIds":[],"mapIds":[],"note":"Seventeen African countries gained independence, within a longer and uneven decolonisation process."},{"id":"LE102-d9c4c2b8ea21c106","title":"Conceptual art","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Conceptual%20art","aliases":["Conceptual art"],"photos":[],"questionIds":[],"tapestryIds":["t68-65894a09bc50"],"museumIds":[],"mapIds":[],"note":"The idea, proposition or instruction can take priority over a unique crafted object.","creator":"Joseph Kosuth, Sol LeWitt"},{"id":"LE102-e787ed1308c981c7","title":"Land art","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Land%20art","aliases":["Land art"],"photos":[],"questionIds":[],"tapestryIds":["t68-2dc976dc461e"],"museumIds":[],"mapIds":[],"note":"Works engage sites and landscapes; not every work shares the same environmental ethics.","creator":"Robert Smithson"},{"id":"LE102-34ab762a13d1c236","title":"Minimalism","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Minimalism","aliases":["Minimalism"],"photos":[],"questionIds":[],"tapestryIds":["t68-05fef4bb7648"],"museumIds":[],"mapIds":[],"note":"Industrial materials, repetition and the viewer's bodily relation to space challenge traditional composition.","creator":"Donald Judd, Carl Andre"},{"id":"LE102-0e2207e226d04839","title":"Minimalism: serial form and the viewer's body","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Minimalism","aliases":["Minimalism: serial form and the viewer's body"],"photos":[],"questionIds":[],"tapestryIds":["t69-b90426723968"],"museumIds":[],"mapIds":[],"note":"Repeated industrial forms and real spatial relationships shift attention from expressive brushwork to the viewer's encounter with objects."},{"id":"LE102-88b18da1c2fc03d6","title":"Civil rights, feminism and social movements","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Civil%20rights%2C%20feminism%20and%20social%20movements","aliases":["Civil rights, feminism and social movements"],"photos":[],"questionIds":[],"tapestryIds":["t69-2578853cd51e"],"museumIds":[],"mapIds":[],"note":"Movements challenged legal and social inequalities through different goals and strategies. Compare voting rights, workplace rights and broader forms of social power."},{"id":"LE102-25a261b04c8bd6cb","title":"Conceptual art, instructions and documentation","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Conceptual%20art%2C%20instructions%20and%20documentation","aliases":["Conceptual art, instructions and documentation"],"photos":[],"questionIds":[],"tapestryIds":["t69-60141c2bafaa"],"museumIds":[],"mapIds":[],"note":"The proposition or process may be central while objects, photographs or text document it. Conceptual art does not mean that material presentation is always irrelevant."},{"id":"LE102-ebae4ebd7788eacd","title":"Land art and site specificity","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Land%20art%20and%20site%20specificity","aliases":["Land art and site specificity"],"photos":[],"questionIds":[],"tapestryIds":["t69-8d3d1dbbd0aa"],"museumIds":[],"mapIds":[],"note":"A work's location and physical conditions can be constitutive of it. Moving documentation into a museum is not equivalent to relocating the original site."},{"id":"LE102-3da444bc87630ab5","title":"Performance, body art and temporary work","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Performance%2C%20body%20art%20and%20temporary%20work","aliases":["Performance, body art and temporary work"],"photos":[],"questionIds":[],"tapestryIds":["t69-158553c2fc72"],"museumIds":[],"mapIds":[],"note":"An action, duration or bodily presence can form the work. Surviving photographs or videos may be documentation rather than the original event itself."},{"id":"LE102-7035d65194da3e03","title":"Berlin Wall construction begins","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Berlin%20Wall%20construction%20begins","aliases":["Berlin Wall construction begins"],"photos":[],"questionIds":["ARCHED-NEW101-0468","ARCHED-NEW101-0474","ARCHED-NEW101-0478"],"tapestryIds":["t68-c84ac4097676"],"museumIds":[],"mapIds":[],"note":"East German authorities began closing the border on 13 August."},{"id":"LE102-4fdead809c9f3542","title":"Gagarin's first human spaceflight","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Gagarin%27s%20first%20human%20spaceflight","aliases":["Gagarin's first human spaceflight"],"photos":[],"questionIds":["ARCHED-NEW101-0455"],"tapestryIds":["t68-6833d0768625"],"museumIds":[],"mapIds":[],"note":"Vostok 1 orbited Earth on 12 April."},{"id":"LE102-ad5791fd7d141d6e","title":"Campbell's Soup Cans","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Campbell%27s%20Soup%20Cans","aliases":["Campbell's Soup Cans"],"photos":[{"src":"/.netlify/functions/access?action=media&name=8c71502d5ec62828ec83c580.webp","credit":"Andy Warhol","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/79809","caption":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: Campbell's Soup Cans · 1962"},{"src":"/.netlify/functions/access?action=media&name=8c71502d5ec62828ec83c580.webp","credit":"The Museum of Modern Art, New York · Partial gift of Irving Blum\r\n\r\nAdditional funding provided by Nelson A. Rockefeller Bequest, gift of Mr. and Mrs. William A. M. Burden, Abby Aldrich Rockefeller Fund, gift of Nina and Gordon Bunshaft, acquired through the Lillie P. Bliss Bequest, Philip Johnson Fund, Frances R. Keech Bequest, gift of Mrs. Bliss Parkinson, and Florence B. Wesley Bequest (all by exchange)","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/79809","licenseUrl":"https://www.moma.org/collection/works/79809"},{"src":"/.netlify/functions/access?action=media&name=8c71502d5ec62828ec83c580.webp","credit":"The Museum of Modern Art, New York · Partial gift of Irving Blum\r\n\r\nAdditional funding provided by Nelson A. Rockefeller Bequest, gift of Mr. and Mrs. William A. M. Burden, Abby Aldrich Rockefeller Fund, gift of Nina and Gordon Bunshaft, acquired through the Lillie P. Bliss Bequest, Philip Johnson Fund, Frances R. Keech Bequest, gift of Mrs. Bliss Parkinson, and Florence B. Wesley Bequest (all by exchange)","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/79809","licenseUrl":""}],"questionIds":["GEN43-Q04364","PDF33-Q106-A"],"tapestryIds":["t68-c6ed89a09ade"],"museumIds":["M77-MOMA-79809"],"mapIds":[],"note":"Serial presentation links consumer goods, repetition and art display.","creator":"Andy Warhol","assetIds":["M77-MOMA-79809","REV85-IMAGE-4364"]},{"id":"LE102-625f9673ddbfda6f","title":"Cuban Missile Crisis","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Cuban%20Missile%20Crisis","aliases":["Cuban Missile Crisis"],"photos":[],"questionIds":["GEN43-Q03840","ARCHED-NEW101-0151","ARCHED-NEW101-0152","ARCHED-NEW101-0504","ARCHED-NEW101-0533","ALPHA-B009-Q823"],"tapestryIds":["t68-0540cb66932e"],"museumIds":[],"mapIds":[],"note":"A US–Soviet confrontation over missiles in Cuba brought the Cold War close to nuclear conflict."},{"id":"LE102-efad85fd215b969e","title":"Drowning Girl","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Drowning%20Girl","aliases":["Drowning Girl"],"photos":[{"src":"/.netlify/functions/access?action=media&name=99a1de58ae6d6b0ac8627c33.webp","credit":"Roy Lichtenstein","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/80249","caption":"Identified work. Sculpture photographs may show later casts or surviving copies. Shown: Drowning Girl · 1963"},{"src":"/.netlify/functions/access?action=media&name=99a1de58ae6d6b0ac8627c33.webp","credit":"The Museum of Modern Art, New York · Philip Johnson Fund (by exchange) and gift of Mr. and Mrs. Bagley Wright","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/80249","licenseUrl":"https://www.moma.org/collection/works/80249"}],"questionIds":["GEN43-Q02231"],"tapestryIds":["t68-54fa48f16adc"],"museumIds":["M77-MOMA-80249"],"mapIds":[],"note":"Pop Art transforms a comic-book source through cropping, scale and painterly reconstruction.","creator":"Roy Lichtenstein","assetIds":["M77-MOMA-80249"]},{"id":"LE102-571a95031867e9ac","title":"John F. Kennedy assassinated","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=John%20F.%20Kennedy%20assassinated","aliases":["John F. Kennedy assassinated"],"photos":[],"questionIds":["ARCHED-NEW101-0464","ARCHED-NEW101-0488","ARCHED-NEW101-0515"],"tapestryIds":["t68-239d90664330"],"museumIds":[],"mapIds":[],"note":"The US president was killed in Dallas on 22 November."},{"id":"LE102-43407f17a87f1676","title":"Spatial Concept, Expectations: series","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Spatial%20Concept%2C%20Expectations%3A%20series","aliases":["Spatial Concept, Expectations: series"],"photos":[{"src":"/.netlify/functions/access?action=media&name=d430361fd6eecea3ff62e8ec.webp","credit":"Lucio Fontana","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/79637","caption":"Representative work from the series/cycle; the timeline range covers the series, not only this image. Shown: Spatial Concept: Expectations · 1959"},{"src":"/.netlify/functions/access?action=media&name=d430361fd6eecea3ff62e8ec.webp","credit":"Lucio Fontana","license":"Image © respective rights holders · MoMA collection","sourceUrl":"https://www.moma.org/collection/works/79637","licenseUrl":""}],"questionIds":["GEN43-Q04260"],"tapestryIds":["t68-b322d0b665af"],"museumIds":[],"mapIds":[],"note":"Slashed canvases investigate real space; the sheet labels a series, not one uniquely dated canvas.","creator":"Lucio Fontana","assetIds":["T83-t68-b322d0b665af"]},{"id":"LE102-72d91605cc736959","title":"Arte Povera named","kind":"art","reference":"https://en.wikipedia.org/wiki/Arte_Povera","aliases":["Arte Povera named"],"photos":[],"questionIds":[],"tapestryIds":["t68-41f4d136f827"],"museumIds":[],"mapIds":[],"note":"An Italian critical grouping using humble materials and questioning cultural institutions.","creator":"Germano Celant"},{"id":"LE102-7ee8179d7b114feb","title":"European Communities Merger Treaty takes effect","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=European%20Communities%20Merger%20Treaty%20takes%20effect","aliases":["European Communities Merger Treaty takes effect"],"photos":[],"questionIds":["ARCHED-NEW101-0505","ARCHED-NEW101-0511"],"tapestryIds":["t68-fc7b668a1e73"],"museumIds":[],"mapIds":[],"note":"A single Commission and Council served the Communities; the separate treaties did not simply disappear."},{"id":"LE102-c13b22cb8f601d27","title":"Arte Povera and unconventional materials","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Arte%20Povera%20and%20unconventional%20materials","aliases":["Arte Povera and unconventional materials"],"photos":[],"questionIds":[],"tapestryIds":["t69-f03a18851a08"],"museumIds":[],"mapIds":[],"note":"Artists used materials such as earth, cloth, wood and industrial components to question established artistic and economic values. Povera does not describe a lack of artistic skill."},{"id":"LE102-ffeef9ca3f6542cb","title":"Martin Luther King Jr. and Robert Kennedy assassinated","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Martin%20Luther%20King%20Jr.%20and%20Robert%20Kennedy%20assassinated","aliases":["Martin Luther King Jr. and Robert Kennedy assassinated"],"photos":[],"questionIds":[],"tapestryIds":["t68-4b29577f27ba"],"museumIds":[],"mapIds":[],"note":"King was killed in April and Kennedy in June; distinguish their roles and circumstances."},{"id":"LE102-aad882dbf233ea11","title":"Prague Spring and Warsaw Pact invasion","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Prague%20Spring%20and%20Warsaw%20Pact%20invasion","aliases":["Prague Spring and Warsaw Pact invasion"],"photos":[],"questionIds":[],"tapestryIds":["t68-443f576165ac"],"museumIds":[],"mapIds":[],"note":"Czechoslovak reform efforts were suppressed by an invasion in August."},{"id":"LE102-e5814714b71adc87","title":"Apollo 11 Moon landing","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Apollo%2011%20Moon%20landing","aliases":["Apollo 11 Moon landing"],"photos":[],"questionIds":["ARCHED-NEW101-0455","ARCHED-NEW101-0490"],"tapestryIds":["t68-801652e3c3d3"],"museumIds":[],"mapIds":[],"note":"Armstrong and Aldrin landed on the Moon; Collins remained in lunar orbit."},{"id":"LE102-0ebb78d33952b994","title":"Postmodern architecture and historical quotation","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Postmodern%20architecture%20and%20historical%20quotation","aliases":["Postmodern architecture and historical quotation"],"photos":[],"questionIds":[],"tapestryIds":["t69-fb476bcfcf5f"],"museumIds":[],"mapIds":[],"note":"Historical reference, symbolism and critiques of modernist uniformity take multiple forms. Postmodern is not a label for every building constructed after 1970.","built":"1970"},{"id":"LE102-2ff7b41055089c72","title":"High-tech architecture and expressed services","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=High-tech%20architecture%20and%20expressed%20services","aliases":["High-tech architecture and expressed services"],"photos":[],"questionIds":[],"tapestryIds":["t69-c02592f5bdbd"],"museumIds":[],"mapIds":[],"note":"Structure and building services may be made visually prominent. Exposed ducts alone are insufficient to identify the movement or architect.","built":"1970"},{"id":"LE102-b62d304ab52f9563","title":"Sydney Opera House opens","kind":"architecture","reference":"https://en.wikipedia.org/wiki/Sydney_Opera_House","aliases":["Sydney Opera House opens","Sydney Opera House"],"photos":[{"src":"/.netlify/functions/access?action=media&name=68fd5d07dd7a011236cd1b39.webp","sourceUrl":"https://commons.wikimedia.org/wiki/File:Sydney_Australia._(21339175489).jpg","credit":"Bernard Spragg. NZ from Christchurch, New Zealand","license":"CC0","licenseUrl":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","width":960,"height":589,"file":"Sydney_Australia._(21339175489).jpg"}],"questionIds":["GEN43-Q01433","ARCHED-B03-20261007-249","ARCHED-NEW101-0194","ARCHED-NEW101-0252","ARCHED-NEW101-0442"],"tapestryIds":["t68-aabd24d12920"],"museumIds":[],"mapIds":[],"note":"Opened after a long construction process; Utzon left the project in 1966.","built":"1973","creator":"Jørn Utzon","city":"Sydney","style":"Modernism","era":"Postwar","lat":-33.85681,"lon":151.21514,"coordinateSource":"https://en.wikipedia.org/wiki/Sydney_Opera_House","resolvedTitle102":"Sydney Opera House","placeId":"LE102-b62d304ab52f9563"},{"id":"LE102-4fb1f397fd8d496e","title":"Khmer Rouge rule in Cambodia","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Khmer%20Rouge%20rule%20in%20Cambodia","aliases":["Khmer Rouge rule in Cambodia"],"photos":[],"questionIds":[],"tapestryIds":["t68-9a6a55d7dc1f"],"museumIds":[],"mapIds":[],"note":"Pol Pot's regime perpetrated mass killings, forced labour and widespread persecution."},{"id":"LE102-bd1c7a9026c5085f","title":"Year of three popes","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Year%20of%20three%20popes","aliases":["Year of three popes"],"photos":[],"questionIds":["ARCHED-NEW101-0478","ARCHED-NEW101-0515","ALPHA-B004-Q318"],"tapestryIds":["t68-586528e7061c"],"museumIds":[],"mapIds":[],"note":"Paul VI died, John Paul I had a brief papacy, and John Paul II was elected."},{"id":"LE102-a8f201ed92d03e91","title":"Iranian Revolution and Islamic Republic","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Iranian%20Revolution%20and%20Islamic%20Republic","aliases":["Iranian Revolution and Islamic Republic"],"photos":[],"questionIds":[],"tapestryIds":["t68-44b78a5cecc2"],"museumIds":[],"mapIds":[],"note":"The monarchy fell and an Islamic Republic was established; the revolution brought together competing forces."},{"id":"LE102-39344e88198b7034","title":"Transavanguardia named","kind":"art","reference":"https://en.wikipedia.org/wiki/Transavantgarde","aliases":["Transavanguardia named"],"photos":[],"questionIds":[],"tapestryIds":["t68-b3018dedd875"],"museumIds":[],"mapIds":[],"note":"An Italian critical label associated with a return to expressive painting.","creator":"Achille Bonito Oliva"},{"id":"LE102-72f90510afec9b8f","title":"Deconstructivist architectural form","kind":"architecture","reference":"https://www.moma.org/calendar/exhibitions/1813?locale=en","aliases":["Deconstructivist architectural form"],"photos":[],"questionIds":[],"tapestryIds":["t69-59cb77b75243"],"museumIds":[],"mapIds":[],"note":"Fragmentation and disrupted geometries challenge expectations of stable composition. The 1988 MoMA exhibition grouped diverse architects, not a single construction system.","built":"1980"},{"id":"LE102-7af206bbbe115a45","title":"Chernobyl nuclear disaster","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Chernobyl%20nuclear%20disaster","aliases":["Chernobyl nuclear disaster"],"photos":[],"questionIds":["ARCHED-NEW98-0031","ARCHED-NEW101-0466","ARCHED-NEW101-0488"],"tapestryIds":["t68-056b75a1d3e1"],"museumIds":[],"mapIds":[],"note":"A reactor accident on 26 April had widespread environmental and political consequences."},{"id":"LE102-f2e76d2a0b1b9e1a","title":"Fall of the Berlin Wall","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Fall%20of%20the%20Berlin%20Wall","aliases":["Fall of the Berlin Wall"],"photos":[],"questionIds":["ARCHED-NEW101-0501","ARCHED-NEW101-0511","ALPHA-B001-Q013","ALPHA-B007-Q585"],"tapestryIds":["t68-9614e43295db"],"museumIds":[],"mapIds":[],"note":"Border crossings opened on 9 November; German reunification followed in 1990."},{"id":"LE102-066e33ede3998f8a","title":"Malta Summit","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Malta%20Summit","aliases":["Malta Summit"],"photos":[],"questionIds":[],"tapestryIds":["t68-cc2ddaa5734f"],"museumIds":[],"mapIds":[],"note":"Bush and Gorbachev met during the rapid transformation of Cold War Europe."},{"id":"LE102-819d2311dd1449fa","title":"Tiananmen Square crackdown","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Tiananmen%20Square%20crackdown","aliases":["Tiananmen Square crackdown"],"photos":[],"questionIds":["ARCHED-NEW101-0462"],"tapestryIds":["t68-8495714b738c"],"museumIds":[],"mapIds":[],"note":"Chinese authorities violently suppressed a protest movement in June."},{"id":"LE102-5835f3d594521611","title":"Globalisation and economic interdependence","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Globalisation%20and%20economic%20interdependence","aliases":["Globalisation and economic interdependence"],"photos":[],"questionIds":[],"tapestryIds":["t69-ed7b257a701d"],"museumIds":[],"mapIds":[],"note":"Cross-border trade, finance, production and information increased interdependence. These processes predate 1989 and do not erase national institutions or inequalities."},{"id":"LE102-4e331577c5aa3e4e","title":"German reunification","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=German%20reunification","aliases":["German reunification"],"photos":[],"questionIds":["GEN43-Q01099","ARCHED-NEW99-0948"],"tapestryIds":["t68-a36e80562565"],"museumIds":[],"mapIds":[],"note":"The German Democratic Republic joined the Federal Republic on 3 October."},{"id":"LE102-cf5bf83309b68c19","title":"Dissolution of the Soviet Union","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Dissolution%20of%20the%20Soviet%20Union","aliases":["Dissolution of the Soviet Union"],"photos":[],"questionIds":["ARCHED-NEW101-0464"],"tapestryIds":["t68-f18cb569fc3d"],"museumIds":[],"mapIds":[],"note":"The USSR ceased to exist in December; successor states followed different political paths."},{"id":"LE102-75489da356e46be3","title":"Maastricht Treaty signed","kind":"history","reference":"https://european-union.europa.eu/principles-countries-history/history-eu/1990-99_en","aliases":["Maastricht Treaty signed"],"photos":[],"questionIds":["ARCHED-NEW101-0474"],"tapestryIds":["t68-93bcf7591cca"],"museumIds":[],"mapIds":[],"note":"Signed on 7 February; the European Union formally began when the treaty entered into force in 1993."},{"id":"LE102-be1144f01d0668ea","title":"European Union established","kind":"history","reference":"https://eur-lex.europa.eu/collection/eu-law/treaties/treaties-founding.html?locale=en","aliases":["European Union established"],"photos":[],"questionIds":["ARCHED-NEW101-0463"],"tapestryIds":["t68-49e132b50907"],"museumIds":[],"mapIds":[],"note":"The Maastricht Treaty entered into force on 1 November."},{"id":"LE102-3a6e39a5cc9a7209","title":"NAFTA enters into force","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=NAFTA%20enters%20into%20force","aliases":["NAFTA enters into force"],"photos":[],"questionIds":["ARCHED-NEW101-0466"],"tapestryIds":["t68-013f78bb29b1"],"museumIds":[],"mapIds":[],"note":"A trade agreement between Canada, Mexico and the United States; later replaced by USMCA."},{"id":"LE102-63901e84f8ea9d1e","title":"September 11 attacks","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=September%2011%20attacks","aliases":["September 11 attacks"],"photos":[],"questionIds":["ARCHED-NEW101-0458","ARCHED-NEW101-0481","ARCHED-NEW101-0510"],"tapestryIds":["t68-cade75e570dc"],"museumIds":[],"mapIds":[],"note":"Al-Qaeda attacks in the United States reshaped international security policy."},{"id":"LE102-8c1ac0496811e713","title":"Lehman Brothers bankruptcy","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Lehman%20Brothers%20bankruptcy","aliases":["Lehman Brothers bankruptcy"],"photos":[],"questionIds":["ARCHED-NEW101-0466","ARCHED-NEW101-0478"],"tapestryIds":["t68-2bc69ad18e52"],"museumIds":[],"mapIds":[],"note":"The September collapse intensified the global financial crisis; the crisis had begun earlier."},{"id":"LE102-80bc06d1e98654c0","title":"Arab Spring uprisings begin","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Arab%20Spring%20uprisings%20begin","aliases":["Arab Spring uprisings begin"],"photos":[],"questionIds":[],"tapestryIds":["t68-902246beb578"],"museumIds":[],"mapIds":[],"note":"Beginning in Tunisia in late 2010, protests spread in 2011 with different outcomes by country."},{"id":"LE102-44c199f81855c240","title":"First Steps, after Millet","kind":"art","reference":"https://www.metmuseum.org/art/collection/search/436526","aliases":["First Steps, after Millet"],"photos":[{"src":"/.netlify/functions/access?action=media&name=d2a374fbe5fc0782a2e5b545.webp","credit":"The Metropolitan Museum of Art","license":"CC0","sourceUrl":"https://www.metmuseum.org/art/collection/search/436526","licenseUrl":""}],"questionIds":[],"tapestryIds":[],"museumIds":[],"mapIds":[],"assetIds":["MET44-436526"]},{"id":"LE102-deee415d9767a557","title":"The Flowering Orchard","kind":"art","reference":"https://www.metmuseum.org/art/collection/search/436527","aliases":["The Flowering Orchard"],"photos":[{"src":"/.netlify/functions/access?action=media&name=859929686c716f815b03105b.webp","credit":"The Metropolitan Museum of Art","license":"CC0","sourceUrl":"https://www.metmuseum.org/art/collection/search/436527","licenseUrl":""}],"questionIds":[],"tapestryIds":[],"museumIds":[],"mapIds":[],"assetIds":["MET44-436527"]},{"id":"LE102-f6e30643f6d29b8f","title":"Oleanders","kind":"art","reference":"https://www.metmuseum.org/art/collection/search/436530","aliases":["Oleanders"],"photos":[{"src":"/.netlify/functions/access?action=media&name=9e821511cccacd9fc5bd928b.webp","credit":"The Metropolitan Museum of Art","license":"CC0","sourceUrl":"https://www.metmuseum.org/art/collection/search/436530","licenseUrl":""}],"questionIds":[],"tapestryIds":[],"museumIds":[],"mapIds":[],"assetIds":["MET44-436530"]},{"id":"LE102-092392d6a904427e","title":"Wheat Field with Cypresses","kind":"art","reference":"https://www.metmuseum.org/art/collection/search/436535","aliases":["Wheat Field with Cypresses"],"photos":[{"src":"/.netlify/functions/access?action=media&name=dcfbd989aa607943824a59a0.webp","credit":"The Metropolitan Museum of Art","license":"CC0","sourceUrl":"https://www.metmuseum.org/art/collection/search/436535","licenseUrl":""}],"questionIds":[],"tapestryIds":[],"museumIds":[]