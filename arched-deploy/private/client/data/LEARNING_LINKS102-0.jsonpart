:["T81-t63-b6d5403cc0e0"]},{"id":"LE102-e2da0629762abd3a","title":"Black Death in Europe","kind":"history","reference":"https://en.wikipedia.org/wiki/Black_Death","aliases":["Black Death in Europe"],"photos":[],"questionIds":[],"tapestryIds":["t63-4bd5ea968802"],"museumIds":[],"mapIds":[],"note":"European wave; regional dates vary."},{"id":"LE102-2b6c4c13ce36cf24","title":"Decameron","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Decameron","aliases":["Decameron"],"photos":[],"questionIds":[],"tapestryIds":["t63-f1f9a4c994a9"],"museumIds":[],"mapIds":[],"note":"Stories framed by flight from plague-stricken Florence in 1348.","creator":"Giovanni Boccaccio"},{"id":"LE102-0696c3aa4fe751fd","title":"Claus Sluter","kind":"person","reference":"https://en.wikipedia.org/wiki/Claus_Sluter","aliases":["Claus Sluter"],"photos":[],"questionIds":[],"tapestryIds":["t63-b3611977feda"],"museumIds":[],"mapIds":[],"note":"Sculptor; birth approximate."},{"id":"LE102-526b7792c7d3f61d","title":"Ottomans establish a foothold at Gallipoli","kind":"history","reference":"https://en.wikipedia.org/wiki/Fall_of_Gallipoli","aliases":["Ottomans establish a foothold at Gallipoli"],"photos":[],"questionIds":[],"tapestryIds":["t63-41377c169ec8"],"museumIds":[],"mapIds":[],"note":"A key stage in expansion into Europe."},{"id":"LE102-c9985ba3e6461011","title":"De remediis utriusque fortunae","kind":"art","reference":"https://en.wikipedia.org/wiki/De_remediis_utriusque_fortunae","aliases":["De remediis utriusque fortunae"],"photos":[],"questionIds":["GEN43-Q01362"],"tapestryIds":["t63-8a74a45ad9fb"],"museumIds":[],"mapIds":[],"note":"Dialogues addressing good and adverse fortune.","creator":"Petrarch"},{"id":"LE102-cb9e7e1bd0621513","title":"Battle of Poitiers","kind":"history","reference":"https://en.wikipedia.org/wiki/Battle_of_Poitiers","aliases":["Battle of Poitiers"],"photos":[],"questionIds":["ARCHED-NEW101-0521"],"tapestryIds":["t63-3ef02acbf753"],"museumIds":[],"mapIds":[],"note":