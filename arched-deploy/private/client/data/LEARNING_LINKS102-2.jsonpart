tapestryIds":["t68-0f8c5d3bbb48"],"museumIds":[],"mapIds":[],"note":"A novel set around the Napoleonic wars; publication and depicted events have different dates.","creator":"Leo Tolstoy"},{"id":"LE102-8d6964e1747eb533","title":"Austro-Prussian War","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Austro-Prussian%20War","aliases":["Austro-Prussian War"],"photos":[],"questionIds":["GEN43-Q04421"],"tapestryIds":["t68-26223a60f60e"],"museumIds":[],"mapIds":[],"note":"Prussian victory changed the German balance of power; Italy gained Venetia through the related settlement."},{"id":"LE102-784a74aeffbb510c","title":"Crime and Punishment","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Crime%20and%20Punishment","aliases":["Crime and Punishment"],"photos":[],"questionIds":["GEN43-Q04491"],"tapestryIds":["t68-46286511936f"],"museumIds":[],"mapIds":[],"note":"A novel probing guilt, morality and social conditions.","creator":"Fyodor Dostoevsky"},{"id":"LE102-354d2388d5b12a75","title":"The Origin of the World","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=The%20Origin%20of%20the%20World","aliases":["The Origin of the World"],"photos":[{"src":"/.netlify/functions/access?action=media&name=24e3426ea301228b942388aa.webp","credit":"Gustave Courbet","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Origin-of-the-World.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."}],"questionIds":[],"tapestryIds":["t68-019e887e400a"],"museumIds":[],"mapIds":[],"note":"A frank bodily image that challenges conventions of representation and spectatorship.","creator":"Gustave Courbet"},{"id":"LE102-4b56ad3358d0746f","title":"Wassily Kandinsky","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Wassily%20Kandinsky","aliases":["Wassily Kandinsky"],"photos":[],"questionIds":["PDF33-Q097-B"],"tapestryIds":["t68-cfc5d639790c"],"museumIds":[],"mapIds":[],"note":"Russian-born artist active in Germany and France; connected to Der Blaue Reiter and Bauhaus."},{"id":"LE102-890eb48fa3e6205c","title":"Alaska Purchase","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Alaska%20Purchase","aliases":["Alaska Purchase"],"photos":[],"questionIds":[],"tapestryIds":["t68-a80cd30eb4de"],"museumIds":[],"mapIds":[],"note":"The United States bought Alaska from Russia."},{"id":"LE102-c4ed31337622670e","title":"Austro-Hungarian Compromise","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Austro-Hungarian%20Compromise","aliases":["Austro-Hungarian Compromise"],"photos":[],"questionIds":[],"tapestryIds":["t68-b4214650024c"],"museumIds":[],"mapIds":[],"note":"Created the Dual Monarchy, not a single unified nation-state."},{"id":"LE102-a81977f2fdbcc4bc","title":"Das Kapital, volume I published","kind":"history","reference":"https://en.wikipedia.org/wiki/Das_Kapital","aliases":["Das Kapital, volume I published"],"photos":[],"questionIds":[],"tapestryIds":["t68-bff01e75d9e7"],"museumIds":[],"mapIds":[],"note":"Marx's critique of capitalist production; distinguish from the 1848 Manifesto."},{"id":"LE102-199d5035478f0823","title":"Frank Lloyd Wright","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Frank%20Lloyd%20Wright","aliases":["Frank Lloyd Wright"],"photos":[],"questionIds":["GEN43-Q04537","ARCHED-NEW99-0547","ARCHED-NEW101-0244","ARCHED-NEW101-0246","ARCHED-NEW101-0247","ARCHED-NEW101-0248","ARCHED-NEW101-0251","ARCHED-NEW101-0266","ALPHA-B001-Q038","ALPHA-B006-Q657","PDF33-Q117-B","PDF34-Q-155-B","PDF34-CON-034-A","PDF35-Q072-B"],"tapestryIds":["t68-dbad288d3bf3"],"museumIds":[],"mapIds":[],"note":"American architect associated with organic architecture, Prairie houses and the Guggenheim Museum."},{"id":"LE102-4426f5a3e2d85e63","title":"Meiji Restoration","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Meiji%20Restoration","aliases":["Meiji Restoration"],"photos":[],"questionIds":["GEN43-Q03814","GEN43-Q04472"],"tapestryIds":["t68-b26608221211"],"museumIds":[],"mapIds":[],"note":"Imperial rule was restored in Japan; state-led modernisation followed."},{"id":"LE102-9c9ecf1c7f54b9eb","title":"First US transcontinental railroad completed","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=First%20US%20transcontinental%20railroad%20completed","aliases":["First US transcontinental railroad completed"],"photos":[],"questionIds":[],"tapestryIds":["t68-871f9c4ea98d"],"museumIds":[],"mapIds":[],"note":"The rail connection joined at Promontory Summit; engineering and settlement transformed the continent."},{"id":"LE102-c98b2c3a009ce360","title":"Suez Canal opens","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Suez%20Canal%20opens","aliases":["Suez Canal opens"],"photos":[],"questionIds":[],"tapestryIds":["t68-153c750b32b9"],"museumIds":[],"mapIds":[],"note":"The canal connected the Mediterranean and Red Sea, changing shipping routes and imperial strategy."},{"id":"LE102-ff9231e9df7ddf25","title":"Henri Matisse","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Henri%20Matisse","aliases":["Henri Matisse"],"photos":[],"questionIds":["PDF33-Q089-B"],"tapestryIds":["t68-184e80b1ce5e"],"museumIds":[],"mapIds":[],"note":"Painter, sculptor and maker of cut-outs; a leading Fauvist."},{"id":"LE102-99e504293466428f","title":"Battle of Sedan","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Battle%20of%20Sedan","aliases":["Battle of Sedan"],"photos":[],"questionIds":["ARCHED-NEW99-0249"],"tapestryIds":["t68-2e6bb2929b4a"],"museumIds":[],"mapIds":[],"note":"Napoleon III was captured; the defeat preceded the proclamation of the French Third Republic."},{"id":"LE102-b010362392368a75","title":"Capture of Rome","kind":"history","reference":"https://en.wikipedia.org/wiki/Capture_of_Rome","aliases":["Capture of Rome"],"photos":[],"questionIds":["ARCHED-NEW101-0484","ALPHA-B006-Q633","NEWDER-025"],"tapestryIds":["t68-571983cbccfe"],"museumIds":[],"mapIds":[],"note":"Italian troops entered Rome on 20 September; Rome became the capital in 1871."},{"id":"LE102-9df4142a50a1d244","title":"Franco-Prussian War","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Franco-Prussian%20War","aliases":["Franco-Prussian War"],"photos":[],"questionIds":["ARCHED-NEW99-0316"],"tapestryIds":["t68-e1eb048bd967"],"museumIds":[],"mapIds":[],"note":"French defeat ended the Second Empire and accelerated German unification."},{"id":"LE102-eaf6d0e672fe245f","title":"German Empire proclaimed","kind":"history","reference":"https://en.wikipedia.org/wiki/Proclamation_of_the_German_Empire","aliases":["German Empire proclaimed"],"photos":[],"questionIds":[],"tapestryIds":["t68-28b78178f2b2"],"museumIds":[],"mapIds":[],"note":"Proclaimed at Versailles under William I, with Bismarck as chancellor."},{"id":"LE102-cd6e94cd6ce4e1ef","title":"Paris Commune","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Paris%20Commune","aliases":["Paris Commune"],"photos":[],"questionIds":["GEN43-Q03844","ARCHED-NEW101-0459","ALPHA-B001-Q024"],"tapestryIds":["t68-d781d2f7abff"],"museumIds":[],"mapIds":[],"note":"A revolutionary government held Paris before its suppression during Bloody Week."},{"id":"LE102-a388c0035651db9e","title":"Treaty of Frankfurt","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Treaty%20of%20Frankfurt","aliases":["Treaty of Frankfurt"],"photos":[],"questionIds":["ARCHED-NEW101-0500"],"tapestryIds":["t68-de54a6dde3f4"],"museumIds":[],"mapIds":[],"note":"Ended the Franco-Prussian War; France ceded Alsace and part of Lorraine to Germany."},{"id":"LE102-124728f2205f21fd","title":"Giacomo Balla","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Giacomo%20Balla","aliases":["Giacomo Balla"],"photos":[],"questionIds":