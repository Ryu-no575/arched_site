rastructure supported imperial administration.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Aqueducts%2C%20roads%20and%20Roman%20urban%20systems","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t69-d1b872994a4a","title":"Forum, amphitheatre and theatre","lane":"architecture","start":-100,"end":300,"approx":true,"note":"A forum is a civic space; an amphitheatre surrounds an oval arena; a theatre has a semicircular seating arrangement facing a stage. Function helps identify the plan.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Forum%2C%20amphitheatre%20and%20theatre","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-1a07cd76ea27","title":"Vitruvius","lane":"people","start":-80,"end":-15,"approx":true,"note":"Roman author and architect; dates approximate.","creators":[],"reference":"https://en.wikipedia.org/wiki/Vitruvius","sourceSheets":[3633],"sourceMapping":"period context","dateType":"lifespan","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-1bf5d8783199","title":"Cleopatra VII","lane":"people","start":-69,"end":-30,"approx":false,"note":"Ptolemaic ruler of Egypt.","creators":[],"reference":"https://en.wikipedia.org/wiki/Cleopatra","sourceSheets":[3633],"sourceMapping":"period context","dateType":"lifespan","threads67":["other"],"setting67":"Historical setting"},{"id":"t63-4e4ae963f6e5","title":"Augustus","lane":"people","start":-63,"end":14,"approx":false,"note":"First Roman emperor.","creators":[],"reference":"https://en.wikipe