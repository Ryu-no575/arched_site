[],"tapestryIds":["t68-a54ea99e75b6"],"museumIds":[],"mapIds":[],"note":"A novel exploring destructive passion, social position and inheritance.","creator":"Emily Brontë"},{"id":"LE102-50bc042594294104","title":"February Revolution and French Second Republic","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=February%20Revolution%20and%20French%20Second%20Republic","aliases":["February Revolution and French Second Republic"],"photos":[],"questionIds":[],"tapestryIds":["t68-2844b1a52d39"],"museumIds":[],"mapIds":[],"note":"Louis-Philippe fell; the Second Republic preceded Louis-Napoleon's rise to imperial rule."},{"id":"LE102-2a2227a44c14001f","title":"The Communist Manifesto published","kind":"history","reference":"https://en.wikipedia.org/wiki/The_Communist_Manifesto","aliases":["The Communist Manifesto published"],"photos":[],"questionIds":["ARCHED-NEW101-0530"],"tapestryIds":["t68-bf48438bbad2"],"museumIds":[],"mapIds":[],"note":"Marx and Engels analysed class conflict and capitalism; publication coincided with, but did not cause all, the revolutions."},{"id":"LE102-43583ab680e80ff3","title":"First Italian War of Independence","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=First%20Italian%20War%20of%20Independence","aliases":["First Italian War of Independence"],"photos":[],"questionIds":[],"tapestryIds":["t68-9db8a57bd5f4"],"museumIds":[],"mapIds":[],"note":"Piedmont-Sardinia fought Austria; defeat did not end the unification movement."},{"id":"LE102-caed006eed2384a8","title":"Revolutions of 1848 in Europe","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Revolutions%20of%201848%20in%20Europe","aliases":["Revolutions of 1848 in Europe"],"photos":[],"questionIds":[],"tapestryIds":["t68-20dbc44edf8c"],"museumIds":[],"mapIds":[],"note":"Liberal, national and social demands produced different revolutions; avoid treating them as one uniform movement."},{"id":"LE102-d6aed4b1a68b91cb","title":"Paul Gauguin","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Paul%20Gauguin","aliases":["Paul Gauguin"],"photos":[],"questionIds":["PDF33-Q085-B"],"tapestryIds":["t68-cfc066343c12"],"museumIds":[],"mapIds":[],"note":"French painter; Polynesian work must be read within colonial contexts."},{"id":"LE102-b3a65e31c2ebe5ef","title":"Roman Republic of 1849","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Roman%20Republic%20of%201849","aliases":["Roman Republic of 1849"],"photos":[],"questionIds":["ARCHED-NEW101-0486"],"tapestryIds":["t68-73afc7dbf440"],"museumIds":[],"mapIds":[],"note":"A short-lived republic ended after French intervention restored papal authority."},{"id":"LE102-c809bc417f3d8109","title":"The Stone Breakers","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Stone_Breakers","aliases":["The Stone Breakers"],"photos":[{"src":"/.netlify/functions/access?action=media&name=1dc4b51c938c448bbb864b8f.webp","credit":"Gustave Courbet","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Gustave_Courbet_-_The_Stonebreakers_-_WGA05457.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=1dc4b51c938c448bbb864b8f.webp","credit":"Gustave Courbet","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Gustave_Courbet_-_The_Stonebreakers_-_WGA05457.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01198"],"tapestryIds":["t63-2b9951e3b430"],"museumIds":[],"mapIds":[],"note":"Realist labour scene; original painting destroyed in 1945.","creator":"Gustave Courbet","assetIds":["T81-t63-2b9951e3b430"]},{"id":"LE102-a7104058da86f1cf","title":"A Burial at Ornans","kind":"art","reference":"https://en.wikipedia.org/wiki/A_Burial_At_Ornans","aliases":["A Burial at Ornans"],"photos":[{"src":"/.netlify/functions/access?action=media&name=e9ab2fb7f06ea54c8617b188.webp","credit":"Gus