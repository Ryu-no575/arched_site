dd9c3"},{"id":"GEN43-Q04589","qid":4589,"nodeId":"REVISION93-4589","relatedNodeIds":["REVISION93-4589"],"factIds":["REVISION93-4589"],"major":"Geography & Civics","group":"Geography & Civics","stem":"Which wind brings hot air from North Africa towards the Mediterranean?","choices":["Tramontane","Sirocco","Bora","Bise","Mistral"],"correctIndex":1,"answer":"Sirocco","explanation":"The sirocco originates over North Africa and can acquire moisture while crossing the Mediterranean.","format":"term_function","references":[{"file":"Original · general culture extension","verificationUrl":"https://weather.metoffice.gov.uk/learn-about/weather/types-of-weather/wind/wind-names","checkedOnline93":true}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v93","editorialStatus74":"ready","skill74":"term_function","topic74":"Which wind brings hot air from North Africa towards the Mediterranean?","difficulty74":"unrated","testedFactKeys":["original93|which wind brings hot air from north africa towards the mediterranean|sirocco"],"reviewStatus":"editorial-reviewed","lineage74":"Original study question; not an official exam item.","evidence":{"type":"editorial-source-review","checkedAt":"2026-10-07","review":"Primary/institutional reference checked; concise distractors reviewed; screened against active Alpha and original questions."},"fingerprint":"1acaf4ba78c360b21f89"},{"id":"GEN43-Q04590","qid":4590,"nodeId":"REVISION93-4590","relatedNodeIds":["REVISION93-4590"],"factIds":["REVISION93-4590"],"major":"Geography & Civics","group":"Geography & Civics","stem":"A fumarole is an opening that emits:","choices":["Glacial meltwater","River sediment","Only liquid lava","Steam and volcanic gases","Wind-blown sand"],"correctIndex":3,"answer":"Steam and volcanic gases","explanation":"Fumaroles release steam and gases from hot volcanic systems; they need not emit lava.","format":"term_function","references":[{"file":"Original · general culture extension","verificationUrl":"https://pubs.usgs.gov/gip/volc/geysers.html","checkedOnline93":true}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v93","editorialStatus74":"ready","skill74":"term_function","topic74":"A fumarole is an opening that emits:","difficulty74":"unrated","testedFactKeys":["original93|a fumarole is an opening that emits|steam and volcanic gases"],"reviewStatus":"editorial-reviewed","lineage74":"Original study question; not an official exam item.","evidence":{"type":"editorial-source-review","checkedAt":"2026-10-07","review":"Primary/institutional reference checked; concise distractors reviewed; screened against active Alpha and original questions."},"fingerprint":"6bc1d302ffc20cb98985"},{"id":"GEN43-Q04591","qid":4591,"nodeId":"REVISION93-4591","relatedNodeIds":["REVISION93-4591"],"factIds":["REVISION93-4591"],"major":"Language & Literature","group":"Language & Literature","stem":"Which twentieth-century poet collected his verse under the title Il Canzoniere?","choices":["Giuseppe Ungaretti","Gabriele D’Annunzio","Salvatore Quasimodo","Umberto Saba","Giovanni Pascoli"],"correctIndex":3,"answer":"Umberto Saba","explanation":"Saba repeatedly enlarged Il Canzoniere. The century specified distinguishes it from Petrarch’s earlier collection of the same title.","format":"creator_work","references":[{"file":"Original · general culture extension","verificationUrl":"https://www.treccani.it/enciclopedia/umberto-saba/","checkedOnline93":true}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-v93","editorialStatus74":"ready","skill74":"creator_work","topic74":"Which twentieth-century poet collected his verse under the title Il Canzoniere?","difficulty74":"unrated","testedFactKeys":["original93|which twentieth century poet collected his verse under the title il canzoniere|umberto saba"],"reviewStatus":"editorial-reviewed","lineage74":"Original study question; not an official exam item.","evidence":{"type":"editorial-source-review","checkedAt":"2026-10-07",