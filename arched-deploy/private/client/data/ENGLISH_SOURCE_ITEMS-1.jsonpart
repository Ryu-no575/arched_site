ered diagram mapping","replacementAssetPlan":"Use a public-domain or appropriately licensed reproduction of the same subject for generated variants; verify the licence and provenance before release."},{"qid":952,"id":"ALPHA-B011-Q952","major":"Art History","era":"Modern","label":"Pre-war abstraction","stem":"Which artistic movement began before the Second World War?","choices":["Body Art","Arte Povera","Abstraction","Pop Art","Spatialism"],"correctIndex":2,"officialKey":"C","explanation":"Abstract painting emerged in the early twentieth century; the other movements developed after the war.","figure":false,"sourceReview":"page_and_printed_key_checked","answerBasis":"Printed answer key IMG_3607.jpeg, checked against the photographed stem and choices.","language":"en","version":"source-en-v39","sourceImage":"IMG_3601.jpeg","sourcePage":102,"examLanguages":["en","it"],"reviewStatus":"ready","holdReason":"","visualMetadata":null,"verificationSources":[],"contentFingerprint":"a6f5ed6944829dec0270aceaafd9c47e855a475cc31355a6ad676e8bcece211e"},{"qid":953,"id":"ALPHA-B011-Q953","major":"Art History","era":"Modern","label":"Dada before the Second World War","stem":"Which artistic movement began before the Second World War?","choices":["Op Art","Dada","Action Painting","Minimalism","Art Informel"],"correctIndex":1,"officialKey":"B","explanation":"Dada emerged in Zurich in 1916, during the First World War.","figure":false,"sourceReview":"page_and_printed_key_checked","answerBasis":"Printed answer key IMG_3607.jpeg, checked against the photographed stem and choices.","language":"en","version":"source-en-v39","sourceImage":"IMG_3601.jpeg","sourcePage":102,"examLanguages":["en","it"],"reviewStatus":"ready","holdReason":"","visualMetadata":null,"verificationSources":[],"contentFingerprint":"ce1ba478694619a9726e176e318396df878f4a0e79f172b5ad03b3f6644a83f1"},{"qid":954,"id":"ALPHA-B011-Q954","major":"Art History","era":"Modern","label":"Magritte's Perspective: Madame Récamier","stem"