ead","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":108,"canonical_number":null,"revision95":1,"topic74":"Himeji structural tradition","skill74":"context_relation","testedRelation95":"B02:himeji-structural-tradition","practiceRepetitionKeys95":["TOPIC:himeji-structural-tradition"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"f094ccf876878a28a3deccf17ffe150c5803df32193597328ada1cfcaeb66548","fingerprint":"288560b17cb1d5df4d80","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-111","qid":950111,"nodeId":"REVIEW95-ARCHED-B02-20261007-111","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-111"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Le Havre postwar reconstruction","stem":"Which material was central to Auguste Perret’s post-war rebuilding of Le Havre?","choices":["Heavy timber framing","Cast-iron framing","Load-bearing brickwork","Stone ashlar masonry","Reinforced concrete"],"correctIndex":4,"answer":"Reinforced concrete","explanation":"Perret used reinforced concrete within a coordinated modular urban scheme. The reconstruction is significant as a city-scale design, not just as a collection of isolated monuments.","format":"single_best_answer","references":[{"file":"UNESCO — Le Havre, the City Rebuilt by Auguste Perret","verificationUrl":"https://whc.unesco.org/en/list/1181/","sourceMetadata95":{"id":"B02-A11","title":"UNESCO — Le Havre, the City Rebuilt by Auguste Perret","url":"https://whc.unesco.org/en/list/1181/","support_summary":"The post-war rebuilding used a modular grid and reinforced concrete systematically.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":111,"canonical_number":null,"revision95":1,"topic74":"Le Havre postwar reconstruction","skill74":"context_relation","testedRelation95":"B02:le-havre-postwar-reconstruction","practiceRepetitionKeys95":["TOPIC:le-havre-postwar-reconstruction"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"8c259918ca37847e0c97d1ce776742325be30ef747379e7bda1ebeb984d1d720","fingerprint":"9f2289c6fb2ae1bd8620","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-112","qid":950112,"nodeId":"REVIEW95-ARCHED-B02-20261007-112","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-112"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Venice lagoon urban form","stem":"Which setting most directly explains the historic street-and-canal pattern of Venice?","choices":["A group of islands within a lagoon","A steep inland gorge","An upland glacier valley","A dry desert plateau","The crater of an extinct volcano"],"correctIndex":0,"answer":"A group of islands within a lagoon","explanation":"Venice grew on small islands whose water channels became part of its circulation system. Its urban form reflects adaptation to the lagoon.","format":"single_best_answer","references":[{"file":"UNESCO — Venice and its Lagoon","verificationUrl":"https://whc.unesco.org/en/list/394/","sourceMetadata95":{"id":"B02-A12","title":"UNESCO — Venice and its Lagoon","url":"https://whc.unesco.org/en/list/394/","support_summary":"Venice developed on small islands in a lagoon, with canals as the arteries of the urban system.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":112,"canonical_number":null,"revision95":1,"topic74":"Venice lagoon urban form","skill74":"context_relation","testedRelation95":"B02:venice-lagoon-urban-form","practiceRepetitionKeys95":["TOPIC:venice-lagoon-urban-form"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"5bbc931b7908d274aa73ec6738990d3df697220b3c67b7c744f88560e0881f18","fingerprint":"912139f8eae10095a9ed","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-114","qid":950114,"nodeId":"REVIEW95-ARCHED-B02-20261007-114","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-114"],"sourceAtlasNodeIds":[],"major":"Architecture","group":"Adaptive reuse versus reconstruction","stem":"Which project is an example of adaptive reuse?","choices":["Leaving a derelict building unused without intervention","Adding imitation medieval features to a modern warehouse","Demolishing a mill and building unrelated offices","Converting an existing mill into a library while retaining its significant fabric","Reconstructing an entirely vanished castle from imagination"],"correctIndex":3,"answer":"Converting an existing mill into a library while retaining its significant fabric","explanation":"Adaptive reuse gives an existing building a compatible new function. Retaining significant fabric distinguishes it from demolition followed by replacement.","format":"scenario_application","references":[{"file":"National Park Service — Standards for Rehabilitation","verificationUrl":"https://www.nps.gov/subjects/taxincentives/secretarys-standards-rehabilitation.htm","sourceMetadata95":{"id":"B02-A14","title":"National Park Service — Standards for Rehabilitation","url":"https://www.nps.gov/subjects/taxincentives/secretarys-standards-rehabilitation.htm","support_summary":"A compatible new use may retain significant historic features; additions should not falsify historical development.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":114,"canonical_number":null,"revision95":1,"topic74":"Adaptive reuse versus reconstruction","skill74":"context_relation","testedRelation95":"B02:adaptive-reuse-versus-reconstruction","practiceRepetitionKeys95":["TOPIC:adaptive-reuse-versus-reconstruction"],"workIds95":[],"evid