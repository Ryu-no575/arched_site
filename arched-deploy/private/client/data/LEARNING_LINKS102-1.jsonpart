1f2ed0278"],"museumIds":[],"mapIds":[],"note":"English settlement in Virginia."},{"id":"LE102-95f759e7c4adcb08","title":"Québec founded","kind":"history","reference":"https://en.wikipedia.org/wiki/History_of_Quebec_City","aliases":["Québec founded"],"photos":[],"questionIds":[],"tapestryIds":["t63-c942ac90f18f"],"museumIds":[],"mapIds":[],"note":"Samuel de Champlain."},{"id":"LE102-ec41e25949d152dd","title":"David with the Head of Goliath","kind":"art","reference":"https://en.wikipedia.org/wiki/David_with_the_Head_of_Goliath_(Caravaggio,_Rome)","aliases":["David with the Head of Goliath"],"photos":[{"src":"/.netlify/functions/access?action=media&name=7f6c9e0dca3026b1758e85d8.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:David_with_the_Head_of_Goliath-Caravaggio_%281610%29.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=7f6c9e0dca3026b1758e85d8.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:David_with_the_Head_of_Goliath-Caravaggio_%281610%29.jpg","licenseUrl":""},{"src":"/.netlify/functions/access?action=media&name=7f6c9e0dca3026b1758e85d8.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:David_with_the_Head_of_Goliath-Caravaggio_%281610%29.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01423"],"tapestryIds":["t63-8d87f7de97ac"],"museumIds":["ART93-t63-8d87f7de97ac"],"mapIds":[],"note":"Borghese version; dates debated. Other versions have different chronologies.","creator":"Caravaggio","assetIds":["ART93-t63-8d87f7de97ac","T82-t63-8d87f7de97ac"]},{"id":"LE102-9de2d361709c689a","title":"John Milton","kind":"person","reference":"https://en.wikipedia.org/wiki/John_Milton","aliases":["John Milton"],"photos":[],"questionIds":[],"tapestryIds":["t63-448e4b02e9d8"],"museumIds":[],"mapIds":[],"note":"Poet."},{"id":"LE102-b530c7e9d9a8361e","title":"Bank of Amsterdam founded","kind":"history","reference":"https://en.wikipedia.org/wiki/Bank_of_Amsterdam","aliases":["Bank of Amsterdam founded"],"photos":[],"questionIds":["ARCHED-NEW101-0473"],"tapestryIds":["t63-028888d1114b"],"museumIds":[],"mapIds":[],"note":"Amsterdam Wisselbank."},{"id":"LE102-60bb329ae9dec64d","title":"Sidereus Nuncius","kind":"art","reference":"https://en.wikipedia.org/wiki/Sidereus_Nuncius","aliases":["Sidereus Nuncius"],"photos":[],"questionIds":["GEN43-Q01378","GEN43-Q04209"],"tapestryIds":["t63-b97584011ccc"],"museumIds":[],"mapIds":[],"note":"Telescopic observations, including Jupiter's satellites.","creator":"Galileo Galilei"},{"id":"LE102-7459bd5f7ecc03e1","title":"Vespro della Beata Vergine","kind":"art","reference":"https://en.wikipedia.org/wiki/Vespro_della_Beata_Vergine","aliases":["Vespro della Beata Vergine"],"photos":[],"questionIds":[],"tapestryIds":["t63-fc9ed01dc753"],"museumIds":[],"mapIds":[],"note":"Published in Venice; sacred vocal collection.","creator":"Claudio Monteverdi"},{"id":"LE102-cb99231516cd5a51","title":"Judith Slaying Holofernes: Naples version","kind":"art","reference":"https://en.wikipedia.org/wiki/Judith_Slaying_Holofernes_(Artemisia_Gentileschi,_Naples)","aliases":["Judith Slaying Holofernes: Naples version"],"photos":[{"src":"/.netlify/functions/access?action=media&name=ad9ddac36bd4f4d418f38faa.webp","credit":"Artemisia Gentileschi","license":"Public domain artwork reproduction","sourceUrl":"https://commons.wikimedia.org/wiki/File:Gentileschi_Artemisia_Judith_Beheading_Holofernes_Naples.jpg","caption":"Full painting; version verified against the named collection."}],"questionIds":[],"tapestryIds":["t63-efebace57b92"],"museumIds":[],"mapIds":[],"note":"Earlier of Artemisia's two celebrated versions.","creator":"Artemisia Gentileschi"},{"id":"LE102-122366fa0dac2d3d","title":"Romanov dynasty begins","kind":"history","reference":"https://en.wikipedia.org/wik