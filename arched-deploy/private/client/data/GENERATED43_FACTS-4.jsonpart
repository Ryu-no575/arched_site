ipedia.org/wiki/Velvet_Revolution"}],"explanation74":"The largely peaceful transition is known as the Velvet Revolution."},{"id":"ORIGINAL80-3835","nodeId":"ORIGINAL80-3835","anchor":"ALPHA-B001-Q079","subject":"Carnation Revolution","value":"Portugal","group":"Carnation Revolution","major":"History & Politics","era":"19th century","relation":"location","references":[{"file":"Editorial reference: Carnation Revolution","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carnation_Revolution"}],"explanation74":"The revolution ended Portugal's Estado Novo dictatorship."},{"id":"ORIGINAL80-3836","nodeId":"ORIGINAL80-3836","anchor":"ALPHA-B001-Q013","subject":"Good Friday Agreement","value":"Northern Ireland","group":"Good Friday Agreement","major":"History & Politics","era":"Early modern","relation":"context","references":[{"file":"Editorial reference: Good Friday Agreement","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Good_Friday_Agreement"}],"explanation74":"The agreement established a framework for peace and power-sharing in Northern Ireland."},{"id":"ORIGINAL80-3837","nodeId":"ORIGINAL80-3837","anchor":"ALPHA-B001-Q022","subject":"Treaty of Rome","value":"European Economic Community","group":"Treaty of Rome","major":"History & Politics","era":"Early modern","relation":"institution","references":[{"file":"Editorial reference: Treaty of Rome","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Rome"}],"explanation74":"The Treaties of Rome established the EEC and Euratom."},{"id":"ORIGINAL80-3838","nodeId":"ORIGINAL80-3838","anchor":"ALPHA-B001-Q013","subject":"Benelux","value":"Belgium, Netherlands, Luxembourg","group":"Benelux","major":"History & Politics","era":"Early modern","relation":"membership","references":[{"file":"Editorial reference: Benelux","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Benelux"}],"explanation74":"Benelux combines the names of Belgium, the Netherlands and Luxembourg."},{"id":"ORIGINAL80-3839","nodeId":"ORIGINAL80-3839","anchor":"ALPHA-B005-Q394","subject":"Non-Aligned Movement","value":"Belgrade","group":"Non-Aligned Movement","major":"History & Politics","era":"Early modern","relation":"location","references":[{"file":"Editorial reference: Non-Aligned Movement","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Non-Aligned_Movement"}],"explanation74":"Bandung was an important precursor; the first Non-Aligned summit took place in Belgrade."},{"id":"ORIGINAL80-3840","nodeId":"ORIGINAL80-3840","anchor":"ALPHA-B008-Q770","subject":"Cuban Missile Crisis","value":"Soviet Union","group":"Cuban Missile Crisis","major":"History & Politics","era":"Late 20th century","relation":"cause","references":[{"file":"Editorial reference: Cuban Missile Crisis","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cuban_Missile_Crisis"}],"explanation74":"The discovery of Soviet nuclear missile installations in Cuba triggered the crisis."},{"id":"ORIGINAL80-3841","nodeId":"ORIGINAL80-3841","anchor":"ALPHA-B001-Q079","subject":"Great Leap Forward","value":"China","group":"Great Leap Forward","major":"History & Politics","era":"19th century","relation":"location","references":[{"file":"Editorial reference: Great Leap Forward","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Great_Leap_Forward"}],"explanation74":"Mao's campaign sought rapid industrial and agricultural transformation in China."},{"id":"ORIGINAL80-3842","nodeId":"ORIGINAL80-3842","anchor":"ALPHA-B001-Q079","subject":"Cultural Revolution","value":"Cultural Revolution","group":"Cultural Revolution","major":"History & Politics","era":"19th century","relation":"identification","references":[{"file":"Editorial reference: Cultural Revolution","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cultural_Revolution"}],"explanation74":"Mao launched the Cultural Revolution in 1966, with Red Guards playing a prominent role."},{"id":"ORIGINAL80-3843","nodeId":"ORIGINAL80-3843","anchor":"ALPHA-B007-Q502","subject":"Suez Crisis","value":"Gamal Abdel Nasser","group":"Suez Crisis","major":"History & Politics","era":"20th century","relation":"actor","references":[{"file":"Editorial reference: Suez Crisis","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Suez_Crisis"}],"explanation74":"Nasser's nationalization of the company was a central trigger of the Suez Crisis."},{"id":"ORIGINAL80-3844","nodeId":"ORIGINAL80-3844","anchor":"ALPHA-B001-Q024","subject":"Paris Commune","value":"Franco-Prussian War","group":"Paris Commune","major":"History & Politics","era":"19th century","relation":"context","references":[{"file":"Editorial reference: Paris Commune","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Paris_Commune"}],"explanation74":"The defeat of Napoleon III and the siege of Paris formed the immediate background."},{"id":"ORIGINAL80-3845","nodeId":"ORIGINAL80-3845","anchor":"ALPHA-B001-Q040","subject":"Treaty of Waitangi","value":"New Zealand","group":"Treaty of Waitangi","major":"History & Politics","era":"Early modern","relation":"location","references":[{"file":"Editorial reference: Treaty of Waitangi","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Waitangi"}],"explanation74":"It was an agreement involving the British Crown and Māori chiefs."},{"id":"ORIGINAL80-3846","nodeId":"ORIGINAL80-3846","anchor":"ALPHA-B001-Q023","subject":"Indian National Congress","value":"Indian National Congress","group":"Indian National Congress","major":"History & Politics","era":"Early modern","relation":"institution","references":[{"file":"Editorial reference: Indian National Congress","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Indian_National_Congress"}],"explanation74":"The Indian National Congress became a principal organization campaigning for independence."},{"id":"ORIGINAL80-3847","nodeId":"ORIGINAL80-3847","anchor":"ALPHA-B003-Q256","subject":"Don Quixote","value":"Chivalric romances","group":"Don Quixote","major":"Language & Literature","era":"Early modern","relation":"narrative context","references":[{"file":"Editorial reference: Don Quixote","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Don_Quixote"}],"explanation74":"Cervantes's protagonist models himself on the knights of romances he has read."},{"id":"ORIGINAL80-3848","nodeId":"ORIGINAL80-3848","anchor":"ALPHA-B001-Q012","subject":"Antigone (Sophocles play)","value":"Burying her brother","group":"Antigone (Sophocles play)","major":"Language & Literature","era":"Early modern","relation":"conflict","references":[{"file":"Editorial reference: Antigone (Sophocles play)","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Antigone_%28Sophocles_play%29"}],"explanation74":"Antigone insists on burial rites for Polynices despite Creon's prohibition."},{"id":"ORIGINAL80-3849","nodeId":"ORIGINAL80-3849","anchor":"ALPHA-B006-Q620","subject":"Divine Comedy","value":"Virgil","group":"Divine Comedy","major":"Language & Literature","era":"Medieval","relation":"character","references":[{"file":"Editorial reference: Divine Comedy","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Divine_Comedy"}],"explanation74":"Virgil guides the early stages of the journey before Beatrice assumes that role."},{"id":"ORIGINAL80-3850","nodeId":"ORIGINAL80-3850","anchor":"ALPHA-B001-Q012","subject":"Aeneid","value":"Carthage","group":"Aeneid","major":"Language & Literature","era":"Early modern","relation":"setting","references":[{"file":"Editorial reference: Aeneid","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aeneid"}],"explanation74":"Aeneas's encounter with Dido takes place in Carthage."},{"id":"ORIGINAL80-3851","nodeId":"ORIGINAL80-3851","anchor":"ALPHA-B001-Q087","subject":"Ulysses (novel)","value":"The Odyssey","group":"Ulysses (novel)","major":"Language & Literature","era":"Early modern","relation":"intertext","references":[{"file":"Editorial reference: Ulysses (novel)","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ulysses_%28novel%29"}],"explanation74":"The novel transforms episodes and figures from Homer's Odyssey into a modern setting."},{"id":"ORIGINAL80-3852","nodeId":"ORIGINAL80-3852","anchor":"ALPHA-B007-Q583","subject":"In Search of Lost Time","value":"Involuntary memory","group":"In Search of Lost Time","major":"Language & Literature","era":"Early modern","relation":"narrative device","references":[{"file":"Editorial reference: In Search of Lost Time","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/In_Search_of_Lost_Time"}],"explanation74":"A sensory experience unexpectedly revives the narrator's memories."},{"id":"ORIGINAL80-3853","nodeId":"ORIGINAL80-3853","anchor":"ALPHA-B001-Q012","subject":"Newspeak","value":"Independent thought","group":"Newspeak","major":"Language & Literature","era":"Early modern","relation":"concept","references":[{"file":"Editorial reference: Newspeak","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Newspeak"}],"explanation74":"Orwell's invented language restricts the words available for dissenting thought."},{"id":"ORIGINAL80-3854","nodeId":"ORIGINAL80-3854","anchor":"ALPHA-B001-Q012","subject":"Animal Farm","value":"Soviet revolutionary dictatorship","group":"Animal Farm","major":"Language & Literature","era":"Early modern","relation":"historical context","references":[{"file":"Editorial reference: Animal Farm","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Animal_Farm"}],"explanation74":"Its animal society allegorizes the Russian Revolution and the consolidation of Stalinist power."},{"id":"ORIGINAL80-3855","nodeId":"ORIGINAL80-3855","anchor":"ALPHA-B001-Q087","subject":"The Metamorphosis","value":"Gregor awakens transformed","group":"The Metamorphosis","major":"Language & Literature","era":"Early modern","relation":"narrative","references":[{"file":"Editorial reference: The Metamorphosis","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Metamorphosis"}],"explanation74":"Gregor Samsa awakens to find that his body has become a monstrous insect-like creature."},{"id":"ORIGINAL80-3856","nodeId":"ORIGINAL80-3856","anchor":"ALPHA-B001-Q087","subject":"The Trial","value":"The charge is never clarified","group":"The Trial","major":"Language & Literature","era":"Early modern","relation":"narrative","references":[{"file":"Editorial reference: The Trial","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Trial"}],"explanation74":"The unexplained prosecution makes the legal system appear inaccessible and arbitrary."},{"id":"ORIGINAL80-3857","nodeId":"ORIGINAL80-3857","anchor":"ALPHA-B001-Q012","subject":"Frankenstein","value":"Mary Shelley","group":"Frankenstein","major":"Language & Literature","era":"Early modern","relation":"authorship","references":[{"file":"Editorial reference: Frankenstein","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Frankenstein"}],"explanation74":"Mary Shelley's novel connects the creation of life with responsibility and ambition."},{"id":"ORIGINAL80-3858","nodeId":"ORIGINAL80-3858","anchor":"ALPHA-B001-Q012","subject":"Dracula","value":"Bram Stoker","group":"Dracula","major":"Language & Literature","era":"Early modern","relation":"authorship","references":[{"file":"Editorial reference: Dracula","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Dracula"}],"explanation74":"Stoker's 1897 novel became a foundational work of modern vampire fiction."},{"id":"ORIGINAL80-3859","nodeId":"ORIGINAL80-3859","anchor":"ALPHA-B001-Q087","subject":"The Betrothed (Manzoni novel)","value":"Spanish rule","group":"The Betrothed (Manzoni novel)","major":"Language & Literature","era":"Early modern","relation":"setting","references":[{"file":"Editorial reference: The Betrothed (Manzoni novel)","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Betrothed_%28Manzoni_novel%29"}],"explanation74":"The novel is set in seventeenth-century Lombardy during Spanish domination."},{"id":"ORIGINAL80-3860","nodeId":"ORIGINAL80-3860","anchor":"ALPHA-B007-Q471","subject":"I Malavoglia","value":"Fishing","group":"I Malavoglia","major":"Language & Literature","era":"Ancient","relation":"social context","references":[{"file":"Editorial reference: I Malavoglia","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/I_Malavoglia"}],"explanation74":"The family's struggles unfold in the Sicilian fishing community of Aci Trezza."},{"id":"ORIGINAL80-3861","nodeId":"ORIGINAL80-3861","anchor":"ALPHA-B001-Q012","subject":"Invisible Cities","value":"Kublai Khan","group":"Invisible Cities","major":"Language & Literature","era":"Early modern","relation":"frame","references":[{"file":"Editorial reference: Invisible Cities","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Invisible_Cities"}],"explanation74":"The imagined conversations provide the frame for Calvino's descriptions of cities."},{"id":"ORIGINAL80-3862","nodeId":"ORIGINAL80-3862","anchor":"ALPHA-B003-Q225","subject":"Six Characters in Search of an Author","value":"Metatheatre","group":"Six Characters in Search of an Author","major":"Language & Literature","era":"Early modern","relation":"form","references":[{"file":"Editorial reference: Six Characters in Search of an Author","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Six_Characters_in_Search_of_an_Author"}],"explanation74":"Metatheatre draws attention to performance and the relationship between actors, characters and reality."},{"id":"ORIGINAL80-3863","nodeId":"ORIGINAL80-3863","anchor":"ALPHA-B001-Q064","subject":"Zibaldone","value":"A collection of notebooks","group":"Zibaldone","major":"Language & Literature","era":"Early modern","relation":"genre","references":[{"file":"Editorial reference: Zibaldone","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Zibaldone"}],"explanation74":"The notebooks collect reflections on language, philosophy, literature and experience."},{"id":"ORIGINAL80-3864","nodeId":"ORIGINAL80-3864","anchor":"ALPHA-B001-Q032","subject":"Ossi di seppia","value":"Liguria","group":"Ossi di seppia","major":"Language & Literature","era":"Early modern","relation":"setting","references":[{"file":"Editorial reference: Ossi di seppia","page":null,"verificationUrl":"https://archivio.unistrapg.it/it/eugenio-montale-literary-park"}],"explanation74":"Montale's early poetry repeatedly draws on the dry, coastal landscapes of Liguria."},{"id":"ORIGINAL80-3865","nodeId":"ORIGINAL80-3865","anchor":"ALPHA-B003-Q238","subject":"Waiting for Godot","value":"Theatre of the Absurd","group":"Waiting for Godot","major":"Language & Literature","era":"Renaissance","relation":"classification","references":[{"file":"Editorial reference: Waiting for Godot","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Waiting_for_Godot"}],"explanation74":"The play's waiting, repetition and uncertain meaning are central to its association with the Absurd."},{"id":"ORIGINAL80-3866","nodeId":"ORIGINAL80-3866","anchor":"ALPHA-B003-Q238","subject":"The Library of Babel","value":"Jorge Luis Borges","group":"The Library of Babel","major":"Language & Literature","era":"Renaissance","relation":"authorship","references":[{"file":"Editorial reference: The Library of Babel","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Library_of_Babel"}],"explanation74":"Borges's story explores an immense library and the search for meaning within it."},{"id":"ORIGINAL80-3867","nodeId":"ORIGINAL80-3867","anchor":"ALPHA-B001-Q015","subject":"Bessemer process","value":"Steel","group":"Bessemer process","major":"Science & Tech","era":"Early modern","relation":"technology","references":[{"file":"Editorial reference: Bessemer process","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bessemer_process"}],"explanation74":"The process converted molten pig iron into steel by oxidizing impurities."},{"id":"ORIGINAL80-3868","nodeId":"ORIGINAL80-3868","anchor":"ALPHA-B003-Q236","subject":"Portland cement","value":"Resemblance to Portland stone","group":"Portland cement","major":"Science & Tech","era":"Early modern","relation":"name","references":[{"file":"Editorial reference: Portland cement","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Portland_cement"}],"explanation74":"The hardened material was compared with the building stone quarried on the Isle of Portland."},{"id":"ORIGINAL80-3869","nodeId":"ORIGINAL80-3869","anchor":"ALPHA-B001-Q015","subject":"Vulcanization","value":"Rubber","group":"Vulcanization","major":"Science & Tech","era":"Early modern","relation":"process","references":[{"file":"Editorial reference: Vulcanization","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Vulcanization"}],"explanation74":"Cross-linking, traditionally using sulfur, makes rubber more durable and elastic."},{"id":"ORIGINAL80-3870","nodeId":"ORIGINAL80-3870","anchor":"ALPHA-B001-Q015","subject":"Piezoelectricity","value":"Electric charge","group":"Piezoelectricity","major":"Science & Tech","era":"Early modern","relation":"principle","references":[{"file":"Editorial reference: Piezoelectricity","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Piezoelectricity"}],"explanation74":"Certain materials generate electrical polarization when mechanically stressed."},{"id":"ORIGINAL80-3871","nodeId":"ORIGINAL80-3871","anchor":"ALPHA-B007-Q474","subject":"Photovoltaics","value":"Electrical energy","group":"Photovoltaics","major":"Science & Tech","era":"Early modern","relation":"principle","references":[{"file":"Editorial reference: Photovoltaics","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Photovoltaics"}],"explanation74":"The photovoltaic effect produces electrical output from absorbed light."},{"id":"ORIGINAL80-3872","nodeId":"ORIGINAL80-3872","anchor":"ALPHA-B002-Q104","subject":"Semiconductor","value":"A semiconductor","group":"Semiconductor","major":"Science & Tech","era":"Early modern","relation":"classification","references":[{"file":"Editorial reference: Semiconductor","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Semiconductor"}],"explanation74":"Its controllable electronic properties make silicon suitable for semiconductor devices."},{"id":"ORIGINAL80-3873","nodeId":"ORIGINAL80-3873","anchor":"ALPHA-B002-Q105","subject":"Pasteurization","value":"Controlled heating","group":"Pasteurization","major":"Science & Tech","era":"Early modern","relation":"process","references":[{"file":"Editorial reference: Pasteurization","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pasteurization"}],"explanation74":"Controlled heat reduces microorganisms without necessarily sterilizing the product completely."},{"id":"ORIGINAL80-3874","nodeId":"ORIGINAL80-3874","anchor":"ALPHA-B002-Q104","subject":"Periodic table","value":"Atomic number","group":"Periodic table","major":"Science & Tech","era":"Early modern","relation":"classification","references":[{"file":"Editorial reference: Periodic table","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Periodic_table"}],"explanation74":"Atomic number is the number of protons in the nucleus."},{"id":"ORIGINAL80-3875","nodeId":"ORIGINAL80-3875","anchor":"ALPHA-B001-Q015","subject":"Isotope","value":"Neutrons","group":"Isotope","major":"Science & Tech","era":"Early modern","relation":"definition","references":[{"file":"Editorial reference: Isotope","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Isotope"}],"explanation74":"Isotopes have the same atomic number but different neutron counts."},{"id":"ORIGINAL80-3876","nodeId":"ORIGINAL80-3876","anchor":"ALPHA-B001-Q015","subject":"Greenhouse effect","value":"Infrared","group":"Greenhouse effect","major":"Science & Tech","era":"Early modern","relation":"mechanism","references":[{"file":"Editorial reference: Greenhouse effect","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Greenhouse_effect"}],"explanation74":"Greenhouse gases interact with outgoing infrared radiation from Earth's surface and atmosphere."},{"id":"ORIGINAL80-3877","nodeId":"ORIGINAL80-3877","anchor":"ALPHA-B003-Q234","subject":"DNA","value":"Adenine and thymine","group":"DNA","major":"Science & Tech","era":"Early modern","relation":"structure","references":[{"file":"Editorial reference: DNA","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/DNA"}],"explanation74":"In DNA, adenine pairs with thymine and cytosine with guanine."},{"id":"ORIGINAL80-3878","nodeId":"ORIGINAL80-3878","anchor":"ALPHA-B001-Q015","subject":"Plate tectonics","value":"Mid-ocean ridges","group":"Plate tectonics","major":"Science & Tech","era":"Early modern","relation":"mechanism","references":[{"file":"Editorial reference: Plate tectonics","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Plate_tectonics"}],"explanation74":"Seafloor spreading creates new crust along divergent plate boundaries."},{"id":"ORIGINAL80-3879","nodeId":"ORIGINAL80-3879","anchor":"ALPHA-B003-Q234","subject":"Radiocarbon dating","value":"Carbon from living organisms","group":"Radiocarbon dating","major":"Science & Tech","era":"Early modern","relation":"method","references":[{"file":"Editorial reference: Radiocarbon dating","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Radiocarbon_dating"}],"explanation74":"The method measures the decay of carbon-14 in formerly living material."},{"id":"ORIGINAL80-3880","nodeId":"ORIGINAL80-3880","anchor":"ALPHA-B004-Q328","subject":"Doppler effect","value":"Relative motion","group":"Doppler effect","major":"Science & Tech","era":"Early modern","relation":"principle","references":[{"file":"Editorial reference: Doppler effect","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Doppler_effect"}],"explanation74":"Motion between source and observer changes the received frequency of a wave."},{"id":"REVISION82-3881","nodeId":"REVISION82-3881","anchor":"ALPHA-B007-Q586","subject":"What organises the exterior storeys of Palazzo Rucellai?","value":"Superimposed pilaster orders","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Palazzo_Rucellai"}],"explanation74":"Alberti articulates the façade through horizontal storeys and classical pilasters."},{"id":"REVISION82-3882","nodeId":"REVISION82-3882","anchor":"ALPHA-B006-Q629","subject":"Who planned the principal architectural ensemble at Pienza for Pius II?","value":"Bernardo Rossellino","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bernardo_Rossellino"}],"explanation74":"Rossellino shaped the cathedral, palace and square ensemble."},{"id":"REVISION82-3883","nodeId":"REVISION82-3883","anchor":"ALPHA-B004-Q293","subject":"What kind of space is Bramante’s Tempietto at San Pietro in Montorio?","value":"A circular commemorative shrine","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/San_Pietro_in_Montorio"}],"explanation74":"The small centralised shrine marks the traditional site of Saint Peter’s martyrdom."},{"id":"REVISION82-3884","nodeId":"REVISION82-3884","anchor":"ALPHA-B004-Q293","subject":"Which rulers commissioned Bramante’s Tempietto?","value":"Ferdinand and Isabella","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/San_Pietro_in_Montorio"}],"explanation74":"The Catholic Monarchs of Spain sponsored the Tempietto."},{"id":"REVISION82-3885","nodeId":"REVISION82-3885","anchor":"ALPHA-B004-Q365","subject":"Which family commissioned Giulio Romano’s Palazzo Te?","value":"Gonzaga","group":"Renaissance","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Palazzo_Te"}],"explanation74":"Federico II Gonzaga commissioned the suburban pleasure palace in Mantua."},{"id":"REVISION82-3886","nodeId":"REVISION82-3886","anchor":"ALPHA-B004-Q277","subject":"What creates the principal illusion in the Sala dei Giganti at Palazzo Te?","value":"A collapsing painted world","group":"Renaissance","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Palazzo_Te"}],"explanation74":"Painted giants and tumbling architecture envelop the room in an illusion of collapse."},{"id":"REVISION82-3887","nodeId":"REVISION82-3887","anchor":"ALPHA-B005-Q371","subject":"The Laurentian Library was created to house the manuscripts of which family?","value":"Medici","group":"Renaissance","major":"Architecture","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Laurentian_Library"}],"explanation74":"The Medici collection was housed in Michelangelo’s library at San Lorenzo."},{"id":"REVISION82-3888","nodeId":"REVISION82-3888","anchor":"ALPHA-B004-Q293","subject":"Which material prominently contrasts with white plaster in Brunelleschi’s Florentine interiors?","value":"Pietra serena","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pietra_serena"}],"explanation74":"The grey sandstone articulates columns, arches and entablatures."},{"id":"REVISION82-3889","nodeId":"REVISION82-3889","anchor":"ALPHA-B004-Q327","subject":"Which hospital is known for Brunelleschi’s arcaded loggia and its care of abandoned children?","value":"Ospedale degli Innocenti","group":"Renaissance","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ospedale_degli_Innocenti"}],"explanation74":"The Innocenti in Florence combines an institutional role with an early Renaissance loggia."},{"id":"REVISION82-3890","nodeId":"REVISION82-3890","anchor":"ALPHA-B006-Q629","subject":"Which guild financed the Ospedale degli Innocenti?","value":"Silk guild","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ospedale_degli_Innocenti"}],"explanation74":"The Arte della Seta financed and administered the Florentine institution."},{"id":"REVISION82-3891","nodeId":"REVISION82-3891","anchor":"ALPHA-B007-Q520","subject":"Which architect designed the ideal city of Sforzinda in a treatise?","value":"Filarete","group":"Renaissance","major":"Architecture","era":"Contemporary","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sforzinda"}],"explanation74":"Filarete described a star-shaped ideal city named for Francesco Sforza."},{"id":"REVISION82-3892","nodeId":"REVISION82-3892","anchor":"ALPHA-B006-Q629","subject":"What is the main plan geometry of Filarete’s Sforzinda?","value":"An eight-pointed star","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sforzinda"}],"explanation74":"Two superimposed squares generate the eight-pointed fortified outline."},{"id":"REVISION82-3893","nodeId":"REVISION82-3893","anchor":"ALPHA-B004-Q277","subject":"Vasari’s elevated corridor in Florence connects Palazzo Vecchio with which palace?","value":"Palazzo Pitti","group":"Renaissance","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Vasari_Corridor"}],"explanation74":"The corridor passes above the Ponte Vecchio to connect the ducal residences."},{"id":"REVISION82-3894","nodeId":"REVISION82-3894","anchor":"ALPHA-B005-Q371","subject":"The Uffizi was initially designed chiefly to accommodate what?","value":"Government offices","group":"Renaissance","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Uffizi"}],"explanation74":"Its name recalls the administrative offices commissioned by Cosimo I."},{"id":"REVISION82-3895","nodeId":"REVISION82-3895","anchor":"ALPHA-B001-Q006","subject":"Which architect completed Venice’s Biblioteca Marciana after Sansovino’s death?","value":"Vincenzo Scamozzi","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Biblioteca_Marciana"}],"explanation74":"Scamozzi continued Sansovino’s library project."},{"id":"REVISION82-3896","nodeId":"REVISION82-3896","anchor":"ALPHA-B006-Q629","subject":"In a Palladian villa, what are the barchesse?","value":"Agricultural service wings","group":"Renaissance","major":"Architecture","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Barchessa"}],"explanation74":"Barchesse accommodate agricultural and service functions beside the main house."},{"id":"REVISION82-3897","nodeId":"REVISION82-3897","anchor":"ALPHA-B008-Q698","subject":"Which religious order commissioned Borromini’s San Carlo alle Quattro Fontane?","value":"Discalced Trinitarians","group":"Baroque","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/San_Carlo_alle_Quattro_Fontane"}],"explanation74":"The small Roman church was built for the Spanish Discalced Trinitarians."},{"id":"REVISION82-3898","nodeId":"REVISION82-3898","anchor":"ALPHA-B007-Q552","subject":"Borromini’s Sant’Ivo was built as the chapel of which institution?","value":"University of Rome","group":"Baroque","major":"Architecture","era":"Contemporary","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sant%27Ivo_alla_Sapienza"}],"explanation74":"The church served the former Sapienza university complex."},{"id":"REVISION82-3899","nodeId":"REVISION82-3899","anchor":"ALPHA-B003-Q216","subject":"What crowns the lantern of Sant’Ivo alla Sapienza?","value":"A spiral form","group":"Baroque","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sant%27Ivo_alla_Sapienza"}],"explanation74":"The spiral lantern is among Borromini’s most recognisable inventions."},{"id":"REVISION82-3900","nodeId":"REVISION82-3900","anchor":"ALPHA-B008-Q686","subject":"Which Roman square contains Bernini’s Fountain of the Four Rivers?","value":"Piazza Navona","group":"Baroque","major":"Architecture","era":"Medieval","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Fontana_dei_Quattro_Fiumi"}],"explanation74":"The fountain stands at the centre of Piazza Navona."},{"id":"REVISION82-3901","nodeId":"REVISION82-3901","anchor":"ALPHA-B008-Q686","subject":"Piazza Navona preserves the outline of which ancient structure?","value":"Stadium of Domitian","group":"Baroque","major":"Architecture","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Piazza_Navona"}],"explanation74":"The elongated square follows the stadium’s arena and seating perimeter."},{"id":"REVISION82-3902","nodeId":"REVISION82-3902","anchor":"ALPHA-B005-Q371","subject":"Which family’s emblem appears in Bernini’s Fountain of the Bees?","value":"Barberini","group":"Baroque","major":"Architecture","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Fontana_delle_Api"}],"explanation74":"Bees were the heraldic emblem of the Barberini family of Urban VIII."},{"id":"REVISION82-3903","nodeId":"REVISION82-3903","anchor":"ALPHA-B002-Q111","subject":"Santa Maria della Salute was founded as a votive response to what?","value":"A plague epidemic","group":"Baroque","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Santa_Maria_della_Salute"}],"explanation74":"The church commemorates Venice’s deliverance from the plague of 1630–31."},{"id":"REVISION82-3904","nodeId":"REVISION82-3904","anchor":"ALPHA-B002-Q111","subject":"Which Turin church contains Guarini’s intersecting rib dome?","value":"San Lorenzo","group":"Baroque","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Royal_Church_of_San_Lorenzo"}],"explanation74":"Guarini’s San Lorenzo is noted for the geometrical crossing of its dome ribs."},{"id":"REVISION82-3905","nodeId":"REVISION82-3905","anchor":"ALPHA-B007-Q551","subject":"The Basilica of Superga is closely connected with which ruling house?","value":"Savoy","group":"Baroque","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Basilica_of_Superga"}],"explanation74":"It was commissioned by Victor Amadeus II and contains Savoy royal tombs."},{"id":"REVISION82-3906","nodeId":"REVISION82-3906","anchor":"ALPHA-B005-Q387","subject":"Which architect designed the Spanish Steps with Alessandro Specchi?","value":"Francesco de Sanctis","group":"Baroque","major":"Architecture","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Spanish_Steps"}],"explanation74":"De Sanctis developed the monumental staircase linking the square and Trinità dei Monti."},{"id":"REVISION82-3907","nodeId":"REVISION82-3907","anchor":"ALPHA-B004-Q327","subject":"The Trevi Fountain marks the monumental endpoint of which aqueduct?","value":"Acqua Vergine","group":"Baroque","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Trevi_Fountain"}],"explanation74":"The fountain terminates the revived ancient Aqua Virgo aqueduct."},{"id":"REVISION82-3908","nodeId":"REVISION82-3908","anchor":"ALPHA-B006-Q613","subject":"In a Roman house, the impluvium was used principally to collect what?","value":"Rainwater","group":"Classical","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Impluvium"}],"explanation74":"The basin below the roof opening collected rainwater in the atrium."},{"id":"REVISION82-3909","nodeId":"REVISION82-3909","anchor":"ALPHA-B001-Q067","subject":"What was a Roman hypocaust designed to provide?","value":"Underfloor heating","group":"Classical","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Hypocaust"}],"explanation74":"Hot air circulated through a raised floor and sometimes wall flues."},{"id":"REVISION82-3910","nodeId":"REVISION82-3910","anchor":"ALPHA-B007-Q551","subject":"The frigidarium in Roman baths was associated with what?","value":"Cold bathing","group":"Classical","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Frigidarium"}],"explanation74":"The frigidarium contained cold-water bathing facilities."},{"id":"REVISION82-3911","nodeId":"REVISION82-3911","anchor":"ALPHA-B002-Q107","subject":"What is a propylaeum?","value":"A monumental gateway","group":"Classical","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Propylaea"}],"explanation74":"Propylaea form a monumental entrance to a sanctuary or precinct."},{"id":"REVISION82-3912","nodeId":"REVISION82-3912","anchor":"ALPHA-B003-Q207","subject":"A dipteral temple has which arrangement?","value":"Two surrounding column rows","group":"Classical","major":"Architecture","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ancient_Greek_temple"}],"explanation74":"A dipteral plan doubles the external peristyle."},{"id":"REVISION82-3913","nodeId":"REVISION82-3913","anchor":"ALPHA-B002-Q124","subject":"What is the springing of an arch?","value":"The level where its curve begins","group":"Classical","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Springer_(architecture)"}],"explanation74":"The arch rises from its springing points on the supports."},{"id":"REVISION82-3914","nodeId":"REVISION82-3914","anchor":"ALPHA-B002-Q107","subject":"What is a clerestory?","value":"A high windowed wall zone","group":"Medieval","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Clerestory"}],"explanation74":"Clerestory windows bring light into a tall central space above adjoining roofs."},{"id":"REVISION82-3915","nodeId":"REVISION82-3915","anchor":"ALPHA-B003-Q182","subject":"Which element separates the nave from the choir in many medieval churches?","value":"Rood screen","group":"Medieval","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rood_screen"}],"explanation74":"The screen marks a liturgical division within the church."},{"id":"REVISION82-3916","nodeId":"REVISION82-3916","anchor":"ALPHA-B007-Q496","subject":"What is an ambulatory in church architecture?","value":"A passage around the choir","group":"Medieval","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ambulatory"}],"explanation74":"An ambulatory permits circulation around the eastern end and associated chapels."},{"id":"REVISION82-3917","nodeId":"REVISION82-3917","anchor":"ALPHA-B007-Q552","subject":"What is the crossing in a cruciform church?","value":"The nave–transept intersection","group":"Medieval","major":"Architecture","era":"Contemporary","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Crossing_(architecture)"}],"explanation74":"The crossing is where the principal longitudinal and transverse spaces meet."},{"id":"REVISION82-3918","nodeId":"REVISION82-3918","anchor":"ALPHA-B008-Q689","subject":"What is a trumeau in a Gothic portal?","value":"The central doorway pier","group":"Medieval","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Trumeau_(architecture)"}],"explanation74":"A trumeau divides the doorway into two openings."},{"id":"REVISION82-3919","nodeId":"REVISION82-3919","anchor":"ALPHA-B002-Q107","subject":"What is the carved or decorated area above a doorway’s lintel called?","value":"Tympanum","group":"Medieval","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tympanum_(architecture)"}],"explanation74":"The tympanum occupies the field between the lintel and the arch above."},{"id":"REVISION82-3920","nodeId":"REVISION82-3920","anchor":"ALPHA-B005-Q411","subject":"Which architectural form is particularly associated with Cistercian ideals of restraint?","value":"Unadorned monastic architecture","group":"Medieval","major":"Architecture","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cistercian_architecture"}],"explanation74":"Cistercian building ideals often favoured clarity and restrained decoration."},{"id":"REVISION82-3921","nodeId":"REVISION82-3921","anchor":"ALPHA-B008-Q689","subject":"The Palatine Chapel in Palermo is located inside which palace?","value":"Norman Palace","group":"Medieval","major":"Architecture","era":"Ancient","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cappella_Palatina"}],"explanation74":"The chapel forms part of Palermo’s royal Norman Palace."},{"id":"REVISION82-3922","nodeId":"REVISION82-3922","anchor":"ALPHA-B008-Q689","subject":"Which tradition is visible in the Palatine Chapel’s muqarnas ceiling?","value":"Islamic craftsmanship","group":"Medieval","major":"Architecture","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cappella_Palatina"}],"explanation74":"The painted wooden ceiling uses a form associated with Islamic architecture."},{"id":"REVISION82-3923","nodeId":"REVISION82-3923","anchor":"ALPHA-B008-Q679","subject":"What was the original intended function of Turin’s Mole Antonelliana?","value":"A synagogue","group":"Modern","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mole_Antonelliana"}],"explanation74":"Antonelli’s project began as a synagogue before being acquired by the city."},{"id":"REVISION82-3924","nodeId":"REVISION82-3924","anchor":"ALPHA-B004-Q278","subject":"Which architect designed Milan’s Galleria Vittorio Emanuele II?","value":"Giuseppe Mengoni","group":"Modern","major":"Architecture","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Galleria_Vittorio_Emanuele_II"}],"explanation74":"Mengoni designed the monumental covered commercial arcade."},{"id":"REVISION82-3925","nodeId":"REVISION82-3925","anchor":"ALPHA-B004-Q278","subject":"What structural materials principally cover the Galleria Vittorio Emanuele II?","value":"Iron and glass","group":"Modern","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Galleria_Vittorio_Emanuele_II"}],"explanation74":"The glazed iron roof connects monumental masonry façades."},{"id":"REVISION82-3926","nodeId":"REVISION82-3926","anchor":"ALPHA-B008-Q750","subject":"Which Milanese building is a prominent example of Giuseppe Sommaruga’s Liberty architecture?","value":"Palazzo Castiglioni","group":"Modern","major":"Architecture","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Palazzo_Castiglioni_(Milan)"}],"explanation74":"Sommaruga’s palace helped establish the Liberty style in Milan."},{"id":"REVISION82-3927","nodeId":"REVISION82-3927","anchor":"ALPHA-B005-Q381","subject":"Terragni’s Casa del Fascio is especially associated with which movement?","value":"Italian Rationalism","group":"Modern","major":"Architecture","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Casa_del_Fascio_(Como)"}],"explanation74":"Its geometric clarity and modern materials place it within Italian Rationalism."},{"id":"REVISION82-3928","nodeId":"REVISION82-3928","anchor":"ALPHA-B001-Q038","subject":"Which architects designed Milan’s Torre Velasca?","value":"BBPR","group":"Modern","major":"Architecture","era":"19th century","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Torre_Velasca"}],"explanation74":"The BBPR partnership designed the tower’s distinctive projecting upper storeys."},{"id":"REVISION82-3929","nodeId":"REVISION82-3929","anchor":"ALPHA-B004-Q322","subject":"Which engineer collaborated on the structural design of Milan’s Pirelli Tower?","value":"Pier Luigi Nervi","group":"Modern","major":"Architecture","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pirelli_Tower"}],"explanation74":"Nervi and Arturo Danusso worked on the tower’s structure."},{"id":"REVISION82-3930","nodeId":"REVISION82-3930","anchor":"ALPHA-B008-Q737","subject":"Which material is especially associated with Pier Luigi Nervi’s structural experiments?","value":"Reinforced concrete","group":"Modern","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pier_Luigi_Nervi"}],"explanation74":"Nervi combined reinforced concrete, ferrocement and prefabrication."},{"id":"REVISION82-3931","nodeId":"REVISION82-3931","anchor":"ALPHA-B004-Q344","subject":"Carlo Scarpa’s Brion complex at San Vito d’Altivole serves which function?","value":"A family tomb complex","group":"Modern","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Brion_tomb"}],"explanation74":"The Brion memorial combines burial spaces, water and carefully detailed concrete architecture."},{"id":"REVISION82-3932","nodeId":"REVISION82-3932","anchor":"ALPHA-B001-Q038","subject":"Scarpa’s Castelvecchio project in Verona is especially known for what?","value":"Museum adaptation and display","group":"Modern","major":"Architecture","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Castelvecchio_Museum"}],"explanation74":"Scarpa reworked the castle as a museum with precise spatial and display interventions."},{"id":"REVISION82-3933","nodeId":"REVISION82-3933","anchor":"ALPHA-B006-Q657","subject":"Aldo Rossi’s Teatro del Mondo was designed as what?","value":"A floating theatre","group":"Modern","major":"Architecture","era":"19th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aldo_Rossi"}],"explanation74":"The temporary theatre floated in Venice for the Biennale."},{"id":"REVISION82-3934","nodeId":"REVISION82-3934","anchor":"ALPHA-B007-Q532","subject":"Which three architects designed the principal CityLife towers in Milan?","value":"Hadid, Isozaki and Libeskind","group":"Modern","major":"Architecture","era":"Early modern","relation":"matching","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/CityLife_(Milan)"}],"explanation74":"The three principal towers are associated with Zaha Hadid, Arata Isozaki and Daniel Libeskind."},{"id":"REVISION82-3935","nodeId":"REVISION82-3935","anchor":"ALPHA-B001-Q038","subject":"Gae Aulenti’s Musée d’Orsay project adapted which former building type?","value":"Railway station","group":"Modern","major":"Architecture","era":"19th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mus%C3%A9e_d%27Orsay"}],"explanation74":"The museum occupies the former Gare d’Orsay."},{"id":"REVISION82-3936","nodeId":"REVISION82-3936","anchor":"ALPHA-B002-Q162","subject":"Renzo Piano’s Lingotto project adapted a former factory of which company?","value":"Fiat","group":"Modern","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lingotto"}],"explanation74":"Piano helped transform the former Fiat factory into a mixed-use complex."},{"id":"REVISION82-3937","nodeId":"REVISION82-3937","anchor":"ALPHA-B006-Q657","subject":"What unusual testing facility was built on Lingotto’s roof?","value":"A car test track","group":"Modern","major":"Architecture","era":"19th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lingotto"}],"explanation74":"Completed cars could be tested on the rooftop track."},{"id":"REVISION82-3938","nodeId":"REVISION82-3938","anchor":"ALPHA-B001-Q038","subject":"Which architects designed the Olivetti nursery at Ivrea?","value":"Luigi Figini and Gino Pollini","group":"Modern","major":"Architecture","era":"19th century","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Luigi_Figini"}],"explanation74":"Figini and Pollini designed social and industrial buildings for Olivetti."},{"id":"REVISION82-3939","nodeId":"REVISION82-3939","anchor":"ALPHA-B007-Q552","subject":"Which architect designed the church of San Giovanni Battista beside the Autostrada del Sole?","value":"Giovanni Michelucci","group":"Modern","major":"Architecture","era":"Contemporary","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giovanni_Michelucci"}],"explanation74":"Michelucci’s motorway church is distinguished by its tent-like roof and expressive structure."},{"id":"REVISION82-3940","nodeId":"REVISION82-3940","anchor":"ALPHA-B004-Q334","subject":"Which Italian architect designed the MASP building in São Paulo?","value":"Lina Bo Bardi","group":"Modern","major":"Architecture","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/S%C3%A3o_Paulo_Museum_of_Art"}],"explanation74":"Bo Bardi elevated the main museum volume to preserve an open civic space below."},{"id":"REVISION82-3941","nodeId":"REVISION82-3941","anchor":"ALPHA-B005-Q443","subject":"What is the major spatial effect of MASP’s elevated gallery block?","value":"A large open public ground space","group":"Modern","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/S%C3%A3o_Paulo_Museum_of_Art"}],"explanation74":"The suspended block frees the ground plane beneath the museum."},{"id":"REVISION82-3942","nodeId":"REVISION82-3942","anchor":"ALPHA-B007-Q552","subject":"Which architect designed the church of San Paolo Apostolo in Foligno with Doriana Fuksas?","value":"Massimiliano Fuksas","group":"Modern","major":"Architecture","era":"Contemporary","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/San_Paolo_Apostolo%2C_Foligno"}],"explanation74":"Massimiliano and Doriana Fuksas designed the paired cubic volumes."},{"id":"REVISION82-3943","nodeId":"REVISION82-3943","anchor":"ALPHA-B007-Q551","subject":"Which planner is associated with the nineteenth-century expansion grid of Barcelona?","value":"Ildefons Cerdà","group":"Urbanism","major":"Architecture","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Eixample"}],"explanation74":"Cerdà planned the Eixample, including its characteristic chamfered blocks."},{"id":"REVISION82-3944","nodeId":"REVISION82-3944","anchor":"ALPHA-B005-Q371","subject":"What distinguishes the street corners of Cerdà’s Barcelona blocks?","value":"Chamfered corners","group":"Urbanism","major":"Architecture","era":"Ancient","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Eixample"}],"explanation74":"Chamfers widen intersections and alter visibility and circulation."},{"id":"REVISION82-3945","nodeId":"REVISION82-3945","anchor":"ALPHA-B001-Q028","subject":"Arturo Soria y Mata’s Ciudad Lineal organised development principally along what?","value":"A transport corridor","group":"Urbanism","major":"Architecture","era":"Ancient","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Linear_city_(Soria_design)"}],"explanation74":"Linear urbanism tied urban growth to a long transport spine."},{"id":"REVISION82-3946","nodeId":"REVISION82-3946","anchor":"ALPHA-B003-Q216","subject":"What was a central aim of Ebenezer Howard’s garden city model?","value":"Combining town and country","group":"Urbanism","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Garden_city_movement"}],"explanation74":"Howard sought the social and economic advantages of town and country together."},{"id":"REVISION82-3947","nodeId":"REVISION82-3947","anchor":"ALPHA-B003-Q194","subject":"Which patron commissioned Giotto’s chapel frescoes in Padua?","value":"Enrico Scrovegni","group":"Giotto","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Scrovegni_Chapel"}],"explanation74":"Enrico Scrovegni commissioned the chapel and its fresco cycle."},{"id":"REVISION82-3948","nodeId":"REVISION82-3948","anchor":"ALPHA-B008-Q721","subject":"What blue pigment is traditionally associated with costly Renaissance painting commissions?","value":"Ultramarine","group":"Giotto","major":"Art History","era":"Late 20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ultramarine"}],"explanation74":"Natural ultramarine was obtained from lapis lazuli and was exceptionally costly."},{"id":"REVISION82-3949","nodeId":"REVISION82-3949","anchor":"ALPHA-B001-Q031","subject":"Where did Ambrogio Lorenzetti paint the Effects of Good and Bad Government?","value":"Palazzo Pubblico, Siena","group":"Siena","major":"Art History","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Allegory_of_Good_and_Bad_Government"}],"explanation74":"The civic fresco cycle was made for Siena’s governing palace."},{"id":"REVISION82-3950","nodeId":"REVISION82-3950","anchor":"ALPHA-B003-Q194","subject":"Masaccio’s Tribute Money belongs to which Florentine chapel?","value":"Brancacci Chapel","group":"Masaccio","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Brancacci_Chapel"}],"explanation74":"The Brancacci fresco cycle treats episodes from the life of Saint Peter."},{"id":"REVISION82-3951","nodeId":"REVISION82-3951","anchor":"ALPHA-B003-Q199","subject":"The Tribute Money presents several moments of a story within one scene. What is this convention called?","value":"Continuous narrative","group":"Masaccio","major":"Art History","era":"20th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Narrative_art"}],"explanation74":"The same figures recur in separate episodes within one pictorial space."},{"id":"REVISION82-3952","nodeId":"REVISION82-3952","anchor":"ALPHA-B004-Q290","subject":"Fra Angelico’s frescoes at San Marco in Florence were made chiefly for whom?","value":"Dominican friars","group":"Fra Angelico","major":"Art History","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/San_Marco%2C_Florence"}],"explanation74":"The convent frescoes supported the devotional life of the Dominican community."},{"id":"REVISION82-3953","nodeId":"REVISION82-3953","anchor":"ALPHA-B006-Q673","subject":"Piero della Francesca’s portraits of Federico da Montefeltro and Battista Sforza use which view?","value":"Profile","group":"Piero","major":"Art History","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Diptych_of_Federico_da_Montefeltro_and_Battista_Sforza"}],"explanation74":"The paired profile portraits evoke classical medals and dynastic representation."},{"id":"REVISION82-3954","nodeId":"REVISION82-3954","anchor":"ALPHA-B004-Q321","subject":"The painted oculus of the Camera degli Sposi gives the illusion of what?","value":"An opening to the sky","group":"Mantegna","major":"Art History","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Camera_degli_Sposi"}],"explanation74":"Figures appear to look down through an illusionistic opening in the ceiling."},{"id":"REVISION82-3955","nodeId":"REVISION82-3955","anchor":"ALPHA-B004-Q309","subject":"Which mythological figure stands at the centre of Botticelli’s Primavera?","value":"Venus","group":"Botticelli","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Primavera_(Botticelli)"}],"explanation74":"Venus occupies the central area beneath the garden canopy."},{"id":"REVISION82-3956","nodeId":"REVISION82-3956","anchor":"ALPHA-B006-Q664","subject":"Why did Leonardo’s experimental wall technique create problems for The Last Supper?","value":"It was applied to a dry wall","group":"Leonardo","major":"Art History","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Last_Supper_(Leonardo)"}],"explanation74":"Leonardo’s technique did not bond with wet plaster like buon fresco and deteriorated early."},{"id":"REVISION82-3957","nodeId":"REVISION82-3957","anchor":"ALPHA-B005-Q382","subject":"Leonardo’s Virgin of the Rocks survives in major versions in Paris and which city?","value":"London","group":"Leonardo","major":"Art History","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Virgin_of_the_Rocks"}],"explanation74":"The second major version is in London’s National Gallery."},{"id":"REVISION82-3958","nodeId":"REVISION82-3958","anchor":"ALPHA-B004-Q284","subject":"Which Medici Chapel sculptures are paired on Giuliano de’ Medici’s tomb?","value":"Night and Day","group":"Michelangelo","major":"Art History","era":"Renaissance","relation":"matching","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://catalogo.cultura.gov.it/approfondimento/michelangelo-e-sagrestia-nuova-firenze/un-progetto-innovativo"}],"explanation74":"Night and Day flank Giuliano’s tomb; Dawn and Dusk belong to Lorenzo’s."},{"id":"REVISION82-3959","nodeId":"REVISION82-3959","anchor":"ALPHA-B004-Q321","subject":"The unfinished figures known as Michelangelo’s Slaves were associated with which project?","value":"Tomb of Julius II","group":"Michelangelo","major":"Art History","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tomb_of_Pope_Julius_II"}],"explanation74":"The figures originated in successive plans for Julius II’s monumental tomb."},{"id":"REVISION82-3960","nodeId":"REVISION82-3960","anchor":"ALPHA-B006-Q643","subject":"Veronese’s Feast in the House of Levi acquired its present title after questioning by which institution?","value":"The Inquisition","group":"Venice","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Feast_in_the_House_of_Levi"}],"explanation74":"Questioned over details in a Last Supper, Veronese changed the title to another biblical feast."},{"id":"REVISION82-3961","nodeId":"REVISION82-3961","anchor":"ALPHA-B006-Q598","subject":"Tintoretto’s extensive decorative cycle at the Scuola Grande di San Rocco was made for what kind of body?","value":"A lay confraternity","group":"Venice","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Scuola_Grande_di_San_Rocco"}],"explanation74":"The scuola was a Venetian charitable and devotional confraternity."},{"id":"REVISION82-3962","nodeId":"REVISION82-3962","anchor":"ALPHA-B008-Q721","subject":"Bronzino’s portraits are closely associated with which court?","value":"Medici court","group":"Mannerism","major":"Art History","era":"Late 20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bronzino"}],"explanation74":"Bronzino served the court of Cosimo I de’ Medici in Florence."},{"id":"REVISION82-3963","nodeId":"REVISION82-3963","anchor":"ALPHA-B001-Q073","subject":"Caravaggio’s Calling of Saint Matthew belongs to which Roman chapel?","value":"Contarelli Chapel","group":"Caravaggio","major":"Art History","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Contarelli_Chapel"}],"explanation74":"The Saint Matthew cycle was commissioned for San Luigi dei Francesi’s Contarelli Chapel."},{"id":"REVISION82-3964","nodeId":"REVISION82-3964","anchor":"ALPHA-B001-Q073","subject":"Which Caravaggio pair was painted for the Cerasi Chapel?","value":"Conversion of Saint Paul and Crucifixion of Saint Peter","group":"Caravaggio","major":"Art History","era":"Renaissance","relation":"matching","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cerasi_Chapel"}],"explanation74":"The two lateral canvases occupy the Cerasi Chapel in Santa Maria del Popolo."},{"id":"REVISION82-3965","nodeId":"REVISION82-3965","anchor":"ALPHA-B003-Q233","subject":"Which myth explains the transformation represented in Bernini’s Apollo and Daphne?","value":"A nymph becoming a laurel tree","group":"Baroque","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Apollo_and_Daphne_(Bernini)"}],"explanation74":"Daphne transforms into a laurel while escaping Apollo."},{"id":"REVISION82-3966","nodeId":"REVISION82-3966","anchor":"ALPHA-B006-Q598","subject":"Bernini’s David differs from many earlier standing Davids by showing what?","value":"The action of preparing a sling shot","group":"Baroque","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/David_(Bernini)"}],"explanation74":"The twisting figure catches a moment of concentrated physical action."},{"id":"REVISION82-3967","nodeId":"REVISION82-3967","anchor":"ALPHA-B006-Q598","subject":"Artemisia Gentileschi’s Judith Slaying Holofernes draws on which tradition?","value":"A biblical narrative","group":"Baroque","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Judith_Slaying_Holofernes_(Artemisia_Gentileschi%2C_Florence)"}],"explanation74":"Judith saves her people by killing the enemy commander Holofernes."},{"id":"REVISION82-3968","nodeId":"REVISION82-3968","anchor":"ALPHA-B003-Q258","subject":"Which painter was Artemisia Gentileschi’s father and early teacher?","value":"Orazio Gentileschi","group":"Baroque","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Artemisia_Gentileschi"}],"explanation74":"Artemisia trained in Orazio’s workshop before developing her independent career."},{"id":"REVISION82-3969","nodeId":"REVISION82-3969","anchor":"ALPHA-B006-Q596","subject":"Annibale Carracci’s Farnese Gallery ceiling chiefly draws on what kind of subject?","value":"Classical mythological loves","group":"Baroque","major":"Art History","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Loves_of_the_Gods"}],"explanation74":"The Loves of the Gods cycle adapts mythological narratives in an elaborate painted framework."},{"id":"REVISION82-3970","nodeId":"REVISION82-3970","anchor":"ALPHA-B006-Q643","subject":"Which artistic institution was founded by the Carracci in Bologna?","value":"Accademia degli Incamminati","group":"Baroque","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Accademia_degli_Incamminati"}],"explanation74":"The Carracci academy promoted drawing and observation as bases of artistic training."},{"id":"REVISION82-3971","nodeId":"REVISION82-3971","anchor":"ALPHA-B008-Q721","subject":"Which term describes a detailed painted city view associated with Canaletto?","value":"Veduta","group":"Eighteenth century","major":"Art History","era":"Late 20th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Veduta"}],"explanation74":"A veduta is a cityscape or topographical view."},{"id":"REVISION82-3972","nodeId":"REVISION82-3972","anchor":"ALPHA-B001-Q031","subject":"An imagined architectural landscape combining real and invented elements is called what?","value":"Capriccio","group":"Eighteenth century","major":"Art History","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Capriccio_(art)"}],"explanation74":"The capriccio permits imaginative recombination of architecture and ruins."},{"id":"REVISION82-3973","nodeId":"REVISION82-3973","anchor":"ALPHA-B001-Q053","subject":"Piranesi’s Carceri d’invenzione depicts what?","value":"Imaginary prisons","group":"Eighteenth century","major":"Art History","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carceri_d%27invenzione"}],"explanation74":"The etchings present vast, fantastical prison interiors."},{"id":"REVISION82-3974","nodeId":"REVISION82-3974","anchor":"ALPHA-B006-Q664","subject":"Which printmaking technique is central to Piranesi’s architectural images?","value":"Etching","group":"Eighteenth century","major":"Art History","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giovanni_Battista_Piranesi"}],"explanation74":"Piranesi worked extensively through etched copperplates."},{"id":"REVISION82-3975","nodeId":"REVISION82-3975","anchor":"ALPHA-B001-Q020","subject":"Which fruit does Pauline hold in Canova’s Venus Victrix?","value":"An apple","group":"Neoclassicism","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Venus_Victrix_(Canova)"}],"explanation74":"The apple identifies Venus as the victor in the mythological judgement."},{"id":"REVISION82-3976","nodeId":"REVISION82-3976","anchor":"ALPHA-B001-Q053","subject":"The Macchiaioli developed chiefly around which Italian city?","value":"Florence","group":"Nineteenth century","major":"Art History","era":"Renaissance","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Macchiaioli"}],"explanation74":"The group’s debates and practice centred on Tuscany and Florence."},{"id":"REVISION82-3977","nodeId":"REVISION82-3977","anchor":"ALPHA-B006-Q598","subject":"The name “Macchiaioli” derives from a word meaning what?","value":"Patches or spots","group":"Nineteenth century","major":"Art History","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Macchiaioli"}],"explanation74":"The name refers to constructing images through patches of light and colour."},{"id":"REVISION82-3978","nodeId":"REVISION82-3978","anchor":"ALPHA-B007-Q521","subject":"Which Florentine meeting place was associated with the Macchiaioli?","value":"Caffè Michelangiolo","group":"Nineteenth century","major":"Art History","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Caff%C3%A8_Michelangiolo"}],"explanation74":"The café was a centre of artistic discussion for the group."},{"id":"REVISION82-3979","nodeId":"REVISION82-3979","anchor":"ALPHA-B001-Q053","subject":"Which technique underlies Pellizza da Volpedo’s mature work?","value":"Divisionism","group":"Nineteenth century","major":"Art History","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giuseppe_Pellizza_da_Volpedo"}],"explanation74":"Separated touches of colour are central to his Divisionist technique."},{"id":"REVISION82-3980","nodeId":"REVISION82-3980","anchor":"ALPHA-B001-Q031","subject":"Which city is particularly associated with Boccioni’s The City Rises?","value":"Milan","group":"Futurism","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_City_Rises"}],"explanation74":"The painting grew from Boccioni’s experience of modern construction and urban change in Milan."},{"id":"REVISION82-3981","nodeId":"REVISION82-3981","anchor":"ALPHA-B008-Q706","subject":"Which Futurist artist also wrote the manifesto The Art of Noises?","value":"Luigi Russolo","group":"Futurism","major":"Art History","era":"Early 20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Art_of_Noises"}],"explanation74":"Russolo proposed expanding musical sound to include industrial and everyday noise."},{"id":"REVISION82-3982","nodeId":"REVISION82-3982","anchor":"ALPHA-B004-Q309","subject":"Gino Severini’s early Futurist paintings frequently draw on which modern entertainment?","value":"Dance halls","group":"Futurism","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gino_Severini"}],"explanation74":"Severini explored dancers, cabarets and rhythmic urban movement."},{"id":"REVISION82-3983","nodeId":"REVISION82-3983","anchor":"ALPHA-B005-Q445","subject":"Which Italian painter moved from Futurism toward metaphysical painting alongside de Chirico?","value":"Carlo Carrà","group":"Metaphysical art","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carlo_Carr%C3%A0"}],"explanation74":"Carrà was active in both Futurism and the metaphysical tendency."},{"id":"REVISION82-3984","nodeId":"REVISION82-3984","anchor":"ALPHA-B003-Q199","subject":"Giorgio Morandi is particularly associated with repeated arrangements of what?","value":"Bottles and vessels","group":"Modern art","major":"Art History","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giorgio_Morandi"}],"explanation74":"Morandi explored subtle relations of tone, shape and space in still lifes."},{"id":"REVISION82-3985","nodeId":"REVISION82-3985","anchor":"ALPHA-B001-Q052","subject":"What material gives Alberto Burri’s Sacchi series its name?","value":"Burlap sacks","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Alberto_Burri"}],"explanation74":"Burri worked with stitched, torn and patched sackcloth."},{"id":"REVISION82-3986","nodeId":"REVISION82-3986","anchor":"ALPHA-B001-Q052","subject":"Burri’s Grande Cretto at Gibellina is closely related to which event?","value":"An earthquake","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cretto_di_Burri"}],"explanation74":"The land work covers the ruins of the town devastated by the Belice earthquake."},{"id":"REVISION82-1400","nodeId":"REVISION82-1400","anchor":"ALPHA-B001-Q052","subject":"Which critic coined the term Arte Povera?","value":"Germano Celant","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arte_Povera"}],"explanation74":"Celant introduced the term in 1967 for a group of experimental practices."},{"id":"REVISION82-3987","nodeId":"REVISION82-3987","anchor":"ALPHA-B001-Q052","subject":"Mario Merz repeatedly incorporated which numerical sequence into his work?","value":"Fibonacci sequence","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mario_Merz"}],"explanation74":"The Fibonacci sequence became a recurring sign of growth in Merz’s work."},{"id":"REVISION82-3988","nodeId":"REVISION82-3988","anchor":"ALPHA-B001-Q052","subject":"Which form recurs prominently in Mario Merz’s installations?","value":"Igloo","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mario_Merz"}],"explanation74":"Merz built igloo-like structures from varied industrial and organic materials."},{"id":"REVISION82-3989","nodeId":"REVISION82-3989","anchor":"ALPHA-B001-Q052","subject":"Michelangelo Pistoletto’s Mirror Paintings incorporate which reflective support?","value":"Polished stainless steel","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Michelangelo_Pistoletto"}],"explanation74":"The reflective surface brings the viewer and surrounding space into the work."},{"id":"REVISION82-3990","nodeId":"REVISION82-3990","anchor":"ALPHA-B001-Q031","subject":"Giuseppe Penone’s practice often explores the relationship between the body and what?","value":"Trees","group":"Modern art","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giuseppe_Penone"}],"explanation74":"Growth, touch and the forms of trees recur throughout Penone’s work."},{"id":"REVISION82-3991","nodeId":"REVISION82-3991","anchor":"ALPHA-B001-Q052","subject":"Alighiero Boetti’s Mappa works were produced using which technique?","value":"Embroidery","group":"Modern art","major":"Art History","era":"19th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Alighiero_Boetti"}],"explanation74":"The embroidered maps link political geography with collaborative making."},{"id":"REVISION82-3992","nodeId":"REVISION82-3992","anchor":"ALPHA-B001-Q052","subject":"Piero Manzoni’s Achromes chiefly investigate which pictorial condition?","value":"Absence of colour","group":"Modern art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Piero_Manzoni"}],"explanation74":"The Achromes pursue surfaces freed from conventional colour composition."},{"id":"REVISION82-3993","nodeId":"REVISION82-3993","anchor":"ALPHA-B001-Q052","subject":"Malevich’s Suprematism chiefly privileged what?","value":"Basic geometric abstraction","group":"Modern art","major":"Art History","era":"19th century","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Suprematism"}],"explanation74":"Simple geometric forms and non-objective composition define Suprematism."},{"id":"REVISION82-3994","nodeId":"REVISION82-3994","anchor":"ALPHA-B001-Q052","subject":"Which artist developed the cut-out technique he called “drawing with scissors”?","value":"Henri Matisse","group":"Modern art","major":"Art History","era":"19th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Henri_Matisse"}],"explanation74":"Matisse cut painted paper into shapes for major late compositions."},{"id":"REVISION82-3995","nodeId":"REVISION82-3995","anchor":"ALPHA-B005-Q421","subject":"Which firm manufactured the Lettera 22 typewriter?","value":"Olivetti","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Olivetti_Lettera_22"}],"explanation74":"Olivetti produced the compact typewriter designed by Marcello Nizzoli."},{"id":"REVISION82-3996","nodeId":"REVISION82-3996","anchor":"ALPHA-B005-Q436","subject":"Which designer developed the Valentine typewriter with Perry A. King?","value":"Ettore Sottsass","group":"Design","major":"Design","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Olivetti_Valentine"}],"explanation74":"Sottsass and King designed the brightly coloured portable Olivetti machine."},{"id":"REVISION82-3997","nodeId":"REVISION82-3997","anchor":"ALPHA-B002-Q163","subject":"Which product was designed by Corradino D’Ascanio for Piaggio?","value":"Vespa scooter","group":"Design","major":"Design","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Vespa"}],"explanation74":"D’Ascanio’s design combined practical engineering with the Vespa’s distinctive form."},{"id":"REVISION82-3998","nodeId":"REVISION82-3998","anchor":"ALPHA-B002-Q163","subject":"Which company originally manufactured the Lambretta?","value":"Innocenti","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lambretta"}],"explanation74":"Innocenti’s scooter took its name from the Lambrate area of Milan."},{"id":"REVISION82-3999","nodeId":"REVISION82-3999","anchor":"ALPHA-B002-Q163","subject":"How does the Eclisse lamp chiefly regulate its light?","value":"A rotating inner shade","group":"Design","major":"Design","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Vico_Magistretti"}],"explanation74":"Rotating the inner hemisphere screens the bulb to varying degrees."},{"id":"REVISION82-4000","nodeId":"REVISION82-4000","anchor":"ALPHA-B001-Q080","subject":"Which chair by Gaetano Pesce resembles a female body and is paired with a spherical ottoman?","value":"UP5_6","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gaetano_Pesce"}],"explanation74":"Pesce’s UP series links a bodily form to an attached ball-like element."},{"id":"REVISION82-4001","nodeId":"REVISION82-4001","anchor":"ALPHA-B005-Q436","subject":"Which designer is associated with the Proust armchair?","value":"Alessandro Mendini","group":"Design","major":"Design","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Alessandro_Mendini"}],"explanation74":"Mendini transformed a historical chair form with a pointillist decorative surface."},{"id":"REVISION82-4002","nodeId":"REVISION82-4002","anchor":"ALPHA-B005-Q436","subject":"The Carlton room divider is associated with which design group?","value":"Memphis","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ettore_Sottsass"}],"explanation74":"Sottsass’s Carlton became an emblem of the Memphis group."},{"id":"REVISION82-4003","nodeId":"REVISION82-4003","anchor":"ALPHA-B002-Q163","subject":"Which tension-supported bookcase was designed by Franco Albini?","value":"Veliero","group":"Design","major":"Design","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://www.cassina.com/gb/en/products/veliero.html"}],"explanation74":"Albini’s Veliero bookcase uses a tensioned structure resembling a sailing vessel."},{"id":"REVISION82-4004","nodeId":"REVISION82-4004","anchor":"ALPHA-B003-Q202","subject":"Enzo Mari’s Autoprogettazione proposed what?","value":"Furniture made from basic boards","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Enzo_Mari"}],"explanation74":"Mari offered plans that enabled users to construct furniture from ordinary timber elements."},{"id":"REVISION82-4005","nodeId":"REVISION82-4005","anchor":"ALPHA-B004-Q280","subject":"Which Italian designer developed the multisensory and experimental children’s books known as Prebooks?","value":"Bruno Munari","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bruno_Munari"}],"explanation74":"Munari’s Prebooks invite exploration through varied materials and formats."},{"id":"REVISION82-4006","nodeId":"REVISION82-4006","anchor":"ALPHA-B004-Q280","subject":"Which architecture and design group produced the Continuous Monument project?","value":"Superstudio","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Superstudio"}],"explanation74":"Superstudio’s continuous gridded megastructure was a critical conceptual project."},{"id":"REVISION82-4007","nodeId":"REVISION82-4007","anchor":"ALPHA-B005-Q436","subject":"No-Stop City is associated with which radical design group?","value":"Archizoom","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Archizoom_Associati"}],"explanation74":"Archizoom imagined a continuous, homogeneous urban interior."},{"id":"REVISION82-4008","nodeId":"REVISION82-4008","anchor":"ALPHA-B007-Q539","subject":"Which designer created the Paimio chair for a Finnish sanatorium?","value":"Alvar Aalto","group":"Design","major":"Design","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Paimio_Chair"}],"explanation74":"Aalto designed the bent-plywood chair for the Paimio Sanatorium."},{"id":"REVISION82-4009","nodeId":"REVISION82-4009","anchor":"ALPHA-B002-Q163","subject":"The Barcelona chair was designed for which setting?","value":"German Pavilion, 1929 exposition","group":"Design","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Barcelona_chair"}],"explanation74":"Mies van der Rohe and Lilly Reich designed it for the German Pavilion in Barcelona."},{"id":"REVISION82-4010","nodeId":"REVISION82-4010","anchor":"ALPHA-B004-Q295","subject":"The Red Blue Chair is closely associated with which movement?","value":"De Stijl","group":"Design","major":"Design","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Red_and_Blue_Chair"}],"explanation74":"Rietveld’s chair applies intersecting planes and the colour language associated with De Stijl."},{"id":"REVISION82-4011","nodeId":"REVISION82-4011","anchor":"ALPHA-B004-Q367","subject":"Which Italian award, established in 1954, recognises industrial design?","value":"Compasso d’Oro","group":"Design","major":"Design","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Compasso_d%27Oro"}],"explanation74":"The Compasso d’Oro is a major Italian industrial design award."},{"id":"REVISION82-4012","nodeId":"REVISION82-4012","anchor":"ALPHA-B001-Q032","subject":"Which Verdi opera adapts Victor Hugo’s play Le roi s’amuse?","value":"Rigoletto","group":"Verdi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rigoletto"}],"explanation74":"Rigoletto adapts Hugo’s drama about a court jester and his daughter."},{"id":"REVISION82-4013","nodeId":"REVISION82-4013","anchor":"ALPHA-B002-Q164","subject":"Which Verdi opera is based on La Dame aux camélias by Alexandre Dumas fils?","value":"La traviata","group":"Verdi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_traviata"}],"explanation74":"Dumas’s story supplied the basis for the tragedy of Violetta Valéry."},{"id":"REVISION82-4014","nodeId":"REVISION82-4014","anchor":"ALPHA-B003-Q238","subject":"Violetta Valéry is the protagonist of which opera?","value":"La traviata","group":"Verdi","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_traviata"}],"explanation74":"Violetta is the Parisian courtesan at the centre of La traviata."},{"id":"REVISION82-4015","nodeId":"REVISION82-4015","anchor":"ALPHA-B001-Q087","subject":"Which civilisation provides the setting for Verdi’s Aida?","value":"Ancient Egypt","group":"Verdi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aida"}],"explanation74":"Aida places the love triangle of Aida, Radamès and Amneris in ancient Egypt."},{"id":"REVISION82-4016","nodeId":"REVISION82-4016","anchor":"ALPHA-B001-Q035","subject":"Who wrote the librettos for Verdi’s Otello and Falstaff?","value":"Arrigo Boito","group":"Verdi","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arrigo_Boito"}],"explanation74":"Boito adapted Shakespeare for both late Verdi operas."},{"id":"REVISION82-4017","nodeId":"REVISION82-4017","anchor":"ALPHA-B003-Q238","subject":"Verdi’s Falstaff principally draws on which Shakespeare comedy?","value":"The Merry Wives of Windsor","group":"Verdi","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Falstaff_(opera)"}],"explanation74":"The Merry Wives of Windsor supplies the principal plot, with material from Henry IV."},{"id":"REVISION82-4018","nodeId":"REVISION82-4018","anchor":"ALPHA-B001-Q032","subject":"The Duke of Mantua sings “La donna è mobile” in which opera?","value":"Rigoletto","group":"Verdi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_donna_%C3%A8_mobile"}],"explanation74":"The aria is sung by the Duke in the final act of Rigoletto."},{"id":"REVISION82-4019","nodeId":"REVISION82-4019","anchor":"ALPHA-B007-Q583","subject":"Verdi composed his Requiem in memory of which writer?","value":"Alessandro Manzoni","group":"Verdi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Requiem_(Verdi)"}],"explanation74":"Manzoni’s death prompted Verdi’s large-scale musical memorial."},{"id":"REVISION82-4020","nodeId":"REVISION82-4020","anchor":"ALPHA-B008-Q720","subject":"Puccini’s Tosca is set principally in which city?","value":"Rome","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tosca"}],"explanation74":"The opera moves through Sant’Andrea della Valle, Palazzo Farnese and Castel Sant’Angelo."},{"id":"REVISION82-4021","nodeId":"REVISION82-4021","anchor":"ALPHA-B001-Q087","subject":"Which opera features the painter Mario Cavaradossi?","value":"Tosca","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tosca"}],"explanation74":"Cavaradossi is Tosca’s lover and a painter caught in political repression."},{"id":"REVISION82-4022","nodeId":"REVISION82-4022","anchor":"ALPHA-B003-Q238","subject":"Cio-Cio-San is the heroine of which opera?","value":"Madama Butterfly","group":"Puccini","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Madama_Butterfly"}],"explanation74":"Cio-Cio-San is the Japanese woman whose relationship with Pinkerton drives the tragedy."},{"id":"REVISION82-4023","nodeId":"REVISION82-4023","anchor":"ALPHA-B008-Q720","subject":"Which Puccini opera is set in a community of artists in Paris?","value":"La bohème","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_boh%C3%A8me"}],"explanation74":"La bohème follows impoverished artists and their relationships in Paris."},{"id":"REVISION82-4024","nodeId":"REVISION82-4024","anchor":"ALPHA-B001-Q046","subject":"Which Puccini opera takes place during the California Gold Rush?","value":"La fanciulla del West","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_fanciulla_del_West"}],"explanation74":"The opera centres on Minnie and a mining community in California."},{"id":"REVISION82-4025","nodeId":"REVISION82-4025","anchor":"ALPHA-B001-Q045","subject":"“Nessun dorma” is sung by Calaf in which opera?","value":"Turandot","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Nessun_dorma"}],"explanation74":"Calaf sings the aria before the resolution of the princess’s challenge."},{"id":"REVISION82-4026","nodeId":"REVISION82-4026","anchor":"ALPHA-B002-Q116","subject":"Who completed the standard final portion of Turandot after Puccini’s death?","value":"Franco Alfano","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Turandot"}],"explanation74":"Alfano completed the opera using Puccini’s sketches; later alternative endings also exist."},{"id":"REVISION82-4027","nodeId":"REVISION82-4027","anchor":"ALPHA-B003-Q260","subject":"Which Puccini opera draws its title character from Dante’s Inferno?","value":"Gianni Schicchi","group":"Puccini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gianni_Schicchi"}],"explanation74":"Dante places the impersonator Gianni Schicchi among the falsifiers; Puccini makes him the centre of a comedy."},{"id":"REVISION82-4028","nodeId":"REVISION82-4028","anchor":"ALPHA-B006-Q630","subject":"Which opera includes “O mio babbino caro”?","value":"Gianni Schicchi","group":"Puccini","major":"Language & Literature","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/O_mio_babbino_caro"}],"explanation74":"Lauretta sings the aria to her father in Gianni Schicchi."},{"id":"REVISION82-4029","nodeId":"REVISION82-4029","anchor":"ALPHA-B003-Q238","subject":"Rossini’s The Barber of Seville is based on a play by whom?","value":"Beaumarchais","group":"Rossini","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Barber_of_Seville"}],"explanation74":"Beaumarchais’s Figaro plays inspired both Rossini and Mozart."},{"id":"REVISION82-4030","nodeId":"REVISION82-4030","anchor":"ALPHA-B003-Q238","subject":"What is Figaro’s occupation in The Barber of Seville?","value":"Barber","group":"Rossini","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Barber_of_Seville"}],"explanation74":"Figaro is the resourceful barber who helps Count Almaviva."},{"id":"REVISION82-4031","nodeId":"REVISION82-4031","anchor":"ALPHA-B001-Q032","subject":"Rossini’s La Cenerentola reworks which tale?","value":"Cinderella","group":"Rossini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_Cenerentola"}],"explanation74":"La Cenerentola is an operatic version of Cinderella, with several plot changes."},{"id":"REVISION82-4032","nodeId":"REVISION82-4032","anchor":"ALPHA-B001-Q087","subject":"Which Rossini opera takes its name from the legendary Swiss archer?","value":"William Tell","group":"Rossini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/William_Tell_(opera)"}],"explanation74":"Rossini’s final opera treats the legend of William Tell and Swiss resistance."},{"id":"REVISION82-4033","nodeId":"REVISION82-4033","anchor":"ALPHA-B003-Q214","subject":"Which Bellini heroine is a Druid priestess?","value":"Norma","group":"Bellini","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Norma_(opera)"}],"explanation74":"Norma is the priestess at the centre of the opera of the same name."},{"id":"REVISION82-4034","nodeId":"REVISION82-4034","anchor":"ALPHA-B008-Q720","subject":"What does the title La sonnambula describe?","value":"A sleepwalker","group":"Bellini","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_sonnambula"}],"explanation74":"Bellini’s heroine Amina sleepwalks, creating the central misunderstanding."},{"id":"REVISION82-4035","nodeId":"REVISION82-4035","anchor":"ALPHA-B002-Q164","subject":"Donizetti’s Lucia di Lammermoor adapts a novel by whom?","value":"Walter Scott","group":"Donizetti","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lucia_di_Lammermoor"}],"explanation74":"The source is Scott’s The Bride of Lammermoor."},{"id":"REVISION82-4036","nodeId":"REVISION82-4036","anchor":"ALPHA-B003-Q214","subject":"Which drink is sold to Nemorino as a love potion in L’elisir d’amore?","value":"Wine","group":"Donizetti","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/L%27elisir_d%27amore"}],"explanation74":"Dulcamara’s supposed magic elixir is ordinary wine."},{"id":"REVISION82-4037","nodeId":"REVISION82-4037","anchor":"ALPHA-B003-Q256","subject":"Mascagni’s Cavalleria rusticana is based on a story by whom?","value":"Giovanni Verga","group":"Verismo","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cavalleria_rusticana"}],"explanation74":"Verga’s Sicilian story became a landmark of operatic verismo."},{"id":"REVISION82-4038","nodeId":"REVISION82-4038","anchor":"ALPHA-B001-Q035","subject":"Which opera centres on Canio and a travelling troupe of actors?","value":"Pagliacci","group":"Verismo","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pagliacci"}],"explanation74":"Leoncavallo’s Pagliacci blurs the troupe’s staged comedy and real jealousy."},{"id":"REVISION82-4039","nodeId":"REVISION82-4039","anchor":"ALPHA-B008-Q720","subject":"In an opera, what is the libretto?","value":"The verbal text","group":"Opera","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Libretto"}],"explanation74":"The libretto contains the words and dramatic text set to music."},{"id":"REVISION82-4040","nodeId":"REVISION82-4040","anchor":"ALPHA-B001-Q045","subject":"Which operatic passage typically advances dialogue in speech-like singing?","value":"Recitative","group":"Opera","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Recitative"}],"explanation74":"Recitative follows speech rhythms and commonly carries the narrative."},{"id":"REVISION82-4041","nodeId":"REVISION82-4041","anchor":"ALPHA-B001-Q035","subject":"Which vocal category is normally lower than a soprano and higher than a contralto?","value":"Mezzo-soprano","group":"Opera","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mezzo-soprano"}],"explanation74":"Mezzo-soprano denotes the middle principal female voice category."},{"id":"REVISION82-4042","nodeId":"REVISION82-4042","anchor":"ALPHA-B003-Q238","subject":"Monteverdi’s L’Orfeo retells the myth of Orpheus and whom?","value":"Eurydice","group":"Monteverdi","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/L%27Orfeo"}],"explanation74":"Orpheus descends to the underworld in an attempt to recover Eurydice."},{"id":"REVISION82-4043","nodeId":"REVISION82-4043","anchor":"ALPHA-B007-Q531","subject":"At which court was Monteverdi’s L’Orfeo first performed?","value":"Gonzaga court","group":"Monteverdi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/L%27Orfeo"}],"explanation74":"The opera was first performed at the Gonzaga court in Mantua."},{"id":"REVISION82-4044","nodeId":"REVISION82-4044","anchor":"ALPHA-B008-Q720","subject":"Vivaldi’s The Four Seasons is a set of concertos principally for which solo instrument?","value":"Violin","group":"Vivaldi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Four_Seasons_(Vivaldi)"}],"explanation74":"The four concertos place the solo violin against a string ensemble and continuo."},{"id":"REVISION82-4045","nodeId":"REVISION82-4045","anchor":"ALPHA-B001-Q012","subject":"Vivaldi taught for many years at which Venetian institution?","value":"Ospedale della Pietà","group":"Vivaldi","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Antonio_Vivaldi"}],"explanation74":"The Pietà was a charitable institution with a renowned musical ensemble."},{"id":"REVISION82-4046","nodeId":"REVISION82-4046","anchor":"ALPHA-B001-Q035","subject":"Which composer wrote the orchestral trilogy Fountains, Pines and Roman Festivals?","value":"Ottorino Respighi","group":"Respighi","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ottorino_Respighi"}],"explanation74":"Respighi’s three symphonic poems evoke the city and its surroundings."},{"id":"REVISION82-4047","nodeId":"REVISION82-4047","anchor":"ALPHA-B008-Q720","subject":"A concerto grosso contrasts the full ensemble with what?","value":"A small solo group","group":"Music","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Concerto_grosso"}],"explanation74":"The concertino is the small solo group set against the ripieno."},{"id":"REVISION82-4048","nodeId":"REVISION82-4048","anchor":"ALPHA-B008-Q720","subject":"Which Italian composer is particularly associated with the development of the concerto grosso?","value":"Arcangelo Corelli","group":"Music","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arcangelo_Corelli"}],"explanation74":"Corelli’s concerti grossi became models for later Baroque composers."},{"id":"REVISION82-4049","nodeId":"REVISION82-4049","anchor":"ALPHA-B001-Q045","subject":"In musical notation, what does “crescendo” require?","value":"Gradually increasing loudness","group":"Music","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Crescendo"}],"explanation74":"Crescendo changes dynamics, not necessarily tempo."},{"id":"REVISION82-4050","nodeId":"REVISION82-4050","anchor":"ALPHA-B008-Q720","subject":"What does “pizzicato” ask a string player to do?","value":"Pluck the strings","group":"Music","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pizzicato"}],"explanation74":"Pizzicato produces sound by plucking rather than bowing."},{"id":"REVISION82-4051","nodeId":"REVISION82-4051","anchor":"ALPHA-B008-Q720","subject":"Which Italian composer is associated with the dodecaphonic opera Il prigioniero?","value":"Luigi Dallapiccola","group":"Music","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Il_prigioniero"}],"explanation74":"Dallapiccola brought twelve-tone techniques into Italian opera."},{"id":"REVISION82-4052","nodeId":"REVISION82-4052","anchor":"ALPHA-B001-Q035","subject":"Which Italian film follows a father and son searching for a stolen bicycle?","value":"Bicycle Thieves","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bicycle_Thieves"}],"explanation74":"De Sica’s film links a stolen bicycle to work and survival in post-war Rome."},{"id":"REVISION82-4053","nodeId":"REVISION82-4053","anchor":"ALPHA-B001-Q046","subject":"Who directed Umberto D.?","value":"Vittorio De Sica","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Umberto_D."}],"explanation74":"De Sica’s film follows an elderly pensioner and his dog in Rome."},{"id":"REVISION82-4054","nodeId":"REVISION82-4054","anchor":"ALPHA-B005-Q419","subject":"Rome, Open City depicts resistance during which occupation?","value":"German occupation of Rome","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rome%2C_Open_City"}],"explanation74":"Rossellini’s film is set during the Nazi occupation in the Second World War."},{"id":"REVISION82-4055","nodeId":"REVISION82-4055","anchor":"ALPHA-B007-Q555","subject":"Which screenwriter was a major theorist of Italian neorealism and a collaborator of De Sica?","value":"Cesare Zavattini","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cesare_Zavattini"}],"explanation74":"Zavattini helped develop neorealism’s attention to ordinary lives."},{"id":"REVISION82-4056","nodeId":"REVISION82-4056","anchor":"ALPHA-B007-Q471","subject":"Visconti’s La terra trema draws on which Verga novel?","value":"I Malavoglia","group":"Cinema","major":"Language & Literature","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_Terra_Trema"}],"explanation74":"The film relocates Verga’s fishing-community story into its cinematic treatment of Aci Trezza."},{"id":"REVISION82-4057","nodeId":"REVISION82-4057","anchor":"ALPHA-B008-Q720","subject":"Visconti’s The Leopard adapts a novel by whom?","value":"Giuseppe Tomasi di Lampedusa","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Leopard"}],"explanation74":"Il Gattopardo examines an aristocratic Sicilian family during unification."},{"id":"REVISION82-4058","nodeId":"REVISION82-4058","anchor":"ALPHA-B003-Q238","subject":"Which historical process forms the background of The Leopard?","value":"Italian unification","group":"Cinema","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Leopard"}],"explanation74":"The story follows the Sicilian aristocracy through the Risorgimento."},{"id":"REVISION82-4059","nodeId":"REVISION82-4059","anchor":"ALPHA-B001-Q032","subject":"Who plays Marcello in Fellini’s La dolce vita?","value":"Marcello Mastroianni","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_Dolce_Vita"}],"explanation74":"Mastroianni plays the journalist Marcello Rubini."},{"id":"REVISION82-4060","nodeId":"REVISION82-4060","anchor":"ALPHA-B003-Q238","subject":"The protagonist of Fellini’s 8½ works in which profession?","value":"Film director","group":"Cinema","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/8%C2%BD"}],"explanation74":"Guido is a film director struggling with artistic and personal uncertainty."},{"id":"REVISION82-4061","nodeId":"REVISION82-4061","anchor":"ALPHA-B006-Q668","subject":"Which Fellini film features Gelsomina and the strongman Zampanò?","value":"La strada","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_Strada"}],"explanation74":"La strada follows Gelsomina’s life travelling with Zampanò."},{"id":"REVISION82-4062","nodeId":"REVISION82-4062","anchor":"ALPHA-B008-Q720","subject":"The title Amarcord derives from a Romagnol expression meaning what?","value":"I remember","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Amarcord"}],"explanation74":"Fellini’s title evokes recollection and the provincial world of his youth."},{"id":"REVISION82-4063","nodeId":"REVISION82-4063","anchor":"ALPHA-B008-Q720","subject":"Antonioni’s Blow-Up is principally set in which city?","value":"London","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Blowup"}],"explanation74":"A London fashion photographer believes his photographs may reveal a murder."},{"id":"REVISION82-4064","nodeId":"REVISION82-4064","anchor":"ALPHA-B008-Q720","subject":"Which medium is central to the mystery in Antonioni’s Blow-Up?","value":"Photography","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Blowup"}],"explanation74":"Enlarging photographs creates uncertainty about what the protagonist has witnessed."},{"id":"REVISION82-4065","nodeId":"REVISION82-4065","anchor":"ALPHA-B001-Q035","subject":"Which Italian director made the trilogy L’avventura, La notte and L’eclisse?","value":"Michelangelo Antonioni","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Michelangelo_Antonioni"}],"explanation74":"These films explore alienation and unstable relationships in modern society."},{"id":"REVISION82-4066","nodeId":"REVISION82-4066","anchor":"ALPHA-B001-Q063","subject":"Which composer is especially associated with Sergio Leone’s westerns?","value":"Ennio Morricone","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ennio_Morricone"}],"explanation74":"Morricone’s scores became a defining element of Leone’s westerns."},{"id":"REVISION82-4067","nodeId":"REVISION82-4067","anchor":"ALPHA-B001-Q087","subject":"Who composed the principal score for Fellini’s 8½?","value":"Nino Rota","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/8%C2%BD"}],"explanation74":"Rota was a central musical collaborator on Fellini’s films."},{"id":"REVISION82-4068","nodeId":"REVISION82-4068","anchor":"ALPHA-B003-Q238","subject":"Which director made The Battle of Algiers?","value":"Gillo Pontecorvo","group":"Cinema","major":"Language & Literature","era":"Renaissance","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Battle_of_Algiers"}],"explanation74":"Pontecorvo reconstructed the conflict between Algerian independence fighters and French forces."},{"id":"REVISION82-4069","nodeId":"REVISION82-4069","anchor":"ALPHA-B003-Q238","subject":"The Battle of Algiers centres on resistance to which colonial power?","value":"France","group":"Cinema","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Battle_of_Algiers"}],"explanation74":"The film depicts the Algerian struggle against French colonial rule."},{"id":"REVISION82-4070","nodeId":"REVISION82-4070","anchor":"ALPHA-B007-Q555","subject":"Which Italian director made The Gospel According to St. Matthew?","value":"Pier Paolo Pasolini","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Gospel_According_to_St._Matthew_(film)"}],"explanation74":"Pasolini adapted Matthew’s Gospel using a deliberately austere visual style."},{"id":"REVISION82-4071","nodeId":"REVISION82-4071","anchor":"ALPHA-B008-Q720","subject":"Cinema Paradiso centres on a young boy’s friendship with whom?","value":"A projectionist","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cinema_Paradiso"}],"explanation74":"Alfredo introduces the young Salvatore to the world of cinema."},{"id":"REVISION82-4072","nodeId":"REVISION82-4072","anchor":"ALPHA-B007-Q531","subject":"Who directed Cinema Paradiso?","value":"Giuseppe Tornatore","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cinema_Paradiso"}],"explanation74":"Tornatore’s film reflects on cinema, memory and a Sicilian community."},{"id":"REVISION82-4073","nodeId":"REVISION82-4073","anchor":"ALPHA-B001-Q087","subject":"The Venice Film Festival’s highest award is named after which animal?","value":"Lion","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Golden_Lion"}],"explanation74":"The Golden Lion reflects the traditional symbol of Venice."},{"id":"REVISION82-4074","nodeId":"REVISION82-4074","anchor":"ALPHA-B001-Q087","subject":"Which festival awards the Golden Bear?","value":"Berlin","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Golden_Bear"}],"explanation74":"The Golden Bear is the principal award of the Berlin International Film Festival."},{"id":"REVISION82-4075","nodeId":"REVISION82-4075","anchor":"ALPHA-B001-Q035","subject":"Which Italian actor and director made Life Is Beautiful?","value":"Roberto Benigni","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Life_Is_Beautiful"}],"explanation74":"Benigni directed the film and played Guido."},{"id":"REVISION82-4076","nodeId":"REVISION82-4076","anchor":"ALPHA-B008-Q720","subject":"The term “spaghetti western” chiefly refers to westerns produced in which cinematic tradition?","value":"Italian cinema","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Spaghetti_Western"}],"explanation74":"The term is associated with Italian-led European western production."},{"id":"REVISION82-4077","nodeId":"REVISION82-4077","anchor":"ALPHA-B008-Q720","subject":"In cinema, a “long take” primarily concerns which feature?","value":"Shot duration","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Long_take"}],"explanation74":"A long take runs for an extended duration without a cut."},{"id":"REVISION82-4078","nodeId":"REVISION82-4078","anchor":"ALPHA-B001-Q035","subject":"Which term denotes arranging scenery, actors and lighting within the frame?","value":"Mise-en-scène","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mise-en-sc%C3%A8ne"}],"explanation74":"Mise-en-scène concerns what is staged before the camera."},{"id":"REVISION82-4079","nodeId":"REVISION82-4079","anchor":"ALPHA-B003-Q214","subject":"What is a film’s diegetic sound?","value":"Sound within its story world","group":"Cinema","major":"Language & Literature","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Diegetic_music"}],"explanation74":"Characters can in principle hear diegetic sound, such as a radio playing in the scene."},{"id":"REVISION82-4080","nodeId":"REVISION82-4080","anchor":"ALPHA-B003-Q238","subject":"What is the narrative frame of Boccaccio’s Decameron?","value":"Storytelling during a plague retreat","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Decameron"}],"explanation74":"Ten young people leave plague-stricken Florence and tell stories."},{"id":"REVISION82-4081","nodeId":"REVISION82-4081","anchor":"ALPHA-B008-Q720","subject":"How many main storytellers take part in the Decameron’s frame narrative?","value":"Ten","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Decameron"}],"explanation74":"Seven women and three men make up the storytelling group."},{"id":"REVISION82-4082","nodeId":"REVISION82-4082","anchor":"ALPHA-B001-Q012","subject":"Petrarch’s Canzoniere is chiefly associated with his love for whom?","value":"Laura","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Canzoniere"}],"explanation74":"Laura is the central beloved figure of Petrarch’s lyric collection."},{"id":"REVISION82-4083","nodeId":"REVISION82-4083","anchor":"ALPHA-B003-Q238","subject":"Which language did Petrarch use for most poems of the Canzoniere?","value":"Italian vernacular","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Canzoniere"}],"explanation74":"The vernacular lyrics contrast with Petrarch’s extensive Latin writings."},{"id":"REVISION82-4084","nodeId":"REVISION82-4084","anchor":"ALPHA-B003-Q238","subject":"What is the usual rhyme pattern of Dante’s terza rima?","value":"ABA BCB CDC","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Terza_rima"}],"explanation74":"The middle rhyme of each tercet links to the outside rhymes of the next."},{"id":"REVISION82-4085","nodeId":"REVISION82-4085","anchor":"ALPHA-B003-Q238","subject":"Which treatise by Dante discusses the use of the vernacular language?","value":"De vulgari eloquentia","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/De_vulgari_eloquentia"}],"explanation74":"Dante examined an elevated vernacular in a treatise written in Latin."},{"id":"REVISION82-4086","nodeId":"REVISION82-4086","anchor":"ALPHA-B001-Q012","subject":"Orlando furioso continues a chivalric narrative begun by which poet?","value":"Matteo Maria Boiardo","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Orlando_Furioso"}],"explanation74":"Ariosto continues the narrative world of Boiardo’s Orlando innamorato."},{"id":"REVISION82-4087","nodeId":"REVISION82-4087","anchor":"ALPHA-B001-Q012","subject":"Tasso’s Gerusalemme liberata takes which conflict as its central subject?","value":"The First Crusade","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jerusalem_Delivered"}],"explanation74":"Tasso fictionalises the crusading campaign culminating in the capture of Jerusalem."},{"id":"REVISION82-4088","nodeId":"REVISION82-4088","anchor":"ALPHA-B003-Q238","subject":"Which court provides the setting of Castiglione’s The Book of the Courtier?","value":"Urbino","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Book_of_the_Courtier"}],"explanation74":"The dialogue portrays courtly conversation at Urbino."},{"id":"REVISION82-4089","nodeId":"REVISION82-4089","anchor":"ALPHA-B004-Q342","subject":"Which Machiavelli work is a comedy about a scheme involving a supposed fertility potion?","value":"La mandragola","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Mandrake"}],"explanation74":"The Mandrake is Machiavelli’s satirical theatrical comedy."},{"id":"REVISION82-4090","nodeId":"REVISION82-4090","anchor":"ALPHA-B003-Q238","subject":"The innkeeper Mirandolina is the protagonist of which Goldoni play?","value":"La locandiera","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Mistress_of_the_Inn"}],"explanation74":"Mirandolina manages her inn and the competing attentions of her guests."},{"id":"REVISION82-4091","nodeId":"REVISION82-4091","anchor":"ALPHA-B007-Q471","subject":"Goldoni’s reform of Italian theatre particularly favoured what?","value":"Fully written dialogue","group":"Literature","major":"Language & Literature","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carlo_Goldoni"}],"explanation74":"Goldoni increasingly replaced improvised commedia conventions with scripted character comedy."},{"id":"REVISION82-4092","nodeId":"REVISION82-4092","anchor":"ALPHA-B001-Q059","subject":"Foscolo’s Dei Sepolcri reflects principally on what?","value":"Tombs and cultural memory","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Dei_Sepolcri"}],"explanation74":"The poem considers burial, remembrance and the civic role of monuments."},{"id":"REVISION82-4093","nodeId":"REVISION82-4093","anchor":"ALPHA-B001-Q012","subject":"Which form does Foscolo’s Last Letters of Jacopo Ortis chiefly use?","value":"Epistolary novel","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jacopo_Ortis"}],"explanation74":"The story is presented through letters and editorial framing."},{"id":"REVISION82-4094","nodeId":"REVISION82-4094","anchor":"ALPHA-B008-Q720","subject":"Renzo and Lucia are the central couple in which novel?","value":"The Betrothed","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Betrothed_(Manzoni_novel)"}],"explanation74":"Manzoni’s novel follows their separation and eventual reunion."},{"id":"REVISION82-4095","nodeId":"REVISION82-4095","anchor":"ALPHA-B008-Q720","subject":"Manzoni’s The Betrothed is set mainly in which Italian region?","value":"Lombardy","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Betrothed_(Manzoni_novel)"}],"explanation74":"The novel moves through seventeenth-century Lombardy under Spanish rule."},{"id":"REVISION82-4096","nodeId":"REVISION82-4096","anchor":"ALPHA-B003-Q214","subject":"Leopardi’s Zibaldone is best described as what?","value":"A notebook of reflections","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Zibaldone"}],"explanation74":"The Zibaldone collects Leopardi’s wide-ranging intellectual notes."},{"id":"REVISION82-4097","nodeId":"REVISION82-4097","anchor":"ALPHA-B008-Q720","subject":"Which village is associated with the fishing family in Verga’s I Malavoglia?","value":"Aci Trezza","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/I_Malavoglia"}],"explanation74":"The family’s fortunes are rooted in the Sicilian fishing community of Aci Trezza."},{"id":"REVISION82-4098","nodeId":"REVISION82-4098","anchor":"ALPHA-B003-Q256","subject":"Which literary tendency is most closely associated with Giovanni Verga?","value":"Verismo","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giovanni_Verga"}],"explanation74":"Verga’s narrative practice is central to Italian verismo."},{"id":"REVISION82-4099","nodeId":"REVISION82-4099","anchor":"ALPHA-B001-Q012","subject":"Which D’Annunzio novel features the aesthete Andrea Sperelli?","value":"Il piacere","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Il_piacere"}],"explanation74":"Andrea Sperelli embodies aestheticism and moral uncertainty in Il piacere."},{"id":"REVISION82-4100","nodeId":"REVISION82-4100","anchor":"ALPHA-B001-Q012","subject":"Italo Svevo’s Zeno’s Conscience is framed in relation to which practice?","value":"Psychoanalysis","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Zeno%27s_Conscience"}],"explanation74":"Zeno’s written recollections are tied to his troubled relationship with psychoanalytic treatment."},{"id":"REVISION82-4101","nodeId":"REVISION82-4101","anchor":"ALPHA-B001-Q012","subject":"What is Italo Svevo’s birth name?","value":"Aron Ettore Schmitz","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italo_Svevo"}],"explanation74":"Schmitz wrote under the pen name Italo Svevo."},{"id":"REVISION82-4102","nodeId":"REVISION82-4102","anchor":"ALPHA-B001-Q012","subject":"Which city is central to Italo Svevo’s life and fiction?","value":"Trieste","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italo_Svevo"}],"explanation74":"Trieste’s multilingual commercial culture shaped Svevo’s work."},{"id":"REVISION82-4103","nodeId":"REVISION82-4103","anchor":"ALPHA-B007-Q471","subject":"Which Pirandello protagonist assumes the new identity Adriano Meis?","value":"Mattia Pascal","group":"Literature","major":"Language & Literature","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Late_Mattia_Pascal"}],"explanation74":"Believed dead, Mattia tries to begin a new life as Adriano Meis."},{"id":"REVISION82-4104","nodeId":"REVISION82-4104","anchor":"ALPHA-B001-Q045","subject":"Ungaretti’s early war poetry draws on his experience in which conflict?","value":"First World War","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giuseppe_Ungaretti"}],"explanation74":"Ungaretti served as a soldier on the Italian front during the First World War."},{"id":"REVISION82-4105","nodeId":"REVISION82-4105","anchor":"ALPHA-B001-Q012","subject":"Which profession did Primo Levi practise in addition to writing?","value":"Chemist","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Primo_Levi"}],"explanation74":"Levi’s chemistry training informs works including The Periodic Table."},{"id":"REVISION82-4106","nodeId":"REVISION82-4106","anchor":"ALPHA-B008-Q720","subject":"Primo Levi’s If This Is a Man recounts imprisonment in which camp system?","value":"Auschwitz","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/If_This_Is_a_Man"}],"explanation74":"Levi was imprisoned at Monowitz, part of the Auschwitz complex."},{"id":"REVISION82-4107","nodeId":"REVISION82-4107","anchor":"ALPHA-B008-Q720","subject":"Which Calvino novel features a nobleman who decides to live in trees?","value":"The Baron in the Trees","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Baron_in_the_Trees"}],"explanation74":"Cosimo’s life in the trees becomes an experiment in independence and social observation."},{"id":"REVISION82-4108","nodeId":"REVISION82-4108","anchor":"ALPHA-B008-Q720","subject":"Eco’s The Name of the Rose is primarily set in what kind of institution?","value":"A medieval abbey","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Name_of_the_Rose"}],"explanation74":"The murder investigation unfolds in a medieval monastic community and its library."},{"id":"REVISION82-4109","nodeId":"REVISION82-4109","anchor":"ALPHA-B001-Q012","subject":"Which discipline was central to Umberto Eco’s academic work?","value":"Semiotics","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Umberto_Eco"}],"explanation74":"Eco studied signs, interpretation and the production of meaning."},{"id":"REVISION82-4110","nodeId":"REVISION82-4110","anchor":"ALPHA-B007-Q569","subject":"Which Italian author wrote The Garden of the Finzi-Continis?","value":"Giorgio Bassani","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Garden_of_the_Finzi-Continis"}],"explanation74":"Bassani’s novel depicts a Jewish family in Ferrara under Fascism."},{"id":"REVISION82-4111","nodeId":"REVISION82-4111","anchor":"ALPHA-B003-Q238","subject":"Leonardo Sciascia’s The Day of the Owl centres on investigation of what?","value":"Mafia power","group":"Literature","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Day_of_the_Owl"}],"explanation74":"The novel examines murder, organised crime and the limits of state authority in Sicily."},{"id":"REVISION82-4112","nodeId":"REVISION82-4112","anchor":"ALPHA-B006-Q668","subject":"Who wrote the historical novel La Storia, centred on Ida and Useppe?","value":"Elsa Morante","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/History_(novel)"}],"explanation74":"Morante’s novel follows vulnerable lives through wartime and post-war Rome."},{"id":"REVISION82-4113","nodeId":"REVISION82-4113","anchor":"ALPHA-B001-Q012","subject":"Grazia Deledda’s fiction is especially associated with which island?","value":"Sardinia","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Grazia_Deledda"}],"explanation74":"Deledda drew extensively on Sardinian settings and social life."},{"id":"REVISION82-4114","nodeId":"REVISION82-4114","anchor":"ALPHA-B007-Q569","subject":"Which author used the pen name Alberto Moravia?","value":"Alberto Pincherle","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Alberto_Moravia"}],"explanation74":"Alberto Pincherle published his fiction as Alberto Moravia."},{"id":"REVISION82-4115","nodeId":"REVISION82-4115","anchor":"ALPHA-B005-Q396","subject":"Which work by Carlo Levi recounts exile in Lucania under Fascism?","value":"Christ Stopped at Eboli","group":"Literature","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Christ_Stopped_at_Eboli"}],"explanation74":"Levi’s account describes confinement and peasant life in southern Italy."},{"id":"REVISION82-4116","nodeId":"REVISION82-4116","anchor":"ALPHA-B003-Q211","subject":"Which people are associated with the necropolises of Cerveteri and Tarquinia?","value":"Etruscans","group":"Ancient Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Etruscan_civilization"}],"explanation74":"Both cities preserve major Etruscan burial complexes."},{"id":"REVISION82-4117","nodeId":"REVISION82-4117","anchor":"ALPHA-B001-Q057","subject":"Magna Graecia refers chiefly to Greek settlements in which area?","value":"Southern Italy","group":"Ancient Italy","major":"History & Politics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Magna_Graecia"}],"explanation74":"The term describes the Greek colonial world of southern Italy."},{"id":"REVISION82-4118","nodeId":"REVISION82-4118","anchor":"ALPHA-B007-Q507","subject":"Which Carthaginian commander crossed the Alps during the Second Punic War?","value":"Hannibal","group":"Ancient Italy","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Hannibal"}],"explanation74":"Hannibal brought his army into Italy by crossing the Alps."},{"id":"REVISION82-4119","nodeId":"REVISION82-4119","anchor":"ALPHA-B008-Q684","subject":"Which brothers are associated with attempts at agrarian reform in the Roman Republic?","value":"Tiberius and Gaius Gracchus","group":"Ancient Italy","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gracchi"}],"explanation74":"The Gracchi sought reforms including redistribution of public land."},{"id":"REVISION82-4120","nodeId":"REVISION82-4120","anchor":"ALPHA-B007-Q477","subject":"Crossing which river symbolised Caesar’s armed challenge to the Senate?","value":"Rubicon","group":"Ancient Italy","major":"History & Politics","era":"19th century","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Crossing_the_Rubicon"}],"explanation74":"Caesar crossed the boundary with his army, initiating civil war."},{"id":"REVISION82-4121","nodeId":"REVISION82-4121","anchor":"ALPHA-B002-Q121","subject":"The term “Pax Romana” chiefly describes what?","value":"A period of relative imperial stability","group":"Ancient Italy","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pax_Romana"}],"explanation74":"The phrase refers to a long period of relative peace within the Roman imperial system."},{"id":"REVISION82-4122","nodeId":"REVISION82-4122","anchor":"ALPHA-B008-Q762","subject":"Diocletian’s tetrarchy divided imperial rule among how many rulers?","value":"Four","group":"Ancient Italy","major":"History & Politics","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tetrarchy"}],"explanation74":"Two senior Augusti and two junior Caesars formed the tetrarchic system."},{"id":"REVISION82-4123","nodeId":"REVISION82-4123","anchor":"ALPHA-B002-Q126","subject":"Which emperor made Ravenna the capital of the Western Roman Empire?","value":"Honorius","group":"Ancient Italy","major":"History & Politics","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Honorius_(emperor)"}],"explanation74":"Honorius transferred the western imperial residence from Milan to Ravenna."},{"id":"REVISION82-4124","nodeId":"REVISION82-4124","anchor":"ALPHA-B003-Q211","subject":"The Ostrogothic kingdom in Italy is most closely associated with which ruler?","value":"Theodoric","group":"Ancient Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Theodoric_the_Great"}],"explanation74":"Theodoric ruled Italy from Ravenna after defeating Odoacer."},{"id":"REVISION82-4125","nodeId":"REVISION82-4125","anchor":"ALPHA-B003-Q211","subject":"Justinian’s reconquest of Italy chiefly opposed which kingdom?","value":"Ostrogothic kingdom","group":"Ancient Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gothic_War_(535%E2%80%93554)"}],"explanation74":"The Gothic War sought to restore Byzantine control of Ostrogothic Italy."},{"id":"REVISION82-4126","nodeId":"REVISION82-4126","anchor":"ALPHA-B003-Q211","subject":"Which city served as the capital of the Lombard kingdom in Italy?","value":"Pavia","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Kingdom_of_the_Lombards"}],"explanation74":"Pavia became the principal royal seat of the Lombards."},{"id":"REVISION82-4127","nodeId":"REVISION82-4127","anchor":"ALPHA-B003-Q211","subject":"Which Frankish ruler defeated the Lombard kingdom and took its royal title?","value":"Charlemagne","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Charlemagne"}],"explanation74":"Charlemagne conquered the Lombard kingdom and assumed its kingship."},{"id":"REVISION82-4128","nodeId":"REVISION82-4128","anchor":"ALPHA-B007-Q477","subject":"The Donation of Pepin contributed to the territorial basis of which state?","value":"Papal States","group":"Medieval Italy","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Donation_of_Pepin"}],"explanation74":"Pepin’s grants helped establish the pope’s temporal rule in central Italy."},{"id":"REVISION82-4129","nodeId":"REVISION82-4129","anchor":"ALPHA-B007-Q492","subject":"Which alliance opposed Frederick Barbarossa at Legnano?","value":"Lombard League","group":"Medieval Italy","major":"History & Politics","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Legnano"}],"explanation74":"The Lombard League united northern Italian communes against imperial power."},{"id":"REVISION82-4130","nodeId":"REVISION82-4130","anchor":"ALPHA-B001-Q057","subject":"Guelphs and Ghibellines were broadly associated with support for whom, respectively?","value":"Pope and emperor","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"matching","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Guelphs_and_Ghibellines"}],"explanation74":"The labels broadly distinguished papal and imperial alignments, though local conflicts complicated them."},{"id":"REVISION82-4131","nodeId":"REVISION82-4131","anchor":"ALPHA-B003-Q211","subject":"Which dynasty ruled the Norman Kingdom of Sicily before the Hohenstaufen?","value":"Hauteville","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Hauteville_family"}],"explanation74":"The Hautevilles established the Norman kingdom in southern Italy and Sicily."},{"id":"REVISION82-4132","nodeId":"REVISION82-4132","anchor":"ALPHA-B002-Q103","subject":"The Sicilian Vespers uprising was directed against which ruling power?","value":"Angevin rule","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sicilian_Vespers"}],"explanation74":"The revolt challenged Charles of Anjou’s government on the island."},{"id":"REVISION82-4133","nodeId":"REVISION82-4133","anchor":"ALPHA-B007-Q507","subject":"Which republic defeated Pisa at the naval Battle of Meloria?","value":"Genoa","group":"Medieval Italy","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Meloria"}],"explanation74":"Genoa’s victory sharply weakened Pisa’s maritime position."},{"id":"REVISION82-4134","nodeId":"REVISION82-4134","anchor":"ALPHA-B003-Q237","subject":"Which maritime republic was governed by a doge and a patrician Great Council?","value":"Venice","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Republic_of_Venice"}],"explanation74":"Venice’s institutions combined the doge with councils dominated by its hereditary patriciate."},{"id":"REVISION82-4135","nodeId":"REVISION82-4135","anchor":"ALPHA-B001-Q057","subject":"What was a condottiero?","value":"A contracted military commander","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Condottiero"}],"explanation74":"Condottieri led military forces hired under contracts by Italian states."},{"id":"REVISION82-4136","nodeId":"REVISION82-4136","anchor":"ALPHA-B003-Q211","subject":"Which family preceded the Sforza as dukes of Milan?","value":"Visconti","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Duchy_of_Milan"}],"explanation74":"The Visconti established the duchy before the Sforza succession."},{"id":"REVISION82-4137","nodeId":"REVISION82-4137","anchor":"ALPHA-B002-Q122","subject":"Savonarola’s political and religious activity is most closely associated with which city?","value":"Florence","group":"Medieval Italy","major":"History & Politics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Girolamo_Savonarola"}],"explanation74":"Savonarola became influential in Florence after the Medici expulsion."},{"id":"REVISION82-4138","nodeId":"REVISION82-4138","anchor":"ALPHA-B002-Q121","subject":"Which French king’s invasion of Italy in 1494 opened the Italian Wars?","value":"Charles VIII","group":"Italian Wars","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italian_War_of_1494%E2%80%931495"}],"explanation74":"Charles VIII’s expedition to claim Naples destabilised the Italian state system."},{"id":"REVISION82-4139","nodeId":"REVISION82-4139","anchor":"ALPHA-B001-Q022","subject":"The sack of Rome in 1527 was carried out by forces serving which emperor?","value":"Charles V","group":"Italian Wars","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sack_of_Rome_(1527)"}],"explanation74":"Mutinous imperial troops sacked the city during the War of the League of Cognac."},{"id":"REVISION82-4140","nodeId":"REVISION82-4140","anchor":"ALPHA-B008-Q769","subject":"The Peace of Cateau-Cambrésis consolidated the predominance of which power in much of Italy?","value":"Spain","group":"Italian Wars","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Peace_of_Cateau-Cambr%C3%A9sis"}],"explanation74":"The settlement ended the main Italian Wars and confirmed Spanish ascendancy."},{"id":"REVISION82-4141","nodeId":"REVISION82-4141","anchor":"ALPHA-B007-Q493","subject":"Which naval battle pitted the Holy League against the Ottoman fleet in 1571?","value":"Lepanto","group":"Early modern","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Lepanto"}],"explanation74":"The Holy League’s victory at Lepanto was a major Mediterranean naval confrontation."},{"id":"REVISION82-4142","nodeId":"REVISION82-4142","anchor":"ALPHA-B008-Q684","subject":"Which order founded by Ignatius of Loyola became influential in Catholic education?","value":"Jesuits","group":"Early modern","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Society_of_Jesus"}],"explanation74":"The Society of Jesus developed an extensive educational network."},{"id":"REVISION82-4143","nodeId":"REVISION82-4143","anchor":"ALPHA-B001-Q022","subject":"Which Italian thinker wrote The City of the Sun?","value":"Tommaso Campanella","group":"Early modern","major":"History & Politics","era":"Early modern","relation":"creator work","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_City_of_the_Sun"}],"explanation74":"Campanella described an ideal communal society in his philosophical dialogue."},{"id":"REVISION82-4144","nodeId":"REVISION82-4144","anchor":"ALPHA-B002-Q126","subject":"Vico’s principle “verum factum” links knowledge most directly to what?","value":"What humans have made","group":"Early modern","major":"History & Politics","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giambattista_Vico"}],"explanation74":"Vico connected knowledge with human making, especially the historical civil world."},{"id":"REVISION82-4145","nodeId":"REVISION82-4145","anchor":"ALPHA-B001-Q022","subject":"Cesare Beccaria’s On Crimes and Punishments notably criticised which practices?","value":"Torture and capital punishment","group":"Enlightenment","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/On_Crimes_and_Punishments"}],"explanation74":"Beccaria argued for rational, proportionate punishment and against torture and the death penalty."},{"id":"REVISION82-4146","nodeId":"REVISION82-4146","anchor":"ALPHA-B003-Q211","subject":"The periodical Il Caffè was associated with which Italian Enlightenment circle?","value":"The Verri brothers","group":"Enlightenment","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Il_Caff%C3%A8"}],"explanation74":"Pietro and Alessandro Verri helped animate Milanese Enlightenment debate."},{"id":"REVISION82-4147","nodeId":"REVISION82-4147","anchor":"ALPHA-B003-Q223","subject":"Which Italian state abolished the death penalty in 1786 under Peter Leopold?","value":"Grand Duchy of Tuscany","group":"Enlightenment","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Grand_Duchy_of_Tuscany"}],"explanation74":"The Leopoldine reform made Tuscany a landmark in penal abolition."},{"id":"REVISION82-4148","nodeId":"REVISION82-4148","anchor":"ALPHA-B007-Q482","subject":"The Carbonari were chiefly what kind of organisation?","value":"A secret revolutionary society","group":"Risorgimento","major":"History & Politics","era":"19th century","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carbonari"}],"explanation74":"Carbonari networks participated in early nineteenth-century liberal and national conspiracies."},{"id":"REVISION82-4149","nodeId":"REVISION82-4149","anchor":"ALPHA-B003-Q211","subject":"Which city was the capital of the Kingdom of Sardinia immediately before Italian unification?","value":"Turin","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Kingdom_of_Sardinia"}],"explanation74":"The Savoy state was governed from Turin, which became Italy’s first capital."},{"id":"REVISION82-4150","nodeId":"REVISION82-4150","anchor":"ALPHA-B002-Q148","subject":"Cavour’s participation in the Crimean War chiefly aimed to obtain what?","value":"International diplomatic influence","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Camillo_Benso%2C_Count_of_Cavour"}],"explanation74":"Participation allowed Piedmont-Sardinia to raise the Italian question at international negotiations."},{"id":"REVISION82-4151","nodeId":"REVISION82-4151","anchor":"ALPHA-B001-Q023","subject":"At Plombières, Cavour negotiated with which ruler?","value":"Napoleon III","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Plombi%C3%A8res_Agreement"}],"explanation74":"The meeting prepared Franco-Piedmontese cooperation against Austria."},{"id":"REVISION82-4152","nodeId":"REVISION82-4152","anchor":"ALPHA-B007-Q482","subject":"Which battle inspired Henry Dunant’s efforts that led toward the Red Cross?","value":"Solferino","group":"Risorgimento","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Solferino"}],"explanation74":"Dunant’s experience of the wounded at Solferino motivated his humanitarian proposals."},{"id":"REVISION82-4153","nodeId":"REVISION82-4153","anchor":"ALPHA-B005-Q409","subject":"Garibaldi’s Expedition of the Thousand first landed at which Sicilian port?","value":"Marsala","group":"Risorgimento","major":"History & Politics","era":"Renaissance","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Expedition_of_the_Thousand"}],"explanation74":"The expedition landed at Marsala before campaigning across Sicily."},{"id":"REVISION82-4154","nodeId":"REVISION82-4154","anchor":"ALPHA-B003-Q211","subject":"Garibaldi’s southern campaign overthrew which kingdom?","value":"Kingdom of the Two Sicilies","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Expedition_of_the_Thousand"}],"explanation74":"The expedition led to the fall of the Bourbon kingdom in southern Italy."},{"id":"REVISION82-4155","nodeId":"REVISION82-4155","anchor":"ALPHA-B001-Q040","subject":"Which ruler met Garibaldi near Teano?","value":"Victor Emmanuel II","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Victor_Emmanuel_II"}],"explanation74":"Garibaldi acknowledged Victor Emmanuel’s authority after the southern campaign."},{"id":"REVISION82-4156","nodeId":"REVISION82-4156","anchor":"ALPHA-B006-Q633","subject":"Which city was Italy’s capital between Turin and Rome?","value":"Florence","group":"Risorgimento","major":"History & Politics","era":"19th century","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Capital_of_Italy"}],"explanation74":"Florence served as the capital from 1865 until the transfer to Rome."},{"id":"REVISION82-4157","nodeId":"REVISION82-4157","anchor":"ALPHA-B002-Q109","subject":"The Third Italian War of Independence resulted in Italy acquiring which territory?","value":"Venetia","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Third_Italian_War_of_Independence"}],"explanation74":"Italy gained Venetia after the war involving Prussia and Austria."},{"id":"REVISION82-4158","nodeId":"REVISION82-4158","anchor":"ALPHA-B001-Q040","subject":"What did Italian irredentism seek?","value":"Union with Italian-claimed territories","group":"Risorgimento","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italian_irredentism"}],"explanation74":"Irredentists sought territories they regarded as Italian but outside the state."},{"id":"REVISION82-4159","nodeId":"REVISION82-4159","anchor":"ALPHA-B007-Q477","subject":"The Italian army’s defeat at Adwa halted an attempt to conquer which country?","value":"Ethiopia","group":"Modern Italy","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Adwa"}],"explanation74":"Ethiopian forces defeated the Italian invasion at Adwa."},{"id":"REVISION82-4160","nodeId":"REVISION82-4160","anchor":"ALPHA-B007-Q493","subject":"Which emperor led Ethiopia during the Battle of Adwa?","value":"Menelik II","group":"Modern Italy","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Menelik_II"}],"explanation74":"Menelik II mobilised Ethiopian resistance to the Italian invasion."},{"id":"REVISION82-4161","nodeId":"REVISION82-4161","anchor":"ALPHA-B002-Q126","subject":"Italy seized Libya from which empire during the war of 1911–12?","value":"Ottoman Empire","group":"Modern Italy","major":"History & Politics","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italo-Turkish_War"}],"explanation74":"The Italo-Turkish War transferred Ottoman provinces in North Africa to Italian control."},{"id":"REVISION82-4162","nodeId":"REVISION82-4162","anchor":"ALPHA-B007-Q507","subject":"The Triple Alliance initially linked Italy with Germany and which other power?","value":"Austria-Hungary","group":"Modern Italy","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Triple_Alliance_(1882)"}],"explanation74":"The alliance joined Italy to Germany and Austria-Hungary in 1882."},{"id":"REVISION82-4163","nodeId":"REVISION82-4163","anchor":"ALPHA-B007-Q507","subject":"The secret Treaty of London in 1915 concerned Italy joining which side?","value":"The Entente","group":"Modern Italy","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_London_(1915)"}],"explanation74":"The agreement offered territorial gains in exchange for joining the Entente war effort."},{"id":"REVISION82-4164","nodeId":"REVISION82-4164","anchor":"ALPHA-B001-Q022","subject":"The defeat at Caporetto occurred on which front?","value":"Italian Front","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Caporetto"}],"explanation74":"The breakthrough forced a major Italian retreat to the Piave."},{"id":"REVISION82-4165","nodeId":"REVISION82-4165","anchor":"ALPHA-B001-Q057","subject":"Which river became central to Italy’s defensive line after Caporetto?","value":"Piave","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Caporetto"}],"explanation74":"The Italian army stabilised its main defensive line along the Piave."},{"id":"REVISION82-4166","nodeId":"REVISION82-4166","anchor":"ALPHA-B001-Q022","subject":"What does “Biennio Rosso” refer to in Italian history?","value":"Two years of social unrest","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Biennio_Rosso"}],"explanation74":"The phrase denotes strikes, factory occupations and political conflict in 1919–20."},{"id":"REVISION82-4167","nodeId":"REVISION82-4167","anchor":"ALPHA-B001-Q021","subject":"Which politician’s murder in 1924 precipitated a major crisis for Mussolini’s government?","value":"Giacomo Matteotti","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giacomo_Matteotti"}],"explanation74":"Matteotti was murdered after denouncing Fascist electoral violence and fraud."},{"id":"REVISION82-4168","nodeId":"REVISION82-4168","anchor":"ALPHA-B001-Q021","subject":"The Aventine Secession was chiefly a protest by whom?","value":"Opposition deputies","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aventine_Secession_(20th_century)"}],"explanation74":"Opposition parliamentarians withdrew after Matteotti’s murder."},{"id":"REVISION82-4169","nodeId":"REVISION82-4169","anchor":"ALPHA-B002-Q103","subject":"The Lateran Pacts settled the dispute commonly known by which name?","value":"The Roman Question","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lateran_Treaty"}],"explanation74":"The agreements resolved the conflict between the Italian state and papacy after unification."},{"id":"REVISION82-4170","nodeId":"REVISION82-4170","anchor":"ALPHA-B002-Q121","subject":"What sovereign state was recognised through the Lateran settlement?","value":"Vatican City","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lateran_Treaty"}],"explanation74":"The settlement established Vatican City as an independent sovereign entity."},{"id":"REVISION82-4171","nodeId":"REVISION82-4171","anchor":"ALPHA-B001-Q022","subject":"Antonio Gramsci’s Prison Notebooks were written during imprisonment under which regime?","value":"Italian Fascism","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Prison_Notebooks"}],"explanation74":"The notebooks developed Gramsci’s thought during Fascist imprisonment."},{"id":"REVISION82-4172","nodeId":"REVISION82-4172","anchor":"ALPHA-B008-Q769","subject":"Which city was heavily bombed in 1937 and became the subject of Picasso’s painting?","value":"Guernica","group":"Modern Italy","major":"History & Politics","era":"19th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bombing_of_Guernica"}],"explanation74":"The bombing during the Spanish Civil War inspired Picasso’s Guernica."},{"id":"REVISION82-4173","nodeId":"REVISION82-4173","anchor":"ALPHA-B001-Q022","subject":"What was the Italian Social Republic?","value":"A Fascist state under German protection","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italian_Social_Republic"}],"explanation74":"The RSI operated in German-controlled northern and central Italy after 1943."},{"id":"REVISION82-4174","nodeId":"REVISION82-4174","anchor":"ALPHA-B001-Q022","subject":"Which organisation coordinated major strands of the Italian Resistance?","value":"National Liberation Committee","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/National_Liberation_Committee"}],"explanation74":"The CLN brought together anti-Fascist political forces."},{"id":"REVISION82-4175","nodeId":"REVISION82-4175","anchor":"ALPHA-B001-Q022","subject":"Which issue was decided by Italy’s referendum of 2 June 1946?","value":"Monarchy or republic","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/1946_Italian_institutional_referendum"}],"explanation74":"The referendum ended the monarchy and established a republican form of state."},{"id":"REVISION82-4176","nodeId":"REVISION82-4176","anchor":"ALPHA-B003-Q211","subject":"Which king left Italy following the 1946 referendum?","value":"Umberto II","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Umberto_II_of_Italy"}],"explanation74":"Umberto II’s short reign ended after the republican vote."},{"id":"REVISION82-4177","nodeId":"REVISION82-4177","anchor":"ALPHA-B001-Q022","subject":"Which Italian statesman was a founding figure of post-war European integration?","value":"Alcide De Gasperi","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Alcide_De_Gasperi"}],"explanation74":"De Gasperi supported the institutions that launched European integration."},{"id":"REVISION82-4178","nodeId":"REVISION82-4178","anchor":"ALPHA-B001-Q057","subject":"Which manifesto associated with Altiero Spinelli argued for a federal Europe?","value":"Ventotene Manifesto","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ventotene_Manifesto"}],"explanation74":"The Ventotene text developed a federalist response to war and nationalism."},{"id":"REVISION82-4179","nodeId":"REVISION82-4179","anchor":"ALPHA-B001-Q057","subject":"Italy’s “economic miracle” principally refers to what?","value":"Rapid post-war industrial growth","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italian_economic_miracle"}],"explanation74":"The term describes accelerated industrialisation and rising consumption after the Second World War."},{"id":"REVISION82-4180","nodeId":"REVISION82-4180","anchor":"ALPHA-B008-Q763","subject":"Which pair of magistrates became symbols of the anti-Mafia struggle after their murders in 1992?","value":"Falcone and Borsellino","group":"Modern Italy","major":"History & Politics","era":"Early modern","relation":"matching","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Paolo_Borsellino"}],"explanation74":"Giovanni Falcone and Paolo Borsellino were killed in separate Mafia bombings."},{"id":"REVISION82-4181","nodeId":"REVISION82-4181","anchor":"ALPHA-B002-Q103","subject":"The Zollverein was primarily what kind of arrangement?","value":"A customs union","group":"Europe","major":"History & Politics","era":"Early modern","relation":"term function","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Zollverein"}],"explanation74":"The German customs union encouraged economic integration among participating states."},{"id":"REVISION82-4182","nodeId":"REVISION82-4182","anchor":"ALPHA-B002-Q126","subject":"The Frankfurt Parliament of 1848 chiefly attempted to create what?","value":"A unified constitutional Germany","group":"Europe","major":"History & Politics","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Frankfurt_Parliament"}],"explanation74":"The assembly debated a constitution and political unification of Germany."},{"id":"REVISION82-4183","nodeId":"REVISION82-4183","anchor":"ALPHA-B001-Q057","subject":"The Dreyfus affair centred on a disputed conviction for what?","value":"Treason","group":"Europe","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Dreyfus_affair"}],"explanation74":"Alfred Dreyfus was wrongly convicted of passing military secrets to Germany."},{"id":"REVISION82-4184","nodeId":"REVISION82-4184","anchor":"ALPHA-B008-Q684","subject":"Solidarity began as a trade-union movement in which country?","value":"Poland","group":"Europe","major":"History & Politics","era":"19th century","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Solidarity_(Polish_trade_union)"}],"explanation74":"Solidarność emerged from Polish labour activism and became a major opposition movement."},{"id":"REVISION82-4185","nodeId":"REVISION82-4185","anchor":"ALPHA-B002-Q122","subject":"Which leader is associated with perestroika and glasnost?","value":"Mikhail Gorbachev","group":"Europe","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mikhail_Gorbachev"}],"explanation74":"Gorbachev’s programmes aimed at restructuring and greater openness in the Soviet Union."},{"id":"REVISION82-4186","nodeId":"REVISION82-4186","anchor":"ALPHA-B002-Q089","subject":"Which Italian university awarded Renzo Piano his architecture degree?","value":"Politecnico di Milano","group":"Italian science","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Renzo_Piano"}],"explanation74":"Piano graduated in architecture from the Politecnico di Milano in 1964."},{"id":"REVISION82-4187","nodeId":"REVISION82-4187","anchor":"ALPHA-B007-Q481","subject":"Which university trained the engineer Pier Luigi Nervi?","value":"University of Bologna","group":"Italian science","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pier_Luigi_Nervi"}],"explanation74":"Nervi graduated in civil engineering from Bologna in 1913."},{"id":"REVISION82-4188","nodeId":"REVISION82-4188","anchor":"ALPHA-B005-Q441","subject":"Lina Bo Bardi studied architecture in which city before moving to Brazil?","value":"Rome","group":"Italian science","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lina_Bo_Bardi"}],"explanation74":"Bo Bardi graduated from the University of Rome’s architecture school."},{"id":"REVISION82-4189","nodeId":"REVISION82-4189","anchor":"ALPHA-B005-Q441","subject":"Which university awarded Aldo Rossi his architecture degree?","value":"Politecnico di Milano","group":"Italian science","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aldo_Rossi"}],"explanation74":"Rossi studied architecture at the Milan Polytechnic."},{"id":"REVISION82-4190","nodeId":"REVISION82-4190","anchor":"ALPHA-B002-Q089","subject":"Gae Aulenti obtained her architecture degree from which institution?","value":"Politecnico di Milano","group":"Italian science","major":"Architecture","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://www.auic.polimi.it/en/la-scuola/projects/exhibition-space-guido-nardi/gae-aulenti-city-open-artwork"}],"explanation74":"Aulenti graduated from the Politecnico di Milano in 1953."},{"id":"REVISION82-4191","nodeId":"REVISION82-4191","anchor":"ALPHA-B003-Q202","subject":"Which Italian fashion designer trained as an architect at Politecnico di Milano?","value":"Gianfranco Ferré","group":"Italian science","major":"Design","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gianfranco_Ferr%C3%A9"}],"explanation74":"Ferré’s architectural training became a frequent reference in accounts of his design approach."},{"id":"REVISION82-4192","nodeId":"REVISION82-4192","anchor":"ALPHA-B002-Q105","subject":"Which physicist studied at the Scuola Normale Superiore in Pisa before developing nuclear research in Rome?","value":"Enrico Fermi","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Enrico_Fermi"}],"explanation74":"Fermi trained in Pisa before leading the Roman group known as the Via Panisperna boys."},{"id":"REVISION82-4193","nodeId":"REVISION82-4193","anchor":"ALPHA-B002-Q104","subject":"Which discovery is associated with Emilio Segrè and Owen Chamberlain?","value":"The antiproton","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Emilio_Segr%C3%A8"}],"explanation74":"Their work established the antiproton experimentally."},{"id":"REVISION82-4194","nodeId":"REVISION82-4194","anchor":"ALPHA-B002-Q105","subject":"Which element was first identified by Carlo Perrier and Emilio Segrè?","value":"Technetium","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Technetium"}],"explanation74":"Perrier and Segrè identified technetium in irradiated material."},{"id":"REVISION82-4195","nodeId":"REVISION82-4195","anchor":"ALPHA-B002-Q104","subject":"Which experimental device is associated with Evangelista Torricelli?","value":"Mercury barometer","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Evangelista_Torricelli"}],"explanation74":"Torricelli used a mercury column to investigate atmospheric pressure."},{"id":"REVISION82-4196","nodeId":"REVISION82-4196","anchor":"ALPHA-B005-Q429","subject":"Avogadro’s law compares equal volumes of gases at equal temperature and pressure in terms of what?","value":"Number of molecules","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Avogadro%27s_law"}],"explanation74":"Under those conditions, equal gas volumes contain equal numbers of molecules."},{"id":"REVISION82-4197","nodeId":"REVISION82-4197","anchor":"ALPHA-B004-Q283","subject":"Which scientist helped clarify atomic weights using Avogadro’s ideas?","value":"Stanislao Cannizzaro","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Stanislao_Cannizzaro"}],"explanation74":"Cannizzaro’s work helped distinguish atomic and molecular weights."},{"id":"REVISION82-4198","nodeId":"REVISION82-4198","anchor":"ALPHA-B002-Q104","subject":"Camillo Golgi is associated with a staining method used especially to study what?","value":"Nervous tissue","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Camillo_Golgi"}],"explanation74":"Golgi’s silver staining made detailed neuronal structures visible."},{"id":"REVISION82-4199","nodeId":"REVISION82-4199","anchor":"ALPHA-B004-Q299","subject":"Which field is most closely associated with Giulio Natta’s Nobel-winning work?","value":"Polymer chemistry","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giulio_Natta"}],"explanation74":"Natta developed stereospecific polymerisation and worked on isotactic polymers."},{"id":"REVISION82-4200","nodeId":"REVISION82-4200","anchor":"ALPHA-B007-Q512","subject":"Which Italian scientist shared the Nobel Prize for discovering W and Z bosons?","value":"Carlo Rubbia","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carlo_Rubbia"}],"explanation74":"Rubbia and Simon van der Meer were recognised for the work leading to the discoveries."},{"id":"REVISION82-4201","nodeId":"REVISION82-4201","anchor":"ALPHA-B001-Q015","subject":"Lazzaro Spallanzani’s boiled-broth experiments challenged which idea?","value":"Spontaneous generation","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lazzaro_Spallanzani"}],"explanation74":"His experiments tested whether microorganisms appeared without contamination from existing life."},{"id":"REVISION82-4202","nodeId":"REVISION82-4202","anchor":"ALPHA-B002-Q104","subject":"Francesco Redi’s experiments with meat and flies challenged what?","value":"Spontaneous generation","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Francesco_Redi"}],"explanation74":"Redi showed that maggots arose from flies rather than spontaneously from meat."},{"id":"REVISION82-4203","nodeId":"REVISION82-4203","anchor":"ALPHA-B002-Q104","subject":"Which anatomical structure is associated with Marcello Malpighi’s observations connecting arteries and veins?","value":"Capillaries","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Marcello_Malpighi"}],"explanation74":"Microscopic observation of capillaries helped complete the account of blood circulation."},{"id":"REVISION82-4204","nodeId":"REVISION82-4204","anchor":"ALPHA-B003-Q224","subject":"Which Italian astronomer’s observations of Mars popularised the term “canali”?","value":"Giovanni Schiaparelli","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giovanni_Schiaparelli"}],"explanation74":"Schiaparelli’s canali were later misleadingly rendered as artificial canals in some accounts."},{"id":"REVISION82-4205","nodeId":"REVISION82-4205","anchor":"ALPHA-B002-Q104","subject":"Giuseppe Piazzi discovered which body, now classified as a dwarf planet?","value":"Ceres","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giuseppe_Piazzi"}],"explanation74":"Piazzi discovered Ceres from Palermo in 1801."},{"id":"REVISION82-4206","nodeId":"REVISION82-4206","anchor":"ALPHA-B002-Q100","subject":"Which astronomer is associated with the division in Saturn’s rings bearing his name?","value":"Giovanni Domenico Cassini","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giovanni_Domenico_Cassini"}],"explanation74":"Cassini identified the major gap now called the Cassini Division."},{"id":"REVISION82-4207","nodeId":"REVISION82-4207","anchor":"ALPHA-B002-Q104","subject":"Galileo’s observation of Jupiter’s moons directly showed that what was possible?","value":"Bodies orbiting something other than Earth","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Galilean_moons"}],"explanation74":"The moons provided a visible system centred on Jupiter rather than Earth."},{"id":"REVISION82-4208","nodeId":"REVISION82-4208","anchor":"ALPHA-B005-Q395","subject":"Which Galileo book presents a dialogue comparing the Ptolemaic and Copernican systems?","value":"Dialogue Concerning the Two Chief World Systems","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Dialogue_Concerning_the_Two_Chief_World_Systems"}],"explanation74":"The Dialogue compares the two principal cosmological systems through three speakers."},{"id":"REVISION82-4209","nodeId":"REVISION82-4209","anchor":"ALPHA-B004-Q283","subject":"Galileo’s Sidereus Nuncius chiefly reports observations made using what?","value":"A telescope","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sidereus_Nuncius"}],"explanation74":"The Starry Messenger reported telescopic observations including lunar features and Jupiter’s moons."},{"id":"REVISION82-4210","nodeId":"REVISION82-4210","anchor":"ALPHA-B002-Q104","subject":"Which mathematical sequence is introduced through a rabbit-population problem in Fibonacci’s Liber Abaci?","value":"Fibonacci sequence","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Liber_Abaci"}],"explanation74":"The rabbit problem gives the famous additive sequence."},{"id":"REVISION82-4211","nodeId":"REVISION82-4211","anchor":"ALPHA-B002-Q100","subject":"Luca Pacioli’s Summa is important in the history of which commercial practice?","value":"Double-entry bookkeeping","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Luca_Pacioli"}],"explanation74":"The Summa contains an influential printed account of double-entry bookkeeping."},{"id":"REVISION82-4212","nodeId":"REVISION82-4212","anchor":"ALPHA-B002-Q114","subject":"Who supplied polyhedral illustrations for Pacioli’s De divina proportione?","value":"Leonardo da Vinci","group":"Italian science","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Divina_proportione"}],"explanation74":"Leonardo’s drawings helped explain the solids discussed in Pacioli’s treatise."},{"id":"REVISION82-4213","nodeId":"REVISION82-4213","anchor":"ALPHA-B003-Q224","subject":"Which Italian mathematician published the algebraic treatise Ars Magna?","value":"Gerolamo Cardano","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gerolamo_Cardano"}],"explanation74":"Cardano’s Ars Magna was a major Renaissance work on algebra."},{"id":"REVISION82-4214","nodeId":"REVISION82-4214","anchor":"ALPHA-B002-Q100","subject":"Rafael Bombelli’s algebra is especially significant for its treatment of what?","value":"Complex numbers","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rafael_Bombelli"}],"explanation74":"Bombelli developed systematic rules for working with quantities involving square roots of negative numbers."},{"id":"REVISION82-4215","nodeId":"REVISION82-4215","anchor":"ALPHA-B002-Q100","subject":"Maria Montessori’s educational method stresses which approach?","value":"Self-directed activity in prepared settings","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Montessori_education"}],"explanation74":"Montessori combined carefully prepared materials with guided independence."},{"id":"REVISION82-4216","nodeId":"REVISION82-4216","anchor":"ALPHA-B002-Q104","subject":"Which Italian physicist independently developed the rotating magnetic field concept associated with induction motors?","value":"Galileo Ferraris","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Galileo_Ferraris"}],"explanation74":"Ferraris’s experiments demonstrated rotating magnetic fields using alternating currents."},{"id":"REVISION82-4217","nodeId":"REVISION82-4217","anchor":"ALPHA-B002-Q102","subject":"Antonio Pacinotti is associated with an early improvement to which technology?","value":"Electrical machines","group":"Italian science","major":"Science & Tech","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Antonio_Pacinotti"}],"explanation74":"Pacinotti developed a ring armature important in the history of generators and motors."},{"id":"REVISION82-4218","nodeId":"REVISION82-4218","anchor":"ALPHA-B001-Q014","subject":"Which river flows through Florence and Pisa?","value":"Arno","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arno"}],"explanation74":"The Arno crosses Tuscany and reaches the sea near Pisa."},{"id":"REVISION82-4219","nodeId":"REVISION82-4219","anchor":"ALPHA-B001-Q014","subject":"Which river flows through Rome?","value":"Tiber","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tiber"}],"explanation74":"Rome developed along the Tiber."},{"id":"REVISION82-4220","nodeId":"REVISION82-4220","anchor":"ALPHA-B005-Q373","subject":"Which mountain chain runs along most of the Italian peninsula?","value":"Apennines","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Apennine_Mountains"}],"explanation74":"The Apennines form the peninsula’s principal longitudinal mountain system."},{"id":"REVISION82-4221","nodeId":"REVISION82-4221","anchor":"ALPHA-B001-Q034","subject":"The Strait of Messina separates Sicily from which region?","value":"Calabria","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Strait_of_Messina"}],"explanation74":"The strait lies between northeastern Sicily and the tip of Calabria."},{"id":"REVISION82-4222","nodeId":"REVISION82-4222","anchor":"ALPHA-B001-Q014","subject":"Which sea lies along much of Italy’s eastern coast?","value":"Adriatic","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Adriatic_Sea"}],"explanation74":"The Adriatic separates the Italian peninsula from the Balkans."},{"id":"REVISION82-4223","nodeId":"REVISION82-4223","anchor":"ALPHA-B001-Q014","subject":"The Dolomites take their name from which material?","value":"Dolomite rock","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Dolomites"}],"explanation74":"Dolomite, a carbonate mineral and rock, gives the range its name."},{"id":"REVISION82-4224","nodeId":"REVISION82-4224","anchor":"ALPHA-B001-Q034","subject":"Which volcano is located on the eastern side of Sicily?","value":"Etna","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mount_Etna"}],"explanation74":"Etna dominates eastern Sicily near Catania."},{"id":"REVISION82-4225","nodeId":"REVISION82-4225","anchor":"ALPHA-B007-Q513","subject":"Which Italian city is particularly associated with the system of canals called Navigli?","value":"Milan","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Navigli"}],"explanation74":"Milan’s Navigli historically supported transport, irrigation and trade."},{"id":"REVISION82-4226","nodeId":"REVISION82-4226","anchor":"ALPHA-B001-Q034","subject":"Which city is associated with the Sassi, districts of rock-cut dwellings?","value":"Matera","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sassi_di_Matera"}],"explanation74":"The Sassi are historic rock-cut settlements in Matera, Basilicata."},{"id":"REVISION82-4227","nodeId":"REVISION82-4227","anchor":"ALPHA-B001-Q034","subject":"Which region contains the conical-roofed trulli of Alberobello?","value":"Apulia","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Trullo"}],"explanation74":"The dry-stone trulli are characteristic of parts of Apulia."},{"id":"REVISION82-4228","nodeId":"REVISION82-4228","anchor":"ALPHA-B004-Q338","subject":"Which Italian region contains the Val d’Orcia cultural landscape?","value":"Tuscany","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Val_d%27Orcia"}],"explanation74":"The Val d’Orcia lies south of Siena in Tuscany."},{"id":"REVISION82-4229","nodeId":"REVISION82-4229","anchor":"ALPHA-B001-Q085","subject":"Which lagoon city is historically associated with mosaics, glassmaking at Murano and lace at Burano?","value":"Venice","group":"Geography","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Venetian_Lagoon"}],"explanation74":"Murano and Burano are islands in the Venetian lagoon."},{"id":"REVISION82-4230","nodeId":"REVISION82-4230","anchor":"ALPHA-B004-Q321","subject":"Which Italian city gave its name to the term “faience” through its ceramic tradition?","value":"Faenza","group":"Geography","major":"Art History","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Faience"}],"explanation74":"The name faience derives from the French form of Faenza."},{"id":"REVISION82-4231","nodeId":"REVISION82-4231","anchor":"ALPHA-B008-Q721","subject":"Carrara is especially associated with quarrying which stone?","value":"Marble","group":"Geography","major":"Art History","era":"Late 20th century","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carrara_marble"}],"explanation74":"Carrara’s marble has been used in sculpture and architecture since antiquity."},{"id":"REVISION82-4232","nodeId":"REVISION82-4232","anchor":"ALPHA-B005-Q415","subject":"Which UN organisation has its headquarters in Rome and focuses on food and agriculture?","value":"FAO","group":"Institutions","major":"Geography & Civics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Food_and_Agriculture_Organization"}],"explanation74":"The Food and Agriculture Organization is headquartered in Rome."},{"id":"REVISION82-4233","nodeId":"REVISION82-4233","anchor":"ALPHA-B007-Q513","subject":"Which organisation’s headquarters is in Paris and addresses education, science and culture?","value":"UNESCO","group":"Institutions","major":"Geography & Civics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/UNESCO"}],"explanation74":"UNESCO’s remit links education, scientific cooperation and cultural heritage."},{"id":"REVISION82-4234","nodeId":"REVISION82-4234","anchor":"ALPHA-B001-Q085","subject":"Which European institution is based in Strasbourg and is distinct from the European Union?","value":"Council of Europe","group":"Institutions","major":"Geography & Civics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Council_of_Europe"}],"explanation74":"The Council of Europe is a separate international organisation focused on human rights and related cooperation."},{"id":"REVISION82-4235","nodeId":"REVISION82-4235","anchor":"ALPHA-B005-Q415","subject":"The European Court of Human Rights applies which treaty?","value":"European Convention on Human Rights","group":"Institutions","major":"Geography & Civics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/European_Court_of_Human_Rights"}],"explanation74":"The Court operates under the Convention within the Council of Europe system."},{"id":"REVISION82-4236","nodeId":"REVISION82-4236","anchor":"ALPHA-B005-Q415","subject":"Which group lists only the six founding members of the EEC?","value":"France, West Germany, Italy, Belgium, Netherlands, Luxembourg","group":"Institutions","major":"Geography & Civics","era":"Early modern","relation":"matching","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Inner_Six"}],"explanation74":"The EEC began with France, West Germany, Italy and the three Benelux states."},{"id":"REVISION82-4237","nodeId":"REVISION82-4237","anchor":"ALPHA-B005-Q415","subject":"Which city hosts the European Central Bank?","value":"Frankfurt","group":"Institutions","major":"Geography & Civics","era":"Early modern","relation":"place geography","references":[{"file":"Original study question: referenced cultural or historical source","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/European_Central_Bank"}],"explanation74":"The ECB is headquartered in Frankfurt am Main."},{"id":"REVISION83-4238","nodeId":"REVISION83-4238","anchor":"ALPHA-B004-Q352","subject":"Which classical architectural element comprises architrave, frieze and cornice?","value":"Entablature","group":"Architecture","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Entablature"}],"explanation74":"The entablature rests on the columns and comprises architrave, frieze and cornice."},{"id":"REVISION83-4239","nodeId":"REVISION83-4239","anchor":"ALPHA-B001-Q007","subject":"What was a Roman basilica principally used for before its adoption by Christians?","value":"Civic and judicial business","group":"Architecture","major":"Architecture","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Basilica"}],"explanation74":"Roman basilicas accommodated public business and legal proceedings."},{"id":"REVISION83-4240","nodeId":"REVISION83-4240","anchor":"ALPHA-B001-Q069","subject":"What is a rib vault's principal distinguishing feature?","value":"Intersecting projecting arches","group":"Architecture","major":"Architecture","era":"Early modern","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Vault_(architecture)"}],"explanation74":"The ribs articulate the vault and support the webbing between them."},{"id":"REVISION83-4241","nodeId":"REVISION83-4241","anchor":"ALPHA-B008-Q731","subject":"A church with a central nave and two side aisles is usually described as having which spatial organisation?","value":"Basilican","group":"Architecture","major":"Architecture","era":"Medieval","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Basilica"}],"explanation74":"The longitudinal nave-and-aisle arrangement is characteristic of basilican planning."},{"id":"REVISION83-4242","nodeId":"REVISION83-4242","anchor":"ALPHA-B006-Q661","subject":"In Renaissance architecture, a rusticated façade emphasises what?","value":"The joints and faces of masonry blocks","group":"Architecture","major":"Architecture","era":"19th century","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rustication_(architecture)"}],"explanation74":"Rustication gives masonry a strongly articulated, often rough or recessed-joint appearance."},{"id":"REVISION83-4243","nodeId":"REVISION83-4243","anchor":"ALPHA-B006-Q623","subject":"Which feature distinguishes a giant order?","value":"Columns or pilasters spanning several storeys","group":"Architecture","major":"Architecture","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giant_order"}],"explanation74":"A giant or colossal order extends across more than one storey."},{"id":"REVISION83-4244","nodeId":"REVISION83-4244","anchor":"ALPHA-B008-Q686","subject":"What was the original civic function of Siena's Palazzo Pubblico?","value":"Seat of municipal government","group":"Architecture","major":"Architecture","era":"Medieval","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Palazzo_Pubblico"}],"explanation74":"The palace housed Siena's republican government."},{"id":"REVISION83-4245","nodeId":"REVISION83-4245","anchor":"ALPHA-B007-Q525","subject":"Which architectural movement proposed megastructures and deliberately provocative projects in 1960s Florence?","value":"Radical architecture","group":"Architecture","major":"Architecture","era":"20th century","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Radical_period"}],"explanation74":"Groups such as Archizoom and Superstudio challenged conventional architecture and consumer society."},{"id":"REVISION83-4246","nodeId":"REVISION83-4246","anchor":"ALPHA-B004-Q321","subject":"In buon fresco painting, pigments are applied to which surface?","value":"Fresh lime plaster","group":"Art","major":"Art History","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Fresco"}],"explanation74":"In buon fresco, pigment becomes bound into the plaster as it carbonates."},{"id":"REVISION83-4247","nodeId":"REVISION83-4247","anchor":"ALPHA-B006-Q643","subject":"Which ingredient traditionally acts as the binder in egg tempera?","value":"Egg yolk","group":"Art","major":"Art History","era":"19th century","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tempera"}],"explanation74":"Egg yolk binds the pigments in traditional egg-tempera painting."},{"id":"REVISION83-4248","nodeId":"REVISION83-4248","anchor":"ALPHA-B004-Q321","subject":"What does the technique of spolvero use to transfer a drawing?","value":"Powder through perforations","group":"Art","major":"Art History","era":"Renaissance","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pouncing"}],"explanation74":"A perforated cartoon allows powdered pigment to mark the design on another surface."},{"id":"REVISION83-4249","nodeId":"REVISION83-4249","anchor":"ALPHA-B008-Q734","subject":"Which process uses acid to bite lines into a metal printing plate?","value":"Etching","group":"Art","major":"Art History","era":"Early modern","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Etching"}],"explanation74":"Etching exposes selected areas of metal through an acid-resistant ground."},{"id":"REVISION83-4250","nodeId":"REVISION83-4250","anchor":"ALPHA-B001-Q031","subject":"Which printing method traditionally relies on the repulsion of oil and water?","value":"Lithography","group":"Art","major":"Art History","era":"Early modern","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lithography"}],"explanation74":"Lithography separates greasy image areas from water-retaining non-image areas."},{"id":"REVISION83-4251","nodeId":"REVISION83-4251","anchor":"ALPHA-B003-Q199","subject":"Which metal is an essential major component of bronze?","value":"Copper","group":"Art","major":"Art History","era":"20th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bronze"}],"explanation74":"Bronze is principally a copper alloy, traditionally alloyed with tin."},{"id":"REVISION83-4252","nodeId":"REVISION83-4252","anchor":"ALPHA-B006-Q643","subject":"What does a pentimento reveal in a painting?","value":"An alteration during execution","group":"Art","major":"Art History","era":"19th century","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pentimento"}],"explanation74":"A pentimento is evidence of a compositional change made while the work was being painted."},{"id":"REVISION83-4253","nodeId":"REVISION83-4253","anchor":"ALPHA-B001-Q031","subject":"Which subject is represented by a Pietà?","value":"Mary mourning the dead Christ","group":"Art","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Piet%C3%A0"}],"explanation74":"A Pietà shows the Virgin with the dead body of Christ."},{"id":"REVISION83-4254","nodeId":"REVISION83-4254","anchor":"ALPHA-B003-Q199","subject":"Which saint is commonly identified by a wheel in Western painting?","value":"Catherine of Alexandria","group":"Art","major":"Art History","era":"20th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Catherine_of_Alexandria"}],"explanation74":"The wheel refers to Catherine's traditional martyrdom narrative."},{"id":"REVISION83-4255","nodeId":"REVISION83-4255","anchor":"ALPHA-B003-Q199","subject":"Which saint is identified by the eyes she carries in this painting?","value":"Lucia","group":"Art","major":"Art History","era":"20th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Saint_Lucy"}],"explanation74":"Eyes identify Saint Lucy, associated with sight. They can appear on a dish or, as here, on a stalk."},{"id":"REVISION83-4256","nodeId":"REVISION83-4256","anchor":"ALPHA-B004-Q294","subject":"Which saint's usual attributes include a lion and a cardinal's hat?","value":"Jerome","group":"Art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jerome"}],"explanation74":"The lion and cardinal's hat are common attributes of Saint Jerome in Western art."},{"id":"REVISION83-4257","nodeId":"REVISION83-4257","anchor":"ALPHA-B001-Q031","subject":"Which apostle is traditionally represented with keys?","value":"Peter","group":"Art","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Saint_Peter"}],"explanation74":"The keys refer to Christ's charge to Peter in the Gospel of Matthew."},{"id":"REVISION83-4258","nodeId":"REVISION83-4258","anchor":"ALPHA-B005-Q445","subject":"Which artist's paintings of railway stations, empty squares and long shadows helped define Metaphysical painting?","value":"Giorgio de Chirico","group":"Art","major":"Art History","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giorgio_de_Chirico"}],"explanation74":"De Chirico's unsettling city scenes are central to Pittura metafisica."},{"id":"REVISION83-4259","nodeId":"REVISION83-4259","anchor":"ALPHA-B004-Q294","subject":"Which Italian painter was associated with both Metaphysical painting and still lifes of bottles?","value":"Giorgio Morandi","group":"Art","major":"Art History","era":"19th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giorgio_Morandi"}],"explanation74":"Morandi briefly explored Metaphysical painting before concentrating on still-life variations."},{"id":"REVISION83-4260","nodeId":"REVISION83-4260","anchor":"ALPHA-B005-Q389","subject":"Which intervention defines Lucio Fontana's Tagli?","value":"Cuts through the canvas","group":"Art","major":"Art History","era":"20th century","relation":"term function","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Lucio_Fontana"}],"explanation74":"Fontana's cuts make actual space part of the work."},{"id":"REVISION83-4261","nodeId":"REVISION83-4261","anchor":"ALPHA-B003-Q185","subject":"Which artist made the white works known as Achromes?","value":"Piero Manzoni","group":"Art","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Piero_Manzoni"}],"explanation74":"Manzoni's Achromes investigate surfaces stripped of conventional pictorial colour."},{"id":"REVISION83-4262","nodeId":"REVISION83-4262","anchor":"ALPHA-B008-Q721","subject":"Which artist is particularly associated with mirror paintings?","value":"Michelangelo Pistoletto","group":"Art","major":"Art History","era":"Late 20th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Michelangelo_Pistoletto"}],"explanation74":"Pistoletto's reflective surfaces include the spectator and surrounding space."},{"id":"REVISION83-4263","nodeId":"REVISION83-4263","anchor":"ALPHA-B001-Q003","subject":"Which artist created maps embroidered by Afghan craftswomen?","value":"Alighiero Boetti","group":"Art","major":"Art History","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Alighiero_Boetti"}],"explanation74":"Boetti's Mappa works combine geographical representation with collaborative embroidery."},{"id":"REVISION83-4264","nodeId":"REVISION83-4264","anchor":"ALPHA-B001-Q035","subject":"Which Italian opera genre is associated with comic plots and everyday characters?","value":"Opera buffa","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Opera_buffa"}],"explanation74":"Opera buffa developed a comic tradition distinct from opera seria."},{"id":"REVISION83-4265","nodeId":"REVISION83-4265","anchor":"ALPHA-B008-Q720","subject":"Puccini's Madama Butterfly is principally set in which Japanese city?","value":"Nagasaki","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"place","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Madama_Butterfly"}],"explanation74":"The story unfolds in Nagasaki, where Butterfly marries the American officer Pinkerton."},{"id":"REVISION83-4266","nodeId":"REVISION83-4266","anchor":"ALPHA-B001-Q035","subject":"Which Italian theatrical tradition relies on stock characters such as Arlecchino and Pantalone?","value":"Commedia dell'arte","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Commedia_dell%27arte"}],"explanation74":"Commedia dell'arte uses recognisable character types, masks and improvised performance."},{"id":"REVISION83-4267","nodeId":"REVISION83-4267","anchor":"ALPHA-B001-Q035","subject":"Which writer is associated with reforming Italian comedy through works such as La locandiera?","value":"Carlo Goldoni","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carlo_Goldoni"}],"explanation74":"Goldoni moved comedy toward scripted dialogue and observed social character."},{"id":"REVISION83-4268","nodeId":"REVISION83-4268","anchor":"ALPHA-B003-Q238","subject":"Which novel follows the decline of a Sicilian aristocratic family during the Risorgimento?","value":"The Leopard","group":"Culture","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Leopard"}],"explanation74":"Lampedusa's novel examines aristocratic change through the Prince of Salina."},{"id":"REVISION83-4269","nodeId":"REVISION83-4269","anchor":"ALPHA-B003-Q214","subject":"Which narrative device frames Zeno's Conscience?","value":"A patient's written recollections","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Zeno%27s_Conscience"}],"explanation74":"Zeno writes autobiographical recollections in connection with psychoanalytic treatment."},{"id":"REVISION83-4270","nodeId":"REVISION83-4270","anchor":"ALPHA-B001-Q087","subject":"Which novel centres on Giovanni Drogo’s long wait at the remote Bastiani Fortress?","value":"The Tartar Steppe","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Tartar_Steppe"}],"explanation74":"Buzzati's novel follows Giovanni Drogo's long wait at the remote Bastiani Fortress."},{"id":"REVISION83-4271","nodeId":"REVISION83-4271","anchor":"ALPHA-B001-Q064","subject":"Which Italian poet developed the idea of the fanciullino, or little child, within the poet?","value":"Giovanni Pascoli","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giovanni_Pascoli"}],"explanation74":"Pascoli describes poetic perception through an inner child capable of wonder."},{"id":"REVISION83-4272","nodeId":"REVISION83-4272","anchor":"ALPHA-B001-Q035","subject":"Which film movement favoured location shooting and attention to post-war everyday hardship?","value":"Italian neorealism","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Italian_neorealism"}],"explanation74":"Neorealism often used real locations and stories of ordinary people's social struggles."},{"id":"REVISION83-4273","nodeId":"REVISION83-4273","anchor":"ALPHA-B003-Q238","subject":"Which profession does the protagonist of Bicycle Thieves obtain before his bicycle is stolen?","value":"Poster hanger","group":"Culture","major":"Language & Literature","era":"Renaissance","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bicycle_Thieves"}],"explanation74":"Antonio needs the bicycle for his new job putting up advertising posters."},{"id":"REVISION83-4274","nodeId":"REVISION83-4274","anchor":"ALPHA-B006-Q668","subject":"Which Visconti film centres on Sicilian fishermen and their economic exploitation?","value":"La terra trema","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/La_terra_trema"}],"explanation74":"La terra trema follows a fishing family in Aci Trezza and draws on Verga."},{"id":"REVISION83-4275","nodeId":"REVISION83-4275","anchor":"ALPHA-B003-Q214","subject":"Which Fellini film evokes a provincial childhood under Fascism?","value":"Amarcord","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Amarcord"}],"explanation74":"Amarcord recreates a fictionalised provincial world drawing on Fellini's memories."},{"id":"REVISION83-4276","nodeId":"REVISION83-4276","anchor":"ALPHA-B001-Q064","subject":"Which film won the Palme d'Or and depicts Lombard peasant life in the nineteenth century?","value":"The Tree of Wooden Clogs","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Tree_of_Wooden_Clogs"}],"explanation74":"Ermanno Olmi's film portrays rural life in Lombardy."},{"id":"REVISION83-4277","nodeId":"REVISION83-4277","anchor":"ALPHA-B008-Q720","subject":"Which Italian film director is particularly associated with the spaghetti western?","value":"Sergio Leone","group":"Culture","major":"Language & Literature","era":"Early modern","relation":"classification style","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sergio_Leone"}],"explanation74":"Leone's westerns helped define the Italian reinterpretation of the genre."},{"id":"REVISION83-4278","nodeId":"REVISION83-4278","anchor":"ALPHA-B003-Q223","subject":"Which peace recognised important communal rights of the Lombard League in 1183?","value":"Peace of Constance","group":"History","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Peace_of_Constance"}],"explanation74":"The Peace of Constance regulated the relationship between the emperor and the Lombard communes."},{"id":"REVISION83-4279","nodeId":"REVISION83-4279","anchor":"ALPHA-B006-Q621","subject":"Which dynasty ruled Naples immediately before the Aragonese conquest of 1442?","value":"Angevin","group":"History","major":"History & Politics","era":"Ancient","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Kingdom_of_Naples"}],"explanation74":"Alfonso V of Aragon ended Angevin rule in Naples."},{"id":"REVISION83-4280","nodeId":"REVISION83-4280","anchor":"ALPHA-B007-Q493","subject":"Which agreement in 1454 sought to stabilise relations among the major Italian states?","value":"Peace of Lodi","group":"History","major":"History & Politics","era":"20th century","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Lodi"}],"explanation74":"The Peace of Lodi helped establish a balance among the leading Italian powers."},{"id":"REVISION83-4281","nodeId":"REVISION83-4281","anchor":"ALPHA-B002-Q103","subject":"Which Italian state was ruled by the House of Savoy before unification?","value":"Kingdom of Sardinia","group":"History","major":"History & Politics","era":"Early modern","relation":"context relation","references":[{"file":"Original study question: cultural or historical reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Kingdom_of_Sardinia"}],"explanation74":"The Savoy monarchy's Kingdom of Sardinia became the institutional nucleus of unified Italy."},{"id":"REVISION84-1453","nodeId":"REVISION84-1453","anchor":"EXP77-1453","subject":"The relief of Orléans belongs to which conflict?","value":"Hundred Years' War","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Siege_of_Orl%C3%A9ans"}],"explanation74":"The siege was lifted in 1429 during the Hundred Years' War, with Joan of Arc taking part."},{"id":"REVISION84-1462","nodeId":"REVISION84-1462","anchor":"EXP77-1462","subject":"Which was the next ecumenical council after the First Council of Nicaea?","value":"First Council of Constantinople","group":"history date","major":"History & Politics","era":"Early modern","relation":"chronology_comparison","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/First_Council_of_Constantinople"}],"explanation74":"Nicaea met in 325; the First Council of Constantinople followed in 381."},{"id":"REVISION84-1485","nodeId":"REVISION84-1485","anchor":"EXP77-1485","subject":"Which came first in Henry VIII's break with Rome?","value":"Marriage to Anne Boleyn","group":"history date","major":"History & Politics","era":"Early modern","relation":"chronology_comparison","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Anne_Boleyn"}],"explanation74":"The marriage took place in 1533, before the Act of Supremacy of 1534 and the later measures listed."},{"id":"REVISION84-1487","nodeId":"REVISION84-1487","anchor":"EXP77-1487","subject":"Which battle conventionally marks the end of the Hundred Years' War?","value":"Castillon","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Castillon"}],"explanation74":"The French victory at Castillon in 1453 is conventionally taken as the war's end."},{"id":"REVISION84-1488","nodeId":"REVISION84-1488","anchor":"EXP77-1488","subject":"Which royal dynasty began with Pepin the Short's accession?","value":"Carolingian","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pepin_the_Short"}],"explanation74":"Pepin became king in 751, replacing the last Merovingian king."},{"id":"REVISION84-1496","nodeId":"REVISION84-1496","anchor":"EXP77-1496","subject":"The Gunpowder Plot targeted which English institution?","value":"Parliament","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gunpowder_Plot"}],"explanation74":"The plotters planned to blow up the House of Lords during the opening of Parliament in 1605."},{"id":"REVISION84-1499","nodeId":"REVISION84-1499","anchor":"EXP77-1499","subject":"Which power lost substantial central European territories under the Treaty of Karlowitz?","value":"Ottoman Empire","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Karlowitz"}],"explanation74":"The settlement of 1699 followed Ottoman military defeats and transferred extensive territories to its opponents."},{"id":"REVISION84-1501","nodeId":"REVISION84-1501","anchor":"EXP77-1501","subject":"The Act of Abjuration rejected the authority of which ruler?","value":"Philip II of Spain","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Act_of_Abjuration"}],"explanation74":"The Dutch provinces repudiated Philip II's sovereignty in 1581."},{"id":"REVISION84-1504","nodeId":"REVISION84-1504","anchor":"EXP77-1504","subject":"Which pope was attacked at Anagni by opponents linked to Philip IV of France?","value":"Boniface VIII","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Outrage_of_Anagni"}],"explanation74":"The attack on Boniface VIII in 1303 arose from his conflict with Philip IV."},{"id":"REVISION84-1508","nodeId":"REVISION84-1508","anchor":"EXP77-1508","subject":"The German Democratic Republic emerged from which occupation zone?","value":"Soviet","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/East_Germany"}],"explanation74":"East Germany was established in the Soviet occupation zone in 1949."},{"id":"REVISION84-1510","nodeId":"REVISION84-1510","anchor":"EXP77-1510","subject":"Which document predates the French Declaration of the Rights of Man and of the Citizen?","value":"United States Constitution","group":"history date","major":"History & Politics","era":"Early modern","relation":"chronology_comparison","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/United_States_Constitution"}],"explanation74":"The US Constitution was signed in 1787; the French Declaration followed in 1789."},{"id":"REVISION84-1514","nodeId":"REVISION84-1514","anchor":"EXP77-1514","subject":"The Peace of Cateau-Cambrésis ended the principal phase of which conflict?","value":"Italian Wars","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Peace_of_Cateau-Cambr%C3%A9sis"}],"explanation74":"The 1559 peace concluded the prolonged struggle for predominance in Italy."},{"id":"REVISION84-1517","nodeId":"REVISION84-1517","anchor":"EXP77-1517","subject":"The Decian persecution required inhabitants to perform which act?","value":"Sacrifice to the Roman gods","group":"history date","major":"History & Politics","era":"20th century","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Decian_persecution"}],"explanation74":"Decius required sacrifices and certificates of compliance, placing Christians who refused at risk."},{"id":"REVISION84-1526","nodeId":"REVISION84-1526","anchor":"EXP77-1526","subject":"Napoleon placed Joseph Bonaparte on which throne?","value":"Spain","group":"history date","major":"History & Politics","era":"19th century","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Joseph_Bonaparte"}],"explanation74":"Joseph became king of Spain in 1808, in the context of the Peninsular War."},{"id":"REVISION84-1527","nodeId":"REVISION84-1527","anchor":"EXP77-1527","subject":"Which dynasty restored Byzantine rule in Constantinople after Latin occupation?","value":"Palaiologos","group":"history date","major":"History & Politics","era":"Ancient","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Reconquest_of_Constantinople"}],"explanation74":"Michael VIII Palaiologos recovered Constantinople in 1261."},{"id":"REVISION84-1529","nodeId":"REVISION84-1529","anchor":"EXP77-1529","subject":"The Holy Roman Empire was dissolved during which wider period?","value":"Napoleonic Wars","group":"history date","major":"History & Politics","era":"Medieval","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Dissolution_of_the_Holy_Roman_Empire"}],"explanation74":"Francis II relinquished the imperial title in 1806 amid Napoleon's restructuring of central Europe."},{"id":"REVISION84-1532","nodeId":"REVISION84-1532","anchor":"EXP77-1532","subject":"Which dynasty followed the direct Capetian line on the French throne?","value":"Valois","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Philip_VI_of_France"}],"explanation74":"Philip VI's accession in 1328 began Valois rule."},{"id":"REVISION84-1533","nodeId":"REVISION84-1533","anchor":"EXP77-1533","subject":"The Treaty of Aix-la-Chapelle of 1748 ended which war?","value":"War of the Austrian Succession","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Aix-la-Chapelle_(1748)"}],"explanation74":"The 1748 settlement concluded the War of the Austrian Succession."},{"id":"REVISION84-1534","nodeId":"REVISION84-1534","anchor":"EXP77-1534","subject":"The Acts of Union of 1707 united which two kingdoms?","value":"England and Scotland","group":"history date","major":"History & Politics","era":"Late 20th century","relation":"matching","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Acts_of_Union_1707"}],"explanation74":"The two kingdoms became the Kingdom of Great Britain."},{"id":"REVISION84-1538","nodeId":"REVISION84-1538","anchor":"EXP77-1538","subject":"Jamestown was founded in which English colony?","value":"Virginia","group":"history date","major":"History & Politics","era":"Early modern","relation":"place_geography","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jamestown,_Virginia"}],"explanation74":"The English settlement of Jamestown was established in Virginia in 1607."},{"id":"REVISION84-1546","nodeId":"REVISION84-1546","anchor":"EXP77-1546","subject":"The German Confederation was established by which diplomatic settlement?","value":"Congress of Vienna","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/German_Confederation"}],"explanation74":"The Congress of Vienna created the confederation in 1815."},{"id":"REVISION84-1547","nodeId":"REVISION84-1547","anchor":"EXP77-1547","subject":"The Treaty of Ryswick ended which conflict?","value":"Nine Years' War","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Peace_of_Ryswick"}],"explanation74":"The treaty of 1697 ended the Nine Years' War."},{"id":"REVISION84-1551","nodeId":"REVISION84-1551","anchor":"EXP77-1551","subject":"Which engagement is also known as the Battle of the Nations?","value":"Leipzig","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Leipzig"}],"explanation74":"The multinational coalition defeated Napoleon at Leipzig in 1813."},{"id":"REVISION84-1556","nodeId":"REVISION84-1556","anchor":"EXP77-1556","subject":"Toscanelli's Atlantic proposal envisaged reaching Asia by sailing in which direction from Europe?","value":"West","group":"history date","major":"History & Politics","era":"Renaissance","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Paolo_dal_Pozzo_Toscanelli"}],"explanation74":"His 1474 proposal envisaged a westward Atlantic route to Asia."},{"id":"REVISION84-1559","nodeId":"REVISION84-1559","anchor":"EXP77-1559","subject":"The Ottoman foothold at Gallipoli chiefly facilitated expansion into which region?","value":"The Balkans","group":"history date","major":"History & Politics","era":"Early modern","relation":"place_geography","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Fall_of_Gallipoli"}],"explanation74":"Gallipoli provided a strategic foothold on the European side of the Dardanelles."},{"id":"REVISION84-1560","nodeId":"REVISION84-1560","anchor":"EXP77-1560","subject":"Which state disappeared following the Third Partition of Poland?","value":"Polish–Lithuanian Commonwealth","group":"history date","major":"History & Politics","era":"Early 20th century","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Third_Partition_of_Poland"}],"explanation74":"The third partition in 1795 ended the Commonwealth's independent existence."},{"id":"REVISION84-1564","nodeId":"REVISION84-1564","anchor":"EXP77-1564","subject":"Charles I's Personal Rule was characterised by government without which body?","value":"Parliament","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Personal_Rule"}],"explanation74":"Charles I governed without summoning Parliament from 1629 to 1640."},{"id":"REVISION84-1566","nodeId":"REVISION84-1566","anchor":"EXP77-1566","subject":"The Rosetta Stone's discovery preceded which achievement?","value":"Champollion's decipherment announcement","group":"history date","major":"History & Politics","era":"Early modern","relation":"chronology_comparison","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rosetta_Stone"}],"explanation74":"The stone was found in 1799; Champollion announced a major decipherment breakthrough in 1822."},{"id":"REVISION84-1568","nodeId":"REVISION84-1568","anchor":"EXP77-1568","subject":"Theoderic established Ostrogothic rule in Italy after defeating whom?","value":"Odoacer","group":"history date","major":"History & Politics","era":"Early 20th century","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ostrogothic_Kingdom"}],"explanation74":"Theoderic defeated Odoacer and took control of Italy in 493."},{"id":"REVISION84-1578","nodeId":"REVISION84-1578","anchor":"EXP77-1578","subject":"Charles of Anjou's victory at Benevento ended the reign of whom?","value":"Manfred of Sicily","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Benevento"}],"explanation74":"Manfred was killed at Benevento in 1266, enabling Angevin rule in southern Italy."},{"id":"REVISION84-1584","nodeId":"REVISION84-1584","anchor":"EXP77-1584","subject":"Which king returned at the Restoration of the English monarchy?","value":"Charles II","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Stuart_Restoration"}],"explanation74":"Charles II returned in 1660 after the republican and Protectorate period."},{"id":"REVISION84-1585","nodeId":"REVISION84-1585","anchor":"EXP77-1585","subject":"Where was Napoleon first exiled after his abdication in 1814?","value":"Elba","group":"history date","major":"History & Politics","era":"Early modern","relation":"place_geography","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Fontainebleau_(1814)"}],"explanation74":"Elba was his first place of exile; Saint Helena followed his final defeat in 1815."},{"id":"REVISION84-1590","nodeId":"REVISION84-1590","anchor":"EXP77-1590","subject":"The Brandenburg–Prussia personal union was associated with which dynasty?","value":"Hohenzollern","group":"history date","major":"History & Politics","era":"19th century","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Brandenburg-Prussia"}],"explanation74":"The Hohenzollerns united Brandenburg and the Duchy of Prussia under one ruler in 1618."},{"id":"REVISION84-1601","nodeId":"REVISION84-1601","anchor":"EXP77-1601","subject":"Which dynasty came to power in Russia after the Time of Troubles?","value":"Romanov","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Michael_of_Russia"}],"explanation74":"Michael Romanov's election in 1613 inaugurated Romanov rule."},{"id":"REVISION84-1602","nodeId":"REVISION84-1602","anchor":"EXP77-1602","subject":"Jan Hus was executed during which council?","value":"Constance","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jan_Hus"}],"explanation74":"Hus was condemned and burned at Constance in 1415."},{"id":"REVISION84-1612","nodeId":"REVISION84-1612","anchor":"EXP77-1612","subject":"The Treaty of Meerssen divided territories between which realms?","value":"East and West Francia","group":"history date","major":"History & Politics","era":"Early modern","relation":"matching","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Meerssen"}],"explanation74":"The 870 treaty divided much of Lothair II's former kingdom between East and West Francia."},{"id":"REVISION84-1620","nodeId":"REVISION84-1620","anchor":"EXP77-1620","subject":"Who directed French government during Louis XIV's minority?","value":"Cardinal Mazarin","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Louis_XIV"}],"explanation74":"Mazarin was the leading minister during the regency and the young king's early reign."},{"id":"REVISION84-1621","nodeId":"REVISION84-1621","anchor":"EXP77-1621","subject":"Which came immediately before the dissolution of the Holy Roman Empire in 1806?","value":"Formation of the Confederation of the Rhine","group":"history date","major":"History & Politics","era":"Early modern","relation":"chronology_comparison","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Confederation_of_the_Rhine"}],"explanation74":"The Confederation of the Rhine was formed shortly before Francis II relinquished the imperial title."},{"id":"REVISION84-1626","nodeId":"REVISION84-1626","anchor":"EXP77-1626","subject":"The Kalmar Union linked Denmark and Norway with which kingdom?","value":"Sweden","group":"history date","major":"History & Politics","era":"19th century","relation":"matching","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Kalmar_Union"}],"explanation74":"The union of 1397 joined the three Scandinavian kingdoms under a common monarch."},{"id":"REVISION84-1634","nodeId":"REVISION84-1634","anchor":"EXP77-1634","subject":"Louis XIV began personal rule after whose death?","value":"Cardinal Mazarin","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Louis_XIV"}],"explanation74":"Mazarin died in 1661; Louis XIV then chose to govern without a chief minister."},{"id":"REVISION84-1635","nodeId":"REVISION84-1635","anchor":"EXP77-1635","subject":"Which leader is associated with the establishment of Normandy?","value":"Rollo","group":"history date","major":"History & Politics","era":"20th century","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Treaty_of_Saint-Clair-sur-Epte"}],"explanation74":"Rollo's settlement with the West Frankish king in 911 underlies the conventional foundation of Normandy."},{"id":"REVISION84-1639","nodeId":"REVISION84-1639","anchor":"EXP77-1639","subject":"At Grunwald, Polish–Lithuanian forces defeated which order?","value":"Teutonic Order","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Battle_of_Grunwald"}],"explanation74":"The battle of 1410 was a major defeat for the Teutonic Order."},{"id":"REVISION84-1645","nodeId":"REVISION84-1645","anchor":"EXP77-1645","subject":"The Carlsbad Decrees sought chiefly to suppress which tendencies?","value":"Liberalism and nationalism","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Carlsbad_Decrees"}],"explanation74":"The decrees of 1819 imposed repressive measures against liberal and nationalist activity in the German states."},{"id":"REVISION84-1649","nodeId":"REVISION84-1649","anchor":"EXP77-1649","subject":"The House of Savoy acquired Sardinia in exchange for which island?","value":"Sicily","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Kingdom_of_Sardinia"}],"explanation74":"Savoy exchanged Sicily for Sardinia in 1720."},{"id":"REVISION84-1651","nodeId":"REVISION84-1651","anchor":"EXP77-1651","subject":"Which state belonged to the Quadruple Alliance of 1815 but not the Holy Alliance?","value":"Britain","group":"history date","major":"History & Politics","era":"Medieval","relation":"exception_discrimination","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Quadruple_Alliance_(1815)"}],"explanation74":"Britain joined Austria, Prussia and Russia in the Quadruple Alliance; the Holy Alliance comprised the latter three."},{"id":"REVISION84-1658","nodeId":"REVISION84-1658","anchor":"EXP77-1658","subject":"The Petition of Right was presented to which English king?","value":"Charles I","group":"history date","major":"History & Politics","era":"Early modern","relation":"context_relation","references":[{"file":"Tapestry source record","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Petition_of_Right"}],"explanation74":"Parliament presented the petition to Charles I in 1628."},{"id":"REVISION85-4282","nodeId":"REVISION85-4282","anchor":"MAJOR:ARCHITECTURE","subject":"What is a hypostyle hall?","value":"A hall supported by many columns","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Hypostyle","checkedOnline85":false}],"explanation74":"A hypostyle hall has a roof carried by rows of columns.","questionId85":"GEN43-Q04282","reviewStatus85":"ready"},{"id":"REVISION85-4283","nodeId":"REVISION85-4283","anchor":"MAJOR:ARCHITECTURE","subject":"In a classical temple, the opisthodomos is at the:","value":"Rear","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Opisthodomos","checkedOnline85":false}],"explanation74":"The opisthodomos is the rear porch or compartment of a Greek temple.","questionId85":"GEN43-Q04283","reviewStatus85":"ready"},{"id":"REVISION85-4284","nodeId":"REVISION85-4284","anchor":"MAJOR:ARCHITECTURE","subject":"Rustication principally concerns the treatment of:","value":"Masonry surfaces","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rustication_(architecture)","checkedOnline85":false}],"explanation74":"Rustication emphasises masonry blocks and their joints, often using rough or strongly articulated faces.","questionId85":"GEN43-Q04284","reviewStatus85":"ready"},{"id":"REVISION85-4285","nodeId":"REVISION85-4285","anchor":"MAJOR:ARCHITECTURE","subject":"A narthex is usually found at the:","value":"Entrance to a church","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Narthex","checkedOnline85":false}],"explanation74":"The narthex is an entrance vestibule or porch of a church.","questionId85":"GEN43-Q04285","reviewStatus85":"ready"},{"id":"REVISION85-4286","nodeId":"REVISION85-4286","anchor":"MAJOR:ARCHITECTURE","subject":"A portico is supported primarily by:","value":"Columns or piers","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Portico","checkedOnline85":false}],"explanation74":"A portico is a roofed entrance or walkway whose open side is carried on columns or piers.","questionId85":"GEN43-Q04286","reviewStatus85":"ready"},{"id":"REVISION85-4287","nodeId":"REVISION85-4287","anchor":"MAJOR:ARCHITECTURE","subject":"Which term describes a window divided into two lights by a central support?","value":"Bifora","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://it.wikipedia.org/wiki/Bifora","checkedOnline85":false}],"explanation74":"A bifora has two openings, generally divided by a column or mullion.","questionId85":"GEN43-Q04287","reviewStatus85":"ready"},{"id":"REVISION85-4288","nodeId":"REVISION85-4288","anchor":"MAJOR:ARCHITECTURE","subject":"What is an oculus?","value":"A circular opening","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Oculus","checkedOnline85":false}],"explanation74":"An oculus is a circular opening, such as that at the top of the Pantheon's dome.","questionId85":"GEN43-Q04288","reviewStatus85":"ready"},{"id":"REVISION85-4289","nodeId":"REVISION85-4289","anchor":"MAJOR:ARCHITECTURE","subject":"In reinforced concrete, steel reinforcement primarily resists:","value":"Tension","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Reinforced_concrete","checkedOnline85":false}],"explanation74":"Concrete is strong in compression; reinforcement is placed especially where tensile stresses occur.","questionId85":"GEN43-Q04289","reviewStatus85":"ready"},{"id":"REVISION85-4290","nodeId":"REVISION85-4290","anchor":"MAJOR:ARCHITECTURE","subject":"What does a curtain wall normally carry?","value":"Its own weight and wind loads","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Curtain_wall_(architecture)","checkedOnline85":false}],"explanation74":"A curtain wall is a non-load-bearing exterior enclosure, transferring its own and environmental loads to the structure.","questionId85":"GEN43-Q04290","reviewStatus85":"ready"},{"id":"REVISION85-4291","nodeId":"REVISION85-4291","anchor":"MAJOR:ARCHITECTURE","subject":"A cantilever is supported:","value":"At one end","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cantilever","checkedOnline85":false}],"explanation74":"A cantilever projects from a fixed support, leaving its other end free.","questionId85":"GEN43-Q04291","reviewStatus85":"ready"},{"id":"REVISION85-4292","nodeId":"REVISION85-4292","anchor":"MAJOR:ARCHITECTURE","subject":"A drawing produced by cutting a building with a vertical plane is a:","value":"Section","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Section_(architecture)","checkedOnline85":false}],"explanation74":"A section reveals the internal vertical organisation of a building.","questionId85":"GEN43-Q04292","reviewStatus85":"ready"},{"id":"REVISION85-4293","nodeId":"REVISION85-4293","anchor":"MAJOR:ARCHITECTURE","subject":"In a Roman town, the main north–south axis is the:","value":"Cardo","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cardo","checkedOnline85":false}],"explanation74":"The cardo is conventionally the north–south axis of a Roman town grid.","questionId85":"GEN43-Q04293","reviewStatus85":"ready"},{"id":"REVISION85-4294","nodeId":"REVISION85-4294","anchor":"MAJOR:ARCHITECTURE","subject":"A Roman insula was commonly a:","value":"Multi-storey housing block","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Insula_(building)","checkedOnline85":false}],"explanation74":"In Roman urban housing, insulae were apartment buildings accommodating multiple households.","questionId85":"GEN43-Q04294","reviewStatus85":"ready"},{"id":"REVISION85-4295","nodeId":"REVISION85-4295","anchor":"MAJOR:ARCHITECTURE","subject":"Which room in Roman baths was heated to the highest temperature?","value":"Caldarium","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Caldarium","checkedOnline85":false}],"explanation74":"The caldarium was the hot room, while the frigidarium was cold and the apodyterium was for changing.","questionId85":"GEN43-Q04295","reviewStatus85":"ready"},{"id":"REVISION85-4296","nodeId":"REVISION85-4296","anchor":"MAJOR:ARCHITECTURE","subject":"The cavea of a Roman theatre contains the:","value":"Spectator seating","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cavea","checkedOnline85":false}],"explanation74":"The cavea is the tiered seating area surrounding the performance space.","questionId85":"GEN43-Q04296","reviewStatus85":"ready"},{"id":"REVISION85-4297","nodeId":"REVISION85-4297","anchor":"MAJOR:ARCHITECTURE","subject":"Roman pozzolana was valued primarily for making:","value":"Hydraulic mortar","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pozzolan","checkedOnline85":false}],"explanation74":"Volcanic pozzolana mixed with lime enables mortar to set through hydraulic reactions, including in wet conditions.","questionId85":"GEN43-Q04297","reviewStatus85":"ready"},{"id":"REVISION85-4298","nodeId":"REVISION85-4298","anchor":"MAJOR:ARCHITECTURE","subject":"The Temple of Athena Nike on the Acropolis belongs to which order?","value":"Ionic","group":"Architecture","major":"Architecture","era":"Other","relation":"classification style","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Temple_of_Athena_Nike","checkedOnline85":false}],"explanation74":"The small amphiprostyle temple uses the Ionic order.","questionId85":"GEN43-Q04298","reviewStatus85":"ready"},{"id":"REVISION85-4299","nodeId":"REVISION85-4299","anchor":"MAJOR:ARCHITECTURE","subject":"The temples of Hera and Athena at Paestum are in which Italian region?","value":"Campania","group":"Architecture","major":"Architecture","era":"Other","relation":"place geography","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Paestum","checkedOnline85":false}],"explanation74":"Ancient Paestum lies near the Tyrrhenian coast in Campania.","questionId85":"GEN43-Q04299","reviewStatus85":"ready"},{"id":"REVISION85-4300","nodeId":"REVISION85-4300","anchor":"MAJOR:ARCHITECTURE","subject":"The Erechtheion is particularly associated with which sculptural supports?","value":"Caryatids","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Erechtheion","checkedOnline85":false}],"explanation74":"Its south porch uses female figures known as caryatids in place of conventional columns.","questionId85":"GEN43-Q04300","reviewStatus85":"ready"},{"id":"REVISION85-4301","nodeId":"REVISION85-4301","anchor":"MAJOR:ARCHITECTURE","subject":"The Maison Carrée at Nîmes is a surviving:","value":"Roman temple","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Maison_Carr%C3%A9e","checkedOnline85":false}],"explanation74":"The Maison Carrée is a well-preserved Roman temple from the early imperial period.","questionId85":"GEN43-Q04301","reviewStatus85":"ready"},{"id":"REVISION85-4302","nodeId":"REVISION85-4302","anchor":"MAJOR:ARCHITECTURE","subject":"Trajan's Markets in Rome are notably constructed using:","value":"Brick-faced concrete","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Trajan%27s_Market","checkedOnline85":false}],"explanation74":"The complex exemplifies Roman brick-faced concrete construction and vaulted spaces.","questionId85":"GEN43-Q04302","reviewStatus85":"ready"},{"id":"REVISION85-4303","nodeId":"REVISION85-4303","anchor":"MAJOR:ARCHITECTURE","subject":"The Pont du Gard carried water to which Roman city?","value":"Nîmes","group":"Architecture","major":"Architecture","era":"Other","relation":"place geography","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pont_du_Gard","checkedOnline85":false}],"explanation74":"The aqueduct supplied Nemausus, modern Nîmes.","questionId85":"GEN43-Q04303","reviewStatus85":"ready"},{"id":"REVISION85-4304","nodeId":"REVISION85-4304","anchor":"MAJOR:ARCHITECTURE","subject":"The Arch of Constantine incorporates reliefs from:","value":"Earlier imperial monuments","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arch_of_Constantine","checkedOnline85":false}],"explanation74":"The arch reuses sculptural material associated with earlier emperors, a major example of spolia.","questionId85":"GEN43-Q04304","reviewStatus85":"ready"},{"id":"REVISION85-4305","nodeId":"REVISION85-4305","anchor":"MAJOR:ARCHITECTURE","subject":"Charlemagne's Palatine Chapel at Aachen drew notably on the model of:","value":"San Vitale in Ravenna","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aachen_Cathedral","checkedOnline85":false}],"explanation74":"The centrally planned church at Aachen was influenced by late-antique models including San Vitale.","questionId85":"GEN43-Q04305","reviewStatus85":"ready"},{"id":"REVISION85-4306","nodeId":"REVISION85-4306","anchor":"MAJOR:ARCHITECTURE","subject":"A westwork is a monumental structure at a church's:","value":"Western entrance","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Westwork","checkedOnline85":false}],"explanation74":"A westwork is a substantial western entrance block, often with towers and upper rooms.","questionId85":"GEN43-Q04306","reviewStatus85":"ready"},{"id":"REVISION85-4307","nodeId":"REVISION85-4307","anchor":"MAJOR:ARCHITECTURE","subject":"The monastery of Cluny belonged to which order?","value":"Benedictine","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Cluny_Abbey","checkedOnline85":false}],"explanation74":"Cluny was a major centre of reformed Benedictine monasticism.","questionId85":"GEN43-Q04307","reviewStatus85":"ready"},{"id":"REVISION85-4308","nodeId":"REVISION85-4308","anchor":"MAJOR:ARCHITECTURE","subject":"The abbey of Fontenay is located in:","value":"Burgundy","group":"Architecture","major":"Architecture","era":"Other","relation":"place geography","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Abbey_of_Fontenay","checkedOnline85":false}],"explanation74":"Fontenay is a major surviving Cistercian abbey in Burgundy, France.","questionId85":"GEN43-Q04308","reviewStatus85":"ready"},{"id":"REVISION85-4309","nodeId":"REVISION85-4309","anchor":"MAJOR:ARCHITECTURE","subject":"The baptistery of Parma is closely associated with:","value":"Benedetto Antelami","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Parma_Baptistery","checkedOnline85":false}],"explanation74":"Antelami is associated with its design and sculptural programme at the transition from Romanesque to Gothic.","questionId85":"GEN43-Q04309","reviewStatus85":"ready"},{"id":"REVISION85-4310","nodeId":"REVISION85-4310","anchor":"MAJOR:ARCHITECTURE","subject":"The Basilica of Saint Francis at Assisi consists notably of:","value":"Two superimposed churches","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Basilica_of_Saint_Francis_of_Assisi","checkedOnline85":false}],"explanation74":"The complex has an Upper Church and a Lower Church, built one above the other.","questionId85":"GEN43-Q04310","reviewStatus85":"ready"},{"id":"REVISION85-4311","nodeId":"REVISION85-4311","anchor":"ENT:GOTHIC","subject":"Sainte-Chapelle in Paris is a major example of:","value":"Rayonnant Gothic","group":"Architecture","major":"Architecture","era":"Other","relation":"classification style","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sainte-Chapelle","checkedOnline85":false}],"explanation74":"Its slender structure and extensive stained glass exemplify Rayonnant Gothic.","questionId85":"GEN43-Q04311","reviewStatus85":"ready"},{"id":"REVISION85-4312","nodeId":"REVISION85-4312","anchor":"ENT:GOTHIC","subject":"Which feature is especially characteristic of English Perpendicular Gothic?","value":"Vertical panel tracery","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Perpendicular_Gothic","checkedOnline85":false}],"explanation74":"Perpendicular Gothic emphasises strong vertical lines and panel-like window tracery.","questionId85":"GEN43-Q04312","reviewStatus85":"ready"},{"id":"REVISION85-4313","nodeId":"REVISION85-4313","anchor":"ENT:GOTHIC","subject":"In Gothic architecture, tracery is the:","value":"Stone framework of a window","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tracery","checkedOnline85":false}],"explanation74":"Tracery subdivides window openings into ornamental patterns supporting the glazing.","questionId85":"GEN43-Q04313","reviewStatus85":"ready"},{"id":"REVISION85-4314","nodeId":"REVISION85-4314","anchor":"MAJOR:ARCHITECTURE","subject":"A gargoyle differs from a purely decorative grotesque because it:","value":"Discharges rainwater","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Gargoyle","checkedOnline85":false}],"explanation74":"A gargoyle is a carved waterspout, whereas a grotesque need not have a drainage function.","questionId85":"GEN43-Q04314","reviewStatus85":"ready"},{"id":"REVISION85-4315","nodeId":"REVISION85-4315","anchor":"MAJOR:ARCHITECTURE","subject":"The dome of Florence Cathedral was constructed without:","value":"Full timber centring below the entire dome","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Florence_Cathedral","checkedOnline85":false}],"explanation74":"Brunelleschi's method avoided the full supporting timber centring normally used for such a span.","questionId85":"GEN43-Q04315","reviewStatus85":"ready"},{"id":"REVISION85-4316","nodeId":"REVISION85-4316","anchor":"MAJOR:ARCHITECTURE","subject":"Brunelleschi's Ospedale degli Innocenti was designed as a:","value":"Foundling hospital","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ospedale_degli_Innocenti","checkedOnline85":false}],"explanation74":"The Florentine institution cared for abandoned children.","questionId85":"GEN43-Q04316","reviewStatus85":"ready"},{"id":"REVISION85-4317","nodeId":"REVISION85-4317","anchor":"MAJOR:ARCHITECTURE","subject":"The Pazzi Chapel is attached to which Florentine complex?","value":"Santa Croce","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Pazzi_Chapel","checkedOnline85":false}],"explanation74":"The chapel stands in the first cloister of Santa Croce.","questionId85":"GEN43-Q04317","reviewStatus85":"ready"},{"id":"REVISION85-4318","nodeId":"REVISION85-4318","anchor":"ENT:RENAISSANCE","subject":"Sabbioneta's Renaissance planning is associated with which ruling family?","value":"Gonzaga","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sabbioneta","checkedOnline85":false}],"explanation74":"Vespasiano Gonzaga developed Sabbioneta as a planned Renaissance town.","questionId85":"GEN43-Q04318","reviewStatus85":"ready"},{"id":"REVISION85-4319","nodeId":"REVISION85-4319","anchor":"MAJOR:ARCHITECTURE","subject":"Villa d'Este at Tivoli is especially celebrated for its:","value":"Terraced water gardens","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Villa_d%27Este","checkedOnline85":false}],"explanation74":"Its Renaissance garden is organised around terraces, fountains and elaborate water effects.","questionId85":"GEN43-Q04319","reviewStatus85":"ready"},{"id":"REVISION85-4320","nodeId":"REVISION85-4320","anchor":"MAJOR:ARCHITECTURE","subject":"The Teatro Olimpico's permanent scenery represents:","value":"Streets receding in perspective","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Teatro_Olimpico","checkedOnline85":false}],"explanation74":"Vincenzo Scamozzi's stage streets use forced perspective behind the monumental stage front.","questionId85":"GEN43-Q04320","reviewStatus85":"ready"},{"id":"REVISION85-4321","nodeId":"REVISION85-4321","anchor":"MAJOR:ARCHITECTURE","subject":"The Scala Regia in the Vatican is especially associated with:","value":"Forced perspective","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Scala_Regia_(Vatican)","checkedOnline85":false}],"explanation74":"Bernini manipulated the columns and spatial dimensions to heighten the staircase's apparent depth.","questionId85":"GEN43-Q04321","reviewStatus85":"ready"},{"id":"REVISION85-4322","nodeId":"REVISION85-4322","anchor":"MAJOR:ARCHITECTURE","subject":"Filippo Juvarra's Basilica of Superga overlooks:","value":"Turin","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Basilica_of_Superga","checkedOnline85":false}],"explanation74":"Superga occupies a hill above Turin and served the House of Savoy.","questionId85":"GEN43-Q04322","reviewStatus85":"ready"},{"id":"REVISION85-4323","nodeId":"REVISION85-4323","anchor":"MAJOR:ARCHITECTURE","subject":"Boullée's celebrated design for a cenotaph honoured:","value":"Isaac Newton","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/%C3%89tienne-Louis_Boull%C3%A9e","checkedOnline85":false}],"explanation74":"Boullée proposed a vast spherical cenotaph for Newton; it was not built.","questionId85":"GEN43-Q04323","reviewStatus85":"ready"},{"id":"REVISION85-4324","nodeId":"REVISION85-4324","anchor":"MAJOR:ARCHITECTURE","subject":"The Crystal Palace was originally built for:","value":"The Great Exhibition","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Crystal_Palace","checkedOnline85":false}],"explanation74":"Joseph Paxton's prefabricated iron-and-glass building housed London's Great Exhibition of 1851.","questionId85":"GEN43-Q04324","reviewStatus85":"ready"},{"id":"REVISION85-4325","nodeId":"REVISION85-4325","anchor":"MAJOR:ARCHITECTURE","subject":"The Galerie des Machines of 1889 was a landmark of:","value":"Metal long-span construction","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Galerie_des_machines","checkedOnline85":false}],"explanation74":"The Paris exhibition hall used enormous metal arches to create an unobstructed interior.","questionId85":"GEN43-Q04325","reviewStatus85":"ready"},{"id":"REVISION85-4326","nodeId":"REVISION85-4326","anchor":"MAJOR:ARCHITECTURE","subject":"Haussmann's transformation of Paris is particularly associated with:","value":"Broad boulevards","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Haussmann%27s_renovation_of_Paris","checkedOnline85":false}],"explanation74":"The works opened broad avenues and reorganised infrastructure and urban spaces.","questionId85":"GEN43-Q04326","reviewStatus85":"ready"},{"id":"REVISION85-4327","nodeId":"REVISION85-4327","anchor":"MAJOR:ARCHITECTURE","subject":"The Barcelona Pavilion was built as the pavilion of:","value":"Germany","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Barcelona_Pavilion","checkedOnline85":false}],"explanation74":"Mies van der Rohe and Lilly Reich designed the German pavilion for the 1929 Barcelona exhibition.","questionId85":"GEN43-Q04327","reviewStatus85":"ready"},{"id":"REVISION85-4328","nodeId":"REVISION85-4328","anchor":"MAJOR:ARCHITECTURE","subject":"The Rietveld Schröder House is located in:","value":"Utrecht","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rietveld_Schr%C3%B6der_House","checkedOnline85":false}],"explanation74":"Rietveld's house for Truus Schröder stands in Utrecht.","questionId85":"GEN43-Q04328","reviewStatus85":"ready"},{"id":"REVISION85-4329","nodeId":"REVISION85-4329","anchor":"ENT:LE-CORBUSIER","subject":"Le Corbusier's Unité d'habitation in Marseille is primarily a:","value":"Residential building","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Unit%C3%A9_d%27habitation","checkedOnline85":false}],"explanation74":"The Unité combines apartments with shared facilities and services.","questionId85":"GEN43-Q04329","reviewStatus85":"ready"},{"id":"REVISION85-4330","nodeId":"REVISION85-4330","anchor":"MAJOR:ARCHITECTURE","subject":"The Seagram Building stands in:","value":"New York","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Seagram_Building","checkedOnline85":false}],"explanation74":"The office tower by Mies van der Rohe with Philip Johnson is on Park Avenue in New York.","questionId85":"GEN43-Q04330","reviewStatus85":"ready"},{"id":"REVISION85-4331","nodeId":"REVISION85-4331","anchor":"MAJOR:ARCHITECTURE","subject":"The urban plan of Brasília was designed by:","value":"Lúcio Costa","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/L%C3%BAcio_Costa","checkedOnline85":false}],"explanation74":"Costa's Plano Piloto established the city's main urban organisation.","questionId85":"GEN43-Q04331","reviewStatus85":"ready"},{"id":"REVISION85-4332","nodeId":"REVISION85-4332","anchor":"MAJOR:ARCHITECTURE","subject":"The Centre Pompidou's exposed pipes and circulation express an approach associated with:","value":"High-tech architecture","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Centre_Pompidou","checkedOnline85":false}],"explanation74":"The building puts services and circulation prominently on the exterior.","questionId85":"GEN43-Q04332","reviewStatus85":"ready"},{"id":"REVISION85-4333","nodeId":"REVISION85-4333","anchor":"MAJOR:ARCHITECTURE","subject":"Giovanni Michelucci's Church of the Autostrada stands near:","value":"Florence","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/San_Giovanni_Battista%2C_Campi_Bisenzio","checkedOnline85":false}],"explanation74":"The church of San Giovanni Battista is beside the motorway near Florence.","questionId85":"GEN43-Q04333","reviewStatus85":"ready"},{"id":"REVISION85-4334","nodeId":"REVISION85-4334","anchor":"MAJOR:ARCHITECTURE","subject":"Paolo Soleri's Arcosanti project is in:","value":"Arizona","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arcosanti","checkedOnline85":false}],"explanation74":"Arcosanti is an experimental settlement in Arizona exploring Soleri's idea of arcology.","questionId85":"GEN43-Q04334","reviewStatus85":"ready"},{"id":"REVISION85-4335","nodeId":"REVISION85-4335","anchor":"MAJOR:ARCHITECTURE","subject":"The term arcology combines architecture with:","value":"Ecology","group":"Architecture","major":"Architecture","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arcology","checkedOnline85":false}],"explanation74":"Paolo Soleri used arcology for the integration of architecture and ecology.","questionId85":"GEN43-Q04335","reviewStatus85":"ready"},{"id":"REVISION85-4336","nodeId":"REVISION85-4336","anchor":"MAJOR:ARCHITECTURE","subject":"The thermal baths at Vals were designed by:","value":"Peter Zumthor","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/7132_Thermal_Baths","checkedOnline85":false}],"explanation74":"Zumthor's Therme Vals is known for its carefully composed stone spaces.","questionId85":"GEN43-Q04336","reviewStatus85":"ready"},{"id":"REVISION85-4337","nodeId":"REVISION85-4337","anchor":"MAJOR:ARCHITECTURE","subject":"Tadao Ando's Church of the Light is in:","value":"Japan","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Church_of_the_Light","checkedOnline85":false}],"explanation74":"The church is in Ibaraki, Osaka Prefecture, Japan.","questionId85":"GEN43-Q04337","reviewStatus85":"ready"},{"id":"REVISION85-4338","nodeId":"REVISION85-4338","anchor":"MAJOR:ARCHITECTURE","subject":"The Guggenheim Museum in Bilbao helped transform a city in:","value":"The Basque Country","group":"Architecture","major":"Architecture","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Guggenheim_Museum_Bilbao","checkedOnline85":false}],"explanation74":"Bilbao is in Spain's Basque Country; the museum became central to its cultural regeneration.","questionId85":"GEN43-Q04338","reviewStatus85":"ready"},{"id":"REVISION85-4339","nodeId":"REVISION85-4339","anchor":"ENT:LE-CORBUSIER","subject":"Which building was NOT designed by Le Corbusier?","value":"Farnsworth House","group":"Architecture","major":"Architecture","era":"Other","relation":"exception discrimination","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Farnsworth_House","checkedOnline85":false}],"explanation74":"The Farnsworth House is by Mies van der Rohe; the other buildings are associated with Le Corbusier.","questionId85":"GEN43-Q04339","reviewStatus85":"ready"},{"id":"REVISION85-4340","nodeId":"REVISION85-4340","anchor":"MAJOR:ARCHITECTURE","subject":"Which is NOT a usual ingredient of Portland-cement concrete?","value":"Bitumen","group":"Architecture","major":"Architecture","era":"Other","relation":"exception discrimination","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Concrete","checkedOnline85":false}],"explanation74":"Portland-cement concrete uses cement, water and aggregates. Bitumen is the binder of asphalt concrete.","questionId85":"GEN43-Q04340","reviewStatus85":"ready"},{"id":"REVISION85-4341","nodeId":"REVISION85-4341","anchor":"MAJOR:ART-HISTORY","subject":"In painting, impasto refers to:","value":"Thickly applied paint","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Impasto","checkedOnline85":false}],"explanation74":"Impasto leaves paint visibly raised, often preserving brush or palette-knife marks.","questionId85":"GEN43-Q04341","reviewStatus85":"ready"},{"id":"REVISION85-4342","nodeId":"REVISION85-4342","anchor":"MAJOR:ART-HISTORY","subject":"A painting composed of three panels is a:","value":"Triptych","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Triptych","checkedOnline85":false}],"explanation74":"A triptych has three panels, often a central panel flanked by two wings.","questionId85":"GEN43-Q04342","reviewStatus85":"ready"},{"id":"REVISION85-4343","nodeId":"REVISION85-4343","anchor":"MAJOR:ART-HISTORY","subject":"A circular painting is called a:","value":"Tondo","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tondo","checkedOnline85":false}],"explanation74":"Tondo denotes a circular painting or relief.","questionId85":"GEN43-Q04343","reviewStatus85":"ready"},{"id":"REVISION85-4344","nodeId":"REVISION85-4344","anchor":"MAJOR:ART-HISTORY","subject":"The small painted panels beneath an altarpiece form the:","value":"Predella","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Predella","checkedOnline85":false}],"explanation74":"The predella is the base of an altarpiece and often contains smaller narrative scenes.","questionId85":"GEN43-Q04344","reviewStatus85":"ready"},{"id":"REVISION85-4345","nodeId":"REVISION85-4345","anchor":"MAJOR:ART-HISTORY","subject":"A woodcut is a form of:","value":"Relief printing","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Woodcut","checkedOnline85":false}],"explanation74":"Ink prints from the raised surfaces of a cut wooden block.","questionId85":"GEN43-Q04345","reviewStatus85":"ready"},{"id":"REVISION85-4346","nodeId":"REVISION85-4346","anchor":"MAJOR:ART-HISTORY","subject":"What is the term for sculpture whose forms remain attached to a background?","value":"Relief","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Relief","checkedOnline85":false}],"explanation74":"Relief sculpture projects from, or is cut into, a supporting background rather than standing fully free.","questionId85":"GEN43-Q04346","reviewStatus85":"ready"},{"id":"REVISION85-4347","nodeId":"REVISION85-4347","anchor":"MAJOR:ART-HISTORY","subject":"A tessera is a component of a:","value":"Mosaic","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Tessera","checkedOnline85":false}],"explanation74":"Tesserae are the small pieces of stone, glass or other material assembled into mosaics.","questionId85":"GEN43-Q04347","reviewStatus85":"ready"},{"id":"REVISION85-4348","nodeId":"REVISION85-4348","anchor":"MAJOR:ART-HISTORY","subject":"Which technique involves heating coloured glass-like material onto a metal surface?","value":"Enamelling","group":"Art History","major":"Art History","era":"Other","relation":"term function","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Vitreous_enamel","checkedOnline85":false}],"explanation74":"Enamel is fused to a surface through firing, often on metal objects.","questionId85":"GEN43-Q04348","reviewStatus85":"ready"},{"id":"REVISION85-4349","nodeId":"REVISION85-4349","anchor":"MAJOR:ART-HISTORY","subject":"The gold backgrounds of many Byzantine icons chiefly suggest:","value":"A sacred, non-naturalistic space","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Icon","checkedOnline85":false}],"explanation74":"Gold contributes to the icon's luminous sacred setting rather than reproducing ordinary spatial depth.","questionId85":"GEN43-Q04349","reviewStatus85":"ready"},{"id":"REVISION85-4350","nodeId":"REVISION85-4350","anchor":"MAJOR:ART-HISTORY","subject":"The mosaics of Justinian and Theodora are in:","value":"San Vitale, Ravenna","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Basilica_of_San_Vitale","checkedOnline85":false}],"explanation74":"The sixth-century imperial panels flank the sanctuary of San Vitale.","questionId85":"GEN43-Q04350","reviewStatus85":"ready"},{"id":"REVISION85-4351","nodeId":"REVISION85-4351","anchor":"MAJOR:ART-HISTORY","subject":"The Bayeux Tapestry depicts events surrounding the:","value":"Norman conquest of England","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bayeux_Tapestry","checkedOnline85":false}],"explanation74":"The embroidered narrative depicts the Norman invasion and Battle of Hastings. Despite its name, it is embroidery, not woven tapestry.","questionId85":"GEN43-Q04351","reviewStatus85":"ready"},{"id":"REVISION85-4352","nodeId":"REVISION85-4352","anchor":"ENT:GIOTTO","subject":"Giotto's frescoes in the Scrovegni Chapel include scenes from the lives of:","value":"The Virgin and Christ","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Scrovegni_Chapel","checkedOnline85":false}],"explanation74":"The chapel's main narrative cycles recount the lives of Mary and Christ, with the Last Judgement on the entrance wall.","questionId85":"GEN43-Q04352","reviewStatus85":"ready"},{"id":"REVISION85-4353","nodeId":"REVISION85-4353","anchor":"MAJOR:ART-HISTORY","subject":"The competition for the Florence Baptistery doors in 1401 required a panel showing:","value":"The Sacrifice of Isaac","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Florence_Baptistery","checkedOnline85":false}],"explanation74":"The surviving competition panels of Ghiberti and Brunelleschi depict Abraham's sacrifice of Isaac.","questionId85":"GEN43-Q04353","reviewStatus85":"ready"},{"id":"REVISION85-4354","nodeId":"REVISION85-4354","anchor":"MAJOR:ART-HISTORY","subject":"Raphael's School of Athens presents an assembly of:","value":"Ancient philosophers","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_School_of_Athens","checkedOnline85":false}],"explanation74":"Plato and Aristotle stand at the centre of an ideal gathering of ancient thinkers.","questionId85":"GEN43-Q04354","reviewStatus85":"ready"},{"id":"REVISION85-4355","nodeId":"REVISION85-4355","anchor":"MAJOR:ART-HISTORY","subject":"Paolo Veronese's Feast in the House of Levi was originally conceived as a:","value":"Last Supper","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Feast_in_the_House_of_Levi","checkedOnline85":false}],"explanation74":"The painting's title was changed after scrutiny of the unconventional figures in the scene.","questionId85":"GEN43-Q04355","reviewStatus85":"ready"},{"id":"REVISION85-4356","nodeId":"REVISION85-4356","anchor":"MAJOR:ART-HISTORY","subject":"Which painter appears at a canvas on the left of Las Meninas?","value":"Diego Velázquez","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Las_Meninas","checkedOnline85":false}],"explanation74":"Velázquez appears standing at his large canvas on the left of the composition.","questionId85":"GEN43-Q04356","reviewStatus85":"ready"},{"id":"REVISION85-4357","nodeId":"REVISION85-4357","anchor":"MAJOR:ART-HISTORY","subject":"Rembrandt's Night Watch depicts a:","value":"Civic militia company","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Night_Watch","checkedOnline85":false}],"explanation74":"The painting is a group portrait of an Amsterdam militia company, not a night-time military battle.","questionId85":"GEN43-Q04357","reviewStatus85":"ready"},{"id":"REVISION85-4358","nodeId":"REVISION85-4358","anchor":"MAJOR:ART-HISTORY","subject":"Watteau's scenes of elegant outdoor sociability are called:","value":"Fêtes galantes","group":"Art History","major":"Art History","era":"Other","relation":"classification style","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/F%C3%AAte_galante","checkedOnline85":false}],"explanation74":"The fête galante became closely associated with Watteau's Rococo painting.","questionId85":"GEN43-Q04358","reviewStatus85":"ready"},{"id":"REVISION85-4359","nodeId":"REVISION85-4359","anchor":"MAJOR:ART-HISTORY","subject":"Jacques-Louis David's Oath of the Horatii draws its subject from:","value":"Ancient Roman legend","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Oath_of_the_Horatii","checkedOnline85":false}],"explanation74":"David used the legend of the Horatii to evoke civic duty and sacrifice.","questionId85":"GEN43-Q04359","reviewStatus85":"ready"},{"id":"REVISION85-4360","nodeId":"REVISION85-4360","anchor":"MAJOR:ART-HISTORY","subject":"Manet's Olympia deliberately reworks a theme associated with:","value":"The reclining Venus","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Olympia_(Manet)","checkedOnline85":false}],"explanation74":"Olympia engages with the tradition of the reclining nude, notably Titian's Venus of Urbino.","questionId85":"GEN43-Q04360","reviewStatus85":"ready"},{"id":"REVISION85-4361","nodeId":"REVISION85-4361","anchor":"MAJOR:ART-HISTORY","subject":"Van Gogh's bedroom paintings depict his room in:","value":"Arles","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bedroom_in_Arles","checkedOnline85":false}],"explanation74":"The bedroom was in the Yellow House at Arles.","questionId85":"GEN43-Q04361","reviewStatus85":"ready"},{"id":"REVISION85-4362","nodeId":"REVISION85-4362","anchor":"MAJOR:ART-HISTORY","subject":"Cézanne repeatedly painted which mountain?","value":"Mont Sainte-Victoire","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Mont_Sainte-Victoire_(C%C3%A9zanne)","checkedOnline85":false}],"explanation74":"The mountain near Aix-en-Provence became a recurring motif in Cézanne's work.","questionId85":"GEN43-Q04362","reviewStatus85":"ready"},{"id":"REVISION85-4363","nodeId":"REVISION85-4363","anchor":"MAJOR:ART-HISTORY","subject":"Picasso's Guernica responds to the bombing of a town during the:","value":"Spanish Civil War","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Guernica_(Picasso)","checkedOnline85":false}],"explanation74":"The painting was created in response to the 1937 bombing of Guernica.","questionId85":"GEN43-Q04363","reviewStatus85":"ready"},{"id":"REVISION85-4364","nodeId":"REVISION85-4364","anchor":"ENT:ANDY-WARHOL","subject":"Andy Warhol's Campbell's Soup Cans connects art with:","value":"Mass-produced consumer goods","group":"Art History","major":"Art History","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Campbell%27s_Soup_Cans","checkedOnline85":false}],"explanation74":"The series draws on everyday commercial packaging and the repetition of consumer imagery.","questionId85":"GEN43-Q04364","reviewStatus85":"ready"},{"id":"REVISION85-4365","nodeId":"REVISION85-4365","anchor":"MAJOR:ART-HISTORY","subject":"Which artist is NOT generally grouped with the Impressionists?","value":"Gustave Courbet","group":"Art History","major":"Art History","era":"Other","relation":"exception discrimination","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Impressionism","checkedOnline85":false}],"explanation74":"Courbet is a central figure of Realism; the other four are core Impressionist painters.","questionId85":"GEN43-Q04365","reviewStatus85":"ready"},{"id":"REVISION85-4366","nodeId":"REVISION85-4366","anchor":"MAJOR:ART-HISTORY","subject":"Which material is NOT a conventional medium for sculpture in the round?","value":"Watercolour wash","group":"Art History","major":"Art History","era":"Other","relation":"exception discrimination","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Sculpture","checkedOnline85":false}],"explanation74":"A watercolour wash is a painting technique; the other materials commonly form freestanding sculptures.","questionId85":"GEN43-Q04366","reviewStatus85":"ready"},{"id":"REVISION85-4367","nodeId":"REVISION85-4367","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"The Baron in the Trees was written by:","value":"Italo Calvino","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Baron_in_the_Trees","checkedOnline85":false}],"explanation74":"Calvino's novel follows Cosimo, who chooses to live in the trees.","questionId85":"GEN43-Q04367","reviewStatus85":"ready"},{"id":"REVISION85-4368","nodeId":"REVISION85-4368","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote The Desert of the Tartars?","value":"Dino Buzzati","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Tartar_Steppe","checkedOnline85":false}],"explanation74":"Buzzati's novel follows officer Giovanni Drogo at a remote fortress.","questionId85":"GEN43-Q04368","reviewStatus85":"ready"},{"id":"REVISION85-4369","nodeId":"REVISION85-4369","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"The Day of the Owl is a novel by:","value":"Leonardo Sciascia","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Day_of_the_Owl","checkedOnline85":false}],"explanation74":"Sciascia's novel examines a murder and the power of the Sicilian Mafia.","questionId85":"GEN43-Q04369","reviewStatus85":"ready"},{"id":"REVISION85-4370","nodeId":"REVISION85-4370","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote The Time of Indifference (Gli indifferenti)?","value":"Alberto Moravia","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Time_of_Indifference","checkedOnline85":false}],"explanation74":"Moravia's debut novel examines a bourgeois family's moral and emotional indifference.","questionId85":"GEN43-Q04370","reviewStatus85":"ready"},{"id":"REVISION85-4371","nodeId":"REVISION85-4371","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Family Lexicon (Lessico famigliare) is by:","value":"Natalia Ginzburg","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Family_Lexicon","checkedOnline85":false}],"explanation74":"Ginzburg reconstructs family life through remembered expressions, speech and events.","questionId85":"GEN43-Q04371","reviewStatus85":"ready"},{"id":"REVISION85-4372","nodeId":"REVISION85-4372","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote Arturo's Island?","value":"Elsa Morante","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Arturo%27s_Island","checkedOnline85":false}],"explanation74":"Morante's novel is set largely on the island of Procida.","questionId85":"GEN43-Q04372","reviewStatus85":"ready"},{"id":"REVISION85-4373","nodeId":"REVISION85-4373","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Ariosto's Orlando Furioso belongs primarily to which literary tradition?","value":"Chivalric romance","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Orlando_Furioso","checkedOnline85":false}],"explanation74":"The poem combines chivalric adventure, love, warfare and fantastic journeys.","questionId85":"GEN43-Q04373","reviewStatus85":"ready"},{"id":"REVISION85-4374","nodeId":"REVISION85-4374","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Tasso's Jerusalem Delivered draws on the:","value":"First Crusade","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jerusalem_Delivered","checkedOnline85":false}],"explanation74":"The epic treats the Christian capture of Jerusalem during the First Crusade.","questionId85":"GEN43-Q04374","reviewStatus85":"ready"},{"id":"REVISION85-4375","nodeId":"REVISION85-4375","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Which Italian writer is associated with the town of Recanati?","value":"Giacomo Leopardi","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Giacomo_Leopardi","checkedOnline85":false}],"explanation74":"Leopardi was born and spent much of his youth in Recanati.","questionId85":"GEN43-Q04375","reviewStatus85":"ready"},{"id":"REVISION85-4376","nodeId":"REVISION85-4376","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Homer's Odyssey centres on the return of Odysseus to:","value":"Ithaca","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Odyssey","checkedOnline85":false}],"explanation74":"Odysseus struggles to return to Ithaca after the Trojan War.","questionId85":"GEN43-Q04376","reviewStatus85":"ready"},{"id":"REVISION85-4377","nodeId":"REVISION85-4377","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Virgil's Aeneid follows a hero fleeing from:","value":"Troy","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Aeneid","checkedOnline85":false}],"explanation74":"Aeneas leaves the destroyed Troy and ultimately reaches Italy.","questionId85":"GEN43-Q04377","reviewStatus85":"ready"},{"id":"REVISION85-4378","nodeId":"REVISION85-4378","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote The Metamorphosis, in which Gregor Samsa wakes transformed?","value":"Franz Kafka","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Metamorphosis","checkedOnline85":false}],"explanation74":"Kafka's novella opens with Gregor Samsa's unexplained transformation.","questionId85":"GEN43-Q04378","reviewStatus85":"ready"},{"id":"REVISION85-4379","nodeId":"REVISION85-4379","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Joyce's Ulysses is set chiefly in:","value":"Dublin","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ulysses_(novel)","checkedOnline85":false}],"explanation74":"The novel follows its principal characters through Dublin over the course of a day.","questionId85":"GEN43-Q04379","reviewStatus85":"ready"},{"id":"REVISION85-4380","nodeId":"REVISION85-4380","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote The Picture of Dorian Gray?","value":"Oscar Wilde","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Picture_of_Dorian_Gray","checkedOnline85":false}],"explanation74":"Wilde's novel centres on a portrait that ages while its subject remains outwardly young.","questionId85":"GEN43-Q04380","reviewStatus85":"ready"},{"id":"REVISION85-4381","nodeId":"REVISION85-4381","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Cervantes' Don Quixote is accompanied by:","value":"Sancho Panza","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Don_Quixote","checkedOnline85":false}],"explanation74":"Sancho Panza serves as Don Quixote's squire and companion.","questionId85":"GEN43-Q04381","reviewStatus85":"ready"},{"id":"REVISION85-4382","nodeId":"REVISION85-4382","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Goethe's Faust makes a pact with:","value":"Mephistopheles","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Goethe%27s_Faust","checkedOnline85":false}],"explanation74":"Mephistopheles is the demonic figure who accompanies Faust.","questionId85":"GEN43-Q04382","reviewStatus85":"ready"},{"id":"REVISION85-4383","nodeId":"REVISION85-4383","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Orwell's Animal Farm is presented through a rebellion by:","value":"Farm animals","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Animal_Farm","checkedOnline85":false}],"explanation74":"The animal fable becomes an allegory of revolution and authoritarian rule.","questionId85":"GEN43-Q04383","reviewStatus85":"ready"},{"id":"REVISION85-4384","nodeId":"REVISION85-4384","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote The Little Prince?","value":"Antoine de Saint-Exupéry","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Little_Prince","checkedOnline85":false}],"explanation74":"Saint-Exupéry's short book combines a fable with reflections on friendship and adult life.","questionId85":"GEN43-Q04384","reviewStatus85":"ready"},{"id":"REVISION85-4385","nodeId":"REVISION85-4385","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Mary Shelley's Frankenstein centres on an attempt to:","value":"Create life","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Frankenstein","checkedOnline85":false}],"explanation74":"Victor Frankenstein creates a living being and confronts the consequences of abandoning it.","questionId85":"GEN43-Q04385","reviewStatus85":"ready"},{"id":"REVISION85-4386","nodeId":"REVISION85-4386","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Mozart's Don Giovanni is based on the legend of:","value":"Don Juan","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Don_Giovanni","checkedOnline85":false}],"explanation74":"The opera adapts the Don Juan tradition of the libertine confronted by supernatural judgement.","questionId85":"GEN43-Q04386","reviewStatus85":"ready"},{"id":"REVISION85-4387","nodeId":"REVISION85-4387","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Wagner's Ring cycle consists of how many operas?","value":"Four","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Der_Ring_des_Nibelungen","checkedOnline85":false}],"explanation74":"The cycle comprises Das Rheingold, Die Walküre, Siegfried and Götterdämmerung.","questionId85":"GEN43-Q04387","reviewStatus85":"ready"},{"id":"REVISION85-4388","nodeId":"REVISION85-4388","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Beethoven's Ninth Symphony sets words from a poem by:","value":"Friedrich Schiller","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Symphony_No._9_(Beethoven)","checkedOnline85":false}],"explanation74":"Its choral finale sets Schiller's Ode to Joy.","questionId85":"GEN43-Q04388","reviewStatus85":"ready"},{"id":"REVISION85-4389","nodeId":"REVISION85-4389","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who composed The Rite of Spring?","value":"Igor Stravinsky","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Rite_of_Spring","checkedOnline85":false}],"explanation74":"Stravinsky's ballet is famous for its rhythmic intensity and its 1913 Paris premiere.","questionId85":"GEN43-Q04389","reviewStatus85":"ready"},{"id":"REVISION85-4390","nodeId":"REVISION85-4390","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who directed Rome, Open City?","value":"Roberto Rossellini","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Rome%2C_Open_City","checkedOnline85":false}],"explanation74":"Rossellini's film became a central work of Italian Neorealism.","questionId85":"GEN43-Q04390","reviewStatus85":"ready"},{"id":"REVISION85-4391","nodeId":"REVISION85-4391","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Bicycle Thieves is chiefly set in:","value":"Rome","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Bicycle_Thieves","checkedOnline85":false}],"explanation74":"De Sica's film follows a worker and his son searching