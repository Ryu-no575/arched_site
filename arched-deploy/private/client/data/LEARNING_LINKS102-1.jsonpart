9e8c12fc","title":"Georges Seurat","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Georges%20Seurat","aliases":["Georges Seurat"],"photos":[],"questionIds":["PDF33-Q082-B"],"tapestryIds":["t68-70a8c9f69a10"],"museumIds":[],"mapIds":[],"note":"Neo-Impressionist painter who investigated systematic colour juxtaposition."},{"id":"LE102-d997a533bcf990d7","title":"Expedition of the Thousand","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Expedition%20of%20the%20Thousand","aliases":["Expedition of the Thousand"],"photos":[],"questionIds":["GEN43-Q04153","ALPHA-B006-Q633","PDF35-Q031-A"],"tapestryIds":["t68-02be20f6097f"],"museumIds":[],"mapIds":[],"note":"Garibaldi's volunteers conquered Sicily and southern Italy before their incorporation into the monarchy."},{"id":"LE102-4ba7740210388dc9","title":"Impressionist colour and visible brushwork","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Impressionist%20colour%20and%20visible%20brushwork","aliases":["Impressionist colour and visible brushwork"],"photos":[],"questionIds":[],"tapestryIds":["t69-03223254c2eb"],"museumIds":[],"mapIds":[],"note":"Broken touches and attention to changing light challenge academic finish. Many paintings were reworked in studios; plein-air painting is not the sole defining feature."},{"id":"LE102-6b8ac9ab1f61b4b0","title":"Arts and Crafts: design, labour and making","kind":"architecture","reference":"https://www.vam.ac.uk/articles/arts-and-crafts-an-introduction","aliases":["Arts and Crafts: design, labour and making"],"photos":[],"questionIds":[],"tapestryIds":["t69-edc7be28c838"],"museumIds":[],"mapIds":[],"note":"The movement connected the quality of design with conditions of production and craft. It included different responses to machinery, not one universal ban on industry.","built":"1860"},{"id":"LE102-edd846e99b19244d","title":"Kingdom of Italy proclaimed","kind":"history","reference":"https://www.quirinale.it/it/pa