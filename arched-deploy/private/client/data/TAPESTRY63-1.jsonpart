tch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=36f33fc963b763daef40c8b7.webp","credit":"Pablo Picasso","license":"Copyrighted artwork; reproduction from Wikipedia. Commercial-use permission not established.","url":"https://en.wikipedia.org/wiki/File:PicassoGuernica.jpg","scope":"Reproduction of Picasso's painting, 1937; original in the Museo Reina Sofía, Madrid."},"imageChecked78":"2026-10-05"},{"id":"t68-4d99ffc71ad5","title":"Italy joins the Anti-Comintern Pact","lane":"history","start":1937,"end":1937,"approx":false,"note":"Italy joined Germany and Japan in an anti-communist pact; distinguish from the 1940 Tripartite Pact.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Italy%20joins%20the%20Anti-Comintern%20Pact","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["italy","central","other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-ccd1bab3bd1d","title":"Italy leaves the League of Nations","lane":"history","start":1937,"end":1937,"approx":false,"note":"The withdrawal followed international conflict over its invasion of Ethiopia.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Italy%20leaves%20the%20League%20of%20Nations","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-c16b790766e0","title":"Montserrat","lane":"art","start":1937,"end":1937,"approx":false,"note":"A sculptural response associated with the Spanish Civil War and the 1937 Spanish pavilion.","creators":["Julio González"],"reference":"https://en.wikipedia.org/w/index.php?search=Montserrat","sourceSheets":[3646],"sourceMapping":"item","dateType":"year","threads67":["iberia","france"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","mediaType78":"visual-artwork","image":{"sr