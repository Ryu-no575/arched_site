concrete and opus caementicium","lane":"architecture","start":-200,"end":300,"approx":true,"note":"Concrete combined aggregate with a binding mortar and allowed flexible mass construction. Brick or stone facing can conceal a concrete core.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Roman%20concrete%20and%20opus%20caementicium","sourceSheets":[],"sourceMapping":"Editorial study concept, not a photo transcription","dateType":"study window","dateQualifier":"Study period, not an event date","threads67":["italy"],"setting67":"Historical / cultural study context","kind69":"concept"},{"id":"t63-51752d0321e4","title":"Battle of Pydna","lane":"history","start":-168,"end":-168,"approx":false,"note":"Roman victory over Macedon.","creators":[],"reference":"https://en.wikipedia.org/wiki/Battle_of_Pydna","sourceSheets":[3633],"sourceMapping":"period context","dateType":"year","threads67":["eastmed"],"setting67":"Historical setting"},{"id":"t63-6cc6f896ca5c","title":"Venus de Milo","lane":"art","start":-150,"end":-125,"approx":true,"note":"Hellenistic sculpture; attribution to Alexandros of Antioch is debated.","creators":[],"reference":"https://en.wikipedia.org/wiki/Venus_de_Milo","sourceSheets":[3633],"sourceMapping":"item","dateType":"period","dateQualifier":"Uncertain","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified","mediaType78":"visual-artwork","image":{"src":"/.netlify/functions/access?action=media&name=058d0311d34413fc6c150fdd.webp","credit":"Livioandronico2013","license":"CC BY-SA 4.0","url":"https://commons.wikimedia.org/wiki/File:Front_views_of_the_Venus_de_Milo.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t63-9f2ba14e61b4","title":"Third Punic War","lane":"history","start":-149,"end":-146,"approx":false,"note":"Destruction of Carthage in 146 BCE.","creators":[],"reference":"https://en.wikipedia.org/wiki/Third_Punic_War",