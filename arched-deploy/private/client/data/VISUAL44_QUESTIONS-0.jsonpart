[{"id":"VIS44-Q11001","qid":11001,"nodeId":"MET44-436526","relatedNodeIds":["MET44-436526"],"major":"Art History","group":"visual art","imageId":"MET44-436526","stem":"Which artist painted the work shown?","choices":["Vincent van Gogh","Camille Pissarro","Paul Cézanne","Georges Seurat","Pierre-Auguste Renoir"],"correctIndex":0,"answer":"Vincent van Gogh","explanation":"Vincent van Gogh painted First Steps, after Millet (1890).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436526,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436526"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"e1377ccaca6d64d1e63e"},{"id":"VIS44-Q11002","qid":11002,"nodeId":"MET44-436526","relatedNodeIds":["MET44-436526"],"major":"Art History","group":"visual art","imageId":"MET44-436526","stem":"What is the title of the painting shown?","choices":["Salisbury Cathedral from the Bishop's Grounds","Two Young Peasant Women","First Steps, after Millet","Wheat Field with Cypresses","Circus Sideshow (Parade de cirque)"],"correctIndex":2,"answer":"First Steps, after Millet","explanation":"This is First Steps, after Millet, by Vincent van Gogh (1890).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436526,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436526"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"ade554bc97e1e29c6be8"},{"id":"VIS44-Q11003","qid":11003,"nodeId":"MET44-436526","relatedNodeIds":["MET44-436526"],"major":"Art History","group":"visual art","imageId":"MET44-436526","stem":"How did Van Gogh reinterpret Millet's First Steps?","choices":["He copied an ancient marble group","He commissioned Millet to finish the figures","He painted the scene from a family posing outdoors","He copied Millet's colours without alteration","He supplied his own colours to a monochrome reproduction"],"correctIndex":4,"answer":"He supplied his own colours to a monochrome reproduction","explanation":"Van Gogh worked from a photograph of Millet's composition and improvised its colours. The work is a creative translation of an earlier image.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436526,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436526"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"392ba6c2684c030eecf5","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11004","qid":11004,"nodeId":"MET44-436527","relatedNodeIds":["MET44-436527"],"major":"Art History","group":"visual art","imageId":"MET44-436527","stem":"Which artist painted the work shown?","choices":["Camille Pissarro","Georges Seurat","Pierre-Auguste Renoir","Vincent van Gogh","Paul Cézanne"],"correctIndex":3,"answer":"Vincent van Gogh","explanation":"Vincent van Gogh painted The Flowering Orchard (1888).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436527,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436527"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"616be98b44ee7d094aaf"},{"id":"VIS44-Q11005","qid":11005,"nodeId":"MET44-436527","relatedNodeIds":["MET44-436527"],"major":"Art History","group":"visual art","imageId":"MET44-436527","stem":"What is the title of the painting shown?","choices":["A Washerwoman at Eragny","The Flowering Orchard","The Brioche","Study Head of an Old Man with a White Beard","Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)"],"correctIndex":1,"answer":"The Flowering Orchard","explanation":"This is The Flowering Orchard, by Vincent van Gogh (1888).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436527,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436527"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"97a171ae87cb95ed8b45"},{"id":"VIS44-Q11006","qid":11006,"nodeId":"MET44-436527","relatedNodeIds":["MET44-436527"],"major":"Art History","group":"visual art","imageId":"MET44-436527","stem":"Which influence is particularly evident in the angular branches of Van Gogh's The Flowering Orchard?","choices":["Japanese prints","Roman military reliefs","French court portraiture","Byzantine mosaics","Dutch marine painting"],"correctIndex":0,"answer":"Japanese prints","explanation":"The elongated, angular branches reflect Van Gogh's admiration for Japanese prints. This connects a visible compositional feature to Japonisme.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436527,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436527"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"be884c8486594c9b6871","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11007","qid":11007,"nodeId":"MET44-436530","relatedNodeIds":["MET44-436530"],"major":"Art History","group":"visual art","imageId":"MET44-436530","stem":"Which artist painted the work shown?","choices":["Pierre-Auguste Renoir","Georges Seurat","Camille Pissarro","Paul Cézanne","Vincent van Gogh"],"correctIndex":4,"answer":"Vincent van Gogh","explanation":"Vincent van Gogh painted Oleanders (1888).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436530,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436530"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"b5b22520a1d4a39a6cf3"},{"id":"VIS44-Q11008","qid":11008,"nodeId":"MET44-436530","relatedNodeIds":["MET44-436530"],"major":"Art History","group":"visual art","imageId":"MET44-436530","stem":"What is the title of the painting shown?","choices":["Wheat Field with Cypresses","The Triumph of Henry IV","Oleanders","The Old Italian Woman","Venice, from the Porch of Madonna della Salute"],"correctIndex":2,"answer":"Oleanders","explanation":"This is Oleanders, by Vincent van Gogh (1888).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436530,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436530"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"ced7e4e30f6694963124"},{"id":"VIS44-Q11009","qid":11009,"nodeId":"MET44-436530","relatedNodeIds":["MET44-436530"],"major":"Art History","group":"visual art","imageId":"MET44-436530","stem":"The book in Van Gogh's Oleanders connects the still life with which writer?","choices":["Victor Hugo","Gustave Flaubert","Honoré de Balzac","Émile Zola","Charles Baudelaire"],"correctIndex":3,"answer":"Émile Zola","explanation":"The book is Zola's La joie de vivre. Its presence alongside the flowers contributes to the painting's life-affirming associations.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436530,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436530"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"941c262c231d8f0c3e18","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11010","qid":11010,"nodeId":"MET44-436535","relatedNodeIds":["MET44-436535"],"major":"Art History","group":"visual art","imageId":"MET44-436535","stem":"Which artist painted the work shown?","choices":["Camille Pissarro","Georges Seurat","Vincent van Gogh","Paul Cézanne","Pierre-Auguste Renoir"],"correctIndex":2,"answer":"Vincent van Gogh","explanation":"Vincent van Gogh painted Wheat Field with Cypresses (1889).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436535,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436535"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"60f477f51365cceeeaf8"},{"id":"VIS44-Q11011","qid":11011,"nodeId":"MET44-436535","relatedNodeIds":["MET44-436535"],"major":"Art History","group":"visual art","imageId":"MET44-436535","stem":"What is the title of the painting shown?","choices":["The Holy Family with Saint Elizabeth, Saint John, and a Dove","Wheat Field with Cypresses","Bouquet of Chrysanthemums","Study for \"A Sunday on La Grande Jatte\"","The Old Italian Woman"],"correctIndex":1,"answer":"Wheat Field with Cypresses","explanation":"This is Wheat Field with Cypresses, by Vincent van Gogh (1889).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436535,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436535"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"add339a19ed6d7dfac58"},{"id":"VIS44-Q11012","qid":11012,"nodeId":"MET44-436535","relatedNodeIds":["MET44-436535"],"major":"Art History","group":"visual art","imageId":"MET44-436535","stem":"Which term describes the thick, raised paint in Wheat Field with Cypresses?","choices":["Impasto","Grisaille","Glazing","Fresco","Sfumato"],"correctIndex":0,"answer":"Impasto","explanation":"Impasto leaves paint standing above the surface. The Met identifies rich impasto as a characteristic of this outdoor study.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436535,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436535"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"d5781027b69659ed2506","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11013","qid":11013,"nodeId":"MET44-437428","relatedNodeIds":["MET44-437428"],"major":"Art History","group":"visual art","imageId":"MET44-437428","stem":"Which artist painted the work shown?","choices":["Georges Seurat","Camille Pissarro","Pierre-Auguste Renoir","Edgar Degas","Paul Cézanne"],"correctIndex":2,"answer":"Pierre-Auguste Renoir","explanation":"Pierre-Auguste Renoir painted Still Life with Peaches and Grapes (1881).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437428,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437428"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"660542e95b41ccfd2c27"},{"id":"VIS44-Q11014","qid":11014,"nodeId":"MET44-437428","relatedNodeIds":["MET44-437428"],"major":"Art History","group":"visual art","imageId":"MET44-437428","stem":"What is the title of the painting shown?","choices":["Oleanders","Study Head of an Old Man with a White Beard","Washerwoman, Study","Hills around the Bay of Moulin Huet, Guernsey","Still Life with Peaches and Grapes"],"correctIndex":4,"answer":"Still Life with Peaches and Grapes","explanation":"This is Still Life with Peaches and Grapes, by Pierre-Auguste Renoir (1881).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437428,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437428"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"acb5048396e62cdf31b7"},{"id":"VIS44-Q11015","qid":11015,"nodeId":"MET44-437428","relatedNodeIds":["MET44-437428"],"major":"Art History","group":"visual art","imageId":"MET44-437428","stem":"Renoir painted two related arrangements of peaches at Wargemont. What did he vary between them?","choices":["The proportions of an altarpiece","The inscription identifying a monarch","The printmaking plates","The colour harmonies","The sequence of biblical events"],"correctIndex":3,"answer":"The colour harmonies","explanation":"The two still lifes use contrasting colour harmonies. Their similar subject allowed Renoir to explore different effects of colour.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437428,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437428"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"eef03cbed839e7bf2ba4","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11016","qid":11016,"nodeId":"MET44-437431","relatedNodeIds":["MET44-437431"],"major":"Art History","group":"visual art","imageId":"MET44-437431","stem":"Which artist painted the work shown?","choices":["Georges Seurat","Vincent van Gogh","Camille Pissarro","Edgar Degas","Pierre-Auguste Renoir"],"correctIndex":4,"answer":"Pierre-Auguste Renoir","explanation":"Pierre-Auguste Renoir painted Hills around the Bay of Moulin Huet, Guernsey (1883).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437431,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437431"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"59a588423c4d26d1c21c"},{"id":"VIS44-Q11017","qid":11017,"nodeId":"MET44-437431","relatedNodeIds":["MET44-437431"],"major":"Art History","group":"visual art","imageId":"MET44-437431","stem":"What is the title of the painting shown?","choices":["Still Life with Peaches and Grapes","Queen Henrietta Maria","The Gardener","Hills around the Bay of Moulin Huet, Guernsey","Antoine Dominique Sauveur Aubert (born 1817), the Artist's Uncle, as a Monk"],"correctIndex":3,"answer":"Hills around the Bay of Moulin Huet, Guernsey","explanation":"This is Hills around the Bay of Moulin Huet, Guernsey, by Pierre-Auguste Renoir (1883).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437431,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437431"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"36fe9a72942abbcd52d6"},{"id":"VIS44-Q11018","qid":11018,"nodeId":"MET44-437431","relatedNodeIds":["MET44-437431"],"major":"Art History","group":"visual art","imageId":"MET44-437431","stem":"Which place is depicted in Renoir's Hills around the Bay of Moulin Huet?","choices":["The Bay of Naples","Guernsey in the English Channel","The harbour of Le Havre","Collioure in southern France","Étretat in Normandy"],"correctIndex":1,"answer":"Guernsey in the English Channel","explanation":"Moulin Huet is on Guernsey. Renoir made several views during a visit, connecting this landscape to a specific journey.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437431,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437431"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"26c2a65cf60f84094460","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11019","qid":11019,"nodeId":"MET44-437434","relatedNodeIds":["MET44-437434"],"major":"Art History","group":"visual art","imageId":"MET44-437434","stem":"Which artist painted the work shown?","choices":["Camille Pissarro","Paul Cézanne","Georges Seurat","Vincent van Gogh","Pierre-Auguste Renoir"],"correctIndex":4,"answer":"Pierre-Auguste Renoir","explanation":"Pierre-Auguste Renoir painted In the Meadow (1888–92).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437434,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437434"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"546fe175e93c3454e021"},{"id":"VIS44-Q11020","qid":11020,"nodeId":"MET44-437434","relatedNodeIds":["MET44-437434"],"major":"Art History","group":"visual art","imageId":"MET44-437434","stem":"What is the title of the painting shown?","choices":["The Fishermen (Fantastic Scene)","In the Meadow","The Holy Family with Saint Elizabeth, Saint John, and a Dove","Wheat Field with Cypresses","Young Woman with Ibis"],"correctIndex":1,"answer":"In the Meadow","explanation":"This is In the Meadow, by Pierre-Auguste Renoir (1888–92).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437434,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437434"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"f0f73da3625cc6b310cc"},{"id":"VIS44-Q11021","qid":11021,"nodeId":"MET44-437434","relatedNodeIds":["MET44-437434"],"major":"Art History","group":"visual art","imageId":"MET44-437434","stem":"Which description correctly classifies Renoir's In the Meadow?","choices":["A genre scene of everyday leisure","An altarpiece for public devotion","A military history painting","A political allegory of national unity","A formal royal portrait"],"correctIndex":0,"answer":"A genre scene of everyday leisure","explanation":"The girls are picking flowers. Such everyday activities are the subject of genre painting, rather than a grand historical or religious narrative.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437434,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437434"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"e00ad4c0a3fcb185cc2d","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11022","qid":11022,"nodeId":"MET44-438012","relatedNodeIds":["MET44-438012"],"major":"Art History","group":"visual art","imageId":"MET44-438012","stem":"Which artist painted the work shown?","choices":["Edgar Degas","Paul Cézanne","Camille Pissarro","Pierre-Auguste Renoir","Georges Seurat"],"correctIndex":3,"answer":"Pierre-Auguste Renoir","explanation":"Pierre-Auguste Renoir painted Bouquet of Chrysanthemums (1881).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438012,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438012"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"a046283369f82bc0355f"},{"id":"VIS44-Q11023","qid":11023,"nodeId":"MET44-438012","relatedNodeIds":["MET44-438012"],"major":"Art History","group":"visual art","imageId":"MET44-438012","stem":"What is the title of the painting shown?","choices":["Bouquet of Chrysanthemums","The Supper at Emmaus","Flora","Wheat Field with Cypresses","Dancers in the Rehearsal Room with a Double Bass"],"correctIndex":0,"answer":"Bouquet of Chrysanthemums","explanation":"This is Bouquet of Chrysanthemums, by Pierre-Auguste Renoir (1881).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438012,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438012"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"37ac2bffe6491e089c1f"},{"id":"VIS44-Q11024","qid":11024,"nodeId":"MET44-438012","relatedNodeIds":["MET44-438012"],"major":"Art History","group":"visual art","imageId":"MET44-438012","stem":"Why did Renoir value flower still lifes as a place to experiment?","choices":["They avoided all decisions about colour","They gave him freedom to explore tones and values","They required an identical composition for every canvas","They had to reproduce botanical specimens at life size","They required him to eliminate visible brushwork"],"correctIndex":1,"answer":"They gave him freedom to explore tones and values","explanation":"Renoir described flower painting as an opportunity for freer experiments with tones and values. Bouquet of Chrysanthemums belongs to this practice.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438012,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438012"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"c948bd69d27981243e28","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11025","qid":11025,"nodeId":"MET44-436120","relatedNodeIds":["MET44-436120"],"major":"Art History","group":"visual art","imageId":"MET44-436120","stem":"Which artist painted the work shown?","choices":["Jean-Auguste-Dominique Ingres","Paul Cézanne","Edgar Degas","Édouard Manet","Camille Pissarro"],"correctIndex":2,"answer":"Edgar Degas","explanation":"Edgar Degas painted The Old Italian Woman (1857).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436120,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436120"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"3b1cb3fbae9f25a1aea7"},{"id":"VIS44-Q11026","qid":11026,"nodeId":"MET44-436120","relatedNodeIds":["MET44-436120"],"major":"Art History","group":"visual art","imageId":"MET44-436120","stem":"What is the title of the painting shown?","choices":["View of the Seine","The Gardener","The Supper at Emmaus","The Old Italian Woman","Boy with a Sword"],"correctIndex":3,"answer":"The Old Italian Woman","explanation":"This is The Old Italian Woman, by Edgar Degas (1857).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436120,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436120"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"0889b51ff3e2b5b22b6e"},{"id":"VIS44-Q11027","qid":11027,"nodeId":"MET44-436120","relatedNodeIds":["MET44-436120"],"major":"Art History","group":"visual art","imageId":"MET44-436120","stem":"Which statement about Degas's The Old Italian Woman is INCORRECT?","choices":["The figure is given a monumental presence","The treatment avoids conventional sentimentality","The sitter's age is concealed through youthful idealisation","Old-master influence coexists with realist detail","The skin and hands receive close observation"],"correctIndex":2,"answer":"The sitter's age is concealed through youthful idealisation","explanation":"Degas depicts age directly. The Met emphasises the observed skin and hands, as well as the painting's unsentimental character.","format":"single_choice","visualSkill":"negative_statement","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436120,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436120"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"b4be423b9f91c86b9a1d","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11028","qid":11028,"nodeId":"MET44-436138","relatedNodeIds":["MET44-436138"],"major":"Art History","group":"visual art","imageId":"MET44-436138","stem":"Which artist painted the work shown?","choices":["Edgar Degas","Camille Pissarro","Georges Seurat","Vincent van Gogh","Pierre-Auguste Renoir"],"correctIndex":0,"answer":"Edgar Degas","explanation":"Edgar Degas painted Dancers in the Rehearsal Room with a Double Bass (ca. 1882–85).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436138,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436138"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"7a8e0b5ede73bc87e772"},{"id":"VIS44-Q11029","qid":11029,"nodeId":"MET44-436138","relatedNodeIds":["MET44-436138"],"major":"Art History","group":"visual art","imageId":"MET44-436138","stem":"What is the title of the painting shown?","choices":["Bouquet of Chrysanthemums","Still Life with Teapot and Fruit","Circus Sideshow (Parade de cirque)","Dancers in the Rehearsal Room with a Double Bass","Still Life with Peaches and Grapes"],"correctIndex":3,"answer":"Dancers in the Rehearsal Room with a Double Bass","explanation":"This is Dancers in the Rehearsal Room with a Double Bass, by Edgar Degas (ca. 1882–85).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436138,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436138"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"54ca4055f8198e8b1427"},{"id":"VIS44-Q11030","qid":11030,"nodeId":"MET44-436138","relatedNodeIds":["MET44-436138"],"major":"Art History","group":"visual art","imageId":"MET44-436138","stem":"What compositional device organises Degas's Dancers in the Rehearsal Room with a Double Bass?","choices":["A circular central perspective","A single frontal figure on gold ground","An elongated, frieze-like format","Separate panels of an altarpiece","A symmetrical heraldic arrangement"],"correctIndex":2,"answer":"An elongated, frieze-like format","explanation":"The long horizontal format links this picture to Degas's series of rehearsal scenes. It accommodates an off-centre arrangement of dancers and instruments.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436138,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436138"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"d13df703b48ae817bd9e","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11031","qid":11031,"nodeId":"MET44-436150","relatedNodeIds":["MET44-436150"],"major":"Art History","group":"visual art","imageId":"MET44-436150","stem":"Which artist painted the work shown?","choices":["Édouard Manet","Pierre-Auguste Renoir","Paul Cézanne","Camille Pissarro","Edgar Degas"],"correctIndex":4,"answer":"Edgar Degas","explanation":"Edgar Degas painted Marie Dihau (1843–1935) (1867–68).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436150,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436150"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"55be9ab3fbba596a5f69"},{"id":"VIS44-Q11032","qid":11032,"nodeId":"MET44-436150","relatedNodeIds":["MET44-436150"],"major":"Art History","group":"visual art","imageId":"MET44-436150","stem":"What is the title of the painting shown?","choices":["Young Woman with Ibis","Young Woman with a Water Pitcher","Marie Dihau (1843–1935)","Circus Sideshow (Parade de cirque)","Madonna and Child"],"correctIndex":2,"answer":"Marie Dihau (1843–1935)","explanation":"This is Marie Dihau (1843–1935), by Edgar Degas (1867–68).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436150,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436150"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"6551546708e9902d3ebc"},{"id":"VIS44-Q11033","qid":11033,"nodeId":"MET44-436150","relatedNodeIds":["MET44-436150"],"major":"Art History","group":"visual art","imageId":"MET44-436150","stem":"Which profession connects Degas's sitter Marie Dihau to the world of performance?","choices":["Naval officer","Archaeologist","Pianist and singer","Architectural restorer","Political journalist"],"correctIndex":2,"answer":"Pianist and singer","explanation":"Marie Dihau was a pianist and singer. Her portrait connects Degas's interest in individual sitters with contemporary musical life.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436150,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436150"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"5c4f3eef5d15dc43ca64","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11034","qid":11034,"nodeId":"MET44-438156","relatedNodeIds":["MET44-438156"],"major":"Art History","group":"visual art","imageId":"MET44-438156","stem":"Which artist painted the work shown?","choices":["Édouard Manet","Edgar Degas","Paul Cézanne","Camille Pissarro","Jean-Auguste-Dominique Ingres"],"correctIndex":1,"answer":"Edgar Degas","explanation":"Edgar Degas painted Young Woman with Ibis (1857–58; reworked 1860–62).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438156,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438156"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"c48d5999adaf948f72be"},{"id":"VIS44-Q11035","qid":11035,"nodeId":"MET44-438156","relatedNodeIds":["MET44-438156"],"major":"Art History","group":"visual art","imageId":"MET44-438156","stem":"What is the title of the painting shown?","choices":["Young Woman with Ibis","View of Toledo","Study Head of an Old Man with a White Beard","Two Young Peasant Women","The Gardener"],"correctIndex":0,"answer":"Young Woman with Ibis","explanation":"This is Young Woman with Ibis, by Edgar Degas (1857–58; reworked 1860–62).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438156,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438156"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"d2433ea49cf91559df47"},{"id":"VIS44-Q11036","qid":11036,"nodeId":"MET44-438156","relatedNodeIds":["MET44-438156"],"major":"Art History","group":"visual art","imageId":"MET44-438156","stem":"Which statement describes the setting of Degas's Young Woman with Ibis?","choices":["It is an unchanged view of a Paris street","It is a measured record of an archaeological site","It documents birds in their natural habitat","It is an imagined setting developed through later revisions","It is a city-planning survey"],"correctIndex":3,"answer":"It is an imagined setting developed through later revisions","explanation":"Degas added an imaginary Middle Eastern cityscape and the birds while reworking the canvas. The setting is not a documentary view.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438156,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438156"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"9164b7a6d444915920a8","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11037","qid":11037,"nodeId":"MET44-436946","relatedNodeIds":["MET44-436946"],"major":"Art History","group":"visual art","imageId":"MET44-436946","stem":"Which artist painted the work shown?","choices":["Pierre-Auguste Renoir","Edgar Degas","Édouard Manet","Camille Pissarro","Paul Cézanne"],"correctIndex":2,"answer":"Édouard Manet","explanation":"Édouard Manet painted The Brioche (1870).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436946,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436946"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"43a49eeb3bd7b6b3098b"},{"id":"VIS44-Q11038","qid":11038,"nodeId":"MET44-436946","relatedNodeIds":["MET44-436946"],"major":"Art History","group":"visual art","imageId":"MET44-436946","stem":"What is the title of the painting shown?","choices":["Self-Portrait","The Monet Family in Their Garden at Argenteuil","The Brioche","View of Toledo","Wheat Field with Cypresses"],"correctIndex":2,"answer":"The Brioche","explanation":"This is The Brioche, by Édouard Manet (1870).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436946,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436946"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"0e4ade4dcd23970a5589"},{"id":"VIS44-Q11039","qid":11039,"nodeId":"MET44-436946","relatedNodeIds":["MET44-436946"],"major":"Art History","group":"visual art","imageId":"MET44-436946","stem":"Manet's The Brioche responds to the work of which earlier French painter?","choices":["Jacques-Louis David","Antoine Watteau","Nicolas Poussin","Jean Siméon Chardin","Claude Lorrain"],"correctIndex":3,"answer":"Jean Siméon Chardin","explanation":"A painting of a brioche by Chardin entering the Louvre helped inspire Manet. Ordinary objects became a means of exploring colour and texture.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436946,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436946"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"94358b7640b4263802ef","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11040","qid":11040,"nodeId":"MET44-436948","relatedNodeIds":["MET44-436948"],"major":"Art History","group":"visual art","imageId":"MET44-436948","stem":"Which artist painted the work shown?","choices":["Jean-Auguste-Dominique Ingres","Paul Cézanne","Edgar Degas","Édouard Manet","Camille Pissarro"],"correctIndex":3,"answer":"Édouard Manet","explanation":"Édouard Manet painted Boy with a Sword (1861).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436948,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436948"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"c6953ed727c6b0992f51"},{"id":"VIS44-Q11041","qid":11041,"nodeId":"MET44-436948","relatedNodeIds":["MET44-436948"],"major":"Art History","group":"visual art","imageId":"MET44-436948","stem":"What is the title of the painting shown?","choices":["Washerwoman, Study","Young Woman with a Water Pitcher","Boy with a Sword","View of the Seine","Madame Cézanne (Hortense Fiquet, 1850–1922) in a Red Dress"],"correctIndex":2,"answer":"Boy with a Sword","explanation":"This is Boy with a Sword, by Édouard Manet (1861).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436948,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436948"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"d571b9c4625e340d3928"},{"id":"VIS44-Q11042","qid":11042,"nodeId":"MET44-436948","relatedNodeIds":["MET44-436948"],"major":"Art History","group":"visual art","imageId":"MET44-436948","stem":"Which painter's tradition is evoked by the historical costume in Manet's Boy with a Sword?","choices":["Georges Seurat","Claude Monet","Sandro Botticelli","Piet Mondrian","Diego Velázquez"],"correctIndex":4,"answer":"Diego Velázquez","explanation":"Manet dressed his young model in historical costume in homage to Spanish painting, especially Velázquez. The costume does not establish the boy as a historical soldier.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436948,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436948"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"df6497379b4ca0b21aba","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11043","qid":11043,"nodeId":"MET44-436957","relatedNodeIds":["MET44-436957"],"major":"Art History","group":"visual art","imageId":"MET44-436957","stem":"Which artist painted the work shown?","choices":["Camille Pissarro","Edgar Degas","Pierre-Auguste Renoir","Édouard Manet","Paul Cézanne"],"correctIndex":3,"answer":"Édouard Manet","explanation":"Édouard Manet painted Madame Edouard Manet (Suzanne Leenhoff, 1829–1906) (ca. 1873).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436957,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436957"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"815a731cc7a21bf194d1"},{"id":"VIS44-Q11044","qid":11044,"nodeId":"MET44-436957","relatedNodeIds":["MET44-436957"],"major":"Art History","group":"visual art","imageId":"MET44-436957","stem":"What is the title of the painting shown?","choices":["Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)","View of the Seine","Salisbury Cathedral from the Bishop's Grounds","Portrait of a Man","Madonna and Child"],"correctIndex":0,"answer":"Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)","explanation":"This is Madame Edouard Manet (Suzanne Leenhoff, 1829–1906), by Édouard Manet (ca. 1873).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436957,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436957"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"b50e9851e06f9ef6822a"},{"id":"VIS44-Q11045","qid":11045,"nodeId":"MET44-436957","relatedNodeIds":["MET44-436957"],"major":"Art History","group":"visual art","imageId":"MET44-436957","stem":"Why is Manet's unfinished portrait of Suzanne Leenhoff useful for studying his technique?","choices":["It is an untouched tracing on glass","It preserves the successive states of an engraving","It shows how he carved a relief before painting","It exposes initial broad strokes and revisions of the face","It demonstrates a mechanical printing process"],"correctIndex":3,"answer":"It exposes initial broad strokes and revisions of the face","explanation":"The unfinished areas expose Manet's early handling, while the face was scraped back repeatedly. The painting reveals a process of revision.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436957,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436957"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"a18b1af052471d2d2838","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11046","qid":11046,"nodeId":"MET44-436965","relatedNodeIds":["MET44-436965"],"major":"Art History","group":"visual art","imageId":"MET44-436965","stem":"Which artist painted the work shown?","choices":["Paul Cézanne","Pierre-Auguste Renoir","Camille Pissarro","Édouard Manet","Edgar Degas"],"correctIndex":3,"answer":"Édouard Manet","explanation":"Édouard Manet painted The Monet Family in Their Garden at Argenteuil (1874).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436965,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436965"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"7b04b74cd26fecaae281"},{"id":"VIS44-Q11047","qid":11047,"nodeId":"MET44-436965","relatedNodeIds":["MET44-436965"],"major":"Art History","group":"visual art","imageId":"MET44-436965","stem":"What is the title of the painting shown?","choices":["The Monet Family in Their Garden at Argenteuil","The Flowering Orchard","Still Life with Teapot and Fruit","View of the Seine","Still Life with Peaches and Grapes"],"correctIndex":0,"answer":"The Monet Family in Their Garden at Argenteuil","explanation":"This is The Monet Family in Their Garden at Argenteuil, by Édouard Manet (1874).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436965,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436965"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"7ebd86a5ddf16cfca1f0"},{"id":"VIS44-Q11048","qid":11048,"nodeId":"MET44-436965","relatedNodeIds":["MET44-436965"],"major":"Art History","group":"visual art","imageId":"MET44-436965","stem":"Which artist–subject pairing is correct for The Monet Family in Their Garden at Argenteuil?","choices":["Edgar Degas — Paul Cézanne and his family","Claude Monet — Édouard Manet and his family","Paul Cézanne — Pierre-Auguste Renoir and his family","Édouard Manet — Claude Monet and his family","Pierre-Auguste Renoir — Edgar Degas and his family"],"correctIndex":3,"answer":"Édouard Manet — Claude Monet and his family","explanation":"Manet painted Monet, Camille and Jean at Argenteuil. A name identifying the subject should not be confused with the name of the painter.","format":"single_choice","visualSkill":"matching","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436965,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436965"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"fc69916b2db34fee67fb","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11049","qid":11049,"nodeId":"MET44-435869","relatedNodeIds":["MET44-435869"],"major":"Art History","group":"visual art","imageId":"MET44-435869","stem":"Which artist painted the work shown?","choices":["Paul Cézanne","Édouard Manet","Pierre-Auguste Renoir","Edgar Degas","Camille Pissarro"],"correctIndex":0,"answer":"Paul Cézanne","explanation":"Paul Cézanne painted Antoine Dominique Sauveur Aubert (born 1817), the Artist's Uncle, as a Monk (1866).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435869,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435869"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"f355a2a83e2235efaea2"},{"id":"VIS44-Q11050","qid":11050,"nodeId":"MET44-435869","relatedNodeIds":["MET44-435869"],"major":"Art History","group":"visual art","imageId":"MET44-435869","stem":"What is the title of the painting shown?","choices":["Antoine Dominique Sauveur Aubert (born 1817), the Artist's Uncle, as a Monk","Circus Sideshow (Parade de cirque)","Virgin and Child with Saint Catherine of Alexandria","The Brioche","The Boulevard Montmartre on a Winter Morning"],"correctIndex":0,"answer":"Antoine Dominique Sauveur Aubert (born 1817), the Artist's Uncle, as a Monk","explanation":"This is Antoine Dominique Sauveur Aubert (born 1817), the Artist's Uncle, as a Monk, by Paul Cézanne (1866).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435869,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435869"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"04d624a0c7cdc5c77432"},{"id":"VIS44-Q11051","qid":11051,"nodeId":"MET44-435869","relatedNodeIds":["MET44-435869"],"major":"Art History","group":"visual art","imageId":"MET44-435869","stem":"Which conclusion about Cézanne's portrait of his uncle in a monk's habit is INCORRECT?","choices":["The sitter could pose in clothing chosen for the picture","The sitter posed in several portraits","The costume proves that the sitter was a monk","The habit shapes a viewer's first interpretation","The work can be described as a portrait in costume"],"correctIndex":2,"answer":"The costume proves that the sitter was a monk","explanation":"Cézanne's uncle was a bailiff who posed in different costumes. The habit is pictorial staging, not evidence of his occupation.","format":"single_choice","visualSkill":"negative_statement","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435869,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435869"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"4f684528d1301b23f029","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11052","qid":11052,"nodeId":"MET44-435876","relatedNodeIds":["MET44-435876"],"major":"Art History","group":"visual art","imageId":"MET44-435876","stem":"Which artist painted the work shown?","choices":["Paul Cézanne","Vincent van Gogh","Camille Pissarro","Pierre-Auguste Renoir","Georges Seurat"],"correctIndex":0,"answer":"Paul Cézanne","explanation":"Paul Cézanne painted Madame Cézanne (Hortense Fiquet, 1850–1922) in a Red Dress (1888–90).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435876,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435876"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"f20cec21b35e5a7dc320"},{"id":"VIS44-Q11053","qid":11053,"nodeId":"MET44-435876","relatedNodeIds":["MET44-435876"],"major":"Art History","group":"visual art","imageId":"MET44-435876","stem":"What is the title of the painting shown?","choices":["Young Woman with Ibis","Boy with a Sword","Young Woman with a Water Pitcher","Still Life with Peaches and Grapes","Madame Cézanne (Hortense Fiquet, 1850–1922) in a Red Dress"],"correctIndex":4,"answer":"Madame Cézanne (Hortense Fiquet, 1850–1922) in a Red Dress","explanation":"This is Madame Cézanne (Hortense Fiquet, 1850–1922) in a Red Dress, by Paul Cézanne (1888–90).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435876,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435876"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"7c2919ae366fc4ecbb58"},{"id":"VIS44-Q11054","qid":11054,"nodeId":"MET44-435876","relatedNodeIds":["MET44-435876"],"major":"Art History","group":"visual art","imageId":"MET44-435876","stem":"Which feature is important in Madame Cézanne in a Red Dress?","choices":["A strictly symmetrical architectural grid","A continuous gold background","A landscape constructed by aerial perspective","Tilting furnishings organised around the seated figure","The complete elimination of the human figure"],"correctIndex":3,"answer":"Tilting furnishings organised around the seated figure","explanation":"The furnishings create a complex, tilting space. The sitter holds this carefully organised interior together.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435876,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435876"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"16cf8a68c0dc46982361","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11055","qid":11055,"nodeId":"MET44-437989","relatedNodeIds":["MET44-437989"],"major":"Art History","group":"visual art","imageId":"MET44-437989","stem":"Which artist painted the work shown?","choices":["Georges Seurat","Pierre-Auguste Renoir","Camille Pissarro","Édouard Manet","Paul Cézanne"],"correctIndex":4,"answer":"Paul Cézanne","explanation":"Paul Cézanne painted Dish of Apples (ca. 1876–77).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437989,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437989"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"a8aa29e4745fc17cee55"},{"id":"VIS44-Q11056","qid":11056,"nodeId":"MET44-437989","relatedNodeIds":["MET44-437989"],"major":"Art History","group":"visual art","imageId":"MET44-437989","stem":"What is the title of the painting shown?","choices":["Salisbury Cathedral from the Bishop's Grounds","Dish of Apples","Flora","Marie Dihau (1843–1935)","Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839)"],"correctIndex":1,"answer":"Dish of Apples","explanation":"This is Dish of Apples, by Paul Cézanne (ca. 1876–77).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437989,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437989"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"fb02a33fc8964bc05374"},{"id":"VIS44-Q11057","qid":11057,"nodeId":"MET44-437989","relatedNodeIds":["MET44-437989"],"major":"Art History","group":"visual art","imageId":"MET44-437989","stem":"The shape of the napkin in Cézanne's Dish of Apples has been compared with which recurring motif?","choices":["The towers of Rouen Cathedral","Mont Sainte-Victoire","The dome of Saint Peter's","The cliffs of Étretat","The bridge at Argenteuil"],"correctIndex":1,"answer":"Mont Sainte-Victoire","explanation":"The Met compares the napkin's shape with Mont Sainte-Victoire. Forms in a still life can recall the artist's landscape motifs.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437989,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437989"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"b7f4b6c7858b67653d57","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11058","qid":11058,"nodeId":"MET44-438136","relatedNodeIds":["MET44-438136"],"major":"Art History","group":"visual art","imageId":"MET44-438136","stem":"Which artist painted the work shown?","choices":["Pierre-Auguste Renoir","Paul Cézanne","Camille Pissarro","Edgar Degas","Édouard Manet"],"correctIndex":1,"answer":"Paul Cézanne","explanation":"Paul Cézanne painted The Fishermen (Fantastic Scene) (ca. 1875).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438136,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438136"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"3543cf7abab5d9dfce0b"},{"id":"VIS44-Q11059","qid":11059,"nodeId":"MET44-438136","relatedNodeIds":["MET44-438136"],"major":"Art History","group":"visual art","imageId":"MET44-438136","stem":"What is the title of the painting shown?","choices":["Hills around the Bay of Moulin Huet, Guernsey","Circus Sideshow (Parade de cirque)","The Gardener","Study Head of an Old Man with a White Beard","The Fishermen (Fantastic Scene)"],"correctIndex":4,"answer":"The Fishermen (Fantastic Scene)","explanation":"This is The Fishermen (Fantastic Scene), by Paul Cézanne (ca. 1875).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438136,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438136"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"69707137496e90a80b61"},{"id":"VIS44-Q11060","qid":11060,"nodeId":"MET44-438136","relatedNodeIds":["MET44-438136"],"major":"Art History","group":"visual art","imageId":"MET44-438136","stem":"Which combination of sources helps explain Cézanne's The Fishermen?","choices":["Medieval illumination and industrial blueprints","Photographic reportage and mechanical printing","Egyptian reliefs and anatomical diagrams","Dutch seascapes and Byzantine icons alone","Modern leisure scenes and Venetian pastoral painting"],"correctIndex":4,"answer":"Modern leisure scenes and Venetian pastoral painting","explanation":"Cézanne drew on Manet and Monet's outdoor leisure scenes and on Venetian pastoral models. The painting combines modern subjects with older traditions.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438136,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438136"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"e6e2e4345e7b312c843a","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11061","qid":11061,"nodeId":"MET44-436448","relatedNodeIds":["MET44-436448"],"major":"Art History","group":"visual art","imageId":"MET44-436448","stem":"Which artist painted the work shown?","choices":["Paul Cézanne","Camille Pissarro","Pierre-Auguste Renoir","Paul Gauguin","Vincent van Gogh"],"correctIndex":3,"answer":"Paul Gauguin","explanation":"Paul Gauguin painted A Farm in Brittany (ca. 1894).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436448,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436448"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"e909e003cf7355bc50c5"},{"id":"VIS44-Q11062","qid":11062,"nodeId":"MET44-436448","relatedNodeIds":["MET44-436448"],"major":"Art History","group":"visual art","imageId":"MET44-436448","stem":"What is the title of the painting shown?","choices":["Young Woman with a Water Pitcher","Self-Portrait","Virgin and Child with Saint Catherine of Alexandria","A Farm in Brittany","Portrait of a Man"],"correctIndex":3,"answer":"A Farm in Brittany","explanation":"This is A Farm in Brittany, by Paul Gauguin (ca. 1894).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436448,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436448"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"eef22eb6ed461a775fc2"},{"id":"VIS44-Q11063","qid":11063,"nodeId":"MET44-436448","relatedNodeIds":["MET44-436448"],"major":"Art History","group":"visual art","imageId":"MET44-436448","stem":"Which statement about Gauguin's A Farm in Brittany is correct?","choices":["It depicts an Italian farm during his training in Rome","It was commissioned as a cadastral map","It depicts a French region despite colours recalling his Tahitian work","It records a Caribbean harbour","It depicts Tahiti because Gauguin painted only Pacific subjects"],"correctIndex":2,"answer":"It depicts a French region despite colours recalling his Tahitian work","explanation":"Brittany is in northwestern France. The palette recalls Gauguin's Tahitian paintings, showing why colour alone cannot identify a location.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436448,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436448"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"7f12aa505795b4c76499","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11064","qid":11064,"nodeId":"MET44-436449","relatedNodeIds":["MET44-436449"],"major":"Art History","group":"visual art","imageId":"MET44-436449","stem":"Which artist painted the work shown?","choices":["Pierre-Auguste Renoir","Paul Gauguin","Camille Pissarro","Paul Cézanne","Vincent van Gogh"],"correctIndex":1,"answer":"Paul Gauguin","explanation":"Paul Gauguin painted The Siesta (ca. 1892–94).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436449,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436449"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"2a238895a748902f1c2c"},{"id":"VIS44-Q11065","qid":11065,"nodeId":"MET44-436449","relatedNodeIds":["MET44-436449"],"major":"Art History","group":"visual art","imageId":"MET44-436449","stem":"What is the title of the painting shown?","choices":["Madonna and Child","The Flowering Orchard","Bouquet of Chrysanthemums","The Siesta","Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)"],"correctIndex":3,"answer":"The Siesta","explanation":"This is The Siesta, by Paul Gauguin (ca. 1892–94).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436449,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436449"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"07cd104bc5a1f41d5613"},{"id":"VIS44-Q11066","qid":11066,"nodeId":"MET44-436449","relatedNodeIds":["MET44-436449"],"major":"Art History","group":"visual art","imageId":"MET44-436449","stem":"What do the revisions in Gauguin's The Siesta reveal?","choices":["The picture copies an engraving without alteration","Every figure remained unchanged from the first sketch","The scene is an untouched photographic record","The relaxed scene was developed through substantial compositional changes","Its arrangement was prescribed by a classical relief"],"correctIndex":3,"answer":"The relaxed scene was developed through substantial compositional changes","explanation":"Gauguin moved figures and replaced a dog with a basket. The calm appearance results from deliberate revisions.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436449,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436449"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"6b28e6b96bc718fc5c7f","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11067","qid":11067,"nodeId":"MET44-437999","relatedNodeIds":["MET44-437999"],"major":"Art History","group":"visual art","imageId":"MET44-437999","stem":"Which artist painted the work shown?","choices":["Camille Pissarro","Paul Cézanne","Pierre-Auguste Renoir","Vincent van Gogh","Paul Gauguin"],"correctIndex":4,"answer":"Paul Gauguin","explanation":"Paul Gauguin painted Still Life with Teapot and Fruit (1896).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437999,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437999"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"131c564abe0f180e0fca"},{"id":"VIS44-Q11068","qid":11068,"nodeId":"MET44-437999","relatedNodeIds":["MET44-437999"],"major":"Art History","group":"visual art","imageId":"MET44-437999","stem":"What is the title of the painting shown?","choices":["A Farm in Brittany","Virgin and Child with Saint Catherine of Alexandria","Still Life with Teapot and Fruit","The Gardener","Young Woman with a Water Pitcher"],"correctIndex":2,"answer":"Still Life with Teapot and Fruit","explanation":"This is Still Life with Teapot and Fruit, by Paul Gauguin (1896).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437999,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437999"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"c27044a63a43e5e8d0dd"},{"id":"VIS44-Q11069","qid":11069,"nodeId":"MET44-437999","relatedNodeIds":["MET44-437999"],"major":"Art History","group":"visual art","imageId":"MET44-437999","stem":"Gauguin's Still Life with Teapot and Fruit adapts a work he owned by which painter?","choices":["Paul Cézanne","Edgar Degas","Georges Seurat","Henri Rousseau","Gustave Caillebotte"],"correctIndex":0,"answer":"Paul Cézanne","explanation":"Gauguin adapted a Cézanne still life's compressed space, replacing its apples and decoration with mangoes and a Tahitian-patterned cloth.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437999,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437999"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"4c4eea74536a71494066","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11070","qid":11070,"nodeId":"MET44-437654","relatedNodeIds":["MET44-437654"],"major":"Art History","group":"visual art","imageId":"MET44-437654","stem":"Which artist painted the work shown?","choices":["Vincent van Gogh","Paul Cézanne","Edgar Degas","Pierre-Auguste Renoir","Georges Seurat"],"correctIndex":4,"answer":"Georges Seurat","explanation":"Georges Seurat painted Circus Sideshow (Parade de cirque) (1887–88).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437654,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437654"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"0c98a093e6e0e541b163"},{"id":"VIS44-Q11071","qid":11071,"nodeId":"MET44-437654","relatedNodeIds":["MET44-437654"],"major":"Art History","group":"visual art","imageId":"MET44-437654","stem":"What is the title of the painting shown?","choices":["Circus Sideshow (Parade de cirque)","Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839)","Dish of Apples","Self-Portrait","Hills around the Bay of Moulin Huet, Guernsey"],"correctIndex":0,"answer":"Circus Sideshow (Parade de cirque)","explanation":"This is Circus Sideshow (Parade de cirque), by Georges Seurat (1887–88).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437654,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437654"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"1e6205d238eba44c2ff9"},{"id":"VIS44-Q11072","qid":11072,"nodeId":"MET44-437654","relatedNodeIds":["MET44-437654"],"major":"Art History","group":"visual art","imageId":"MET44-437654","stem":"What was the function of the performance in Seurat's Circus Sideshow?","choices":["Rehearsing a religious procession","Entertaining only the circus owner's family","Attracting passersby to buy circus tickets","Recruiting soldiers at a military parade","Opening a parliamentary session"],"correctIndex":2,"answer":"Attracting passersby to buy circus tickets","explanation":"The free sideshow advertised the circus outside its tent. The painting connects modern art with commercial entertainment in Paris.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437654,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437654"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"a1c90fc2d8dda4f68032","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11073","qid":11073,"nodeId":"MET44-437656","relatedNodeIds":["MET44-437656"],"major":"Art History","group":"visual art","imageId":"MET44-437656","stem":"Which artist painted the work shown?","choices":["Pierre-Auguste Renoir","Vincent van Gogh","Camille Pissarro","Georges Seurat","Edgar Degas"],"correctIndex":3,"answer":"Georges Seurat","explanation":"Georges Seurat painted The Gardener (1882–83).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437656,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437656"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"579648fd4c7e0e2e289f"},{"id":"VIS44-Q11074","qid":11074,"nodeId":"MET44-437656","relatedNodeIds":["MET44-437656"],"major":"Art History","group":"visual art","imageId":"MET44-437656","stem":"What is the title of the painting shown?","choices":["Circus Sideshow (Parade de cirque)","Edmond Cavé (1794–1852)","Two Young Peasant Women","The Gardener","View of Toledo"],"correctIndex":3,"answer":"The Gardener","explanation":"This is The Gardener, by Georges Seurat (1882–83).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437656,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437656"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"b4561ff5b2b44319adb9"},{"id":"VIS44-Q11075","qid":11075,"nodeId":"MET44-437656","relatedNodeIds":["MET44-437656"],"major":"Art History","group":"visual art","imageId":"MET44-437656","stem":"What helps explain the brighter palette in Seurat's The Gardener?","choices":["His interest in Impressionist practice and colour theory","His rejection of optical approaches to colour","His use of gold-ground icon techniques","His exclusive adoption of monochrome","His replacement of painting by engraving"],"correctIndex":0,"answer":"His interest in Impressionist practice and colour theory","explanation":"The brighter colours mark Seurat's growing engagement with Impressionism and writings on colour, beyond the earthy palette of earlier rural scenes.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437656,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437656"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"43952b82a4849bec8c29","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11076","qid":11076,"nodeId":"MET44-437658","relatedNodeIds":["MET44-437658"],"major":"Art History","group":"visual art","imageId":"MET44-437658","stem":"Which artist painted the work shown?","choices":["Georges Seurat","Camille Pissarro","Pierre-Auguste Renoir","Vincent van Gogh","Edgar Degas"],"correctIndex":0,"answer":"Georges Seurat","explanation":"Georges Seurat painted Study for \"A Sunday on La Grande Jatte\" (1884).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437658,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437658"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"70deda2b5c67b1235a30"},{"id":"VIS44-Q11077","qid":11077,"nodeId":"MET44-437658","relatedNodeIds":["MET44-437658"],"major":"Art History","group":"visual art","imageId":"MET44-437658","stem":"What is the title of the painting shown?","choices":["The Supper at Emmaus","Study for \"A Sunday on La Grande Jatte\"","The Holy Family with Saint Elizabeth, Saint John, and a Dove","Edmond Cavé (1794–1852)","Portrait of a Man"],"correctIndex":1,"answer":"Study for \"A Sunday on La Grande Jatte\"","explanation":"This is Study for \"A Sunday on La Grande Jatte\", by Georges Seurat (1884).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437658,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437658"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"a88de58eb90be988058c"},{"id":"VIS44-Q11078","qid":11078,"nodeId":"MET44-437658","relatedNodeIds":["MET44-437658"],"major":"Art History","group":"visual art","imageId":"MET44-437658","stem":"What principle did Seurat describe by the term Divisionism?","choices":["Dividing a canvas into movable panels","Enclosing every colour with one continuous contour","Mixing every pigment into a neutral colour before painting","Placing coloured glass over a monochrome drawing","Separate touches of colour intended to combine optically"],"correctIndex":4,"answer":"Separate touches of colour intended to combine optically","explanation":"Divisionism concerns the separation of colours into adjacent touches. Pointillism describes dot-like marks; the two terms emphasise different aspects of the method.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437658,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437658"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"6fd9b5eea6c3eceafe9e","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11079","qid":11079,"nodeId":"MET44-437659","relatedNodeIds":["MET44-437659"],"major":"Art History","group":"visual art","imageId":"MET44-437659","stem":"Which artist painted the work shown?","choices":["Camille Pissarro","Georges Seurat","Edgar Degas","Pierre-Auguste Renoir","Vincent van Gogh"],"correctIndex":1,"answer":"Georges Seurat","explanation":"Georges Seurat painted View of the Seine (1882–83).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437659,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437659"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"114c9a5fb65683c443ab"},{"id":"VIS44-Q11080","qid":11080,"nodeId":"MET44-437659","relatedNodeIds":["MET44-437659"],"major":"Art History","group":"visual art","imageId":"MET44-437659","stem":"What is the title of the painting shown?","choices":["Study for \"A Sunday on La Grande Jatte\"","Madonna and Child","Queen Henrietta Maria","View of the Seine","The Supper at Emmaus"],"correctIndex":3,"answer":"View of the Seine","explanation":"This is View of the Seine, by Georges Seurat (1882–83).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437659,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437659"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"b19e801911b6d09ef8bb"},{"id":"VIS44-Q11081","qid":11081,"nodeId":"MET44-437659","relatedNodeIds":["MET44-437659"],"major":"Art History","group":"visual art","imageId":"MET44-437659","stem":"Why were the small wooden panels used for Seurat's View of the Seine useful for outdoor work?","choices":["They made colour invisible until varnished","They were durable and portable","They required immediate firing in a kiln","They prevented compositional changes","They worked only under studio lighting"],"correctIndex":1,"answer":"They were durable and portable","explanation":"Seurat made numerous early oil studies on portable wooden panels. Their practical format supported painting outside the studio.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437659,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437659"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"b5865455ea62af5557ba","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11082","qid":11082,"nodeId":"MET44-437303","relatedNodeIds":["MET44-437303"],"major":"Art History","group":"visual art","imageId":"MET44-437303","stem":"Which artist painted the work shown?","choices":["Georges Seurat","Pierre-Auguste Renoir","Paul Cézanne","Camille Pissarro","Edgar Degas"],"correctIndex":3,"answer":"Camille Pissarro","explanation":"Camille Pissarro painted Washerwoman, Study (1880).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437303,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437303"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"cd89c78bb652d81e8eb2"},{"id":"VIS44-Q11083","qid":11083,"nodeId":"MET44-437303","relatedNodeIds":["MET44-437303"],"major":"Art History","group":"visual art","imageId":"MET44-437303","stem":"What is the title of the painting shown?","choices":["Young Woman with a Water Pitcher","The Brioche","Washerwoman, Study","A Washerwoman at Eragny","The Triumph of Henry IV"],"correctIndex":2,"answer":"Washerwoman, Study","explanation":"This is Washerwoman, Study, by Camille Pissarro (1880).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437303,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437303"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"4fc82f28ee55672876b3"},{"id":"VIS44-Q11084","qid":11084,"nodeId":"MET44-437303","relatedNodeIds":["MET44-437303"],"major":"Art History","group":"visual art","imageId":"MET44-437303","stem":"What change in Pissarro's work is exemplified by Washerwoman, Study?","choices":["Rural figures disappear from every composition","Royal portraiture replaces rural subjects","Sculpture replaces painting as his medium","Rural figures become substantial subjects in their own right","Religious narrative replaces ordinary workers"],"correctIndex":3,"answer":"Rural figures become substantial subjects in their own right","explanation":"Pissarro gave villagers a more independent role in the works exhibited in 1882. Workers became central subjects rather than small landscape details.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437303,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437303"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"b96e434e9dac33e4ae9a","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11085","qid":11085,"nodeId":"MET44-437304","relatedNodeIds":["MET44-437304"],"major":"Art History","group":"visual art","imageId":"MET44-437304","stem":"Which artist painted the work shown?","choices":["Vincent van Gogh","Pierre-Auguste Renoir","Camille Pissarro","Paul Gauguin","Paul Cézanne"],"correctIndex":2,"answer":"Camille Pissarro","explanation":"Camille Pissarro painted Two Young Peasant Women (1891–92).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437304,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437304"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"f2c6000350d77b4bf8ee"},{"id":"VIS44-Q11086","qid":11086,"nodeId":"MET44-437304","relatedNodeIds":["MET44-437304"],"major":"Art History","group":"visual art","imageId":"MET44-437304","stem":"What is the title of the painting shown?","choices":["Two Young Peasant Women","Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)","Study for \"A Sunday on La Grande Jatte\"","View of the Seine","Madame Cézanne (Hortense Fiquet, 1850–1922) in a Red Dress"],"correctIndex":0,"answer":"Two Young Peasant Women","explanation":"This is Two Young Peasant Women, by Camille Pissarro (1891–92).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437304,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437304"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"debd15675c371910fffb"},{"id":"VIS44-Q11087","qid":11087,"nodeId":"MET44-437304","relatedNodeIds":["MET44-437304"],"major":"Art History","group":"visual art","imageId":"MET44-437304","stem":"Which type of subject connects Two Young Peasant Women to Pissarro's wider practice?","choices":["A contest between classical gods","A devotional gathering of saints","Ceremonial royal portraiture","Everyday rural life","A military victory"],"correctIndex":3,"answer":"Everyday rural life","explanation":"Pissarro repeatedly studied rural people and their daily activities. The painting treats ordinary life as an independent artistic subject.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437304,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437304"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"c65fe4cdd32278f31cbe","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11088","qid":11088,"nodeId":"MET44-437305","relatedNodeIds":["MET44-437305"],"major":"Art History","group":"visual art","imageId":"MET44-437305","stem":"Which artist painted the work shown?","choices":["Pierre-Auguste Renoir","Vincent van Gogh","Paul Gauguin","Paul Cézanne","Camille Pissarro"],"correctIndex":4,"answer":"Camille Pissarro","explanation":"Camille Pissarro painted A Washerwoman at Eragny (1893).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437305,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437305"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"31b8685161d9b4ee72ed"},{"id":"VIS44-Q11089","qid":11089,"nodeId":"MET44-437305","relatedNodeIds":["MET44-437305"],"major":"Art History","group":"visual art","imageId":"MET44-437305","stem":"What is the title of the painting shown?","choices":["The Supper at Emmaus","Self-Portrait","A Washerwoman at Eragny","The Holy Family with Saint Elizabeth, Saint John, and a Dove","Portrait of a Man"],"correctIndex":2,"answer":"A Washerwoman at Eragny","explanation":"This is A Washerwoman at Eragny, by Camille Pissarro (1893).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437305,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437305"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"e964e282c3b8bdd72d86"},{"id":"VIS44-Q11090","qid":11090,"nodeId":"MET44-437305","relatedNodeIds":["MET44-437305"],"major":"Art History","group":"visual art","imageId":"MET44-437305","stem":"Which account of Pissarro's A Washerwoman at Eragny is correct?","choices":["Gold leaf supplies the landscape's illumination","The landscape is painted entirely in monochrome","Every colour is enclosed by a heavy black outline","Yellow mixed into wet greens suggests shimmering sunlight","Blue alone represents both light and shade"],"correctIndex":3,"answer":"Yellow mixed into wet greens suggests shimmering sunlight","explanation":"Pissarro enlivened the greens with yellow while the paint was wet. The dappled handling also recalls his earlier Pointillist experiments.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437305,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437305"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"e3f0d35423f8af1d4767","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11091","qid":11091,"nodeId":"MET44-437310","relatedNodeIds":["MET44-437310"],"major":"Art History","group":"visual art","imageId":"MET44-437310","stem":"Which artist painted the work shown?","choices":["Vincent van Gogh","Pierre-Auguste Renoir","Paul Gauguin","Camille Pissarro","Paul Cézanne"],"correctIndex":3,"answer":"Camille Pissarro","explanation":"Camille Pissarro painted The Boulevard Montmartre on a Winter Morning (1897).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437310,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437310"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"8810b050168ce424dcff"},{"id":"VIS44-Q11092","qid":11092,"nodeId":"MET44-437310","relatedNodeIds":["MET44-437310"],"major":"Art History","group":"visual art","imageId":"MET44-437310","stem":"What is the title of the painting shown?","choices":["Hills around the Bay of Moulin Huet, Guernsey","The Fishermen (Fantastic Scene)","The Flowering Orchard","Dancers in the Rehearsal Room with a Double Bass","The Boulevard Montmartre on a Winter Morning"],"correctIndex":4,"answer":"The Boulevard Montmartre on a Winter Morning","explanation":"This is The Boulevard Montmartre on a Winter Morning, by Camille Pissarro (1897).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437310,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437310"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"31288d509f5e0dcc7657"},{"id":"VIS44-Q11093","qid":11093,"nodeId":"MET44-437310","relatedNodeIds":["MET44-437310"],"major":"Art History","group":"visual art","imageId":"MET44-437310","stem":"What enabled the elevated viewpoint of Pissarro's Boulevard Montmartre series?","choices":["A boat beneath the street","An archaeological reconstruction","A tethered balloon","His view from hotel lodgings","A medieval city map"],"correctIndex":3,"answer":"His view from hotel lodgings","explanation":"Pissarro studied the boulevards from the Grand Hôtel de Russie. The high window allowed him to observe changing urban activity.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437310,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437310"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"f4e6bc13398c58a7bf53","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11094","qid":11094,"nodeId":"MET44-437390","relatedNodeIds":["MET44-437390"],"major":"Art History","group":"visual art","imageId":"MET44-437390","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","Diego Velázquez","Rembrandt","Johannes Vermeer","Peter Paul Rubens"],"correctIndex":2,"answer":"Rembrandt","explanation":"Rembrandt painted Portrait of a Woman (1633).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437390,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437390"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"661563ec6ed6cb5f46bb"},{"id":"VIS44-Q11095","qid":11095,"nodeId":"MET44-437390","relatedNodeIds":["MET44-437390"],"major":"Art History","group":"visual art","imageId":"MET44-437390","stem":"What is the title of the painting shown?","choices":["Edmond Cavé (1794–1852)","Portrait of a Woman","Boy with a Sword","Circus Sideshow (Parade de cirque)","Dish of Apples"],"correctIndex":1,"answer":"Portrait of a Woman","explanation":"This is Portrait of a Woman, by Rembrandt (1633).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437390,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437390"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"6ef26842f7a089f8edcf"},{"id":"VIS44-Q11096","qid":11096,"nodeId":"MET44-437390","relatedNodeIds":["MET44-437390"],"major":"Art History","group":"visual art","imageId":"MET44-437390","stem":"Which statement reflects the evidence about Rembrandt's Portrait of a Woman?","choices":["The subject is an idealised Roman empress","A contract identifies the queen of France","The sitter is securely identified as his mother","The sitter is unidentified and workshop involvement has been debated","Every area is documented as an apprentice's work"],"correctIndex":3,"answer":"The sitter is unidentified and workshop involvement has been debated","explanation":"The museum does not identify the sitter and notes debate over a collaborator's role. Attribution and sitter identity are distinct questions.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437390,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437390"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"e39e8704f8427a1d9d06","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11097","qid":11097,"nodeId":"MET44-437397","relatedNodeIds":["MET44-437397"],"major":"Art History","group":"visual art","imageId":"MET44-437397","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","Diego Velázquez","Johannes Vermeer","Rembrandt","Peter Paul Rubens"],"correctIndex":3,"answer":"Rembrandt","explanation":"Rembrandt painted Self-Portrait (1660).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437397,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437397"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"50923ac33b0456af7b99"},{"id":"VIS44-Q11098","qid":11098,"nodeId":"MET44-437397","relatedNodeIds":["MET44-437397"],"major":"Art History","group":"visual art","imageId":"MET44-437397","stem":"What is the title of the painting shown?","choices":["Boy with a Sword","Self-Portrait","The Monet Family in Their Garden at Argenteuil","Oleanders","Portrait of a Man"],"correctIndex":1,"answer":"Self-Portrait","explanation":"This is Self-Portrait, by Rembrandt (1660).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437397,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437397"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"f220ae299e2f917d0b4e"},{"id":"VIS44-Q11099","qid":11099,"nodeId":"MET44-437397","relatedNodeIds":["MET44-437397"],"major":"Art History","group":"visual art","imageId":"MET44-437397","stem":"Which statement about Rembrandt's Self-Portrait is INCORRECT?","choices":["Raised paint gives the features physical presence","The work belongs to a sustained practice of self-portraiture","The artist acknowledges his ageing appearance","Some curls were incised with the brush's end","Signs of age are smoothed away to create an ideal youthful face"],"correctIndex":4,"answer":"Signs of age are smoothed away to create an ideal youthful face","explanation":"Rembrandt depicts ageing directly through textured paint. He also used the end of the brush to incise curls.","format":"single_choice","visualSkill":"negative_statement","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437397,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437397"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"b09dfd6896180edc5036","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11100","qid":11100,"nodeId":"MET44-437398","relatedNodeIds":["MET44-437398"],"major":"Art History","group":"visual art","imageId":"MET44-437398","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","Johannes Vermeer","Rembrandt","Diego Velázquez","Peter Paul Rubens"],"correctIndex":2,"answer":"Rembrandt","explanation":"Rembrandt painted Flora (ca. 1654).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437398,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437398"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"27d9246cdce7afd1bbd0"},{"id":"VIS44-Q11101","qid":11101,"nodeId":"MET44-437398","relatedNodeIds":["MET44-437398"],"major":"Art History","group":"visual art","imageId":"MET44-437398","stem":"What is the title of the painting shown?","choices":["Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)","Virgin and Child with Saint Catherine of Alexandria","Flora","Two Young Peasant Women","The Boulevard Montmartre on a Winter Morning"],"correctIndex":2,"answer":"Flora","explanation":"This is Flora, by Rembrandt (ca. 1654).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437398,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437398"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"9cacc2dcd713bd142c2a"},{"id":"VIS44-Q11102","qid":11102,"nodeId":"MET44-437398","relatedNodeIds":["MET44-437398"],"major":"Art History","group":"visual art","imageId":"MET44-437398","stem":"Which subject–tradition pairing describes Rembrandt's Flora?","choices":["Dutch queen — a response to Japanese prints","Greek warrior — a response to medieval glass","Roman goddess of spring — a response to Venetian painting","Biblical prophet — a response to French Neoclassicism","Christian martyr — a response to Egyptian relief"],"correctIndex":2,"answer":"Roman goddess of spring — a response to Venetian painting","explanation":"Flora is a Roman goddess associated with spring. Rembrandt responded especially to Titian while retaining his own sombre palette and paint handling.","format":"single_choice","visualSkill":"matching","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437398,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437398"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"e6d8844fd6431fad9363","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11103","qid":11103,"nodeId":"MET44-437400","relatedNodeIds":["MET44-437400"],"major":"Art History","group":"visual art","imageId":"MET44-437400","stem":"Which artist painted the work shown?","choices":["Peter Paul Rubens","Anthony van Dyck","Diego Velázquez","Johannes Vermeer","Rembrandt"],"correctIndex":4,"answer":"Rembrandt","explanation":"Rembrandt painted Portrait of a Man (ca. 1655–60).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437400,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437400"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"e8cf6fa44e5b0f116535"},{"id":"VIS44-Q11104","qid":11104,"nodeId":"MET44-437400","relatedNodeIds":["MET44-437400"],"major":"Art History","group":"visual art","imageId":"MET44-437400","stem":"What is the title of the painting shown?","choices":["Hills around the Bay of Moulin Huet, Guernsey","A Farm in Brittany","First Steps, after Millet","Portrait of a Man","Self-Portrait"],"correctIndex":3,"answer":"Portrait of a Man","explanation":"This is Portrait of a Man, by Rembrandt (ca. 1655–60).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437400,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437400"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"610d7048648fdf9341da"},{"id":"VIS44-Q11105","qid":11105,"nodeId":"MET44-437400","relatedNodeIds":["MET44-437400"],"major":"Art History","group":"visual art","imageId":"MET44-437400","stem":"Why does the condition of Rembrandt's Portrait of a Man matter for attribution and dating?","choices":["The painting has become a bronze relief","The canvas was designed to change subjects over time","Its signature has been replaced by a dated photograph","Abrasion has removed evidence in the hands, body and hat","Gold leaf conceals the entire scene"],"correctIndex":3,"answer":"Abrasion has removed evidence in the hands, body and hat","explanation":"The museum records significant abrasion. Damage can limit the stylistic evidence available to scholars.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437400,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437400"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"ac1906bc2c48b5b198ba","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11106","qid":11106,"nodeId":"MET44-437877","relatedNodeIds":["MET44-437877"],"major":"Art History","group":"visual art","imageId":"MET44-437877","stem":"Which artist painted the work shown?","choices":["Peter Paul Rubens","Johannes Vermeer","Diego Velázquez","Rembrandt","Anthony van Dyck"],"correctIndex":1,"answer":"Johannes Vermeer","explanation":"Johannes Vermeer painted Allegory of the Catholic Faith (ca. 1670–72).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437877,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437877"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"7b371c234635ca549404"},{"id":"VIS44-Q11107","qid":11107,"nodeId":"MET44-437877","relatedNodeIds":["MET44-437877"],"major":"Art History","group":"visual art","imageId":"MET44-437877","stem":"What is the title of the painting shown?","choices":["View of Toledo","Allegory of the Catholic Faith","In the Meadow","Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)","Washerwoman, Study"],"correctIndex":1,"answer":"Allegory of the Catholic Faith","explanation":"This is Allegory of the Catholic Faith, by Johannes Vermeer (ca. 1670–72).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437877,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437877"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"c8d1052aba349d94c310"},{"id":"VIS44-Q11108","qid":11108,"nodeId":"MET44-437877","relatedNodeIds":["MET44-437877"],"major":"Art History","group":"visual art","imageId":"MET44-437877","stem":"What does the stone crushing a serpent signify in Vermeer's Allegory of the Catholic Faith?","choices":["The Church overcoming evil","Winter defeating spring","The collapse of a classical temple","Discovery of a continent","Dutch commercial wealth"],"correctIndex":0,"answer":"The Church overcoming evil","explanation":"The stone and serpent belong to the work's Catholic allegory. They express a symbolic meaning rather than a domestic incident.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437877,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437877"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"938d52870556fa54869d","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11109","qid":11109,"nodeId":"MET44-437881","relatedNodeIds":["MET44-437881"],"major":"Art History","group":"visual art","imageId":"MET44-437881","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","Rembrandt","Johannes Vermeer","Peter Paul Rubens","Diego Velázquez"],"correctIndex":2,"answer":"Johannes Vermeer","explanation":"Johannes Vermeer painted Young Woman with a Water Pitcher (ca. 1662).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437881,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437881"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"186202731b1875d4512e"},{"id":"VIS44-Q11110","qid":11110,"nodeId":"MET44-437881","relatedNodeIds":["MET44-437881"],"major":"Art History","group":"visual art","imageId":"MET44-437881","stem":"What is the title of the painting shown?","choices":["Portrait of a Man","First Steps, after Millet","Young Woman with a Water Pitcher","The Old Italian Woman","Dancers in the Rehearsal Room with a Double Bass"],"correctIndex":2,"answer":"Young Woman with a Water Pitcher","explanation":"This is Young Woman with a Water Pitcher, by Johannes Vermeer (ca. 1662).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437881,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437881"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"d015e13a5eca35eb8cc2"},{"id":"VIS44-Q11111","qid":11111,"nodeId":"MET44-437881","relatedNodeIds":["MET44-437881"],"major":"Art History","group":"visual art","imageId":"MET44-437881","stem":"Which theme is central to Vermeer's Young Woman with a Water Pitcher?","choices":["A private domestic routine","A mythological contest","A public military ceremony","A royal audience","An official painters' guild meeting"],"correctIndex":0,"answer":"A private domestic routine","explanation":"The pitcher and basin relate to washing at the start of the day. Vermeer makes an intimate domestic activity the subject of a carefully composed painting.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437881,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437881"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"a57365e46edf91e50682","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11112","qid":11112,"nodeId":"MET44-437529","relatedNodeIds":["MET44-437529"],"major":"Art History","group":"visual art","imageId":"MET44-437529","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","El Greco","Peter Paul Rubens","Rembrandt","Diego Velázquez"],"correctIndex":2,"answer":"Peter Paul Rubens","explanation":"Peter Paul Rubens painted The Holy Family with Saint Elizabeth, Saint John, and a Dove (ca. 1608–9).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437529,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437529"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"bbab40ef12c76d6645e1"},{"id":"VIS44-Q11113","qid":11113,"nodeId":"MET44-437529","relatedNodeIds":["MET44-437529"],"major":"Art History","group":"visual art","imageId":"MET44-437529","stem":"What is the title of the painting shown?","choices":["A Farm in Brittany","The Holy Family with Saint Elizabeth, Saint John, and a Dove","Marie Dihau (1843–1935)","Venice, from the Porch of Madonna della Salute","Hills around the Bay of Moulin Huet, Guernsey"],"correctIndex":1,"answer":"The Holy Family with Saint Elizabeth, Saint John, and a Dove","explanation":"This is The Holy Family with Saint Elizabeth, Saint John, and a Dove, by Peter Paul Rubens (ca. 1608–9).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437529,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437529"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"6068a0b64a59e4560aab"},{"id":"VIS44-Q11114","qid":11114,"nodeId":"MET44-437529","relatedNodeIds":["MET44-437529"],"major":"Art History","group":"visual art","imageId":"MET44-437529","stem":"What does the dove symbolise in Rubens's Holy Family with Saint Elizabeth and Saint John?","choices":["The patron's wealth","The city of Antwerp","The Roman Senate","The Holy Spirit","The goddess Venus"],"correctIndex":3,"answer":"The Holy Spirit","explanation":"The dove is a Christian symbol of the Holy Spirit. Its treatment in this composition also alludes to Christ's eventual sacrifice.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437529,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437529"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"0d61ab0a4a7a943dfe7c","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11115","qid":11115,"nodeId":"MET44-437534","relatedNodeIds":["MET44-437534"],"major":"Art History","group":"visual art","imageId":"MET44-437534","stem":"Which artist painted the work shown?","choices":["El Greco","Peter Paul Rubens","Anthony van Dyck","Diego Velázquez","Rembrandt"],"correctIndex":1,"answer":"Peter Paul Rubens","explanation":"Peter Paul Rubens painted The Triumph of Henry IV (ca. 1630).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437534,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437534"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"04fff4e22a88049cdf52"},{"id":"VIS44-Q11116","qid":11116,"nodeId":"MET44-437534","relatedNodeIds":["MET44-437534"],"major":"Art History","group":"visual art","imageId":"MET44-437534","stem":"What is the title of the painting shown?","choices":["Queen Henrietta Maria","Bouquet of Chrysanthemums","The Triumph of Henry IV","The Gardener","Venice, from the Porch of Madonna della Salute"],"correctIndex":2,"answer":"The Triumph of Henry IV","explanation":"This is The Triumph of Henry IV, by Peter Paul Rubens (ca. 1630).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437534,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437534"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"97f3a77ea28aced106d6"},{"id":"VIS44-Q11117","qid":11117,"nodeId":"MET44-437534","relatedNodeIds":["MET44-437534"],"major":"Art History","group":"visual art","imageId":"MET44-437534","stem":"Which statement describes Rubens's The Triumph of Henry IV?","choices":["A French king's entry is presented through Roman triumphal imagery","It records an ancient emperor from direct observation","It excludes allegory in favour of neutral reportage","It depicts a medieval English coronation","It reconstructs an ancient road for scientific study"],"correctIndex":0,"answer":"A French king's entry is presented through Roman triumphal imagery","explanation":"Rubens represents Henry IV's entry into Paris using the language of a Roman triumph. Classical imagery glorifies a later ruler.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437534,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437534"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"9dcdf0db994610034afa","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11118","qid":11118,"nodeId":"MET44-437871","relatedNodeIds":["MET44-437871"],"major":"Art History","group":"visual art","imageId":"MET44-437871","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","El Greco","Rembrandt","Diego Velázquez","Peter Paul Rubens"],"correctIndex":3,"answer":"Diego Velázquez","explanation":"Diego Velázquez painted The Supper at Emmaus (1622–23).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437871,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437871"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"9dc1c5411eb6c7432e3e"},{"id":"VIS44-Q11119","qid":11119,"nodeId":"MET44-437871","relatedNodeIds":["MET44-437871"],"major":"Art History","group":"visual art","imageId":"MET44-437871","stem":"What is the title of the painting shown?","choices":["The Supper at Emmaus","Salisbury Cathedral from the Bishop's Grounds","Virgin and Child with Saint Catherine of Alexandria","Allegory of the Catholic Faith","The Brioche"],"correctIndex":0,"answer":"The Supper at Emmaus","explanation":"This is The Supper at Emmaus, by Diego Velázquez (1622–23).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437871,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437871"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"fadec58174710ef4ef4d"},{"id":"VIS44-Q11120","qid":11120,"nodeId":"MET44-437871","relatedNodeIds":["MET44-437871"],"major":"Art History","group":"visual art","imageId":"MET44-437871","stem":"Which approach connects Velázquez's early Supper at Emmaus with Caravaggio?","choices":["Pastel colours and dissolving contours alone","Dots designed for optical colour mixing","Gold grounds and rigid frontal poses","Replacement of figures by geometric abstraction","Unidealised figures and dramatic lighting in a tightly arranged narrative"],"correctIndex":4,"answer":"Unidealised figures and dramatic lighting in a tightly arranged narrative","explanation":"The Met links Velázquez's early subjects and ordinary-looking models to Caravaggio. Gesture and lighting heighten the moment of recognition.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437871,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437871"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"3c93152fd674d6b3253a","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11121","qid":11121,"nodeId":"MET44-436575","relatedNodeIds":["MET44-436575"],"major":"Art History","group":"visual art","imageId":"MET44-436575","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","Diego Velázquez","Rembrandt","El Greco","Peter Paul Rubens"],"correctIndex":3,"answer":"El Greco","explanation":"El Greco painted View of Toledo (ca. 1599–1600).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436575,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436575"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"344521bf820f95eb523e"},{"id":"VIS44-Q11122","qid":11122,"nodeId":"MET44-436575","relatedNodeIds":["MET44-436575"],"major":"Art History","group":"visual art","imageId":"MET44-436575","stem":"What is the title of the painting shown?","choices":["Salisbury Cathedral from the Bishop's Grounds","Portrait of a Man","View of Toledo","Study Head of an Old Man with a White Beard","First Steps, after Millet"],"correctIndex":2,"answer":"View of Toledo","explanation":"This is View of Toledo, by El Greco (ca. 1599–1600).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436575,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436575"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"25f37b2cc9ff9dff0c4e"},{"id":"VIS44-Q11123","qid":11123,"nodeId":"MET44-436575","relatedNodeIds":["MET44-436575"],"major":"Art History","group":"visual art","imageId":"MET44-436575","stem":"Which statement about El Greco's View of Toledo is INCORRECT?","choices":["It distorts landscape and architecture for effect","It gives the city an expressive atmosphere","It reproduces the skyline with strict documentary accuracy","It changes the placement of important buildings","It depicts the city where the artist spent much of his career"],"correctIndex":2,"answer":"It reproduces the skyline with strict documentary accuracy","explanation":"El Greco altered the skyline, including the cathedral's position. His aim here was an expressive vision rather than exact topography.","format":"single_choice","visualSkill":"negative_statement","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436575,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436575"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"6ca9dbefe4d272d0a38b","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11124","qid":11124,"nodeId":"MET44-436703","relatedNodeIds":["MET44-436703"],"major":"Art History","group":"visual art","imageId":"MET44-436703","stem":"Which artist painted the work shown?","choices":["Jean-Auguste-Dominique Ingres","John Constable","J. M. W. Turner","Édouard Manet","Edgar Degas"],"correctIndex":0,"answer":"Jean-Auguste-Dominique Ingres","explanation":"Jean-Auguste-Dominique Ingres painted Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839) (1823).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436703,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436703"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"13fee512cd9bfc0e2c92"},{"id":"VIS44-Q11125","qid":11125,"nodeId":"MET44-436703","relatedNodeIds":["MET44-436703"],"major":"Art History","group":"visual art","imageId":"MET44-436703","stem":"What is the title of the painting shown?","choices":["Two Young Peasant Women","Queen Henrietta Maria","The Gardener","Wheat Field with Cypresses","Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839)"],"correctIndex":4,"answer":"Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839)","explanation":"This is Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839), by Jean-Auguste-Dominique Ingres (1823).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436703,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436703"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"64d55a47c64f20ad570f"},{"id":"VIS44-Q11126","qid":11126,"nodeId":"MET44-436703","relatedNodeIds":["MET44-436703"],"major":"Art History","group":"visual art","imageId":"MET44-436703","stem":"What does it mean to call Ingres's Madame Leblanc a pendant portrait?","choices":["It was made to hang from a necklace","It was printed as a page in a book","It was conceived as a companion to another portrait","It was painted on the back of a canvas","It was a detachable altarpiece wing"],"correctIndex":2,"answer":"It was conceived as a companion to another portrait","explanation":"The portrait was conceived in relation to the portrait of her husband. Pendant works are companion pieces.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436703,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436703"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"f40be7177b42de2044b5","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11127","qid":11127,"nodeId":"MET44-436704","relatedNodeIds":["MET44-436704"],"major":"Art History","group":"visual art","imageId":"MET44-436704","stem":"Which artist painted the work shown?","choices":["J. M. W. Turner","Edgar Degas","Jean-Auguste-Dominique Ingres","Édouard Manet","John Constable"],"correctIndex":2,"answer":"Jean-Auguste-Dominique Ingres","explanation":"Jean-Auguste-Dominique Ingres painted Edmond Cavé (1794–1852) (1844).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436704,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436704"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"c82efb807e10e361978c"},{"id":"VIS44-Q11128","qid":11128,"nodeId":"MET44-436704","relatedNodeIds":["MET44-436704"],"major":"Art History","group":"visual art","imageId":"MET44-436704","stem":"What is the title of the painting shown?","choices":["Edmond Cavé (1794–1852)","Salisbury Cathedral from the Bishop's Grounds","The Brioche","Venice, from the Porch of Madonna della Salute","Two Young Peasant Women"],"correctIndex":0,"answer":"Edmond Cavé (1794–1852)","explanation":"This is Edmond Cavé (1794–1852), by Jean-Auguste-Dominique Ingres (1844).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436704,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436704"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"e80f423c01093878c2ed"},{"id":"VIS44-Q11129","qid":11129,"nodeId":"MET44-436704","relatedNodeIds":["MET44-436704"],"major":"Art History","group":"visual art","imageId":"MET44-436704","stem":"How does Ingres's Edmond Cavé relate to the portrait of Cavé's wife?","choices":["It was later made as a companion to her earlier portrait","Her portrait was destroyed to provide its support","The sitters are unrelated despite their shared name","The two figures originally shared one canvas","Both copy the same ancient sculptural bust"],"correctIndex":0,"answer":"It was later made as a companion to her earlier portrait","explanation":"Ingres consulted the dimensions of the wife's earlier portrait when preparing Edmond Cavé's companion image.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436704,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436704"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"ac4ceccf45e5653d975a","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11130","qid":11130,"nodeId":"MET44-437853","relatedNodeIds":["MET44-437853"],"major":"Art History","group":"visual art","imageId":"MET44-437853","stem":"Which artist painted the work shown?","choices":["John Constable","J. M. W. Turner","Édouard Manet","Jean-Auguste-Dominique Ingres","Edgar Degas"],"correctIndex":1,"answer":"J. M. W. Turner","explanation":"J. M. W. Turner painted Venice, from the Porch of Madonna della Salute (ca. 1835).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437853,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437853"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"ffe47868fd2c64a5b24f"},{"id":"VIS44-Q11131","qid":11131,"nodeId":"MET44-437853","relatedNodeIds":["MET44-437853"],"major":"Art History","group":"visual art","imageId":"MET44-437853","stem":"What is the title of the painting shown?","choices":["A Farm in Brittany","The Triumph of Henry IV","The Brioche","Bouquet of Chrysanthemums","Venice, from the Porch of Madonna della Salute"],"correctIndex":4,"answer":"Venice, from the Porch of Madonna della Salute","explanation":"This is Venice, from the Porch of Madonna della Salute, by J. M. W. Turner (ca. 1835).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437853,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437853"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"0e24d5a3c1548e799067"},{"id":"VIS44-Q11132","qid":11132,"nodeId":"MET44-437853","relatedNodeIds":["MET44-437853"],"major":"Art History","group":"visual art","imageId":"MET44-437853","stem":"Which effect is central to Turner's Venice, from the Porch of Madonna della Salute?","choices":["Rigid black contours isolate every building","Reflections connect the palace foundations with the lagoon","An aerial plan replaces a ground-level view","Identical values eliminate all light contrasts","Monochrome replaces all colour"],"correctIndex":1,"answer":"Reflections connect the palace foundations with the lagoon","explanation":"Turner's reflections soften the meeting of architecture and water. The effect draws on his experience of marine painting and watercolour.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437853,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437853"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"c77be0913a35d5b10a92","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11133","qid":11133,"nodeId":"MET44-435922","relatedNodeIds":["MET44-435922"],"major":"Art History","group":"visual art","imageId":"MET44-435922","stem":"Which artist painted the work shown?","choices":["Édouard Manet","John Constable","Edgar Degas","J. M. W. Turner","Jean-Auguste-Dominique Ingres"],"correctIndex":1,"answer":"John Constable","explanation":"John Constable painted Salisbury Cathedral from the Bishop's Grounds (ca. 1825).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435922,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435922"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"1f6269c286e216dba658"},{"id":"VIS44-Q11134","qid":11134,"nodeId":"MET44-435922","relatedNodeIds":["MET44-435922"],"major":"Art History","group":"visual art","imageId":"MET44-435922","stem":"What is the title of the painting shown?","choices":["Allegory of the Catholic Faith","Study for \"A Sunday on La Grande Jatte\"","Wheat Field with Cypresses","Boy with a Sword","Salisbury Cathedral from the Bishop's Grounds"],"correctIndex":4,"answer":"Salisbury Cathedral from the Bishop's Grounds","explanation":"This is Salisbury Cathedral from the Bishop's Grounds, by John Constable (ca. 1825).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435922,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435922"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"181d2dd5dcbfa03fb20e"},{"id":"VIS44-Q11135","qid":11135,"nodeId":"MET44-435922","relatedNodeIds":["MET44-435922"],"major":"Art History","group":"visual art","imageId":"MET44-435922","stem":"What role does the tree canopy play in Constable's Salisbury Cathedral from the Bishop's Grounds?","choices":["It hides the entire cathedral","It separates two historical periods","It frames the cathedral's spire","It replaces perspective with a map","It diagrams the structure of Gothic vaults"],"correctIndex":2,"answer":"It frames the cathedral's spire","explanation":"Constable adjusted the trees and sky to frame the spire. The landscape is composed around the architecture.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":435922,"verificationUrl":"https://www.metmuseum.org/art/collection/search/435922"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"51608740d18bc06e2ec3","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11136","qid":11136,"nodeId":"MET44-437824","relatedNodeIds":["MET44-437824"],"major":"Art History","group":"visual art","imageId":"MET44-437824","stem":"Which artist painted the work shown?","choices":["Diego Velázquez","Titian","Anthony van Dyck","El Greco","Peter Paul Rubens"],"correctIndex":1,"answer":"Titian","explanation":"Titian painted Madonna and Child (ca. 1508).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437824,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437824"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"27952aebf082e07a7bd9"},{"id":"VIS44-Q11137","qid":11137,"nodeId":"MET44-437824","relatedNodeIds":["MET44-437824"],"major":"Art History","group":"visual art","imageId":"MET44-437824","stem":"What is the title of the painting shown?","choices":["View of Toledo","Oleanders","Madonna and Child","Boy with a Sword","Two Young Peasant Women"],"correctIndex":2,"answer":"Madonna and Child","explanation":"This is Madonna and Child, by Titian (ca. 1508).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437824,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437824"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"c4bfbbe4db8693bbda58"},{"id":"VIS44-Q11138","qid":11138,"nodeId":"MET44-437824","relatedNodeIds":["MET44-437824"],"major":"Art History","group":"visual art","imageId":"MET44-437824","stem":"Which revision increased the intimacy of Titian's Madonna and Child?","choices":["Removing every gesture and physical connection","Separating the figures into unrelated compartments","Replacing figures with inscriptions","Changing the scene into a state portrait","Relaxing the figures from a more formal upright arrangement"],"correctIndex":4,"answer":"Relaxing the figures from a more formal upright arrangement","explanation":"Technical examination revealed an earlier, more upright arrangement. The revised poses convey an intimate moment of affection.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":437824,"verificationUrl":"https://www.metmuseum.org/art/collection/search/437824"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"5aa5ab36dff61dca371c","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11139","qid":11139,"nodeId":"MET44-436260","relatedNodeIds":["MET44-436260"],"major":"Art History","group":"visual art","imageId":"MET44-436260","stem":"Which artist painted the work shown?","choices":["Rembrandt","Diego Velázquez","El Greco","Anthony van Dyck","Peter Paul Rubens"],"correctIndex":3,"answer":"Anthony van Dyck","explanation":"Anthony van Dyck painted Study Head of an Old Man with a White Beard (ca. 1617–20).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436260,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436260"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"d373b65706d2a7be077f"},{"id":"VIS44-Q11140","qid":11140,"nodeId":"MET44-436260","relatedNodeIds":["MET44-436260"],"major":"Art History","group":"visual art","imageId":"MET44-436260","stem":"What is the title of the painting shown?","choices":["The Triumph of Henry IV","The Holy Family with Saint Elizabeth, Saint John, and a Dove","Marie Dihau (1843–1935)","Madame Edouard Manet (Suzanne Leenhoff, 1829–1906)","Study Head of an Old Man with a White Beard"],"correctIndex":4,"answer":"Study Head of an Old Man with a White Beard","explanation":"This is Study Head of an Old Man with a White Beard, by Anthony van Dyck (ca. 1617–20).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436260,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436260"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"e05005bc2e4148d240b2"},{"id":"VIS44-Q11141","qid":11141,"nodeId":"MET44-436260","relatedNodeIds":["MET44-436260"],"major":"Art History","group":"visual art","imageId":"MET44-436260","stem":"Which earlier attribution helps explain the artistic setting of Van Dyck's Study Head of an Old Man?","choices":["Sandro Botticelli","Peter Paul Rubens","Johannes Vermeer","Claude Monet","Jacques-Louis David"],"correctIndex":1,"answer":"Peter Paul Rubens","explanation":"The painting was once attributed to Rubens. Its softer forms and textured handling support attribution to the young Van Dyck in the same Antwerp artistic milieu.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436260,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436260"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"6849572c8a5e0621e3e8","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11142","qid":11142,"nodeId":"MET44-436262","relatedNodeIds":["MET44-436262"],"major":"Art History","group":"visual art","imageId":"MET44-436262","stem":"Which artist painted the work shown?","choices":["Diego Velázquez","Peter Paul Rubens","El Greco","Rembrandt","Anthony van Dyck"],"correctIndex":4,"answer":"Anthony van Dyck","explanation":"Anthony van Dyck painted Virgin and Child with Saint Catherine of Alexandria (ca. 1630).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436262,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436262"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"8aa55f693e0aad6f45c9"},{"id":"VIS44-Q11143","qid":11143,"nodeId":"MET44-436262","relatedNodeIds":["MET44-436262"],"major":"Art History","group":"visual art","imageId":"MET44-436262","stem":"What is the title of the painting shown?","choices":["The Siesta","A Farm in Brittany","Madame Jacques-Louis Leblanc (Françoise Poncelle, 1788–1839)","Virgin and Child with Saint Catherine of Alexandria","Study Head of an Old Man with a White Beard"],"correctIndex":3,"answer":"Virgin and Child with Saint Catherine of Alexandria","explanation":"This is Virgin and Child with Saint Catherine of Alexandria, by Anthony van Dyck (ca. 1630).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436262,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436262"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"05d164f0798122ebd23c"},{"id":"VIS44-Q11144","qid":11144,"nodeId":"MET44-436262","relatedNodeIds":["MET44-436262"],"major":"Art History","group":"visual art","imageId":"MET44-436262","stem":"What does Saint Catherine's palm signify in Van Dyck's Virgin and Child with Saint Catherine?","choices":["A journey to a specific harbour","Membership in a painters' guild","Martyrdom","Athletic victory","Royal marriage"],"correctIndex":2,"answer":"Martyrdom","explanation":"The palm is a Christian attribute of martyrdom. Attributes help viewers recognise saints and understand their roles.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":436262,"verificationUrl":"https://www.metmuseum.org/art/collection/search/436262"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"4e613eb64a77a0b9cbca","sourceFormExamples":[588,590,592,594,644]},{"id":"VIS44-Q11145","qid":11145,"nodeId":"MET44-438112","relatedNodeIds":["MET44-438112"],"major":"Art History","group":"visual art","imageId":"MET44-438112","stem":"Which artist painted the work shown?","choices":["Anthony van Dyck","Johannes Vermeer","Rembrandt","Diego Velázquez","Peter Paul Rubens"],"correctIndex":0,"answer":"Anthony van Dyck","explanation":"Anthony van Dyck painted Queen Henrietta Maria (1636).","format":"single_choice","visualSkill":"artist_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438112,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438112"}],"examLanguages":["en","it"],"scope":"shared","version":"question-reviewed-v57","fingerprint":"05f149c6888efd0da435"},{"id":"VIS44-Q11146","qid":11146,"nodeId":"MET44-438112","relatedNodeIds":["MET44-438112"],"major":"Art History","group":"visual art","imageId":"MET44-438112","stem":"What is the title of the painting shown?","choices":["First Steps, after Millet","The Monet Family in Their Garden at Argenteuil","Queen Henrietta Maria","Wheat Field with Cypresses","Venice, from the Porch of Madonna della Salute"],"correctIndex":2,"answer":"Queen Henrietta Maria","explanation":"This is Queen Henrietta Maria, by Anthony van Dyck (1636).","format":"single_choice","visualSkill":"work_recognition","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438112,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438112"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v44","fingerprint":"37192252e5f5f448bc65"},{"id":"VIS44-Q11147","qid":11147,"nodeId":"MET44-438112","relatedNodeIds":["MET44-438112"],"major":"Art History","group":"visual art","imageId":"MET44-438112","stem":"What was the original purpose of Van Dyck's Queen Henrietta Maria?","choices":["An anatomical study for medical students","A royal portrait intended as a diplomatic gift","A preparatory landscape study","A record of a criminal trial","An anonymous commercial advertisement"],"correctIndex":1,"answer":"A royal portrait intended as a diplomatic gift","explanation":"The queen commissioned the portrait for Cardinal Francesco Barberini. Its courtly presentation and royal insignia served a diplomatic purpose.","format":"single_choice","visualSkill":"historical_context","references":[{"file":"The Metropolitan Museum of Art · Open Access","page":null,"objectID":438112,"verificationUrl":"https://www.metmuseum.org/art/collection/search/438112"}],"examLanguages":["en","it"],"scope":"shared","version":"museum-visual-v47","fingerprint":"65c4bb9206a4ce6a3343","sourceFormExamples":[588,590,592,594,644]}]