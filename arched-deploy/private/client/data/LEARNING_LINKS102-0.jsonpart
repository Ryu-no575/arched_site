ense":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Melchior_Broederlam_-_Painted_wings_of_the_Retable_of_the_Crucifixion.jpg","licenseUrl":""}],"questionIds":[],"tapestryIds":["t63-9e8aa37edb1d","t63-a59c06a78bfe"],"museumIds":[],"mapIds":[],"note":"Documented activity period, not a known lifespan.","creator":"Melchior Broederlam","assetIds":["T81-t63-a59c06a78bfe"]},{"id":"LE102-f269e3acc4070d5e","title":"Donatello","kind":"person","reference":"https://en.wikipedia.org/wiki/Donatello","aliases":["Donatello"],"photos":[],"questionIds":[],"tapestryIds":["t63-8fe1606f6e81"],"museumIds":[],"mapIds":[],"note":"Sculptor; birth approximate."},{"id":"LE102-5721e7b604313b6e","title":"Canterbury Tales","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Canterbury_Tales","aliases":["Canterbury Tales"],"photos":[],"questionIds":["GEN43-Q01266","GEN43-Q01430"],"tapestryIds":["t63-196882dca4bd"],"museumIds":[],"mapIds":[],"note":"Unfinished collection framed by a pilgrimage.","creator":"Geoffrey Chaucer"},{"id":"LE102-46bbc4aa890b1b70","title":"Battle of Kosovo","kind":"history","reference":"https://en.wikipedia.org/wiki/Battle_of_Kosovo","aliases":["Battle of Kosovo"],"photos":[],"questionIds":["ARCHED-NEW101-0524"],"tapestryIds":["t63-06ba5c0f38aa"],"museumIds":[],"mapIds":[],"note":"Medieval Serbian and Ottoman forces; losses on both sides."},{"id":"LE102-a0c3998b865e167f","title":"Jan van Eyck","kind":"person","reference":"https://en.wikipedia.org/wiki/Jan_van_Eyck","aliases":["Jan van Eyck"],"photos":[],"questionIds":[],"tapestryIds":["t63-9e2cbb87fab8"],"museumIds":[],"mapIds":[],"note":"Netherlandish painter; birth approximate."},{"id":"LE102-602576cdb88a767f","title":"Well of Moses","kind":"art","reference":"https://en.wikipedia.org/wiki/Well_of_Moses","aliases":["Well of Moses"],"photos":[{"src":"/.netlify/functions/access?action=media&name=3daac50676baf6c38065d2ef.webp","credit":"Benjamin Smith","license":"CC BY-SA 4.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Dijon_-_Puits_de_Mo%C3%AFse_-_01.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=3daac50676baf6c38065d2ef.webp","credit":"Benjamin Smith","license":"CC BY-SA 4.0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Dijon_-_Puits_de_Mo%C3%AFse_-_01.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01412"],"tapestryIds":["t63-76299ed888b9"],"museumIds":[],"mapIds":[],"note":"Chartreuse de Champmol; completed with workshop participation.","creator":"Claus Sluter","assetIds":["REV84-IMAGE-1412"]},{"id":"LE102-5a1e37038dca687f","title":"Fra Angelico","kind":"person","reference":"https://en.wikipedia.org/wiki/Fra_Angelico","aliases":["Fra Angelico"],"photos":[],"questionIds":[],"tapestryIds":["t63-0411622d9bdc"],"museumIds":[],"mapIds":[],"note":"Painter; birth dated around 1395 in many modern accounts."},{"id":"LE102-d49246e853fd84a5","title":"Battle of Nicopolis","kind":"history","reference":"https://en.wikipedia.org/wiki/Battle_of_Nicopolis","aliases":["Battle of Nicopolis"],"photos":[],"questionIds":["ARCHED-NEW101-0476"],"tapestryIds":["t63-f4ce6c639ae9"],"museumIds":[],"mapIds":[],"note":"Ottoman victory over a crusading coalition."},{"id":"LE102-97a99e74b24f6ffc","title":"Michelozzo","kind":"person","reference":"https://en.wikipedia.org/wiki/Michelozzo","aliases":["Michelozzo"],"photos":[],"questionIds":[],"tapestryIds":["t63-527635617988"],"museumIds":[],"mapIds":[],"note":"Florentine architect and sculptor."},{"id":"LE102-dfb8a12684e100d1","title":"Kalmar Union","kind":"history","reference":"https://en.wikipedia.org/wiki/Kalmar_Union","aliases":["Kalmar Union"],"photos":[],"questionIds":["GEN43-Q01626","ARCHED-NEW101-0519"],"tapestryIds":["t63-92ebfe44b8db"],"museumIds":[],"mapIds":[],"note":"Denmark, Norway and Sweden."},{"id":"LE102-d2b0bafbe849ed9c","title":"Paolo Uccello","kind":"person","reference":"https://en.wikipedia.org/wiki/Paolo_Uccello","aliases":["Paolo Uccello"],"photos":[],"questionIds":[],"tapestryIds":["t63-2e6852deed95"],"museumIds":[],"mapIds":[],"note":"Painter; perspective studies."},{"id":"LE102-755c1ed38c02605c","title":"Rogier van der Weyden","kind":"person","reference":"https://en.wikipedia.org/wiki/Rogier_van_der_Weyden","aliases":["Rogier van der Weyden"],"photos":[],"questionIds":[],"tapestryIds":["t63-0adb5445478c"],"museumIds":[],"mapIds":[],"note":"Netherlandish painter."},{"id":"LE102-bd89d3ce4c4ff2b5","title":"Limbourg brothers","kind":"person","reference":"https://en.wikipedia.org/wiki/Limbourg_brothers","aliases":["Limbourg brothers"],"photos":[],"questionIds":[],"tapestryIds":["t63-828dc43ee450"],"museumIds":[],"mapIds":[],"note":"Pol, Johan and Herman; approximate period of activity, not a lifespan."},{"id":"LE102-753f7a0539b25ad0","title":"Johannes Gutenberg","kind":"person","reference":"https://en.wikipedia.org/wiki/Johannes_Gutenberg","aliases":["Johannes Gutenberg","Gutenberg's movable-type printing in Europe"],"photos":[],"questionIds":[],"tapestryIds":["t63-e3567bfa0acf","t63-8f87bbdb61cb"],"museumIds":[],"mapIds":[],"note":"Printer; birth approximate."},{"id":"LE102-087ec2024121151f","title":"Filarete","kind":"person","reference":"https://en.wikipedia.org/wiki/Filarete","aliases":["Filarete"],"photos":[],"questionIds":[],"tapestryIds":["t63-f1c26075d7bf"],"museumIds":[],"mapIds":[],"note":"Antonio Averlino; architect and sculptor."},{"id":"LE102-fff152ddfc17fbc9","title":"Early Italian Renaissance","kind":"art","reference":"https://en.wikipedia.org/wiki/Early_Renaissance","aliases":["Early Italian Renaissance"],"photos":[],"questionIds":[],"tapestryIds":["t63-73aa689a3d69"],"museumIds":[],"mapIds":[],"note":"Editorial period range; artists and cities developed at different rates."},{"id":"LE102-84b26fe18e4e27e3","title":"Linear perspective: horizon and vanishing point","kind":"art","reference":"https://www.metmuseum.org/essays/architecture-in-renaissance-italy","aliases":["Linear perspective: horizon and vanishing point"],"photos":[],"questionIds":[],"tapestryIds":["t69-629eb3ead524"],"museumIds":[],"mapIds":[],"note":"Orthogonals converge towards a vanishing point on the horizon in single-point perspective. The horizon corresponds to eye level, not necessarily a visible skyline."},{"id":"LE102-2bf35234a334d36a","title":"Atmospheric perspective","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Atmospheric%20perspective","aliases":["Atmospheric perspective"],"photos":[],"questionIds":[],"tapestryIds":["t69-82191bb0d296"],"museumIds":[],"mapIds":[],"note":"Distant forms can appear less distinct, lower in contrast and cooler in colour. This differs from the geometric convergence of linear perspective."},{"id":"LE102-ce0433b8829cc42c","title":"Centralised plan and Renaissance ideals","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Centralised%20plan%20and%20Renaissance%20ideals","aliases":["Centralised plan and Renaissance ideals"],"photos":[],"questionIds":[],"tapestryIds":["t69-2291145e213a"],"museumIds":[],"mapIds":[],"note":"Circular, square and Greek-cross plans can express geometrical order. A Greek cross has arms of approximately equal length, unlike a longitudinal Latin cross.","built":"1400"},{"id":"LE102-3a5d73f581033481","title":"Disegno and colore","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Disegno%20and%20colore","aliases":["Disegno and colore"],"photos":[],"questionIds":[],"tapestryIds":["t69-2f3c166311ae"],"museumIds":[],"mapIds":[],"note":"The traditional comparison contrasts drawing and design associated with Florence with colour and painterly handling associated with Venice. It is a critical framework, not an absolute regional rule."},{"id":"LE102-ec072e60d1babfd1","title":"Fresco, tempera and oil: identifying technique","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Fresco%2C%20tempera%20and%20oil","aliases":["Fresco, tempera and oil: identifying technique"],"photos":[],"questionIds":[],"tapestryIds":["t69-55f40d6a5754"],"museumIds":[],"mapIds":[],"note":"Buon fresco uses pigment on fresh plaster; tempera uses an emulsion binder; oil paint dries through oxidation. Support, binder and application are separate questions."},{"id":"LE102-84a20c5f831df188","title":"Patronage, guilds and artistic commissions","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Patronage%2C%20guilds%20and%20artistic%20commissions","aliases":["Patronage, guilds and artistic commissions"],"photos":[],"questionIds":[],"tapestryIds":["t69-9a016773120d"],"museumIds":[],"mapIds":[],"note":"Churches, civic bodies, rulers, guilds and private patrons commissioned different subjects and formats. A work's purpose can explain its scale, placement and iconography."},{"id":"LE102-dcc755c9fecf78ed","title":"Renaissance architectural proportion","kind":"architecture","reference":"https://www.metmuseum.org/essays/architecture-in-renaissance-italy","aliases":["Renaissance architectural proportion"],"photos":[],"questionIds":[],"tapestryIds":["t69-46c24b5ffb16"],"museumIds":[],"mapIds":[],"note":"Architects reinterpreted classical orders, symmetry and measured relationships. Classical appearance can coexist with new construction solutions and Christian functions.","built":"1400"},{"id":"LE102-987bf4706735ad46","title":"Sfumato and chiaroscuro","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Sfumato%20and%20chiaroscuro","aliases":["Sfumato and chiaroscuro"],"photos":[],"questionIds":[],"tapestryIds":["t69-dc5b3770bdf0"],"museumIds":[],"mapIds":[],"note":"Sfumato softens boundaries through subtle tonal transitions. Chiaroscuro models form through light and shade. The two terms are related but not interchangeable."},{"id":"LE102-9ea41aaf82269036","title":"Masaccio","kind":"person","reference":"https://en.wikipedia.org/wiki/Masaccio","aliases":["Masaccio"],"photos":[],"questionIds":[],"tapestryIds":["t63-bb142cb416a6"],"museumIds":[],"mapIds":[],"note":"Florentine painter."},{"id":"LE102-84bb18b1abc862fb","title":"Battle of Ankara","kind":"history","reference":"https://en.wikipedia.org/wiki/Battle_of_Ankara","aliases":["Battle of Ankara"],"photos":[],"questionIds":[],"tapestryIds":["t63-2f8e6011094b"],"museumIds":[],"mapIds":[],"note":"Timur defeats Bayezid I."},{"id":"LE102-39765ad310e036dd","title":"Leon Battista Alberti","kind":"person","reference":"https://en.wikipedia.org/wiki/Leon_Battista_Alberti","aliases":["Leon Battista Alberti"],"photos":[],"questionIds":["ARCHED-NEW101-0227","ARCHED-NEW101-0228","ARCHED-NEW101-0229","ALPHA-B010-Q856"],"tapestryIds":["t63-13750798fa37"],"museumIds":[],"mapIds":[],"note":"Architect and humanist."},{"id":"LE102-9cea37d8def9df94","title":"Fra Filippo Lippi","kind":"person","reference":"https://en.wikipedia.org/wiki/Filippo_Lippi","aliases":["Fra Filippo Lippi"],"photos":[],"questionIds":[],"tapestryIds":["t63-caa6ba40955d"],"museumIds":[],"mapIds":[],"note":"Florentine painter; birth approximate."},{"id":"LE102-42d18c9e9b14c6af","title":"Battle of Grunwald / Tannenberg","kind":"history","reference":"https://en.wikipedia.org/wiki/Battle_of_Grunwald","aliases":["Battle of Grunwald / Tannenberg"],"photos":[],"questionIds":[],"tapestryIds":["t63-557336ee7b2e"],"museumIds":[],"mapIds":[],"note":"Polish–Lithuanian victory over the Teutonic Order."},{"id":"LE102-ee80ec99e1eb4df9","title":"Domenico Veneziano","kind":"person","reference":"https://en.wikipedia.org/wiki/Domenico_Veneziano","aliases":["Domenico Veneziano"],"photos":[],"questionIds":[],"tapestryIds":["t63-7362025bdf4d"],"museumIds":[],"mapIds":[],"note":"Painter; birth approximate."},{"id":"LE102-f6a637cbe1114d93","title":"Johannes Ockeghem","kind":"person","reference":"https://en.wikipedia.org/wiki/Johannes_Ockeghem","aliases":["Johannes Ockeghem"],"photos":[],"questionIds":[],"tapestryIds":["t63-51e70c53ca6a"],"museumI