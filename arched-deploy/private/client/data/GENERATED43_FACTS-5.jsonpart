edia.org/wiki/Matera","checkedOnline85":false}],"explanation74":"Matera and its Sassi are in Basilicata.","questionId85":"GEN43-Q04434","reviewStatus85":"ready"},{"id":"REVISION85-4435","nodeId":"REVISION85-4435","anchor":"MAJOR:GEOGRAPHY-AND-CIVICS","subject":"Ravenna is in:","value":"Emilia-Romagna","group":"Geography & Civics","major":"Geography & Civics","era":"Other","relation":"place geography","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Ravenna","checkedOnline85":false}],"explanation74":"Ravenna lies in the Romagna portion of Emilia-Romagna.","questionId85":"GEN43-Q04435","reviewStatus85":"ready"},{"id":"REVISION85-4436","nodeId":"REVISION85-4436","anchor":"MAJOR:GEOGRAPHY-AND-CIVICS","subject":"Trieste is the capital of:","value":"Friuli Venezia Giulia","group":"Geography & Civics","major":"Geography & Civics","era":"Other","relation":"place geography","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Trieste","checkedOnline85":false}],"explanation74":"Trieste is the regional capital of Friuli Venezia Giulia.","questionId85":"GEN43-Q04436","reviewStatus85":"ready"},{"id":"REVISION85-4437","nodeId":"REVISION85-4437","anchor":"MAJOR:GEOGRAPHY-AND-CIVICS","subject":"Which Italian region has no coastline?","value":"Umbria","group":"Geography & Civics","major":"Geography & Civics","era":"Other","relation":"place geography","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Umbria","checkedOnline85":false}],"explanation74":"Umbria is landlocked; the other listed regions have a coast.","questionId85":"GEN43-Q04437","reviewStatus85":"ready"},{"id":"REVISION85-4438","nodeId":"REVISION85-4438","anchor":"MAJOR:GEOGRAPHY-AND-CIVICS","subject":"The city of Avignon stands beside which river?","value":"Rhône"