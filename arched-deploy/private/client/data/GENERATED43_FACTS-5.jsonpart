":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Waiting_for_Godot","checkedOnline85":false}],"explanation74":"Beckett's play follows two characters waiting for the absent Godot.","questionId85":"GEN43-Q04489","reviewStatus85":"ready"},{"id":"REVISION85-4490","nodeId":"REVISION85-4490","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Who wrote The Stranger (L'Étranger)?","value":"Albert Camus","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"creator work","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/The_Stranger_(Camus_novel)","checkedOnline85":false}],"explanation74":"Camus's novel follows Meursault in French Algeria.","questionId85":"GEN43-Q04490","reviewStatus85":"ready"},{"id":"REVISION85-4491","nodeId":"REVISION85-4491","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"The protagonist of Dostoevsky's Crime and Punishment is:","value":"Raskolnikov","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Crime_and_Punishment","checkedOnline85":false}],"explanation74":"Rodion Raskolnikov commits a murder and struggles with guilt and justification.","questionId85":"GEN43-Q04491","reviewStatus85":"ready"},{"id":"REVISION85-4492","nodeId":"REVISION85-4492","anchor":"MAJOR:LANGUAGE-AND-LITERATURE","subject":"Tolstoy's War and Peace includes the invasion of Russia by:","value":"Napoleon","group":"Language & Literature","major":"Language & Literature","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic refe