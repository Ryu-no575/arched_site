ess?action=media&name=0f7323354f591f00b3aefe85.webp","credit":"Annibale Carracci","license":"Copyrighted artwork; reproduction from Wikipedia. Commercial-use permission not established.","sourceUrl":"https://en.wikipedia.org/wiki/File:Farnese_Gallery_-_Annibale_Carracci_-_1597_-_Farnese_Gallery%2C_Rome.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=0f7323354f591f00b3aefe85.webp","credit":"Annibale Carracci","license":"Copyrighted artwork; reproduction from Wikipedia. Commercial-use permission not established.","sourceUrl":"https://en.wikipedia.org/wiki/File:Farnese_Gallery_-_Annibale_Carracci_-_1597_-_Farnese_Gallery%2C_Rome.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01356","GEN43-Q03969"],"tapestryIds":["t63-d9a3002f912f"],"museumIds":[],"mapIds":[],"note":"Roman mythological fresco cycle; Triumph of Bacchus and Ariadne at its centre.","creator":"Annibale Carracci","assetIds":["T81-t63-d9a3002f912f","T82-t63-d9a3002f912f"]},{"id":"LE102-24d88ffac8e1a0f9","title":"Edict of Nantes","kind":"history","reference":"https://en.wikipedia.org/wiki/Edict_of_Nantes","aliases":["Edict of Nantes"],"photos":[],"questionIds":["GEN43-Q01125","GEN43-Q01126","GEN43-Q04557","ARCHED-NEW98-0032","ARCHED-NEW101-0107"],"tapestryIds":["t63-52cabb004ec7"],"museumIds":[],"mapIds":[],"note":"Religious settlement under Henry IV."},{"id":"LE102-236f5af00d869332","title":"Gian Lorenzo Bernini","kind":"person","reference":"https://en.wikipedia.org/wiki/Gian_Lorenzo_Bernini","aliases":["Gian Lorenzo Bernini"],"photos":[],"questionIds":["ARCHED-NEW101-0235","ARCHED-NEW101-0236","ALPHA-B004-Q344","ALPHA-B008-Q693","PDF33-Q041-B","PDF35-Q074-B"],"tapestryIds":["t63-181f4f8f6e73"],"museumIds":[],"mapIds":[],"note":"Sculptor and architect."},{"id":"LE102-42ce1b76fc29786c","title":"Calling of Saint Matthew","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Calling_of_St_Matthew","aliases":["Calling of Saint Matthew"],"photos":[{"src":"/.netlify/functions/access?action=media&name=cea1e3f9e820308f7ce72a74.webp","credit":"Gleb Simonov","license":"CC0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Caravaggio_%E2%80%94_The_Calling_of_Saint_Matthew.jpg","caption":"work"},{"src":"/.netlify/functions/access?action=media&name=cea1e3f9e820308f7ce72a74.webp","credit":"Gleb Simonov","license":"CC0","sourceUrl":"https://commons.wikimedia.org/wiki/File:Caravaggio_%E2%80%94_The_Calling_of_Saint_Matthew.jpg","licenseUrl":""}],"questionIds":["GEN43-Q03963","ADD45-Q11202","PDF33-Q046-A"],"tapestryIds":["t63-355beea6585e"],"museumIds":[],"mapIds":[],"note":"Contarelli Chapel; light and gesture connect the sacred story to contemporary life.","creator":"Caravaggio","assetIds":["REV84-IMAGE-3963"]},{"id":"LE102-ab8b44ca54e1251c","title":"Martyrdom of Saint Matthew","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Martyrdom_of_Saint_Matthew","aliases":["Martyrdom of Saint Matthew"],"photos":[{"src":"/.netlify/functions/access?action=media&name=7981d2d090d85d4fc12232c2.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Caravaggio_%E2%80%94_The_Martyrdom_of_Saint_Matthew.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=7981d2d090d85d4fc12232c2.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Caravaggio_%E2%80%94_The_Martyrdom_of_Saint_Matthew.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01361"],"tapestryIds":["t63-0db69c5027a1"],"museumIds":[],"mapIds":[],"note":"Companion to the Calling in the Contarelli Chapel.","creator":"Caravaggio","assetIds":["T81-t63-0db69c5027a1"]},{"id":"LE102-91f3154038f4c156","title":"Hamlet","kind":"art","reference":"https://en.wikipedia.org/wiki/Hamlet","aliases":["Hamlet"],"photos":[],"questionIds":[],"tapestryIds":["t63-78d94745b093"],"museumIds":[],"mapIds":[],"note":"Composition dates approximate; first publication 1603.","creator":"William Shakespeare"},{"id":"LE102-b113acdfcc59e9fd","title":"Anthony van Dyck","kind":"person","reference":"https://en.wikipedia.org/wiki/Anthony_van_Dyck","aliases":["Anthony van Dyck"],"photos":[],"questionIds":[],"tapestryIds":["t63-ffe0f5bd554d"],"museumIds":[],"mapIds":[],"note":"Painter."},{"id":"LE102-addc78053db7e95b","title":"Diego Velázquez","kind":"person","reference":"https://en.wikipedia.org/wiki/Diego_Vel%C3%A1zquez","aliases":["Diego Velázquez"],"photos":[],"questionIds":["PDF33-Q053-B","PDF34-Q-087-B"],"tapestryIds":["t63-be42cbccbe2d"],"museumIds":[],"mapIds":[],"note":"Spanish court painter."},{"id":"LE102-59d98f83943bf150","title":"Francesco Borromini","kind":"person","reference":"https://en.wikipedia.org/wiki/Francesco_Borromini","aliases":["Francesco Borromini"],"photos":[],"questionIds":["ARCHED-NEW101-0235","PDF34-Q-141-B","PDF35-Q082-B"],"tapestryIds":["t63-ba78f8fcfda2"],"museumIds":[],"mapIds":[],"note":"Architect."},{"id":"LE102-9eccdec3fa8cd218","title":"English East India Company chartered","kind":"history","reference":"https://en.wikipedia.org/wiki/East_India_Company","aliases":["English East India Company chartered"],"photos":[],"questionIds":["ARCHED-NEW101-0482","ARCHED-NEW101-0492"],"tapestryIds":["t63-a65bb5c803e2"],"museumIds":[],"mapIds":[],"note":"Royal charter from Elizabeth I."},{"id":"LE102-6dc72e2568fe80fa","title":"Crucifixion of Saint Peter","kind":"art","reference":"https://en.wikipedia.org/wiki/Crucifixion_of_Saint_Peter_(Caravaggio)","aliases":["Crucifixion of Saint Peter"],"photos":[{"src":"/.netlify/functions/access?action=media&name=943363535122fb4e4fc7c0fc.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Crucifixion_of_Saint_Peter-Caravaggio_%28c.1600%29.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=61f196135381c37bb62c290d.webp","credit":"Sailko","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Michelangelo,_crocifissione_di_san_pietro,_1546-50,_02_(cropped).jpg","licenseUrl":""},{"src":"/.netlify/functions/access?action=media&name=943363535122fb4e4fc7c0fc.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Crucifixion_of_Saint_Peter-Caravaggio_%28c.1600%29.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01335","GEN43-Q03503","ADD45-Q11383"],"tapestryIds":["t63-312328941f3e"],"museumIds":["PDFART48-53"],"mapIds":[],"note":"Cerasi Chapel, Santa Maria del Popolo, Rome.","creator":"Caravaggio","assetIds":["PDFART48-53","T81-t63-312328941f3e"],"placeId":"MAP103-Q182955"},{"id":"LE102-44f75fbf8061e5bd","title":"Claude Lorrain","kind":"person","reference":"https://en.wikipedia.org/wiki/Claude_Lorrain","aliases":["Claude Lorrain"],"photos":[],"questionIds":[],"tapestryIds":["t63-ff8959caa6b8"],"museumIds":[],"mapIds":[],"note":"Landscape painter; birth approximate."},{"id":"LE102-0f19e0c0b1147d50","title":"Dutch genres and the art market","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Dutch%20genres%20and%20the%20art%20market","aliases":["Dutch genres and the art market"],"photos":[],"questionIds":[],"tapestryIds":["t69-01d218155f42"],"museumIds":[],"mapIds":[],"note":"Portraits, landscapes, interiors and still lifes served varied buyers in the Dutch Republic. A less court-centred market does not mean an absence of religious or political meaning."},{"id":"LE102-d7d5660a4d7d455f","title":"Tenebrism and selective illumination","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Tenebrism%20and%20selective%20illumination","aliases":["Tenebrism and selective illumination"],"photos":[],"questionIds":[],"tapestryIds":["t69-89ca15069eaa"],"museumIds":[],"mapIds":[],"note":"Strong dark fields and concentrated light heighten dramatic focus. Tenebrism is a more specific lighting effect than chiaroscuro generally."},{"id":"LE102-dfcd730a706c5dd5","title":"Vanitas and still-life symbolism","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Vanitas%20and%20still-life%20symbolism","aliases":["Vanitas and still-life symbolism"],"photos":[],"questionIds":[],"tapestryIds":["t69-3ac77ec15ea6"],"museumIds":[],"mapIds":[],"note":"Skulls, extinguished candles and timepieces can evoke mortality and transience. Read symbols in the context of the specific work instead of assuming every object has one meaning."},{"id":"LE102-b4d0aee338651992","title":"Absolutism, court ritual and architecture","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=Absolutism%2C%20court%20ritual%20and%20architecture","aliases":["Absolutism, court ritual and architecture"],"photos":[],"questionIds":[],"tapestryIds":["t69-fd5546c30a95"],"museumIds":[],"mapIds":[],"note":"Palaces and gardens can organise access, ceremony and political visibility. Absolutism describes claims and structures of power, not the absence of every constraint."},{"id":"LE102-edf2a34a25e30118","title":"Baroque","kind":"history","reference":"https://en.wikipedia.org/wiki/Baroque","aliases":["Baroque"],"photos":[],"questionIds":[],"tapestryIds":["t63-52e79589e474"],"museumIds":[],"mapIds":[],"note":"Broad European period; regional and medium-specific chronologies differ."},{"id":"LE102-b06e547efce92132","title":"Baroque movement and theatrical space","kind":"architecture","reference":"https://en.wikipedia.org/w/index.php?search=Baroque%20movement%20and%20theatrical%20space","aliases":["Baroque movement and theatrical space"],"photos":[],"questionIds":[],"tapestryIds":["t69-085ee7a7f524"],"museumIds":[],"mapIds":[],"note":"Curved forms, directed light and coordinated painting, sculpture and architecture can guide a visitor's experience. Compare Borromini's spatial geometry with Bernini's theatrical ensembles.","built":"1600"},{"id":"LE102-efa80e52173eddce","title":"Quadratura and illusionistic ceilings","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=Quadratura%20and%20illusionistic%20ceilings","aliases":["Quadratura and illusionistic ceilings"],"photos":[],"questionIds":[],"tapestryIds":["t69-4cbe4c257468"],"museumIds":[],"mapIds":[],"note":"Painted architecture can seem to extend actual space; perspective must be coordinated with the viewer's position. Distinguish illusionistic construction from simple decorative pattern."},{"id":"LE102-4ed2808219313c02","title":"Conversion on the Way to Damascus","kind":"art","reference":"https://en.wikipedia.org/wiki/Conversion_on_the_Way_to_Damascus","aliases":["Conversion on the Way to Damascus"],"photos":[{"src":"/.netlify/functions/access?action=media&name=dd0e5878a143320f9a944f04.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Conversion_on_the_Way_to_Damascus-Caravaggio_(c.1600-1).jpg","caption":"work"},{"src":"/.netlify/functions/access?action=media&name=dd0e5878a143320f9a944f04.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Conversion_on_the_Way_to_Damascus-Caravaggio_(c.1600-1).jpg","licenseUrl":""},{"src":"/.netlify/functions/access?action=media&name=dd0e5878a143320f9a944f04.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Conversion_on_the_Way_to_Damascus-Caravaggio_(c.1600-1).jpg","licenseUrl":""}],"questionIds":["GEN43-Q01329","ADD45-Q11400"],"tapestryIds":["t63-c3c11496d84f"],"museumIds":["PDFART48-76","ART93-t63-c3c11496d84f"],"mapIds":[],"note":"Second Cerasi Chapel version; distinguish the first commission's panel.","creator":"Caravaggio","assetIds":["PDFART48-76","ART93-t63-c3c11496d84f","T81-t63-c3c11496d84f"]},{"id":"LE102-706ff9c9cbde49f3","title":"Supper at Emmaus: London version","kind":"art","reference":"https://en.wikipedia.org/wiki/Supper_at_Emmaus_(Caravaggio,_London)","aliases":["Supper at Emmaus: London version","Supper at Emmaus (Caravaggio, London)"],"photos":[{"src":"/.netlify/functions/access?action=media&name=ff2f12adff42ec429b1c7e2a.webp","credit":"Caravaggio","license":"Public domain artwork reproduction","sourceUrl":"https://commons.wikimedia.org/wiki/File:Supper_at_Emmaus-Caravaggio_%281601%29.jpg","caption":"Full painting; version verified against the named collection."},{"src":"/.netlify/functions/access?action=media&name=ff2f12adff42ec429b1c7e2a.webp","credit":"Caravaggio","license":"Public domain artwork reproduction","sourceUrl":"https://commons.wikimedia.org/wiki/File:Supper_at_Emmaus-Caravaggio_%281601%29.jpg","licenseUrl":""}],"questionIds":["GEN43-Q01191","ADD45-Q11332"],"tapestryIds":["t63-e7528d4b1d8e"],"museumIds":["ART45-Q318947"],"mapIds":[],"note":"Distinguish from the later Milan version of 1606.","creator":"Caravaggio","assetIds":["ART45-Q318947"],"placeId":"MAP103-Q180788"},{"id":"LE102-43534a1d64c5c5b0","title":"Alonso Cano","kind":"person","reference":"https://en.wikipedia.org/wiki/Alonso_Cano","aliases":["Alonso Cano"],"photos":[],"questionIds":[],"tapestryIds":["t63-a02ef3cc906b"],"museumIds":[],"mapIds":[],"note":"Painter, sculptor and architect."},{"id":"LE102-186cc340939559d5","title":"Dutch East India Company founded","kind":"history","reference":"https://en.wikipedia.org/wiki/Dutch_East_India_Company","aliases":["Dutch East India Company founded"],"photos":[],"questionIds":[],"tapestryIds":["t63-d6714ea09af2"],"museumIds":[],"mapIds":[],"note":"VOC."},{"id":"LE102-6350db0b3649db43","title":"Entombment of Christ","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Entombment_of_Christ_(Caravaggio)","aliases":["Entombment of Christ"],"photos":[{"src":"/.netlify/functions/access?action=media&name=c48293a501e455c25aaad98b.webp","credit":"Caravaggio","license":"Public domain","sourceUrl":"http