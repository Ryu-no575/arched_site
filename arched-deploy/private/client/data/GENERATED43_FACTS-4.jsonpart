ny Enlightenment writers.","questionId85":"GEN43-Q04414","reviewStatus85":"ready"},{"id":"REVISION85-4415","nodeId":"REVISION85-4415","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"The Boston Tea Party protested a policy involving:","value":"Tea taxation and trade","group":"History & Politics","major":"History & Politics","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Boston_Tea_Party","checkedOnline85":false}],"explanation74":"The protest opposed the Tea Act and the imperial arrangements surrounding the tea trade.","questionId85":"GEN43-Q04415","reviewStatus85":"ready"},{"id":"REVISION85-4416","nodeId":"REVISION85-4416","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"The French decrees of August 1789 attacked the privileges of the:","value":"Feudal order","group":"History & Politics","major":"History & Politics","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Abolition_of_feudalism_in_France","checkedOnline85":false}],"explanation74":"The August decrees of 1789 attacked the legal privileges of the old social order.","questionId85":"GEN43-Q04416","reviewStatus85":"ready"},{"id":"REVISION85-4417","nodeId":"REVISION85-4417","anchor":"MAJOR:HISTORY-AND-POLITICS","subject":"The Jacobins are associated with the:","value":"French Revolution","group":"History & Politics","major":"History & Politics","era":"Other","relation":"context relation","references":[{"file":"Original general-knowledge question: topic reference","page":null,"verificationUrl":"https://en.wikipedia.org/wiki/Jacobin","checkedOnline85":false}],"explanation74":"The Jacobin club was a major political organisation during the French Revolution.","questionId85":"GEN43-Q04417","reviewStatus85":"ready"},{"id":"REVISION85-4418","nodeId":"REVISIO