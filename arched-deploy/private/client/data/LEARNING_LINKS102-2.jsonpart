se":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Edouard_Manet_-_Olympia_-_Google_Art_ProjectFXD.jpg","licenseUrl":""}],"questionIds":["ADD45-Q11243","ADD45-Q11244","ADD45-Q11274"],"tapestryIds":["t68-44583d12618c"],"museumIds":["ART45-OFFICIAL-8a339ca31853","PDFART48-150"],"mapIds":[],"note":"Painted in 1863 and exhibited at the Salon in 1865; the contemporary nude challenges conventions of idealised mythological subjects.","creator":"Édouard Manet","assetIds":["ART45-OFFICIAL-8a339ca31853","PDFART48-150"]},{"id":"LE102-f0dad9bc9c8c4b27","title":"The Birth of Venus","kind":"art","reference":"https://en.wikipedia.org/w/index.php?search=The%20Birth%20of%20Venus","aliases":["The Birth of Venus"],"photos":[{"src":"/.netlify/functions/access?action=media&name=db551131d6e73f2ef0594e9f.webp","credit":"Alexandre Cabanel","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Alexandre_Cabanel_-_The_Birth_of_Venus_-_Google_Art_Project_2.jpg","caption":"Identified work. Sculpture photographs may show later casts or surviving copies."},{"src":"/.netlify/functions/access?action=media&name=eb5a8e139e565d4d261bce08.webp","credit":"Uffizi Gallery · Wikimedia Commons","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Sandro_Botticelli_-_La_nascita_di_Venere_-_Google_Art_Project_-_edited.jpg","licenseUrl":"https://commons.wikimedia.org/wiki/Commons:Licensing"}],"questionIds":["ADD45-Q11162","ADD45-Q11163","ADD45-Q11263","ADD45-Q11264","ADD45-Q11265","PDF33-Q025-A"],"tapestryIds":["t68-973c6c0c3f01"],"museumIds":["ART45-Q151047"],"mapIds":[],"note":"Academic mythological painting; contrast with Manet's contemporary challenges to the Salon.","creator":"Alexandre Cabanel","assetIds":["ART45-Q151047"],"placeId":"MAP51-093"},{"id":"LE102-7730eb5b343ed801","title":"Paul Signac","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Paul%20Signac","aliases":["Paul Signac"],"photos":[],"questionI