rical appearance."}},{"id":"t68-c21f1a149bd4","title":"Lateran Pacts","lane":"history","start":1929,"end":1929,"approx":false,"note":"Settled the Roman Question and created Vatican City as a sovereign state.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Lateran%20Pacts","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["italy"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-a5db25d5c768","title":"The Treachery of Images","lane":"art","start":1929,"end":1929,"approx":false,"note":"The painted pipe and its text distinguish an object from an image of that object.","creators":["René Magritte"],"reference":"https://en.wikipedia.org/w/index.php?search=The%20Treachery%20of%20Images","sourceSheets":[3645],"sourceMapping":"supplemental work for a creator on the source sheet","dateType":"year","threads67":["low"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16","image":{"src":"/.netlify/functions/access?action=media&name=7b07a3ccfa3a0e05ec806e8e.webp","credit":"Los Angeles County Museum of Art · Wikimedia Commons","license":"Public domain","url":"https://en.wikipedia.org/wiki/The_Treachery_of_Images","scope":"Exact title and artist matched to existing catalogue"},"mediaType78":"visual-artwork"},{"id":"t68-46cea29fab6a","title":"Wall Street crash","lane":"history","start":1929,"end":1929,"approx":false,"note":"The stock-market collapse accompanied the onset of the Great Depression; the depression had broader causes.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Wall%20Street%20crash","sourceSheets":[3645],"sourceMapping":"item","dateType":"year","threads67":["other"],"setting67":"Historical setting","sourceBatch68":"Sheets 11–16"},{"id":"t68-118b90acd1ab","title":"Great Depression","lane":"history","start":1929,"end":1939,"approx":false,"note":"A severe global economic crisis; dates of recovery varied by country.","creator