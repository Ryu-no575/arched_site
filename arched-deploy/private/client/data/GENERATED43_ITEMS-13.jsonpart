a4b6b9","semanticKey101":"1985035cb7ce643e0afa9dd16e977b457ed3307e36797e899ba421073955d72b","practiceRepetitionKeys95":["FACT:ARCHED-NEW101-0083"],"testedRelation95":"v101:ec853608eb7e84268939","workNames101":[],"imageId":null,"semanticReview101":"Replaced duplicate or reverse restatement with a distinct factual relation."},{"id":"ARCHED-NEW101-0084","qid":1010084,"major":"History & Politics","stem":"Which political movement was founded by Giuseppe Mazzini to promote a united republican Italy?","choices":["Young Turks","Carbonari","Popular Party","National Fascist Party","Young Italy"],"answer":"Young Italy","correctIndex":4,"explanation":"Mazzini founded Young Italy as a republican nationalist movement in 1831.","group":"Italian unification","topic74":"Italian unification","format":"context_relation","skill74":"context_relation","task101":"context_relation","examLanguages":["en","it"],"scope":"shared","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"version":"editorial-v101","difficulty74":"unrated","references":[],"evidenceStatus101":"editorial factual review; individual external verification not claimed","nodeId":"FACT101-ARCHED-NEW101-0084","relatedNodeIds":["FACT101-ARCHED-NEW101-0084"],"fingerprint":"c619d55ca2b7484441f4","semanticKey101":"dc46fdf9add364875d9bb9da0afeb1141462c41523e92f18d9c5fb9b25f46ed9","practiceRepetitionKeys95":["FACT:ARCHED-NEW101-0084"],"testedRelation95":"v101:56b90b166257943305c4"},{"id":"ARCHED-NEW101-0085","qid":1010085,"major":"History & Politics","stem":"Which Roman road originally connected Rome with Capua before extension toward Brindisi?","choices":["Via Emilia","Via Flaminia","Via Aurelia","Via Cassia","Via Appia"],"answer":"Via Appia","correctIndex":4,"explanation":"The Appian Way became a major route from Rome to southern Italy.","group":"Ancient transport","topic74":"Ancient transport","format":"context_relation","skill74":"context_relation","task101":"context_r