le","license":"Public domain","url":"https://commons.wikimedia.org/wiki/File:Constable_-_The_Cornfield.jpg","scope":"Identified work. Sculpture photographs may show later casts or surviving copies."},"imageChecked78":"2026-10-05"},{"id":"t68-b0f8fef72c36","title":"Arnold Böcklin","lane":"people","start":1827,"end":1901,"approx":false,"note":"Swiss Symbolist painter; cultural context should not be equated with one modern state.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Arnold%20B%C3%B6cklin","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["central"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-fbb1259e0a10","title":"William Holman Hunt","lane":"people","start":1827,"end":1910,"approx":false,"note":"Pre-Raphaelite painter combining detailed observation with moral and religious subjects.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=William%20Holman%20Hunt","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-bb56b4e1298a","title":"Dante Gabriel Rossetti","lane":"people","start":1828,"end":1882,"approx":false,"note":"Pre-Raphaelite painter and poet.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Dante%20Gabriel%20Rossetti","sourceSheets":[3643],"sourceMapping":"item","dateType":"lifespan","threads67":["britain"],"setting67":"Cultural / geographical association; see work context","sourceBatch68":"Sheets 11–16"},{"id":"t68-7332bd9193c6","title":"Leo Tolstoy","lane":"people","start":1828,"end":1910,"approx":false,"note":"Russian novelist and moral thinker; distinguish his life from the historical settings of his novels.","creators":[],"reference":"https://en.wikipedia.org/w/index.php?search=Leo%20Tolstoy","sourceSheets":[3643],"sourceMapping":"item",