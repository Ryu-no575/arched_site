gine/simboli-repubblica-tricolore","aliases":["Kingdom of Italy proclaimed"],"photos":[],"questionIds":["GEN43-Q01630","ARCHED-NEW101-0456","ARCHED-NEW101-0485","ARCHED-NEW101-0520"],"tapestryIds":["t68-707db078684b"],"museumIds":[],"mapIds":[],"note":"Proclaimed on 17 March under Victor Emmanuel II; Rome and Venice were not yet included."},{"id":"LE102-9abffd9a215c0e4a","title":"American Civil War","kind":"history","reference":"https://en.wikipedia.org/w/index.php?search=American%20Civil%20War","aliases":["American Civil War"],"photos":[],"questionIds":["ALPHA-B002-Q122","ALPHA-B005-Q401","ALPHA-B008-Q751","NEWDER-027","NEWDER-034"],"tapestryIds":["t68-d5d81ee88fad"],"museumIds":[],"mapIds":[],"note":"Union and Confederacy fought over secession and slavery; emancipation and constitutional change followed."},{"id":"LE102-5b12af60324a0e8a","title":"Les Misérables","kind":"person","reference":"https://en.wikipedia.org/w/index.php?search=Les%20Mis%C3%A9rables","aliases":["Les Misérables"],"photos":[],"questionIds":[],"tapestryIds":["t68-0579ccd6c1a7"],"museumIds":[],"mapIds":[],"note":"Historical novel of justice and social exclusion; the 1832 uprising depicted is not the French Revolution of 1789.","creator":"Victor Hugo"},{"id":"LE102-bec8fe7ca3bfb347","title":"The Turkish Bath","kind":"art","reference":"https://en.wikipedia.org/wiki/The_Turkish_Bath","aliases":["The Turkish Bath"],"photos":[{"src":"/.netlify/functions/access?action=media&name=884df9f55a56d9d9ccffb379.webp","credit":"Jean-Auguste-Dominique Ingres","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Le_Bain_Turc,_by_Jean_Auguste_Dominique_Ingres,_from_C2RMFFXD.jpg","caption":""},{"src":"/.netlify/functions/access?action=media&name=884df9f55a56d9d9ccffb379.webp","credit":"Jean-Auguste-Dominique Ingres","license":"Public domain","sourceUrl":"https://commons.wikimedia.org/wiki/File:Le_Bain_Turc,_by_Jean_Auguste_Dominique_Ingres,_from_C2RMFFXD.jpg","licenseUrl":""}],"questionIds