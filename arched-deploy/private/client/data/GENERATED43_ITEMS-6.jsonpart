rreotypes"],"correctIndex":3,"answer":"Etchings","explanation":"These eighteenth-century prints imagine monumental, labyrinthine prison spaces.","format":"visual_matching","references":[{"file":"The Met — Title Page, Carceri d’invenzione","verificationUrl":"https://www.metmuseum.org/art/collection/search/362797","sourceMetadata95":{"id":"B03-S-Piranesi","key":"Piranesi","title":"The Met — Title Page, Carceri d’invenzione","url":"https://www.metmuseum.org/art/collection/search/362797","source_type":"institutional_primary","verification_status":"supporting_text_read","checked_at":"2026-10-07","support_scope":"The Met identifies this title plate, c.1749–1750, as etching, engraving and sulphur tint/open bite; the object image is labelled Public Domain.","retrieval_reference":"turn259132view0","quoted_text":false,"retrieval_record":"turn993414view1","verification_record_origin":"resumed_web_read"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":129,"canonical_number":null,"revision95":3,"topic74":"Piranesi Carceri: print medium and historical imagination","skill74":"context_relation","testedRelation95":"B02R2:piranesi-carceri:-print-medium-and-historical-imagination","practiceRepetitionKeys95":["WORK-0d7fa8af48b86525","TOPIC:piranesi-carceri-print-medium-and-historical-imagination"],"workIds95":["WORK-0d7fa8af48b86525"],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"d458b744daf707bc07a205a7d9a89510b4d37f9b05b382cd7e219f8d5be5058c","fingerprint":"f6f7fcafbaa00b57e322","imageId":"HANDOFF95-IMAGE-0d7fa8af48b86525ad9b","imageDependency":"essential","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"revised_and_adopted"}},{"id":"ARCHED-B02-20261007-131","qid":950131,"nodeId":"REVIEW95-ARCHED-B02-20261007-131","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-131"],"sourceAtlasNodeIds":[],"major":"Art History","group":"Fauvism principal artists","stem":"Which pair of artists is closely associated with early Fauvism?","choices":["Piet Mondrian and Kazimir Malevich","Henri Matisse and André Derain","Andy Warhol and Roy Lichtenstein","Jacques-Louis David and Jean-Auguste-Dominique Ingres","Salvador Dalí and René Magritte"],"correctIndex":1,"answer":"Henri Matisse and André Derain","explanation":"Matisse and Derain developed an approach using vivid, non-naturalistic colour. Recognizing the pair helps locate Fauvism among the different movements of modern art.","format":"single_best_answer","references":[{"file":"The Metropolitan Museum of Art — Fauvism","verificationUrl":"https://www.metmuseum.org/essays/fauvism","sourceMetadata95":{"id":"B02-R09","title":"The Metropolitan Museum of Art — Fauvism","url":"https://www.metmuseum.org/essays/fauvism","support_summary":"Henri Matisse and André Derain worked together in 1905 and were central to the development of Fauvism.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":131,"canonical_number":null,"revision95":1,"topic74":"Fauvism principal artists","skill74":"context_relation","testedRelation95":"B02:fauvism-principal-artists","practiceRepetitionKeys95":["TOPIC:fauvism-principal-artists"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"3422aba34bad1629c0f7e51f358f6d589d9dfaa1405a8e284f2357c6b419a6d4","fingerprint":"167c7190c951aa6b604e","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-135","qid":950135,"nodeId":"REVIEW95-ARCHED-B02-20261007-135","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-135"],"sourceAtlasNodeIds":[],"major":"Art History","group":"Mosaic and fresco comparison","stem":"Which contrast between mosaic and buon fresco is correct?","choices":["Mosaic — ink held in engraved grooves; buon fresco — coloured glass fitted into lead","Mosaic — woven wool and silk; buon fresco — assembled stone tesserae","Mosaic — pigment on fresh plaster; buon fresco — carved blocks of marble","Mosaic — assembled tesserae; buon fresco — pigment applied to fresh plaster","Mosaic — oil paint on canvas; buon fresco — a photographic emulsion"],"correctIndex":3,"answer":"Mosaic — assembled tesserae; buon fresco — pigment applied to fresh plaster","explanation":"Mosaic constructs an image from small pieces such as stone or glass. Buon fresco applies pigments to fresh plaster. They can decorate similar architectural spaces while using fundamentally different processes.","format":"matching","references":[{"file":"Encyclopaedia reference — Mosaic","verificationUrl":"https://en.wikipedia.org/wiki/Mosaic","sourceMetadata95":{"id":"B03-S-Mosaic","key":"Mosaic","title":"Encyclopaedia reference — Mosaic","url":"https://en.wikipedia.org/wiki/Mosaic","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}},{"file":"Encyclopaedia reference — Fresco","verificationUrl":"https://en.wikipedia.org/wiki/Fresco","sourceMetadata95":{"id":"B03-S-Fresco","key":"Fresco","title":"Encyclopaedia reference — Fresco","url":"https://en.wikipedia.org/wiki/Fresco","source_type":"tertiary_encyclopaedia","verification_status":"reference_locator_not_retrieved_this_pass","checked_at":null,"support_scope":"Reference supplied for this topic; no claim that its live text was read in this pass.","quoted_text":false,"verification_record_origin":"reference_only"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":135,"canonical_number":null,"revision95":2,"topic74":"Mosaic and fresco comparison","skill74":"context_relation","testedRelation95":"B02R2:mosaic-and-fresco-comparison","practiceRepetitionKeys95":["TOPIC:mosaic-and-fresco-comparison"],"workIds95":[],"evidenceStatus95":"reference_only_pending_external_check","exactDuplicateOf95":[],"sourceSnapshotHash95":"89570b320f7d97252bd5beb9c222143c3a46673bcc49f8ca9bd1aba1b16ef268","fingerprint":"cdfcd3b236039880a4c2","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"reference_only_pending_external_check","decision":"adopted"}},{"id":"ARCHED-B02-20261007-138","qid":950138,"nodeId":"REVIEW95-ARCHED-B02-20261007-138","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-138"],"sourceAtlasNodeIds":[],"major":"Art History","group":"Still life and portrait distinction","stem":"Which subject would most naturally be classified as a still life?","choices":["A landscape of mountains and clouds","A table arranged with a jug, fruit and folded cloth","A ruler posing for a ceremonial portrait","A crowded city street with pedestrians","A cavalry charge during a battle"],"correctIndex":1,"answer":"A table arranged with a jug, fruit and folded cloth","explanation":"Still life concentrates on inanimate objects arranged as a pictorial subject. A painting may include a table within another genre, so the main subject matters.","format":"single_best_answer","references":[{"file":"National Gallery — Still life","verificationUrl":"https://www.nationalgallery.org.uk/paintings/glossary/still-lives","sourceMetadata95":{"id":"B02-R15","title":"National Gallery — Still life","url":"https://www.nationalgallery.org.uk/paintings/glossary/still-lives","support_summary":"Still-life painting represents arranged inanimate objects.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":138,"canonical_number":null,"revision95":1,"topic74":"Still life and portrait distinction","skill74":"context_relation","testedRelation95":"B02:still-life-and-portrait-distinction","practiceRepetitionKeys95":["TOPIC:still-life-and-portrait-distinction"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"5b573da70700cb9f29b1fd63fc6a3065427893f0976ff50e9c9fe29f6e32aac8","fingerprint":"6fc43169815d599c37e7","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-142","qid":950142,"nodeId":"REVIEW95-ARCHED-B02-20261007-142","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-142"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"American Declaration political purpose","stem":"What did the American Declaration of Independence of 1776 proclaim?","choices":["A new federal constitution replacing the Articles of Confederation","Separation of the colonies from the British Crown","The abolition of slavery throughout all thirteen colonies","The transfer of French colonies to British administration","The admission of the western territories as states"],"correctIndex":1,"answer":"Separation of the colonies from the British Crown","explanation":"The document declared the colonies independent states. Its language of rights did not mean that all inhabitants immediately enjoyed equal rights in practice.","format":"single_best_answer","references":[{"file":"US National Archives — Declaration of Independence transcript","verificationUrl":"https://www.archives.gov/founding-docs/declaration-transcript","sourceMetadata95":{"id":"B02-H04","title":"US National Archives — Declaration of Independence transcript","url":"https://www.archives.gov/founding-docs/declaration-transcript","support_summary":"The declaration states that the colonies are free and independent states, absolved from allegiance to the British Crown.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":142,"canonical_number":null,"revision95":1,"topic74":"American Declaration political purpose","skill74":"context_relation","testedRelation95":"B02:american-declaration-political-purpose","practiceRepetitionKeys95":["TOPIC:american-declaration-political-purpose"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"52e96401ee45c8ae2e08b8d065676b18e6cc837265f3420dfd504732ef401f6f","fingerprint":"e0cc1112edf17770d407","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-143","qid":950143,"nodeId":"REVIEW95-ARCHED-B02-20261007-143","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-143"],"sourceAtlasNodeIds":["HUB-NAPOLEONIC-ERA"],"major":"History & Politics","group":"Waterloo and Napoleon","stem":"At which battle was Napoleon defeated at the end of the Hundred Days?","choices":["Wagram","Jena","Austerlitz","Marengo","Waterloo"],"correctIndex":4,"answer":"Waterloo","explanation":"Waterloo was fought in 1815 after Napoleon returned from exile. It belongs to the end of the Napoleonic era, not to the wars of the twentieth century.","format":"single_best_answer","references":[{"file":"National Army Museum — Battle of Waterloo","verificationUrl":"https://www.nam.ac.uk/explore/battle-waterloo","sourceMetadata95":{"id":"B02-H05","title":"National Army Museum — Battle of Waterloo","url":"https://www.nam.ac.uk/explore/battle-waterloo","support_summary":"The defeat at Waterloo in 1815 ended Napoleon’s return to power.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":143,"canonical_number":null,"revision95":1,"topic74":"Waterloo and Napoleon","skill74":"context_relation","testedRelation95":"B02:waterloo-and-napoleon","practiceRepetitionKeys95":["TOPIC:waterloo-and-napoleon"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"7b6cb2f7bd5abca0343aa1f0848b509e1c47488a6dfd14c47ff2fb74fa7abf4c","fingerprint":"5358fda1f932d5ded533","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-145","qid":950145,"nodeId":"REVIEW95-ARCHED-B02-20261007-145","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-145"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"British women equal franchise 1928","stem":"What changed with Britain’s Equal Franchise Act of 1928?","choices":["Women gained parliamentary voting rights on the same terms as men","All adult residents gained the vote irrespective of nationality","Women obtained the vote only in local elections","Some women over thirty received the parliamentary vote for the first time","Parliamentary voting became compulsory for both sexes"],"correctIndex":0,"answer":"Women gained parliamentary voting rights on the same terms as men","explanation":"Some women had obtained the parliamentary vote in 1918 under unequal conditions. The 1928 reform removed the sex-based difference in the franchise terms.","format":"single_best_answer","references":[{"file":"UK Parliament — Women and the vote","verificationUrl":"https://www.parliament.uk/about/living-heritage/transformingsociety/electionsvoting/womenvote/overview/thevote/","sourceMetadata95":{"id":"B02-H07","title":"UK Parliament — Women and the vote","url":"https://www.parliament.uk/about/living-heritage/transformingsociety/electionsvoting/womenvote/overview/thevote/","support_summary":"Women first gained a restricted parliamentary franchise in 1918; the 1928 Act gave women voting rights on the same terms as men.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":145,"canonical_number":null,"revision95":1,"topic74":"British women equal franchise 1928","skill74":"context_relation","testedRelation95":"B02:british-women-equal-franchise-1928","practiceRepetitionKeys95":["TOPIC:british-women-equal-franchise-1928"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"d7f97ae528303386899580bd1bd2251d59210aa78a183eaa2ec3977712362c23","fingerprint":"89619a83999e936c2b81","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-146","qid":950146,"nodeId":"REVIEW95-ARCHED-B02-20261007-146","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-146"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Partition of British India","stem":"Which two independent states emerged from the partition of British India in 1947?","choices":["Bangladesh and Sri Lanka","India and Nepal","India and Myanmar","India and Pakistan","Pakistan and Afghanistan"],"correctIndex":3,"answer":"India and Pakistan","explanation":"Pakistan initially included western and eastern parts; the eastern part later became Bangladesh. Independence and partition also brought enormous human suffering through displacement and violence.","format":"single_best_answer","references":[{"file":"National Army Museum — Independence and Partition, 1947","verificationUrl":"https://www.nam.ac.uk/explore/independence-and-partition-1947","sourceMetadata95":{"id":"B02-H08","title":"National Army Museum — Independence and Partition, 1947","url":"https://www.nam.ac.uk/explore/independence-and-partition-1947","support_summary":"The end of British rule in 1947 brought the independent states of India and Pakistan, accompanied by mass displacement and violence.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":146,"canonical_number":null,"revision95":1,"topic74":"Partition of British India","skill74":"context_relation","testedRelation95":"B02:partition-of-british-india","practiceRepetitionKeys95":["TOPIC:partition-of-british-india"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"d86c5f095a8597a2a4b3861a9398d4205ce1d3dcc66ad7d889a3b66c87be4227","fingerprint":"ffa63c83bd5acf3a71b2","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-149","qid":950149,"nodeId":"REVIEW95-ARCHED-B02-20261007-149","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-149"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Holocaust historical definition","stem":"Which description identifies the Holocaust most precisely?","choices":["The nuclear destruction of Hiroshima and Nagasaki","The expulsion of the Moors from medieval Spain","The Nazi-led genocide of European Jews","The famine during the Irish potato blight","The massacre of French Protestants in 1572"],"correctIndex":2,"answer":"The Nazi-led genocide of European Jews","explanation":"Nazi Germany, its allies and collaborators systematically persecuted and murdered European Jews. Other groups were also victims of Nazi persecution and mass murder; the term has a specific historical meaning.","format":"single_best_answer","references":[{"file":"United States Holocaust Memorial Museum — Introduction to the Holocaust","verificationUrl":"https://encyclopedia.ushmm.org/content/en/article/introduction-to-the-holocaust","sourceMetadata95":{"id":"B02-H11","title":"United States Holocaust Memorial Museum — Introduction to the Holocaust","url":"https://encyclopedia.ushmm.org/content/en/article/introduction-to-the-holocaust","support_summary":"The Holocaust was the systematic persecution and murder of six million European Jews by Nazi Germany and its allies and collaborators.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,"verification_record_origin":"previous_batch_inherited"}}],"examLanguages":["en","it"],"scope":"shared","version":"editorial-review-v100","editorialStatus74":"ready","reviewStatus":"editorially_reviewed","publication_ready":true,"previewOnly95":false,"seriesNumber95":149,"canonical_number":null,"revision95":1,"topic74":"Holocaust historical definition","skill74":"context_relation","testedRelation95":"B02:holocaust-historical-definition","practiceRepetitionKeys95":["TOPIC:holocaust-historical-definition"],"workIds95":[],"evidenceStatus95":"supporting_text_records_available","exactDuplicateOf95":[],"sourceSnapshotHash95":"8d07cb308538ce8d767ac233bb342836627b846fc66b63f8d072ba44203405a0","fingerprint":"b39f1e4042b82e4ab499","review100":{"date":"2026-10-09","scope":"Stem, five alternatives, correct answer and explanation reviewed. Retained source provenance is not an assertion of fresh external verification.","sourceVerification":"supporting_text_records_available","decision":"adopted"}},{"id":"ARCHED-B02-20261007-157","qid":950157,"nodeId":"REVIEW95-ARCHED-B02-20261007-157","relatedNodeIds":["REVIEW95-ARCHED-B02-20261007-157"],"sourceAtlasNodeIds":[],"major":"History & Politics","group":"Thirteenth Amendment and legal slavery","stem":"Which US constitutional amendment abolished slavery, subject to its stated punishment-for-crime exception?","choices":["The Nineteenth Amendment","The First Amendment","The Fourth Amendment","The Thirteenth Amendment","The Second Amendment"],"correctIndex":3,"answer":"The Thirteenth Amendment","explanation":"The Thirteenth Amendment made abolition part of the Constitution. The First concerns freedoms such as speech, while the Nineteenth concerns voting rights regardless of sex.","format":"single_best_answer","references":[{"file":"US National Archives — 13th Amendment","verificationUrl":"https://www.archives.gov/milestone-documents/13th-amendment","sourceMetadata95":{"id":"B02-H19","title":"US National Archives — 13th Amendment","url":"https://www.archives.gov/milestone-documents/13th-amendment","support_summary":"The amendment abolished slavery and involuntary servitude in the United States, with the stated punishment-for-crime exception.","verification_status":"supporting_web_text_read","checked_on":"2026-10-07","verification_method":"Author read the cited supporting web text; not independent expert certification.","source_type":"institutional","quoted_text":false,