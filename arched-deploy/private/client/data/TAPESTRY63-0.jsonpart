o","sourceSheets":[3638,3639],"sourceMapping":"period context","dateType":"lifespan","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-94b9bbf6939a","title":"Peace of Cateau-Cambrésis","lane":"history","start":1559,"end":1559,"approx":false,"note":"Ends the principal phase of the Italian Wars.","creators":[],"reference":"https://en.wikipedia.org/wiki/Peace_of_Cateau-Cambr%C3%A9sis","sourceSheets":[3638,3639],"sourceMapping":"period context","dateType":"year","threads67":["shared"],"setting67":"Cross-regional / setting not yet specified"},{"id":"t63-624867f232d1","title":"Uffizi palace","lane":"architecture","start":1560,"end":1580,"approx":false,"note":"Built as administrative offices for Cosimo I; completed after Vasari's death.","creators":["Giorgio Vasari"],"reference":"https://en.wikipedia.org/wiki/Uffizi","sourceSheets":[3639],"sourceMapping":"item","dateType":"period","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation","image":{"src":"/.netlify/functions/access?action=media&name=2ad3007fcff24d6675ee8fe0.webp","credit":"Arek N.","license":"CC BY-SA 3.0","url":"https://commons.wikimedia.org/wiki/File:Florence,_Italy_-_panoramio_(125).jpg","scope":"Photograph of the identified subject or its surviving remains; not a reconstruction of its historical appearance."}},{"id":"t63-bc742c07fcbe","title":"Annibale Carracci","lane":"people","start":1560,"end":1609,"approx":false,"note":"Bolognese painter; frescoes of the Farnese Gallery.","creators":[],"reference":"https://en.wikipedia.org/wiki/Annibale_Carracci","sourceSheets":[3638,3639],"sourceMapping":"period context","dateType":"lifespan","threads67":["italy"],"setting67":"Cultural association · not necessarily the place of creation"},{"id":"t63-dea321ef82e6","title":"Francis Bacon","lane":"people","start":1561,"end":1626,"approx":false,"note":"Philosopher and statesman.","creators":[],"reference":"https://en.wikipe